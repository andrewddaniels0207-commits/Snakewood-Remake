    msgbox(gText_NicknameThisPokemon, MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) goto(LittlerootTown_ProfessorBirchsLab_EventScript_CyndaquilTransferredToPC)
    call(Common_EventScript_NameReceivedBoxMon)
