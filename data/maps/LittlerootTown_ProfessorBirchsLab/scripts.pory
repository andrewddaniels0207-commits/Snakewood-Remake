script LittlerootTown_ProfessorBirchsLab_EventScript_Rival {
    lock
    faceplayer
    if (var(VAR_DEX_UPGRADE_JOHTO_STARTER_STATE) == 5) goto(LittlerootTown_ProfessorBirchsLab_EventScript_RivalFuturePlans)
    if (var(VAR_DEX_UPGRADE_JOHTO_STARTER_STATE) >= 6) goto(LittlerootTown_ProfessorBirchsLab_EventScript_RivalHaveYouGoneToBattleFrontier)
    if (var(VAR_DEX_UPGRADE_JOHTO_STARTER_STATE) >= 2) goto(LittlerootTown_ProfessorBirchsLab_EventScript_RivalTakeBreakFromFieldwork)
    checkplayergender()
    if (var(VAR_RESULT) == MALE) call(LittlerootTown_ProfessorBirchsLab_EventScript_MayWhereShouldIGoNext)
    if (var(VAR_RESULT) == FEMALE) call(LittlerootTown_ProfessorBirchsLab_EventScript_BrendanWhereShouldIGoNext)
    release
    end
}

