mapscripts CeruleanCity_House1_Frlg_MapScripts {}

script CeruleanCity_House1_EventScript_BadgeGuy {
    lock
    faceplayer
    msgbox(CeruleanCity_House1_Text_BadgesHaveAmazingSecrets)
    goto(CeruleanCity_House1_EventScript_DescribeAnotherBadge)
    end
}

script CeruleanCity_House1_EventScript_DescribeAnotherBadge {
    message(CeruleanCity_House1_Text_DescribeWhichBadge)
    waitmessage()
    setvar(VAR_0x8004, SCROLL_MULTI_BADGES)
    special(ShowScrollableMultichoice)
    waitstate
    switch (var(VAR_RESULT)) {
        case 0:
            goto(CeruleanCity_House1_EventScript_DescribeBoulderBadge)
        case 1:
            goto(CeruleanCity_House1_EventScript_DescribeCascadeBadge)
        case 2:
            goto(CeruleanCity_House1_EventScript_DescribeThunderBadge)
        case 3:
            goto(CeruleanCity_House1_EventScript_DescribeRainbowBadge)
        case 4:
            goto(CeruleanCity_House1_EventScript_DescribeSoulBadge)
        case 5:
            goto(CeruleanCity_House1_EventScript_DescribeMarshBadge)
        case 6:
            goto(CeruleanCity_House1_EventScript_DescribeVolcanoBadge)
        case 7:
            goto(CeruleanCity_House1_EventScript_DescribeEarthBadge)
        case 8:
            goto(CeruleanCity_House1_EventScript_StopDescribingBadges)
        case 127:
            goto(CeruleanCity_House1_EventScript_StopDescribingBadges)
    }
    end
}

script CeruleanCity_House1_EventScript_DescribeBoulderBadge {
    msgbox(CeruleanCity_House1_Text_AttackStatFlash)
    goto(CeruleanCity_House1_EventScript_DescribeAnotherBadge)
    end
}

script CeruleanCity_House1_EventScript_DescribeCascadeBadge {
    msgbox(CeruleanCity_House1_Text_ObeyLv30Cut)
    goto(CeruleanCity_House1_EventScript_DescribeAnotherBadge)
    end
}

script CeruleanCity_House1_EventScript_DescribeThunderBadge {
    msgbox(CeruleanCity_House1_Text_SpeedStatFly)
    goto(CeruleanCity_House1_EventScript_DescribeAnotherBadge)
    end
}

script CeruleanCity_House1_EventScript_DescribeRainbowBadge {
    msgbox(CeruleanCity_House1_Text_ObeyLv50Strength)
    goto(CeruleanCity_House1_EventScript_DescribeAnotherBadge)
    end
}

script CeruleanCity_House1_EventScript_DescribeSoulBadge {
    msgbox(CeruleanCity_House1_Text_DefenseStatSurf)
    goto(CeruleanCity_House1_EventScript_DescribeAnotherBadge)
    end
}

script CeruleanCity_House1_EventScript_DescribeMarshBadge {
    msgbox(CeruleanCity_House1_Text_ObeyLv70RockSmash)
    goto(CeruleanCity_House1_EventScript_DescribeAnotherBadge)
    end
}

script CeruleanCity_House1_EventScript_DescribeVolcanoBadge {
    msgbox(CeruleanCity_House1_Text_SpStatsWaterfall)
    goto(CeruleanCity_House1_EventScript_DescribeAnotherBadge)
    end
}

script CeruleanCity_House1_EventScript_DescribeEarthBadge {
    msgbox(CeruleanCity_House1_Text_AllMonsWillObeyYou)
    goto(CeruleanCity_House1_EventScript_DescribeAnotherBadge)
    end
}

script CeruleanCity_House1_EventScript_StopDescribingBadges {
    msgbox(CeruleanCity_House1_Text_ComeVisitAnytime)
    release
    end
}

text CeruleanCity_House1_Text_BadgesHaveAmazingSecrets {
    "Only skilled TRAINERS can collect\n"
    "POKéMON BADGES.\p"
    "I see you have at least one.\p"
    "Those BADGES have amazing secrets,\n"
    "did you know?$"
}

text CeruleanCity_House1_Text_DescribeWhichBadge {
    "Now then…\p"
    "Which of the eight BADGES should\n"
    "I describe?$"
}

text CeruleanCity_House1_Text_ComeVisitAnytime {
    "Come visit me anytime you wish.$"
}

text CeruleanCity_House1_Text_AttackStatFlash {
    "The ATTACK stat of all your\n"
    "POKéMON increases a little bit.\p"
    "It also lets you use the move\n"
    "FLASH outside of battle.$"
}

text CeruleanCity_House1_Text_ObeyLv30Cut {
    "POKéMON up to Lv. 30 will obey\n"
    "you.\p"
    "That includes even outsiders you\n"
    "obtain in trades.\p"
    "POKéMON of higher levels will\n"
    "be unruly in battle, however.\p"
    "It also lets you use the move\n"
    "CUT outside of battle.$"
}

text CeruleanCity_House1_Text_SpeedStatFly {
    "The SPEED stat of all your\n"
    "POKéMON increases a little bit.\p"
    "It also lets you use the move\n"
    "FLY outside of battle.$"
}

