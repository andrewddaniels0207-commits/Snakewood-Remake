mapscripts AquaHideout_B1F_MapScripts {
    MAP_SCRIPT_ON_RESUME: AquaHideout_B1F_OnResume
    MAP_SCRIPT_ON_TRANSITION: AquaHideout_B1F_OnTransition
}

script AquaHideout_B1F_OnResume {
    if (flag(FLAG_SYS_CTRL_OBJ_DELETE)) call(AquaHideout_B1F_EventScript_TryRemoveElectrode)
    end
}

script AquaHideout_B1F_EventScript_TryRemoveElectrode {
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) != B_OUTCOME_CAUGHT) goto(Common_EventScript_NopReturn)
    removeobject(VAR_LAST_TALKED)
    return
}

script AquaHideout_B1F_OnTransition {
    if (!flag(FLAG_DEFEATED_ELECTRODE_1_AQUA_HIDEOUT)) call(AquaHideout_B1F_EventScript_ShowElectrode1)
    if (!flag(FLAG_DEFEATED_ELECTRODE_2_AQUA_HIDEOUT)) call(AquaHideout_B1F_EventScript_ShowElectrode2)
    end
}

script AquaHideout_B1F_EventScript_ShowElectrode1 {
    clearflag(FLAG_HIDE_AQUA_HIDEOUT_B1F_ELECTRODE_1)
    return
}

script AquaHideout_B1F_EventScript_ShowElectrode2 {
    clearflag(FLAG_HIDE_AQUA_HIDEOUT_B1F_ELECTRODE_2)
    return
}

script AquaHideout_B1F_EventScript_Electrode1 {
    lock
    faceplayer
    setwildbattle(SPECIES_ELECTRODE, 30)
    waitse()
    playmoncry(SPECIES_ELECTRODE, CRY_MODE_ENCOUNTER)
    delay(40)
    waitmoncry()
    setflag(FLAG_SYS_CTRL_OBJ_DELETE)
    dowildbattle()
    clearflag(FLAG_SYS_CTRL_OBJ_DELETE)
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) == B_OUTCOME_WON) goto(AquaHideout_B1F_EventScript_DefeatedElectrode1)
    if (var(VAR_RESULT) == B_OUTCOME_RAN) goto(AquaHideout_B1F_EventScript_DefeatedElectrode1)
    if (var(VAR_RESULT) == B_OUTCOME_PLAYER_TELEPORTED) goto(AquaHideout_B1F_EventScript_DefeatedElectrode1)
    setflag(FLAG_DEFEATED_ELECTRODE_1_AQUA_HIDEOUT)
    release
    end
}

script AquaHideout_B1F_EventScript_DefeatedElectrode1 {
    setflag(FLAG_DEFEATED_ELECTRODE_1_AQUA_HIDEOUT)
    goto(Common_EventScript_RemoveStaticPokemon)
    end
}

script AquaHideout_B1F_EventScript_Electrode2 {
    lock
    faceplayer
    setwildbattle(SPECIES_ELECTRODE, 30)
    waitse()
    playmoncry(SPECIES_ELECTRODE, CRY_MODE_ENCOUNTER)
    delay(40)
    waitmoncry()
    setflag(FLAG_SYS_CTRL_OBJ_DELETE)
    dowildbattle()
    clearflag(FLAG_SYS_CTRL_OBJ_DELETE)
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) == B_OUTCOME_WON) goto(AquaHideout_B1F_EventScript_DefeatedElectrode2)
    if (var(VAR_RESULT) == B_OUTCOME_RAN) goto(AquaHideout_B1F_EventScript_DefeatedElectrode2)
    if (var(VAR_RESULT) == B_OUTCOME_PLAYER_TELEPORTED) goto(AquaHideout_B1F_EventScript_DefeatedElectrode2)
    setflag(FLAG_DEFEATED_ELECTRODE_2_AQUA_HIDEOUT)
    release
    end
}

script AquaHideout_B1F_EventScript_DefeatedElectrode2 {
    setflag(FLAG_DEFEATED_ELECTRODE_2_AQUA_HIDEOUT)
    goto(Common_EventScript_RemoveStaticPokemon)
    end
}

script AquaHideout_B1F_EventScript_Grunt2 {
    trainerbattle_single(TRAINER_GRUNT_AQUA_HIDEOUT_2, AquaHideout_B1F_Text_Grunt2Intro, AquaHideout_B1F_Text_Grunt2Defeat, AquaHideout_B1F_EventScript_Grunt2Defeated)
    msgbox(AquaHideout_B1F_Text_Grunt2PostBattle, MSGBOX_AUTOCLOSE)
    end
}

script AquaHideout_B1F_EventScript_Grunt2Defeated {
    special(PlayerFaceTrainerAfterBattle)
    waitmovement(0)
    msgbox(AquaHideout_B1F_Text_Grunt2PostBattle, MSGBOX_DEFAULT)
    release
    end
}

script AquaHideout_B1F_EventScript_Grunt3 {
    trainerbattle_single(TRAINER_GRUNT_AQUA_HIDEOUT_3, AquaHideout_B1F_Text_Grunt3Intro, AquaHideout_B1F_Text_Grunt3Defeat, AquaHideout_B1F_EventScript_Grunt3Defeated)
    msgbox(AquaHideout_B1F_Text_Grunt3PostBattle, MSGBOX_AUTOCLOSE)
    end
}

script AquaHideout_B1F_EventScript_Grunt3Defeated {
    msgbox(AquaHideout_B1F_Text_Grunt3PostBattle, MSGBOX_DEFAULT)
    release
    end
}

script AquaHideout_B1F_EventScript_Grunt5 {
    trainerbattle_single(TRAINER_GRUNT_AQUA_HIDEOUT_5, AquaHideout_B1F_Text_Grunt5Intro, AquaHideout_B1F_Text_Grunt5Defeat)
    msgbox(AquaHideout_B1F_Text_Grunt5PostBattle, MSGBOX_AUTOCLOSE)
    end
}

script AquaHideout_B1F_EventScript_Grunt7 {
    trainerbattle_single(TRAINER_GRUNT_AQUA_HIDEOUT_7, AquaHideout_B1F_Text_Grunt7Intro, AquaHideout_B1F_Text_Grunt7Defeat)
    msgbox(AquaHideout_B1F_Text_Grunt7PostBattle, MSGBOX_AUTOCLOSE)
    end
}

text AquaHideout_B1F_Text_Grunt2Intro {
    "If you want to know the secret about\n"
    "our HIDEOUT, you have me to beat!$"
}

text AquaHideout_B1F_Text_Grunt2Defeat {
    "I can't win at all…$"
}

text AquaHideout_B1F_Text_Grunt2PostBattle {
    "Our HIDEOUT's secret?\p"
    "Well, let's just say…\n"
    "There's a submarine at the far end!\p"
    "But, by now…\n"
    "Kekekeke…$"
}

text AquaHideout_B1F_Text_Grunt3Intro {
    "Fuel supply loaded A-OK!\n"
    "In-cruise snacks loaded A-OK!\p"
    "Nothing left to do but KO a pesky\n"
    "meddler!$"
}

text AquaHideout_B1F_Text_Grunt3Defeat {
    "I took a serious licking!$"
}

text AquaHideout_B1F_Text_Grunt3PostBattle {
    "Humph!\n"
    "This was supposed to happen!\p"
    "My mission was to just hold you up!$"
}

text AquaHideout_B1F_Text_Grunt5Intro {
    "Yawn… Keeping watch over the\n"
    "HIDEOUT bores me. I'll take you on.$"
}

text AquaHideout_B1F_Text_Grunt5Defeat {
    "Yawn…\n"
    "Oh, I lost…$"
}

text AquaHideout_B1F_Text_Grunt5PostBattle {
    "If you scurry too much, other TEAM\n"
    "AQUA members might get you.$"
}

text AquaHideout_B1F_Text_Grunt7Intro {
    "Hey!\n"
    "You there!\p"
    "Which do you think is cooler?\n"
    "TEAM AQUA's uniform or TEAM MAGMA's?$"
}

text AquaHideout_B1F_Text_Grunt7Defeat {
    "I lost in a cool way…$"
}

text AquaHideout_B1F_Text_Grunt7PostBattle {
    "If you have a cool uniform, you look\n"
    "good even in a loss, don't you think?$"
}
