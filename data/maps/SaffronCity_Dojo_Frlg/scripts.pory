script SaffronCity_Dojo_EventScript_MasterKoichi {
    trainerbattle_single(TRAINER_BLACK_BELT_KOICHI, SaffronCity_Dojo_Text_MasterKoichiIntro, SaffronCity_Dojo_Text_MasterKoichiDefeat, SaffronCity_Dojo_EventScript_DefeatedMasterKoichi)
    if (flag(FLAG_GOT_HITMON_FROM_DOJO)) {
        goto(SaffronCity_Dojo_EventScript_MasterKoichiAlreadyGotHitmon)
    }
    msgbox(SaffronCity_Dojo_Text_ChoosePrizedFightingMon, MSGBOX_AUTOCLOSE)
    end
}

script SaffronCity_Dojo_EventScript_MasterKoichiAlreadyGotHitmon {
    msgbox(SaffronCity_Dojo_Text_StayAndTrainWithUs)
    release
    end
}

script SaffronCity_Dojo_EventScript_DefeatedMasterKoichi {
    setvar(VAR_MAP_SCENE_SAFFRON_CITY_DOJO, 1)
    release
    end
}

text SaffronCity_Dojo_Text_MasterKoichiIntro {
    "Grunt!\p"
    "I am the KARATE MASTER!\n"
    "I am the LEADER here!\p"
    "You wish to challenge us?\n"
    "Expect no mercy!\p"
    "Fwaaa!$"
}

text SaffronCity_Dojo_Text_MasterKoichiDefeat {
    "Hwa!\n"
    "Arrgh! Beaten!$"
}

text SaffronCity_Dojo_Text_ChoosePrizedFightingMon {
    "Indeed, I have lost!\p"
    "But, I beseech you, do not take\n"
    "our emblem as your trophy!\p"
    "In return, I will give you a prized\n"
    "FIGHTING POKéMON!\p"
    "Choose whichever one you like!$"
}

