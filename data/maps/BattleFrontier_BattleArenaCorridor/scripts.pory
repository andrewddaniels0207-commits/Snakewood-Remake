    walk_right()
    #(52 "data/maps/BattleFrontier_BattleArenaCorridor/scripts.pory")
    set_invisible()
    #(53 "data/maps/BattleFrontier_BattleArenaCorridor/scripts.pory")
    step_end()
    #(56 "data/maps/BattleFrontier_BattleArenaCorridor/scripts.pory")
}

