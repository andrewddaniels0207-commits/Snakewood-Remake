mapscripts MirageTower_2F_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE: CaveHole_CheckFallDownHole
    MAP_SCRIPT_ON_TRANSITION: CaveHole_FixCrackedGround
    MAP_SCRIPT_ON_RESUME: MirageTower_2F_SetHoleWarp
}

script MirageTower_2F_SetHoleWarp {
    setstepcallback(STEP_CB_CRACKED_FLOOR)
    setholewarp(MAP_MIRAGE_TOWER_1F)
    end
}
