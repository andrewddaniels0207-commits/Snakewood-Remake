    lock
    faceplayer
    if (flag(FLAG_SYS_GAME_CLEAR)) goto(MossdeepCity_SpaceCenter_2F_EventScript_GentlemanNormal)
    if (var(VAR_MOSSDEEP_CITY_STATE) == 2) goto(MossdeepCity_SpaceCenter_2F_EventScript_GentlemanMagma)
    if (var(VAR_MOSSDEEP_CITY_STATE) < 2) goto(MossdeepCity_SpaceCenter_2F_EventScript_GentlemanNormal)
    goto(MossdeepCity_SpaceCenter_2F_EventScript_GentlemanMagma)
