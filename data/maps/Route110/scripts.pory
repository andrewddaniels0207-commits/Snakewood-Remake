    goto(Route110_EventScript_EndChallenge)
    end
}

script Route110_EventScript_EndChallenge {
    setvar(VAR_CYCLING_CHALLENGE_STATE, 3)
    savebgm(MUS_DUMMY)
    fadedefaultbgm()
    return
}

script Route110_EventScript_RivalTrigger1 {
    setvar(VAR_0x8008, 1)
    goto(Route110_EventScript_RivalScene)
    end
}

script Route110_EventScript_RivalTrigger2 {
    setvar(VAR_0x8008, 2)
    goto(Route110_EventScript_RivalScene)
    end
}

script Route110_EventScript_RivalTrigger3 {
    setvar(VAR_0x8008, 3)
    goto(Route110_EventScript_RivalScene)
    end
}

script Route110_EventScript_RivalScene {
    lockall
    checkplayergender()
    if (var(VAR_RESULT) == MALE) {
        call(Route110_EventScript_PlayMayMusic)
    }
    if (var(VAR_RESULT) == FEMALE) {
        call(Route110_EventScript_PlayBrendanMusic)
    }
    applymovement(LOCALID_ROUTE110_RIVAL, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    applymovement(LOCALID_ROUTE110_RIVAL, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(LOCALID_ROUTE110_RIVAL, Common_Movement_Delay48)
    waitmovement(0)
    delay(30)
    if (var(VAR_0x8008) == 1) {
        call(Route110_EventScript_RivalApproachPlayer1)
    }
    if (var(VAR_0x8008) == 2) {
        call(Route110_EventScript_RivalApproachPlayer2)
    }
    if (var(VAR_0x8008) == 3) {
        call(Route110_EventScript_RivalApproachPlayer3)
    }
    checkplayergender()
    if (var(VAR_RESULT) == MALE) {
        goto(Route110_EventScript_MayBattle)
    }
    if (var(VAR_RESULT) == FEMALE) {
        goto(Route110_EventScript_BrendanBattle)
    }
    releaseall
    end
}

script Route110_EventScript_PlayMayMusic {
    playbgm(MUS_ENCOUNTER_MAY, TRUE)
    return
}

script Route110_EventScript_PlayBrendanMusic {
    playbgm(MUS_ENCOUNTER_BRENDAN, TRUE)
    return
}

script Route110_EventScript_MayBattle {
    msgbox(Route110_Text_MayLetsBattle, MSGBOX_DEFAULT)
    switch (var(VAR_STARTER_MON)) {
        case 0:
            goto(Route110_EventScript_MayBattleTreecko)
        case 1:
            goto(Route110_EventScript_MayBattleTorchic)
        case 2:
            goto(Route110_EventScript_MayBattleMudkip)
    }
    end
}

script Route110_EventScript_MayBattleTreecko {
    trainerbattle_no_intro(TRAINER_MAY_ROUTE_110_TREECKO, Route110_Text_MayDefeated)
    goto(Route110_EventScript_MayDefeated)
    end
}

