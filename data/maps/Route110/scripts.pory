script Route110_EventScript_CyclingChallengeEnd {
    lockall
    applymovement(LOCALID_CHALLENGE_BIKER, Common_Movement_WalkInPlaceFasterRight)
    waitmovement(0)
    call(Route110_EventScript_CyclingChallengeResults)
    releaseall
    end
}

script Route110_EventScript_CyclingChallengeResults {
    special(FinishCyclingRoadChallenge)
    msgbox(Route110_Text_CyclingChallengeResultSummary, MSGBOX_DEFAULT)
    switch (var(VAR_RESULT)) {
        case 10:
            goto(Route110_EventScript_ChallengeReactionBest)
        case 9:
            goto(Route110_EventScript_ChallengeReactionGood)
        case 8:
            goto(Route110_EventScript_ChallengeReactionGood)
        case 7:
            goto(Route110_EventScript_ChallengeReactionGood)
        case 6:
            goto(Route110_EventScript_ChallengeReactionOk)
        case 5:
            goto(Route110_EventScript_ChallengeReactionOk)
        case 4:
            goto(Route110_EventScript_ChallengeReactionOk)
        case 3:
            goto(Route110_EventScript_ChallengeReactionBad)
        case 2:
            goto(Route110_EventScript_ChallengeReactionBad)
        case 1:
            goto(Route110_EventScript_ChallengeReactionBad)
        case 0:
            goto(Route110_EventScript_ChallengeReactionWorst)
    }
    end
}

script Route110_EventScript_ChallengeReactionBest {
    msgbox(Route110_Text_ChallengeReactionBest, MSGBOX_DEFAULT)
    goto(Route110_EventScript_EndChallenge)
    end
}

