mapscripts Route18_EastEntrance_2F_Frlg_MapScripts {}

script Route18_EastEntrance_2F_EventScript_LeftBinoculars {
    msgbox(Route18_EastEntrance_2F_Text_PalletTownInWest, MSGBOX_SIGN)
    end
}

script Route18_EastEntrance_2F_EventScript_RightBinoculars {
    msgbox(Route18_EastEntrance_2F_Text_PeopleSwimming, MSGBOX_SIGN)
    end
}

script Route18_EastEntrance_2F_EventScript_Haden {
    lock
    faceplayer
    setvar(VAR_0x8008, INGAME_TRADE_LICKITUNG)
    call(EventScript_GetInGameTradeSpeciesInfo)
    if (flag(FLAG_DID_MARC_TRADE)) goto(Route18_EastEntrance_2F_EventScript_AlreadyTraded)
    msgbox(Trade_Text_LookingForMonWannaTradeForMon, MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) goto(Route18_EastEntrance_2F_EventScript_DeclineTrade)
    call(EventScript_ChooseMonForInGameTrade)
    if (var(VAR_0x8004) >= PARTY_SIZE) goto(Route18_EastEntrance_2F_EventScript_DeclineTrade)
    call(EventScript_GetInGameTradeSpecies)
    if (var(VAR_RESULT) != VAR_0x8009) goto(Route18_EastEntrance_2F_EventScript_NotRequestedMon)
    call(EventScript_DoInGameTrade)
    msgbox(Trade_Text_HeyThanks)
    setflag(FLAG_DID_MARC_TRADE)
    release
    end
}

script Route18_EastEntrance_2F_EventScript_DeclineTrade {
    msgbox(Trade_Text_AwwOhWell)
    release
    end
}

script Route18_EastEntrance_2F_EventScript_NotRequestedMon {
    bufferspeciesname(STR_VAR_1, VAR_0x8009)
    msgbox(Trade_Text_WhatThatsNoMon)
    release
    end
}

script Route18_EastEntrance_2F_EventScript_AlreadyTraded {
    msgbox(Trade_Text_IsntMyOldMonGreat)
    release
    end
}

text Route18_EastEntrance_2F_Text_PalletTownInWest {
    "Let's see what the binoculars have\n"
    "to show…\p"
    "PALLET TOWN is in the west.$"
}

text Route18_EastEntrance_2F_Text_PeopleSwimming {
    "Let's see what the binoculars have\n"
    "to show…\p"
    "There are people swimming.$"
}
