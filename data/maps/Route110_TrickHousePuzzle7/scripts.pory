script Route110_TrickHousePuzzle7_EventScript_YellowButton {
    playse(SE_SWITCH)
    waitse()
    playse(SE_REPEL)
    initrotatingtilepuzzle(TRUE)
    moverotatingtileobjects(0)
    waitmovement(0)
    turnrotatingtileobjects()
    waitmovement(0)
    freerotatingtilepuzzle()
    end
}

