mapscripts Route110_TrickHousePuzzle7_MapScripts {
    MAP_SCRIPT_ON_RESUME: Route110_TrickHousePuzzle7_OnResume
    MAP_SCRIPT_ON_TRANSITION: Route110_TrickHousePuzzle7_OnTransition
    MAP_SCRIPT_ON_LOAD: Route110_TrickHousePuzzle7_OnLoad
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TRICK_HOUSE_PUZZLE_7_STATE_2, 1: Route110_TrickHousePuzzle7_EventScript_ClearState2
    ]
}

script Route110_TrickHousePuzzle7_OnResume {
    call(Route110_TrickHousePuzzle7_EventScript_UpdateSwitchMetatiles)
    end
}

script Route110_TrickHousePuzzle7_EventScript_UpdateSwitchMetatiles {
    if (flag(FLAG_TRICK_HOUSE_PUZZLE_7_SWITCH_1)) call(Route110_TrickHousePuzzle7_EventScript_SetSwitch1MetatilesOn)
    if (flag(FLAG_TRICK_HOUSE_PUZZLE_7_SWITCH_2)) call(Route110_TrickHousePuzzle7_EventScript_SetSwitch2MetatilesOn)
    if (flag(FLAG_TRICK_HOUSE_PUZZLE_7_SWITCH_3)) call(Route110_TrickHousePuzzle7_EventScript_SetSwitch3MetatilesOn)
    if (flag(FLAG_TRICK_HOUSE_PUZZLE_7_SWITCH_4)) call(Route110_TrickHousePuzzle7_EventScript_SetSwitch4MetatilesOn)
    if (flag(FLAG_TRICK_HOUSE_PUZZLE_7_SWITCH_5)) call(Route110_TrickHousePuzzle7_EventScript_SetSwitch5MetatilesOn)
    return
}

script Route110_TrickHousePuzzle7_EventScript_SetSwitch1MetatilesOn {
    setmetatile(13, 17, METATILE_TrickHousePuzzle_Arrow_RedOnBlack_Up, FALSE)
    setmetatile(12, 16, METATILE_TrickHousePuzzle_Lever_On, TRUE)
    return
}

script Route110_TrickHousePuzzle7_EventScript_SetSwitch2MetatilesOn {
    setmetatile(12, 13, METATILE_TrickHousePuzzle_Arrow_RedOnBlack_Up, FALSE)
    setmetatile(12, 11, METATILE_TrickHousePuzzle_Lever_On, TRUE)
    return
}

script Route110_TrickHousePuzzle7_EventScript_SetSwitch3MetatilesOn {
    setmetatile(7, 12, METATILE_TrickHousePuzzle_Arrow_RedOnBlack_Up, FALSE)
    setmetatile(5, 10, METATILE_TrickHousePuzzle_Lever_On, TRUE)
    return
}

script Route110_TrickHousePuzzle7_EventScript_SetSwitch4MetatilesOn {
    setmetatile(6, 6, METATILE_TrickHousePuzzle_Arrow_RedOnBlack_Right_Alt, FALSE)
    setmetatile(4, 4, METATILE_TrickHousePuzzle_Lever_On, TRUE)
    return
}

script Route110_TrickHousePuzzle7_EventScript_SetSwitch5MetatilesOn {
    setmetatile(8, 4, METATILE_TrickHousePuzzle_Arrow_RedOnBlack_Left, FALSE)
    setmetatile(7, 5, METATILE_TrickHousePuzzle_Lever_On, TRUE)
    return
}

script Route110_TrickHousePuzzle7_EventScript_SetSwitch1MetatilesOff {
    setmetatile(13, 17, METATILE_TrickHousePuzzle_Arrow_RedOnBlack_Down, FALSE)
    setmetatile(12, 16, METATILE_TrickHousePuzzle_Lever_Off, TRUE)
    return
}

script Route110_TrickHousePuzzle7_EventScript_SetSwitch2MetatilesOff {
    setmetatile(12, 13, METATILE_TrickHousePuzzle_Arrow_RedOnBlack_Left, FALSE)
    setmetatile(12, 11, METATILE_TrickHousePuzzle_Lever_Off, TRUE)
    return
}

script Route110_TrickHousePuzzle7_EventScript_SetSwitch3MetatilesOff {
    setmetatile(7, 12, METATILE_TrickHousePuzzle_Arrow_RedOnBlack_Down, FALSE)
    setmetatile(5, 10, METATILE_TrickHousePuzzle_Lever_Off, TRUE)
    return
}

script Route110_TrickHousePuzzle7_EventScript_SetSwitch4MetatilesOff {
    setmetatile(6, 6, METATILE_TrickHousePuzzle_Arrow_RedOnBlack_Left_Alt, FALSE)
    setmetatile(4, 4, METATILE_TrickHousePuzzle_Lever_Off, TRUE)
    return
}

script Route110_TrickHousePuzzle7_EventScript_SetSwitch5MetatilesOff {
    setmetatile(8, 4, METATILE_TrickHousePuzzle_Arrow_RedOnBlack_Right, FALSE)
    setmetatile(7, 5, METATILE_TrickHousePuzzle_Lever_Off, TRUE)
    return
}

script Route110_TrickHousePuzzle7_OnTransition {
    if (var(VAR_TRICK_HOUSE_PUZZLE_7_STATE_2) == 1) goto(Route110_TrickHousePuzzle7_EventScript_TeleportedTransition)
    clearflag(FLAG_TRICK_HOUSE_PUZZLE_7_SWITCH_1)
    clearflag(FLAG_TRICK_HOUSE_PUZZLE_7_SWITCH_2)
    clearflag(FLAG_TRICK_HOUSE_PUZZLE_7_SWITCH_3)
    clearflag(FLAG_TRICK_HOUSE_PUZZLE_7_SWITCH_4)
    clearflag(FLAG_TRICK_HOUSE_PUZZLE_7_SWITCH_5)
    end
}

script Route110_TrickHousePuzzle7_EventScript_TeleportedTransition {
    end
}

script Route110_TrickHousePuzzle7_OnLoad {
    if (var(VAR_TRICK_HOUSE_PUZZLE_7_STATE_2) == 1) call(Route110_TrickHousePuzzle7_EventScript_UpdateSwitchMetatiles)
    end
}

script Route110_TrickHousePuzzle7_EventScript_ClearState2 {
    setvar(VAR_TRICK_HOUSE_PUZZLE_7_STATE_2, 0)
    end
}

script Route110_TrickHousePuzzle7_EventScript_Scroll {
    lockall
    if (var(VAR_TRICK_HOUSE_PUZZLE_7_STATE) == 0) goto(Route110_TrickHousePuzzle7_EventScript_FoundScroll)
    goto(Route110_TrickHousePuzzle_EventScript_ReadScrollAgain)
    end
}

script Route110_TrickHousePuzzle7_EventScript_FoundScroll {
    setvar(VAR_TRICK_HOUSE_PUZZLE_7_STATE, 1)
    goto(Route110_TrickHousePuzzle_EventScript_FoundScroll)
    end
}

script Route110_TrickHousePuzzle7_EventScript_TeleportPad {
    lockall
    setvar(VAR_TRICK_HOUSE_PUZZLE_7_STATE_2, 1)
    warpteleport(MAP_ROUTE110_TRICK_HOUSE_PUZZLE7, 3, 19)
    waitstate
    releaseall
    end
}

script Route110_TrickHousePuzzle7_EventScript_Switch1 {
    lockall
    delay(32)
    if (!flag(FLAG_TRICK_HOUSE_PUZZLE_7_SWITCH_1)) call(Route110_TrickHousePuzzle7_EventScript_SetSwitch1MetatilesOn)
    if (flag(FLAG_TRICK_HOUSE_PUZZLE_7_SWITCH_1)) call(Route110_TrickHousePuzzle7_EventScript_SetSwitch1MetatilesOff)
    special(DrawWholeMapView)
    playse(SE_CLICK)
    if (!flag(FLAG_TRICK_HOUSE_PUZZLE_7_SWITCH_1)) goto(Route110_TrickHousePuzzle7_EventScript_SetSwitch1On)
    if (flag(FLAG_TRICK_HOUSE_PUZZLE_7_SWITCH_1)) goto(Route110_TrickHousePuzzle7_EventScript_SetSwitch1Off)
    end
}

