mapscripts BattleFrontier_Lounge4_MapScripts {}

script BattleFrontier_Lounge4_EventScript_Woman {
    msgbox(BattleFrontier_Lounge4_Text_WonderIfInterviewsAiring, MSGBOX_NPC)
    end
}

script BattleFrontier_Lounge4_EventScript_Cook {
    msgbox(BattleFrontier_Lounge4_Text_IfIOpenedRestaurantHere, MSGBOX_NPC)
    end
}

script BattleFrontier_Lounge4_EventScript_Man {
    msgbox(BattleFrontier_Lounge4_Text_NeedBreatherAfterBattles, MSGBOX_NPC)
    end
}

text BattleFrontier_Lounge4_Text_WonderIfInterviewsAiring {
    "I wonder if they'll be airing interviews\n"
    "with tough TRAINERS today?$"
}

text BattleFrontier_Lounge4_Text_IfIOpenedRestaurantHere {
    "If I opened a restaurant here,\n"
    "it'd make money for sure.$"
}

text BattleFrontier_Lounge4_Text_NeedBreatherAfterBattles {
    "Whew…\p"
    "I need to take a breather after\n"
    "some intense battles…\p"
    "But even now, I never take a break\n"
    "from plotting strategy and combos.$"
}
