    if (flag(FLAG_RECEIVED_DURIN_BERRY)) goto(Route123_BerryMastersHouse_EventScript_GiveNormalBerry)
    msgbox(Route123_BerryMastersHouse_Text_InspirationalTakeThis, MSGBOX_DEFAULT)
    giveitem(ITEM_DURIN_BERRY)
