script Route123_BerryMastersHouse_EventScript_GiveBelueBerry {
    if (flag(FLAG_RECEIVED_BELUE_BERRY)) goto(Route123_BerryMastersHouse_EventScript_GiveNormalBerry)
    msgbox(Route123_BerryMastersHouse_Text_InspirationalTakeThis, MSGBOX_DEFAULT)
    giveitem(ITEM_BELUE_BERRY)
    if (var(VAR_RESULT) == FALSE) goto(Common_EventScript_ShowBagIsFull)
    setflag(FLAG_RECEIVED_BELUE_BERRY)
