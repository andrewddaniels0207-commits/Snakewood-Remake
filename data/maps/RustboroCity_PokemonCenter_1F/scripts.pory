mapscripts RustboroCity_PokemonCenter_1F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: RustboroCity_PokemonCenter_1F_OnTransition
    MAP_SCRIPT_ON_RESUME: CableClub_OnResume
}

script RustboroCity_PokemonCenter_1F_OnTransition {
    setrespawn(HEAL_LOCATION_RUSTBORO_CITY)
    call(Common_EventScript_UpdateBrineyLocation)
    end
}

script RustboroCity_PokemonCenter_1F_EventScript_Nurse {
    setvar(VAR_0x800B, LOCALID_RUSTBORO_NURSE)
    call(Common_EventScript_PkmnCenterNurse)
    waitmessage()
    waitbuttonpress()
    release
    end
}

script RustboroCity_PokemonCenter_1F_EventScript_Man {
    msgbox(RustboroCity_PokemonCenter_1F_Text_PokemonHavePersonalities, MSGBOX_NPC)
    end
}

script RustboroCity_PokemonCenter_1F_EventScript_Boy {
    msgbox(RustboroCity_PokemonCenter_1F_Text_MaleAndFemalePokemon, MSGBOX_NPC)
    end
}

script RustboroCity_PokemonCenter_1F_EventScript_Girl {
    msgbox(RustboroCity_PokemonCenter_1F_Text_HMCutNextDoor, MSGBOX_NPC)
    end
}

text RustboroCity_PokemonCenter_1F_Text_PokemonHavePersonalities {
    "My POKéMON has a NAIVE nature, and my\n"
    "friend's has a JOLLY nature.\p"
    "It's fascinating how POKéMON have\n"
    "personalities!$"
}

text RustboroCity_PokemonCenter_1F_Text_MaleAndFemalePokemon {
    "Just like people, there are male and\n"
    "female POKéMON.\p"
    "But no one seems to have any idea how\n"
    "they're different.$"
}

text RustboroCity_PokemonCenter_1F_Text_HMCutNextDoor {
    "The man next door gave me an HM!\p"
    "I used it to teach my POKéMON how to\n"
    "CUT down skinny trees.$"
}
