script BattleFrontier_Lounge7_EventScript_ExitTutorMoveSelect {
    special(CloseBattleFrontierTutorWindow)
    special(CloseBattlePointsWindow)
    msgbox(BattleFrontier_Lounge7_Text_YouDontWantTo, MSGBOX_DEFAULT)
    release
    end
}

script BattleFrontier_Lounge7_EventScript_CancelChooseMon {
    msgbox(BattleFrontier_Lounge7_Text_YouDontWantTo, MSGBOX_DEFAULT)
    release
    end
}

script BattleFrontier_Lounge7_EventScript_ConfirmMoveSelection {
    special(BufferBattleFrontierTutorMoveName)
    buffernumberstring(STR_VAR_2, VAR_0x8008)
    msgbox(BattleFrontier_Lounge7_Text_MoveWillBeXBattlePoints, MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) goto(BattleFrontier_Lounge7_EventScript_ChooseNewMove)
    specialvar(VAR_TEMP_1, GetFrontierBattlePoints)
    if (var(VAR_TEMP_1) >= VAR_0x8008) goto(BattleFrontier_Lounge7_EventScript_TeachTutorMove)
    msgbox(BattleFrontier_Lounge7_Text_HaventGotEnoughPoints, MSGBOX_DEFAULT)
    goto(BattleFrontier_Lounge7_EventScript_ChooseNewMove)
    end
}

script BattleFrontier_Lounge7_EventScript_TeachTutorMove {
    msgbox(BattleFrontier_Lounge7_Text_TeachMoveToWhichMon, MSGBOX_DEFAULT)
    fadescreen(FADE_TO_BLACK)
    special(CloseBattlePointsWindow)
    special(CloseBattleFrontierTutorWindow)
    chooseboxmon(SELECT_PC_MON_MOVE_TUTOR)
    waitstate
    if (var(VAR_RESULT) == FALSE) goto(BattleFrontier_Lounge7_EventScript_CancelChooseMon)
    msgbox(BattleFrontier_Lounge7_Text_IllTakeBattlePoints, MSGBOX_DEFAULT)
    copyvar(VAR_0x8004, VAR_0x8008)
    special(TakeFrontierBattlePoints)
    release
    end
}

script BattleFrontier_Lounge7_EventScript_ChooseNewMove {
    if (var(VAR_TEMP_FRONTIER_TUTOR_ID) == 0) goto(BattleFrontier_Lounge7_EventScript_ChooseNewLeftTutorMove)
    goto(BattleFrontier_Lounge7_EventScript_ChooseNewRightTutorMove)
    end
}

script BattleFrontier_Lounge7_EventScript_Sailor {
    msgbox(BattleFrontier_Lounge7_Text_ThinkLadiesDontGetAlong, MSGBOX_NPC)
    end
}

script BattleFrontier_Lounge7_EventScript_Gentleman {
    msgbox(BattleFrontier_Lounge7_Text_LadiesWereStrongAndBeautiful, MSGBOX_NPC)
    end
}

text BattleFrontier_Lounge7_Text_LeftTutorIntro {
    "Buhahaha!\p"
    "You couldn't tell it from looking now,\n"
    "but I used to be one tough TRAINER.\p"
    "I had a reputation as the toughest\n"
    "BEAUTY around, I tell you!\p"
    "… … … … … …\p"
    "What is it now?\n"
    "You don't believe me.\p"
    "I'm not like that blowhard woman over\n"
    "there. I'm actually talented!\p"
    "Let me prove it to you.\n"
    "I can teach your POKéMON special and\l"
    "yet cute moves.\p"
    "But my lessons don't come free.\n"
    "How about paying for the moves I teach\l"
    "with a wee bit of Battle Points?$"
}

text BattleFrontier_Lounge7_Text_LeftTutorWelcomeBack {
    "Buhahaha!\p"
    "Are you back to learn special and\n"
    "yet cute POKéMON moves?$"
}

text BattleFrontier_Lounge7_Text_TeachWhichMove {
    "Fine, fine, look here!\n"
    "Which move should I teach?$"
}

text BattleFrontier_Lounge7_Text_MoveWillBeXBattlePoints {
    "The move {STR_VAR_1}, is it?\n"
    "That will be {STR_VAR_2} Battle Points, okay?$"
}

text BattleFrontier_Lounge7_Text_TeachMoveToWhichMon {
    "Fine, fine, now pick the POKéMON\n"
    "I should teach the move to.$"
}

text BattleFrontier_Lounge7_Text_HaventGotEnoughPoints {
    "What the…\n"
    "You haven't got enough Battle Points!$"
}

text BattleFrontier_Lounge7_Text_IllTakeBattlePoints {
    "Do you see how skilled I am now?\n"
    "I'll take your Battle Points, thanks!$"
}

text BattleFrontier_Lounge7_Text_YouDontWantTo {
    "What's that?\n"
    "You don't want to…\p"
    "If you want to see how skilled I am,\n"
    "you come see me anytime!$"
}

text BattleFrontier_Lounge7_Text_RightTutorIntro {
    "Ihihihi!\p"
    "I know it's hard to see now, but I used\n"
    "to be one fantastic TRAINER.\p"
    "I had a reputation as the most\n"
    "invincible SWIMMER around, I tell you!\p"
    "… … … … … …\p"
    "What's wrong?\n"
    "You don't believe me.\p"
    "I'm not like that buffoonish woman over\n"
    "there. I'm actually experienced!\p"
    "I can prove it to you.\n"
    "I can teach your POKéMON hard and\l"
    "yet pretty moves.\p"
    "But my lessons don't come free.\n"
    "How about paying for the moves I teach\l"
    "with a wee bit of Battle Points?$"
}

text BattleFrontier_Lounge7_Text_RightTutorWelcomeBack {
    "Ihihihi!\p"
    "Have you come to learn hard and\n"
    "yet pretty POKéMON moves?$"
}

text BattleFrontier_Lounge7_Text_ThinkLadiesDontGetAlong {
    "Those ladies, the way they bad-mouth\n"
    "each other, you probably think that\l"
    "they don't get along.\p"
    "But if that were true, they wouldn't\n"
    "stay out here together, would they?$"
}

text BattleFrontier_Lounge7_Text_LadiesWereStrongAndBeautiful {
    "When I was just a wee YOUNGSTER,\n"
    "those ladies were strong and beautiful.\p"
    "They were idols among us TRAINERS.\p"
    "Even now, age hasn't dulled their\n"
    "abilities.\p"
    "In fact, their POKéMON moves have\n"
    "grown even more polished.\p"
    "But… For some reason, I can't help\n"
    "but feel this…\p"
    "Time is so cruel…$"
}

text BattleFrontier_Lounge7_Text_SoftboiledDesc {
    "Recovers up to\n"
    "half the user's\n"
    "maximum HP.$"
}

text BattleFrontier_Lounge7_Text_SeismicTossDesc {
    "Inflicts damage\n"
    "identical to the\n"
    "user's level.$"
}

text BattleFrontier_Lounge7_Text_DreamEaterDesc {
    "Recovers half the\n"
    "damage inflicted\n"
    "on a sleeping foe.$"
}

text BattleFrontier_Lounge7_Text_MegaPunchDesc {
    "A strong punch\n"
    "thrown with\n"
    "incredible power.$"
}

text BattleFrontier_Lounge7_Text_MegaKickDesc {
    "An extremely\n"
    "powerful kick with\n"
    "intense force.$"
}

text BattleFrontier_Lounge7_Text_BodySlamDesc {
    "A full-body slam\n"
    "that may cause\n"
    "paralysis.$"
}

text BattleFrontier_Lounge7_Text_RockSlideDesc {
    "Large boulders\n"
    "are hurled. May\n"
    "cause flinching.$"
}

text BattleFrontier_Lounge7_Text_CounterDesc {
    "Retaliates any\n"
    "physical hit with\n"
    "double the power.$"
}

text BattleFrontier_Lounge7_Text_ThunderWaveDesc {
    "A weak jolt of\n"
    "electricity that\n"
    "paralyzes the foe.$"
}

text BattleFrontier_Lounge7_Text_SwordsDanceDesc {
    "A fighting dance\n"
    "that sharply\n"
    "raises ATTACK.$"
}

text BattleFrontier_Lounge7_Text_DefenseCurlDesc {
    "Curls up to con-\n"
    "ceal weak spots\n"
    "and raise DEFENSE.$"
}

text BattleFrontier_Lounge7_Text_SnoreDesc {
    "A loud attack\n"
    "that can be used\n"
    "only while asleep.$"
}

text BattleFrontier_Lounge7_Text_MudSlapDesc {
    "Hurls mud in the\n"
    "foe's face to re-\n"
    "duce its accuracy.$"
}

text BattleFrontier_Lounge7_Text_SwiftDesc {
    "Sprays star-\n"
    "shaped rays\n"
    "that never miss.$"
}

text BattleFrontier_Lounge7_Text_IcyWindDesc {
    "A chilling attack\n"
    "that lowers the\n"
    "foe's SPEED.$"
}

text BattleFrontier_Lounge7_Text_EndureDesc {
    "Endures any at-\n"
    "tack for 1 turn,\n"
    "leaving 1HP.$"
}

text BattleFrontier_Lounge7_Text_PsychUpDesc {
    "Copies the foe's\n"
    "effect(s) and\n"
    "gives to the user.$"
}

text BattleFrontier_Lounge7_Text_IcePunchDesc {
    "An icy punch\n"
    "that may\n"
    "freeze the foe.$"
}

text BattleFrontier_Lounge7_Text_ThunderPunchDesc {
    "An electrified\n"
    "punch that may\n"
    "paralyze the foe.$"
}

text BattleFrontier_Lounge7_Text_FirePunchDesc {
    "A fiery punch\n"
    "that may burn\n"
    "the foe.$"
}
