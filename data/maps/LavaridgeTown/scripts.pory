mapscripts LavaridgeTown_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: LavaridgeTown_OnTransition
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_LAVARIDGE_TOWN_STATE, 1: LavaridgeTown_EventScript_RivalGiveGoGoggles
    ]
}

script LavaridgeTown_OnTransition {
    setflag(FLAG_VISITED_LAVARIDGE_TOWN)
    if (flag(FLAG_WHITEOUT_TO_LAVARIDGE)) {
        call(LavaridgeTown_EventScript_ClearLavaridgeWhiteOut)
    }
    if (flag(FLAG_DEFEATED_EVIL_TEAM_MT_CHIMNEY)) {
        call(LavaridgeTown_EventScript_ShowMtChimneyTrainers)
    }
    call(Common_EventScript_SetupRivalGfxId)
    call(Common_EventScript_SetupRivalOnBikeGfxId)
    if (var(VAR_LAVARIDGE_TOWN_STATE) == 1) {
        call(LavaridgeTown_EventScript_CheckSetRivalPos)
    }
    if (var(VAR_LAVARIDGE_TOWN_STATE) == 1) {
        call(LavaridgeTown_EventScript_HideMapNamePopup)
    }
    end
}

script LavaridgeTown_EventScript_ClearLavaridgeWhiteOut {
    clearflag(FLAG_WHITEOUT_TO_LAVARIDGE)
    return
}

script LavaridgeTown_EventScript_CheckSetRivalPos {
    getplayerxy(VAR_0x8004, VAR_0x8005)
    if (var(VAR_0x8004) == 9) {
        goto(LavaridgeTown_EventScript_SetRivalPos)
    }
    return
}

script LavaridgeTown_EventScript_SetRivalPos {
    setobjectxyperm(LOCALID_LAVARIDGE_RIVAL, 11, 9)
    setobjectxyperm(LOCALID_LAVARIDGE_RIVAL_ON_BIKE, 9, 8)
    setobjectmovementtype(LOCALID_LAVARIDGE_RIVAL_ON_BIKE, MOVEMENT_TYPE_FACE_UP)
    clearflag(FLAG_HIDE_LAVARIDGE_TOWN_RIVAL)
    return
}

script LavaridgeTown_EventScript_ShowMtChimneyTrainers {
    clearflag(FLAG_HIDE_MT_CHIMNEY_TRAINERS)
    return
}

script LavaridgeTown_EventScript_HideMapNamePopup {
    setflag(FLAG_HIDE_MAP_NAME_POPUP)
    return
}

script LavaridgeTown_EventScript_RivalGiveGoGoggles {
    lockall
    getplayerxy(VAR_0x8008, VAR_0x8009)
    if (var(VAR_0x8008) == 9) {
        call(LavaridgeTown_EventScript_RivalNoticePlayer)
    }
    if (var(VAR_0x8008) != 9) {
        call(LavaridgeTown_EventScript_RivalExitHerbShop)
    }
    delay(20)
    checkplayergender()
    if (var(VAR_RESULT) == MALE) {
        call(LavaridgeTown_EventScript_PlayMayMusic)
    }
    if (var(VAR_RESULT) == FEMALE) {
        call(LavaridgeTown_EventScript_PlayBrendanMusic)
    }
    if (var(VAR_0x8008) == 9) {
        call(LavaridgeTown_EventScript_RivalApproachPlayer1)
    }
    if (var(VAR_0x8008) != 9) {
        call(LavaridgeTown_EventScript_RivalApproachPlayer2)
    }
    checkplayergender()
    if (var(VAR_RESULT) == MALE) {
        goto(LavaridgeTown_EventScript_MayGiveGoGoggles)
    }
    if (var(VAR_RESULT) == FEMALE) {
        goto(LavaridgeTown_EventScript_BrendanGiveGoGoggles)
    }
    end
}

script LavaridgeTown_EventScript_MayGiveGoGoggles {
    msgbox(LavaridgeTown_Text_MayNiceBadgesTakeThis, MSGBOX_DEFAULT)
    giveitem(ITEM_GO_GOGGLES)
    setflag(FLAG_RECEIVED_GO_GOGGLES)
    msgbox(LavaridgeTown_Text_MayExplainGoGogglesChallengeDad, MSGBOX_DEFAULT)
    goto(LavaridgeTown_EventScript_RivalExit)
    end
}

script LavaridgeTown_EventScript_BrendanGiveGoGoggles {
    msgbox(LavaridgeTown_Text_BrendanNiceBadgesTakeThis, MSGBOX_DEFAULT)
    giveitem(ITEM_GO_GOGGLES)
    setflag(FLAG_RECEIVED_GO_GOGGLES)
    msgbox(LavaridgeTown_Text_BrendanExplainGoGogglesChallengeDad, MSGBOX_DEFAULT)
    goto(LavaridgeTown_EventScript_RivalExit)
    end
}

script LavaridgeTown_EventScript_RivalExit {
    closemessage
    removeobject(LOCALID_LAVARIDGE_RIVAL)
    addobject(LOCALID_LAVARIDGE_RIVAL_ON_BIKE)
    delay(30)
    if (var(VAR_0x8008) == 9) {
        call(LavaridgeTown_EventScript_RivalExit1)
    }
    if (var(VAR_0x8008) != 9) {
        call(LavaridgeTown_EventScript_RivalExit2)
    }
    removeobject(LOCALID_LAVARIDGE_RIVAL_ON_BIKE)
    setvar(VAR_LAVARIDGE_TOWN_STATE, 2)
    clearflag(FLAG_HIDE_MAP_NAME_POPUP)
    savebgm(MUS_DUMMY)
    fadedefaultbgm()
    releaseall
    end
}

script LavaridgeTown_EventScript_PlayMayMusic {
    playbgm(MUS_ENCOUNTER_MAY, TRUE)
    return
}

script LavaridgeTown_EventScript_PlayBrendanMusic {
    playbgm(MUS_ENCOUNTER_BRENDAN, TRUE)
    return
}

script LavaridgeTown_EventScript_RivalNoticePlayer {
    applymovement(LOCALID_LAVARIDGE_RIVAL, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    playse(SE_PIN)
    applymovement(LOCALID_LAVARIDGE_RIVAL, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(LOCALID_LAVARIDGE_RIVAL, Common_Movement_Delay48)
    waitmovement(0)
    return
}

script LavaridgeTown_EventScript_RivalExitHerbShop {
    opendoor(12, 15)
    waitdooranim()
    addobject(LOCALID_LAVARIDGE_RIVAL)
    applymovement(LOCALID_LAVARIDGE_RIVAL, LavaridgeTown_Movement_RivalExitHerbShop)
    waitmovement(0)
    closedoor(12, 15)
    waitdooranim()
    applymovement(LOCALID_LAVARIDGE_RIVAL, Common_Movement_WalkInPlaceFasterLeft)
    waitmovement(0)
    playse(SE_PIN)
    applymovement(LOCALID_LAVARIDGE_RIVAL, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(LOCALID_LAVARIDGE_RIVAL, Common_Movement_Delay48)
    waitmovement(0)
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterRight)
    waitmovement(0)
    return
}

script LavaridgeTown_EventScript_RivalApproachPlayer1 {
    applymovement(LOCALID_LAVARIDGE_RIVAL, LavaridgeTown_Movement_RivalApproachPlayer1)
    waitmovement(0)
    return
}

script LavaridgeTown_EventScript_RivalApproachPlayer2 {
    applymovement(LOCALID_LAVARIDGE_RIVAL, LavaridgeTown_Movement_RivalApproachPlayer2)
    waitmovement(0)
    return
}

script LavaridgeTown_EventScript_RivalExit1 {
    applymovement(LOCALID_PLAYER, LavaridgeTown_Movement_PlayerWatchRivalExit)
    applymovement(LOCALID_LAVARIDGE_RIVAL_ON_BIKE, LavaridgeTown_Movement_RivalExit1)
    waitmovement(0)
    return
}

script LavaridgeTown_EventScript_RivalExit2 {
    applymovement(LOCALID_LAVARIDGE_RIVAL_ON_BIKE, LavaridgeTown_Movement_RivalExit2)
    waitmovement(0)
    return
}

movement LavaridgeTown_Movement_RivalExit2 {
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_up
    walk_fast_up
    walk_fast_up
    walk_fast_up
    walk_fast_up
    walk_fast_up
    walk_fast_up
    step_end
}

movement LavaridgeTown_Movement_PlayerWatchRivalExit {
    delay_16
    delay_8
    walk_in_place_faster_right
    step_end
}

movement LavaridgeTown_Movement_RivalExit1 {
    walk_fast_down
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_right
    step_end
}

movement LavaridgeTown_Movement_RivalApproachPlayer2 {
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    step_end
}

movement LavaridgeTown_Movement_RivalApproachPlayer1 {
    walk_left
    walk_left
    walk_up
    step_end
}

movement LavaridgeTown_Movement_RivalExitHerbShop {
    walk_down
    step_end
}

script LavaridgeTown_EventScript_HotSpringsTrigger {
    specialvar(VAR_RESULT, GetPlayerFacingDirection)
    if (var(VAR_RESULT) == DIR_SOUTH) {
        goto(LavaridgeTown_EventScript_EnteredHotSprings)
    }
    end
}

script LavaridgeTown_EventScript_EnteredHotSprings {
    incrementgamestat(GAME_STAT_ENTERED_HOT_SPRINGS)
    end
}

script LavaridgeTown_EventScript_ExpertM {
    msgbox(LavaridgeTown_Text_HotSpringsNeverRunDry, MSGBOX_NPC)
    end
}

script LavaridgeTown_EventScript_OldMan {
    msgbox(LavaridgeTown_Text_PokemonNippedBackside, MSGBOX_SIGN)
    end
}

script LavaridgeTown_EventScript_Twin {
    msgbox(LavaridgeTown_Text_BatheInHotSpringsEveryDay, MSGBOX_NPC)
    end
}

script LavaridgeTown_EventScript_HotSpringsOldWoman1 {
    msgbox(LavaridgeTown_Text_IfPokemonInHotSprings, MSGBOX_NPC)
    end
}

script LavaridgeTown_EventScript_HotSpringsOldWoman2 {
    msgbox(LavaridgeTown_Text_HotSpringsClaims, MSGBOX_NPC)
    end
}

script LavaridgeTown_EventScript_ExpertF {
    msgbox(LavaridgeTown_Text_OhYouLikeHotSprings, MSGBOX_NPC)
    end
}

script LavaridgeTown_EventScript_EggWoman {
    lock
    faceplayer
    if (flag(FLAG_RECEIVED_LAVARIDGE_EGG)) {
        goto(LavaridgeTown_EventScript_ReceivedEgg)
    }
    msgbox(LavaridgeTown_Text_HaveEggWillYouTakeIt, MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        goto(LavaridgeTown_EventScript_DeclineEgg)
    }
    getpartysize()
    if (var(VAR_RESULT) == PARTY_SIZE) {
        goto(LavaridgeTown_EventScript_NoRoomForEgg)
    }
    msgbox(LavaridgeTown_Text_HopeYoullWalkPlentyWithEgg, MSGBOX_DEFAULT)
    setflag(FLAG_RECEIVED_LAVARIDGE_EGG)
    playfanfare(MUS_OBTAIN_ITEM)
    message(LavaridgeTown_Text_ReceivedTheEgg)
    waitfanfare()
    giveegg(SPECIES_WYNAUT)
    release
    end
}

script LavaridgeTown_EventScript_ReceivedEgg {
    msgbox(LavaridgeTown_Text_EverySoOftenEggFoundAtDayCare, MSGBOX_DEFAULT)
    release
    end
}

script LavaridgeTown_EventScript_NoRoomForEgg {
    msgbox(LavaridgeTown_Text_NoRoomForThisEgg, MSGBOX_DEFAULT)
    release
    end
}

script LavaridgeTown_EventScript_DeclineEgg {
    msgbox(LavaridgeTown_Text_AsYouWishThen, MSGBOX_DEFAULT)
    release
    end
}

script LavaridgeTown_EventScript_TownSign {
    msgbox(LavaridgeTown_Text_TownSign, MSGBOX_SIGN)
    end
}

script LavaridgeTown_EventScript_GymSign {
    msgbox(LavaridgeTown_Text_GymSign, MSGBOX_SIGN)
    end
}

script LavaridgeTown_EventScript_HerbShopSign {
    msgbox(LavaridgeTown_Text_HerbShopSign, MSGBOX_SIGN)
    end
}

text LavaridgeTown_Text_MayNiceBadgesTakeThis {
    "MAY: {PLAYER}{KUN}! Long time no see!\p"
    "Oh? While I visited the hot springs,\n"
    "you got the LAVARIDGE GYM BADGE.\p"
    "You must have collected\n"
    "good POKéMON…\l"
    "No, I believe you raised some.\p"
    "I guess it would be okay for you to\n"
    "have this.$"
}

text LavaridgeTown_Text_MayExplainGoGogglesChallengeDad {
    "MAY: With those GO-GOGGLES, you'll\n"
    "have no trouble getting through the\l"
    "desert near ROUTE 111.\p"
    "But, wow, {PLAYER}{KUN}…\n"
    "Challenging GYMS…\p"
    "You're trying hard because you don't\n"
    "want to lose to me, I bet!\p"
    "{PLAYER}{KUN}, I think I should challenge\n"
    "your dad in PETALBURG GYM.\p"
    "See you again!$"
}

text LavaridgeTown_Text_BrendanNiceBadgesTakeThis {
    "BRENDAN: {PLAYER}, hey, it's been a while.\n"
    "How's it going?\p"
    "Hmm…\n"
    "That's a decent collection of BADGES.\p"
    "All right, then.\n"
    "You may as well have this.$"
}

text LavaridgeTown_Text_BrendanExplainGoGogglesChallengeDad {
    "BRENDAN: Keep those with you if you're\n"
    "planning on going into that desert near\l"
    "ROUTE 111.\p"
    "There should be some POKéMON that\n"
    "are exclusively desert-dwellers.\l"
    "You might look around for those.\p"
    "As for me…\n"
    "I'm considering challenging NORMAN,\l"
    "the GYM LEADER of PETALBURG.\p"
    "Unlike you, {PLAYER}, your dad looks like\n"
    "he really is tough.\p"
    "See you around!$"
}

text LavaridgeTown_Text_HaveEggWillYouTakeIt {
    "I have here an EGG.\p"
    "I'd hoped to hatch it by covering it in\n"
    "hot sand by the hot springs.\l"
    "But that doesn't seem to be enough…\p"
    "I've heard it would be best if it were\n"
    "kept together with POKéMON and\l"
    "carried about.\p"
    "You are a TRAINER, yes?\n"
    "And your POKéMON radiate vitality.\p"
    "So, what say you?\n"
    "Will you take this EGG to hatch?$"
}

text LavaridgeTown_Text_HopeYoullWalkPlentyWithEgg {
    "Good! I hope you'll walk plenty with\n"
    "this here EGG!$"
}

text LavaridgeTown_Text_ReceivedTheEgg {
    "{PLAYER} received the EGG.$"
}

text LavaridgeTown_Text_NoRoomForThisEgg {
    "Oh? You've too many POKéMON.\n"
    "There's no room for this EGG…$"
}

text LavaridgeTown_Text_AsYouWishThen {
    "As you wish, then…\p"
    "If you have a change of heart about\n"
    "hatching this EGG, I will be here.$"
}

text LavaridgeTown_Text_EverySoOftenEggFoundAtDayCare {
    "Every so often, an EGG will be found at\n"
    "the POKéMON DAY CARE.\p"
    "Or at least that's how the rumor goes.$"
}

text LavaridgeTown_Text_HotSpringsNeverRunDry {
    "We draw as much hot water as we need,\n"
    "and yet the hot springs never run dry.\p"
    "Isn't it magical?\p"
    "These hot springs appear near active\n"
    "volcanoes. Veins of water under the\l"
    "ground are heated by magma to well up\l"
    "as hot springs.$"
}

text LavaridgeTown_Text_PokemonNippedBackside {
    "Being buried in this hot sand is…\n"
    "Sigh…\p"
    "So warm and heavenly…\p"
    "Eh? Gyaah! Ouch!\p"
    "A POKéMON nipped my backside!$"
}

text LavaridgeTown_Text_OhYouLikeHotSprings {
    "Oh, you like hot springs, do you?\p"
    "That's surprising for one as young\n"
    "as you.$"
}

text LavaridgeTown_Text_BatheInHotSpringsEveryDay {
    "I bathe in the hot springs every day.\p"
    "I want to become a beautiful and strong\n"
    "GYM LEADER like FLANNERY.$"
}

text LavaridgeTown_Text_IfPokemonInHotSprings {
    "If people put POKéMON in hot springs,\n"
    "it might be seriously strange.\p"
    "Why, it might be an electric bath, or\n"
    "a bubble bath, or even a lava bath…$"
}

text LavaridgeTown_Text_HotSpringsClaims {
    "They're claiming that these hot springs\n"
    "are good for calming nervous tension,\l"
    "relieving aching muscles, solving\l"
    "romantic problems, and attracting\l"
    "money…$"
}

text LavaridgeTown_Text_TownSign {
    "LAVARIDGE TOWN\p"
    "“POKéMON CENTER HOT SPRINGS\n"
    "An excellent place for relaxing!”$"
}

text LavaridgeTown_Text_GymSign {
    "LAVARIDGE TOWN POKéMON GYM\n"
    "LEADER: FLANNERY\l"
    "“One with a fiery passion that burns!”$"
}

text LavaridgeTown_Text_HerbShopSign {
    "POKéMON HERB SHOP\n"
    "“Bitter taste--better cure!”$"
}
