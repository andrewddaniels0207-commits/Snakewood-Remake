script SlateportCity_OceanicMuseum_1F_EventScript_FamiliarGrunt {
    lock
    faceplayer
    delay(8)
    playse(SE_PIN)
    applymovement(LOCALID_OCEANIC_MUSEUM_FAMILIAR_GRUNT, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(LOCALID_OCEANIC_MUSEUM_FAMILIAR_GRUNT, Common_Movement_Delay48)
    waitmovement(0)
    msgbox(SlateportCity_OceanicMuseum_1F_Text_RememberMeTakeThis, MSGBOX_DEFAULT)
    giveitem(ITEM_TM_THIEF)
    if (var(VAR_RESULT) == 0) goto(SlateportCity_OceanicMuseum_1F_EventScript_NoRoomForThief)
    setflag(FLAG_RECEIVED_TM_THIEF)
    msgbox(SlateportCity_OceanicMuseum_1F_Text_HopeINeverSeeYouAgain, MSGBOX_DEFAULT)
    closemessage
    if (var(VAR_FACING) == DIR_NORTH) goto(SlateportCity_OceanicMuseum_1F_EventScript_FamiliarGruntExitNorth)
    if (var(VAR_FACING) == DIR_SOUTH) goto(SlateportCity_OceanicMuseum_1F_EventScript_FamiliarGruntExitSouth)
    if (var(VAR_FACING) == DIR_WEST) goto(SlateportCity_OceanicMuseum_1F_EventScript_FamiliarGruntExitWestEast)
    if (var(VAR_FACING) == DIR_EAST) goto(SlateportCity_OceanicMuseum_1F_EventScript_FamiliarGruntExitWestEast)
    end
}

script SlateportCity_OceanicMuseum_1F_EventScript_FamiliarGruntExitNorth {
    applymovement(LOCALID_PLAYER, SlateportCity_OceanicMuseum_1F_Movement_PlayerWatchGruntExitNorth)
    applymovement(LOCALID_OCEANIC_MUSEUM_FAMILIAR_GRUNT, SlateportCity_OceanicMuseum_1F_Movement_FamiliarGruntExitNorth)
    waitmovement(0)
    goto(SlateportCity_OceanicMuseum_1F_EventScript_FamiliarGruntExited)
    end
}

script SlateportCity_OceanicMuseum_1F_EventScript_FamiliarGruntExitSouth {
    applymovement(LOCALID_OCEANIC_MUSEUM_FAMILIAR_GRUNT, SlateportCity_OceanicMuseum_1F_Movement_FamiliarGruntExit)
    waitmovement(0)
    goto(SlateportCity_OceanicMuseum_1F_EventScript_FamiliarGruntExited)
    end
}

script SlateportCity_OceanicMuseum_1F_EventScript_FamiliarGruntExitWestEast {
    applymovement(LOCALID_PLAYER, SlateportCity_OceanicMuseum_1F_Movement_PlayerWatchGruntExitWestEast)
    applymovement(LOCALID_OCEANIC_MUSEUM_FAMILIAR_GRUNT, SlateportCity_OceanicMuseum_1F_Movement_FamiliarGruntExit)
    waitmovement(0)
    goto(SlateportCity_OceanicMuseum_1F_EventScript_FamiliarGruntExited)
    end
}

script SlateportCity_OceanicMuseum_1F_EventScript_FamiliarGruntExited {
    setflag(FLAG_HIDE_SLATEPORT_CITY_OCEANIC_MUSEUM_FAMILIAR_AQUA_GRUNT)
    playse(SE_EXIT)
    removeobject(LOCALID_OCEANIC_MUSEUM_FAMILIAR_GRUNT)
    release
    end
}

script SlateportCity_OceanicMuseum_1F_EventScript_NoRoomForThief {
    msgbox(SlateportCity_OceanicMuseum_1F_Text_YouHaveToTakeThis, MSGBOX_DEFAULT)
    release
    end
}

movement SlateportCity_OceanicMuseum_1F_Movement_PlayerWatchGruntExitNorth {
    delay_16
    delay_8
    delay_4
    walk_in_place_faster_down
    step_end
}

movement SlateportCity_OceanicMuseum_1F_Movement_PlayerWatchGruntExitWestEast {
    delay_16
    walk_in_place_faster_down
    step_end
}

movement SlateportCity_OceanicMuseum_1F_Movement_FamiliarGruntExit {
    face_down
    walk_fast_down
    walk_fast_down
    walk_fast_down
    walk_fast_down
    delay_8
    step_end
}

movement SlateportCity_OceanicMuseum_1F_Movement_FamiliarGruntExitNorth {
    walk_fast_right
    walk_fast_down
    walk_fast_down
    walk_fast_down
    walk_fast_down
    delay_8
    step_end
}

text SlateportCity_OceanicMuseum_1F_Text_WouldYouLikeToEnter {
    "Welcome to the OCEANIC MUSEUM.\p"
    "The entrance fee is ¥50.\n"
    "Would you like to enter?$"
}

text SlateportCity_OceanicMuseum_1F_Text_PleaseEnjoyYourself {
    "Please enjoy yourself.$"
}

text SlateportCity_OceanicMuseum_1F_Text_NotEnoughMoney {
    "Oh? I'm sorry, but you don't seem to\n"
    "have enough money.$"
}

text SlateportCity_OceanicMuseum_1F_Text_CatchUpWithYourGroup {
    "Oh? You're with that group that\n"
    "went in earlier?\p"
    "You're the only one who's late.\n"
    "You'd better go catch up to them!$"
}

text SlateportCity_OceanicMuseum_1F_Text_AquaExistForGoodOfAll {
    "We, TEAM AQUA, exist for the good\n"
    "of all!$"
}

text SlateportCity_OceanicMuseum_1F_Text_OurBossIsntHere {
    "We were told to assemble here,\n"
    "so we did, but…\p"
    "Our BOSS, the linchpin, isn't here.$"
}

text SlateportCity_OceanicMuseum_1F_Text_WouldStuffHereMakeMeRich {
    "If I ripped off the stuff here,\n"
    "would it make me rich?$"
}

text SlateportCity_OceanicMuseum_1F_Text_CanLearnForNefariousDeeds {
    "What I learn here, I can put to use on\n"
    "nefarious deeds…$"
}

text SlateportCity_OceanicMuseum_1F_Text_RustboroBungled {
    "If our goons didn't bungle things\n"
    "in RUSTBORO, we wouldn't be here!$"
}

text SlateportCity_OceanicMuseum_1F_Text_DidntHaveMoney {
    "I didn't have ¥50, so it took a long\n"
    "time getting by the receptionist.$"
}

text SlateportCity_OceanicMuseum_1F_Text_LearnAboutSeaForBattling {
    "I want to learn about the sea and\n"
    "use that knowledge for battling.$"
}

text SlateportCity_OceanicMuseum_1F_Text_SternIsRoleModel {
    "I get all giddy and gooey when\n"
    "I see the sea!\p"
    "For me, CAPT. STERN is the number\n"
    "one role model!$"
}

text SlateportCity_OceanicMuseum_1F_Text_MustBePokemonWeDontKnow {
    "The sea is vast without end, and\n"
    "infinitely deep…\p"
    "There must be many POKéMON that\n"
    "we don't know about.$"
}

text SlateportCity_OceanicMuseum_1F_Text_WantSeaPokemon {
    "I want a sea POKéMON.\p"
    "I think it would feel cool and nice\n"
    "to hug.$"
}

text SlateportCity_OceanicMuseum_1F_Text_RememberMeTakeThis {
    "Aiyeeeh!\n"
    "What are you doing here?\p"
    "Me? I'm the TEAM AQUA member\n"
    "you thumped before, remember?\l"
    "Back in RUSTURF TUNNEL?\p"
    "Here, take this!\n"
    "You have to forgive me!$"
}

text SlateportCity_OceanicMuseum_1F_Text_HopeINeverSeeYouAgain {
    "That TM, it suits you more than it\n"
    "does me.\p"
    "Hope I never see you again!\n"
    "Wahahaha!$"
}

text SlateportCity_OceanicMuseum_1F_Text_YouHaveToTakeThis {
    "Awww, come on!\n"
    "You have to take this and let me go!$"
}

text SlateportCity_OceanicMuseum_1F_Text_WhirlpoolExperiment {
    "A blue fluid is spiraling inside\n"
    "a glass vessel.\p"
    "“This is an experiment to create a\n"
    "WHIRLPOOL artificially using wind.”$"
}

text SlateportCity_OceanicMuseum_1F_Text_WaterfallExperiment {
    "A red ball is bobbing up and down\n"
    "inside a glass vessel.\p"
    "“This is an experiment simulating a\n"
    "WATERFALL using the ball's buoyancy.”$"
}

text SlateportCity_OceanicMuseum_1F_Text_OceanSoilDisplay {
    "It's a sample of soil from the ocean\n"
    "floor.\p"
    "“Over many years, the remains of\n"
    "life-forms settle at the bottom of\l"
    "the sea, making sedimentary layers.\p"
    "“By analyzing these layers, the\n"
    "ancient past is revealed.”$"
}

text SlateportCity_OceanicMuseum_1F_Text_BeachSandDisplay {
    "It's a sample of beach sand.\p"
    "“Stones from mountains are washed\n"
    "down by rivers where they are\l"
    "chipped and ground down.\p"
    "“They are reduced to grains and end\n"
    "up as sand on beaches.”$"
}

text SlateportCity_OceanicMuseum_1F_Text_OceanicMinifact1 {
    "“OCEANIC MINIFACT 1\n"
    "Why is seawater blue?\p"
    "“Light is composed of many colors.\p"
    "“When light passes through water,\n"
    "most kinds of light lose color.\p"
    "“However, blue light retains its\n"
    "color, making the sea appear blue.”$"
}

text SlateportCity_OceanicMuseum_1F_Text_OceanicMinifact2 {
    "“OCEANIC MINIFACT 2\n"
    "Why is the sea salty?\p"
    "“Seawater contains dissolved salt in\n"
    "the form of sodium and chlorine ions.\p"
    "“These ions leech out of rocks\n"
    "and are carried out to sea by rain.\p"
    "“The concentration of dissolved salt\n"
    "makes the sea salty.”$"
}

text SlateportCity_OceanicMuseum_1F_Text_OceanicMinifact3 {
    "“OCEANIC MINIFACT 3\n"
    "Which is bigger? The sea or land?\p"
    "“The sea covers about 70% of\n"
    "the planet, and the rest is land.\p"
    "“The sea is therefore more than twice\n"
    "the size of land.”$"
}

text SlateportCity_OceanicMuseum_1F_Text_FossilDisplay {
    "It's a fossil with wavy ridges on it.\p"
    "“Soil on the ocean floor gets scoured\n"
    "by the tide.\p"
    "“The flowing seawater marks the soil\n"
    "with small ridges and valleys.\p"
    "“If this soil becomes fossilized, it is\n"
    "called a ripple mark.”$"
}

text SlateportCity_OceanicMuseum_1F_Text_DepthMeasuringMachine {
    "A strange machine is rotating under\n"
    "a glass dome.\p"
    "Maybe it's for measuring the depth\n"
    "of something…$"
}
