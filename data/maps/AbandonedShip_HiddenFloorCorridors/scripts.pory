mapscripts AbandonedShip_HiddenFloorCorridors_MapScripts {
    MAP_SCRIPT_ON_RESUME: AbandonedShip_HiddenFloorCorridors_OnResume
    MAP_SCRIPT_ON_LOAD: AbandonedShip_HiddenFloorCorridors_OnLoad
}

script AbandonedShip_HiddenFloorCorridors_OnResume {
    setdivewarp(MAP_ABANDONED_SHIP_UNDERWATER1, 5, 4)
    end
}

script AbandonedShip_HiddenFloorCorridors_OnLoad {
    if (!flag(FLAG_USED_ROOM_1_KEY)) call(AbandonedShip_HiddenFloorCorridors_EventScript_LockRoom1)
    if (!flag(FLAG_USED_ROOM_2_KEY)) call(AbandonedShip_HiddenFloorCorridors_EventScript_LockRoom2)
    if (!flag(FLAG_USED_ROOM_4_KEY)) call(AbandonedShip_HiddenFloorCorridors_EventScript_LockRoom4)
    if (!flag(FLAG_USED_ROOM_6_KEY)) call(AbandonedShip_HiddenFloorCorridors_EventScript_LockRoom6)
    if (flag(FLAG_USED_ROOM_1_KEY)) call(AbandonedShip_HiddenFloorCorridors_EventScript_UnlockRoom1)
    if (flag(FLAG_USED_ROOM_2_KEY)) call(AbandonedShip_HiddenFloorCorridors_EventScript_UnlockRoom2)
    if (flag(FLAG_USED_ROOM_4_KEY)) call(AbandonedShip_HiddenFloorCorridors_EventScript_UnlockRoom4)
    if (flag(FLAG_USED_ROOM_6_KEY)) call(AbandonedShip_HiddenFloorCorridors_EventScript_UnlockRoom6)
    end
}

script AbandonedShip_HiddenFloorCorridors_EventScript_UnlockRoom1 {
    setmetatile(3, 8, METATILE_InsideShip_IntactDoor_Bottom_Unlocked, TRUE)
    return
}

script AbandonedShip_HiddenFloorCorridors_EventScript_UnlockRoom2 {
    setmetatile(6, 8, METATILE_InsideShip_IntactDoor_Bottom_Unlocked, TRUE)
    return
}

script AbandonedShip_HiddenFloorCorridors_EventScript_UnlockRoom4 {
    setmetatile(3, 3, METATILE_InsideShip_DoorIndent_Unlocked, FALSE)
    return
}

script AbandonedShip_HiddenFloorCorridors_EventScript_UnlockRoom6 {
    setmetatile(9, 3, METATILE_InsideShip_DoorIndent_Unlocked, FALSE)
    return
}

script AbandonedShip_HiddenFloorCorridors_EventScript_LockRoom1 {
    setmetatile(3, 8, METATILE_InsideShip_IntactDoor_Bottom_Locked, TRUE)
    return
}

script AbandonedShip_HiddenFloorCorridors_EventScript_LockRoom2 {
    setmetatile(6, 8, METATILE_InsideShip_IntactDoor_Bottom_Locked, TRUE)
    return
}

script AbandonedShip_HiddenFloorCorridors_EventScript_LockRoom4 {
    setmetatile(3, 3, METATILE_InsideShip_DoorIndent_Locked, FALSE)
    return
}

script AbandonedShip_HiddenFloorCorridors_EventScript_LockRoom6 {
    setmetatile(9, 3, METATILE_InsideShip_DoorIndent_Locked, FALSE)
    return
}

script AbandonedShip_HiddenFloorCorridors_EventScript_Room1Door {
    lockall
    if (flag(FLAG_USED_ROOM_1_KEY)) goto(AbandonedShip_HiddenFloorCorridors_EventScript_TheDoorIsOpen)
    checkitem(ITEM_KEY_TO_ROOM_1)
    if (var(VAR_RESULT) == FALSE) goto(AbandonedShip_HiddenFloorCorridors_EventScript_Rm1IsLocked)
    msgbox(AbandonedShip_HiddenFloorCorridors_Text_InsertedKey, MSGBOX_DEFAULT)
    playse(SE_PIN)
    removeitem(ITEM_KEY_TO_ROOM_1)
    setflag(FLAG_USED_ROOM_1_KEY)
    call(AbandonedShip_HiddenFloorCorridors_EventScript_UnlockRoom1)
    special(DrawWholeMapView)
    releaseall
    end
}

script AbandonedShip_HiddenFloorCorridors_EventScript_Room2Door {
    lockall
    if (flag(FLAG_USED_ROOM_2_KEY)) goto(AbandonedShip_HiddenFloorCorridors_EventScript_TheDoorIsOpen)
    checkitem(ITEM_KEY_TO_ROOM_2)
    if (var(VAR_RESULT) == FALSE) goto(AbandonedShip_HiddenFloorCorridors_EventScript_Rm2IsLocked)
    msgbox(AbandonedShip_HiddenFloorCorridors_Text_InsertedKey, MSGBOX_DEFAULT)
    playse(SE_PIN)
    removeitem(ITEM_KEY_TO_ROOM_2)
    setflag(FLAG_USED_ROOM_2_KEY)
    call(AbandonedShip_HiddenFloorCorridors_EventScript_UnlockRoom2)
    special(DrawWholeMapView)
    releaseall
    end
}

