script AbandonedShip_HiddenFloorCorridors_EventScript_Room6Door {
    lockall
    if (flag(FLAG_USED_ROOM_6_KEY)) goto(AbandonedShip_HiddenFloorCorridors_EventScript_TheDoorIsOpen)
    checkitem(ITEM_KEY_TO_ROOM_6)
