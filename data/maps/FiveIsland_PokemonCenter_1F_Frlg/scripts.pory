mapscripts FiveIsland_PokemonCenter_1F_Frlg_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: FiveIsland_PokemonCenter_1F_OnTransition
    MAP_SCRIPT_ON_RESUME: CableClub_OnResume
}

script FiveIsland_PokemonCenter_1F_OnTransition {
    setrespawn(HEAL_LOCATION_FIVE_ISLAND)
    end
}

script FiveIsland_PokemonCenter_1F_EventScript_Nurse {
    lock
    faceplayer
    call(EventScript_PkmnCenterNurse_Frlg)
    release
    end
}

script FiveIsland_PokemonCenter_1F_EventScript_Chef {
    msgbox(FiveIsland_PokemonCenter_1F_Text_OnMyWayToPrepareMeal, MSGBOX_NPC)
    end
}

script FiveIsland_PokemonCenter_1F_EventScript_CooltrainerF {
    msgbox(FiveIsland_PokemonCenter_1F_Text_YoureOnQuestToCatchEveryMon, MSGBOX_NPC)
    end
}

text FiveIsland_PokemonCenter_1F_Text_OnMyWayToPrepareMeal {
    "I'm on my way to prepare a meal\n"
    "for a certain high-society person.$"
}

text FiveIsland_PokemonCenter_1F_Text_YoureOnQuestToCatchEveryMon {
    "You're on a quest to catch every\n"
    "single kind of POKéMON?\p"
    "…How incredible. Please tell me if\n"
    "you catch a strong one!$"
}
