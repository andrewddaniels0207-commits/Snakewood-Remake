raw `
FuchsiaCity_House3_Frlg_MapScripts::
	.byte 0


FuchsiaCity_House3_EventScript_MoveDeleter::
# 4 "data/maps/FuchsiaCity_House3_Frlg/scripts.pory"
	lock
