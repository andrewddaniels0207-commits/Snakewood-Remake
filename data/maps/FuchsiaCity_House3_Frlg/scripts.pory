FuchsiaCity_House3_EventScript_ChooseMonForMoveDeleter_1:
# 21 "data/maps/FuchsiaCity_House3_Frlg/scripts.pory"
	special IsSelectedMonEgg
# 22 "data/maps/FuchsiaCity_House3_Frlg/scripts.pory"
