	faceplayer
# 6 "data/maps/FuchsiaCity_House3_Frlg/scripts.pory"
	msgbox FuchsiaCity_House3_Text_WouldYouLikeToForgetMove, MSGBOX_YESNO
# 7 "data/maps/FuchsiaCity_House3_Frlg/scripts.pory"
	compare VAR_RESULT, YES
