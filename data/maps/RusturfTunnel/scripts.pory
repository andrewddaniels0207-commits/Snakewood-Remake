script RusturfTunnel_EventScript_Mike {
    trainerbattle_single(TRAINER_MIKE_2, RusturfTunnel_Text_MikeIntro, RusturfTunnel_Text_MikeDefeat)
    msgbox(RusturfTunnel_Text_MikePostBattle, MSGBOX_AUTOCLOSE)
    end
}

text RusturfTunnel_Text_ComeAndGetSome {
    "What, are you coming?\n"
    "Come and get some, then!$"
}

text RusturfTunnel_Text_Peeko {
    "PEEKO: Pii pihyoh!$"
}

text RusturfTunnel_Text_GruntIntro {
    "Grah, keelhaul it all!\p"
    "That hostage POKéMON turned out to\n"
    "be worthless!\p"
    "And to think I made a getaway…\n"
    "In this tunnel to nowhere!\p"
    "Hey! You!\n"
    "So you want to battle me?$"
}

text RusturfTunnel_Text_GruntDefeat {
    "Urrrggh! My career in crime comes to\n"
    "a dead end!$"
}

text RusturfTunnel_Text_GruntTakePackage {
    "This is plain not right…\p"
    "The BOSS told me this would be a\n"
    "slick-and-easy job to pull.\p"
    "All I had to do was steal some package\n"
    "from DEVON.\p"
    "Tch!\n"
    "You want it back that badly, take it!$"
}

text RusturfTunnel_Text_PeekoGladToSeeYouSafe {
    "PEEKO!\n"
    "Am I glad to see you're safe!$"
}

text RusturfTunnel_Text_ThankYouLetsGoHomePeeko {
    "PEEKO owes her life to you!\p"
    "They call me MR. BRINEY.\n"
    "And, you are?\p"
    "… … … … … … … …\n"
    "… … … … … … … …\p"
    "Ah, so you are {PLAYER}{KUN}!\n"
    "I sincerely thank you!\p"
    "Now, if there's anything that troubles\n"
    "you, don't hesitate to tell me!\p"
    "You can usually find me in my cottage\n"
    "by the sea near PETALBURG WOODS.\p"
    "Come, PEEKO, we should make our way\n"
    "home.\p"
    "PEEKO: Pihyoh!$"
}

text RusturfTunnel_Text_WhyCantTheyKeepDigging {
    "… …\p"
    "Why can't they keep digging?\n"
    "Is the bedrock too hard?\p"
    "My beloved awaits me in VERDANTURF\n"
    "TOWN just beyond here…\p"
    "If RUSTBORO and VERDANTURF were\n"
    "joined by this tunnel, I could visit\l"
    "her every day…\p"
    "But this…\n"
    "What am I to do?$"
}

text RusturfTunnel_Text_ToGetToVerdanturf {
    "To get from RUSTBORO to VERDANTURF,\n"
    "you need to go to DEWFORD, then pass\l"
    "through SLATEPORT and MAUVILLE…$"
}

text RusturfTunnel_Text_YouShatteredBoulderTakeHM {
    "Wow! You shattered that boulder\n"
    "blocking the way.\p"
    "To show you how much I appreciate it,\n"
    "I'd like you to have this HM.$"
}

text RusturfTunnel_Text_ExplainStrength {
    "That HM contains STRENGTH.\p"
    "If a muscular POKéMON were to learn\n"
    "that, it would be able to move even\l"
    "large boulders.$"
}

text RusturfTunnel_Text_WandaReunion {
    "WANDA!\n"
    "Now I can see you anytime!\p"
    "WANDA: That's…wonderful.\p"
    "Please, take some rest at my home.$"
}

text RusturfTunnel_Text_BoyfriendOnOtherSideOfRock {
    "On the other side of this rock…\n"
    "My boyfriend is there.\p"
    "He… He's not just digging the tunnel\n"
    "to come see me.\p"
    "He works his hands raw and rough\n"
    "for the benefit of everyone.$"
}

text RusturfTunnel_Text_MikeIntro {
    "What do you call a wild man up in the\n"
    "mountains? A mountain man, right?\p"
    "So why don't they call a POKéMON in\n"
    "the mountains a mountain POKéMON?$"
}

text RusturfTunnel_Text_MikeDefeat {
    "My POKéMON…\n"
    "Ran out of power…$"
}

text RusturfTunnel_Text_MikePostBattle {
    "They halted development here to\n"
    "protect POKéMON, right?\l"
    "There's a feel-good story!$"
}
