mapscripts MauvilleCity_PokemonCenter_2F_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE: CableClub_OnFrame
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE: CableClub_OnWarp
    MAP_SCRIPT_ON_LOAD: CableClub_OnLoad
    MAP_SCRIPT_ON_TRANSITION: CableClub_OnTransition
}

script MauvilleCity_PokemonCenter_2F_EventScript_Colosseum {
    call(CableClub_EventScript_Colosseum)
    end
}

script MauvilleCity_PokemonCenter_2F_EventScript_TradeCenter {
    call(CableClub_EventScript_TradeCenter)
    end
}

script MauvilleCity_PokemonCenter_2F_EventScript_RecordCorner {
    call(CableClub_EventScript_RecordCorner)
    end
}

script MauvilleCity_PokemonCenter_2F_EventScript_Youngster {
    msgbox(MauvilleCity_PokemonCenter_2F_Text_Youngster, MSGBOX_NPC)
    end
}

text MauvilleCity_PokemonCenter_2F_Text_Youngster {
    "Did you know that you can link battle\n"
    "at the COLOSSEUM here?\p"
    "They put up your record on the wall\n"
    "for everyone to see.\p"
    "It's embarrassing if you lose more\n"
    "often than you win…$"
}
