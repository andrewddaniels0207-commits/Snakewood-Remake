mapscripts SkyPillar_5F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: SkyPillar_5F_OnTransition
}

script SkyPillar_5F_OnTransition {
    if (var(VAR_SKY_PILLAR_STATE) < 2) {
        call(SkyPillar_5F_EventScript_CleanFloor)
    }
    return
}

script SkyPillar_5F_EventScript_CleanFloor {
    setmaplayoutindex(LAYOUT_SKY_PILLAR_5F_CLEAN)
    return
}
