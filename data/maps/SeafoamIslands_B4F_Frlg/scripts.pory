mapscripts SeafoamIslands_B4F_Frlg_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: SeafoamIslands_B4F_OnTransition
    MAP_SCRIPT_ON_RESUME: SeafoamIslands_B4F_OnResume
    MAP_SCRIPT_ON_LOAD: SeafoamIslands_B4F_OnLoad
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE: SeafoamIslands_B4F_OnWarp
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_MAP_SCENE_SEAFOAM_ISLANDS_B4F, 1: SeafoamIslands_B4F_EventScript_EnterOnCurrent
        VAR_TEMP_1, 1: SeafoamIslands_B4F_EventScript_EnterByFalling
    ]
}

script SeafoamIslands_B4F_OnResume {
    if (flag(FLAG_SYS_CTRL_OBJ_DELETE)) {
        call(SeafoamIslands_B4F_EventScript_TryRemoveArticuno)
    }
    end
}

script SeafoamIslands_B4F_EventScript_TryRemoveArticuno {
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) != B_OUTCOME_CAUGHT) {
        goto(Common_EventScript_NopReturn)
    }
    removeobject(VAR_LAST_TALKED)
    return
}

script SeafoamIslands_B4F_OnTransition {
    if (!flag(FLAG_FOUGHT_ARTICUNO)) {
        call(SeafoamIslands_B4F_EventScript_ShowArticuno)
    }
    if (!flag(FLAG_STOPPED_SEAFOAM_B4F_CURRENT)) {
        call(SeafoamIslands_B4F_EventScript_CheckStoppedCurrent)
    }
    if (flag(FLAG_STOPPED_SEAFOAM_B4F_CURRENT)) {
        call(SeafoamIslands_B4F_EventScript_SetNoCurrentLayout)
    }
    end
}

script SeafoamIslands_B4F_EventScript_CheckStoppedCurrent {
    setvar(NUM_BOULDERS_PRESENT, 0)
    if (!flag(FLAG_HIDE_SEAFOAM_B4F_BOULDER_1)) {
        call(SeafoamIslands_B4F_EventScript_AddBoulderPresent)
    }
    if (!flag(FLAG_HIDE_SEAFOAM_B4F_BOULDER_2)) {
        call(SeafoamIslands_B4F_EventScript_AddBoulderPresent)
    }
    if (var(NUM_BOULDERS_PRESENT) == 2) {
        call(SeafoamIslands_B4F_EventScript_StoppedCurrent)
    }
    return
}

script SeafoamIslands_B4F_EventScript_StoppedCurrent {
    setflag(FLAG_STOPPED_SEAFOAM_B4F_CURRENT)
    return
}

script SeafoamIslands_B4F_EventScript_SetNoCurrentLayout {
    setmaplayoutindex(LAYOUT_SEAFOAM_ISLANDS_B4F_CURRENT_STOPPED)
    return
}

script SeafoamIslands_B4F_EventScript_ShowArticuno {
    clearflag(FLAG_HIDE_ARTICUNO)
    return
}

script SeafoamIslands_B4F_OnLoad {
    setvar(NUM_BOULDERS_PRESENT, 0)
    if (!flag(FLAG_HIDE_SEAFOAM_B4F_BOULDER_1)) {
        call(SeafoamIslands_B4F_EventScript_AddBoulderPresent)
    }
    if (!flag(FLAG_HIDE_SEAFOAM_B4F_BOULDER_2)) {
        call(SeafoamIslands_B4F_EventScript_AddBoulderPresent)
    }
    if (var(NUM_BOULDERS_PRESENT) == 2) {
        goto(SeafoamIslands_B4F_EventScript_SetCalmWaterNearStairs)
    }
    end
}

script SeafoamIslands_B4F_EventScript_SetCalmWaterNearStairs {
    setmetatile(12, 14, METATILE_GeneralFrlg_CalmWater, 0)
    setmetatile(13, 14, METATILE_GeneralFrlg_CalmWater, 0)
    end
}

raw `
SeafoamIslands_B4F_OnWarp:
	map_script_2 VAR_MAP_SCENE_SEAFOAM_ISLANDS_B4F, 1, SeafoamIslands_B4F_EventScript_WarpInOnCurrent
	.2byte 0

`

script SeafoamIslands_B4F_EventScript_WarpInOnCurrent {
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    special(ForcePlayerToStartSurfing)
    end
}

script SeafoamIslands_B4F_EventScript_EnterOnCurrent {
    lockall
    applymovement(LOCALID_PLAYER, SeafoamIslands_B4F_Movement_EnterOnCurrent)
    waitmovement(0)
    setvar(VAR_MAP_SCENE_SEAFOAM_ISLANDS_B4F, 0)
    releaseall
    end
}

movement SeafoamIslands_B4F_Movement_EnterOnCurrent {
    walk_fast_up
    walk_fast_up
    walk_fast_up
    step_end
}

script SeafoamIslands_B4F_EventScript_EnterByFalling {
    lockall
    setvar(NUM_BOULDERS_PRESENT, 0)
    if (!flag(FLAG_HIDE_SEAFOAM_B4F_BOULDER_1)) {
        call(SeafoamIslands_B4F_EventScript_AddBoulderPresent)
    }
    if (!flag(FLAG_HIDE_SEAFOAM_B4F_BOULDER_2)) {
        call(SeafoamIslands_B4F_EventScript_AddBoulderPresent)
    }
    if (var(NUM_BOULDERS_PRESENT) == 2) {
        goto(SeafoamIslands_B4F_EventScript_CurrentBlocked)
    }
    getplayerxy(VAR_0x8008, VAR_0x8009)
    if (var(VAR_0x8008) < 9) {
        call(SeafoamIslands_B4F_EventScript_RideCurrentFar)
    }
    if (var(VAR_0x8008) >= 9) {
        call(SeafoamIslands_B4F_EventScript_RideCurrentClose)
    }
    special(SeafoamIslandsB4F_CurrentDumpsPlayerOnLand)
    setvar(VAR_TEMP_1, 0)
    releaseall
    end
}

script SeafoamIslands_B4F_EventScript_AddBoulderPresent {
    addvar(NUM_BOULDERS_PRESENT, 1)
    return
}

script SeafoamIslands_B4F_EventScript_RideCurrentFar {
    applymovement(LOCALID_PLAYER, SeafoamIslands_B4F_Movement_RideCurrentFar)
    waitmovement(0)
    return
}

script SeafoamIslands_B4F_EventScript_RideCurrentClose {
    applymovement(LOCALID_PLAYER, SeafoamIslands_B4F_Movement_RideCurrentClose)
    waitmovement(0)
    return
}

script SeafoamIslands_B4F_EventScript_CurrentBlocked {
    setvar(VAR_TEMP_1, 0)
    releaseall
    end
}

movement SeafoamIslands_B4F_Movement_RideCurrentFar {
    walk_up
    walk_up
    walk_up
    walk_right
    walk_right
    walk_right
    walk_right
    walk_up
    step_end
}

movement SeafoamIslands_B4F_Movement_RideCurrentClose {
    walk_up
    walk_up
    walk_up
    walk_right
    walk_right
    walk_right
    walk_up
    step_end
}

script SeafoamIslands_B4F_EventScript_UpwardCurrent {
    lockall
    applymovement(LOCALID_PLAYER, SeafoamIslands_B4F_Movement_WalkUp)
    waitmovement(0)
    releaseall
    end
}

movement SeafoamIslands_B4F_Movement_WalkUp {
    walk_up
    step_end
}

script SeafoamIslands_B4F_EventScript_Articuno {
    lock
    faceplayer
    setwildbattle(SPECIES_ARTICUNO, 50)
    waitse()
    playmoncry(SPECIES_ARTICUNO, CRY_MODE_ENCOUNTER)
    message(Text_Gyaoo)
    waitmessage()
    waitmoncry()
    delay(10)
    playbgm(MUS_RG_ENCOUNTER_GYM_LEADER, 0)
    waitbuttonpress()
    setflag(FLAG_SYS_CTRL_OBJ_DELETE)
    special(BattleSetup_StartLegendaryBattle)
    waitstate
    clearflag(FLAG_SYS_CTRL_OBJ_DELETE)
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) == B_OUTCOME_WON) {
        goto(SeafoamIslands_B4F_EventScript_DefeatedArticuno)
    }
    if (var(VAR_RESULT) == B_OUTCOME_RAN) {
        goto(SeafoamIslands_B4F_EventScript_RanFromArticuno)
    }
    if (var(VAR_RESULT) == B_OUTCOME_PLAYER_TELEPORTED) {
        goto(SeafoamIslands_B4F_EventScript_RanFromArticuno)
    }
    setflag(FLAG_FOUGHT_ARTICUNO)
    release
    end
}

script SeafoamIslands_B4F_EventScript_DefeatedArticuno {
    setflag(FLAG_FOUGHT_ARTICUNO)
    goto(EventScript_RemoveStaticMon)
    end
}

script SeafoamIslands_B4F_EventScript_RanFromArticuno {
    setvar(VAR_0x8004, SPECIES_ARTICUNO)
    goto(EventScript_MonFlewAway)
    end
}

script SeafoamIslands_B4F_EventScript_BoulderHintSign {
    msgbox(SeafoamIslands_B4F_Text_BouldersMightChangeWaterFlow, MSGBOX_SIGN)
    end
}

script SeafoamIslands_B4F_EventScript_FastCurrentSign {
    msgbox(SeafoamIslands_B4F_Text_DangerFastCurrent, MSGBOX_SIGN)
    end
}

text Text_RockSlideTeach {
    "When you're up on a rocky mountain\n"
    "like this, rockslides are a threat.\p"
    "Can you imagine?\n"
    "Boulders tumbling down on you?\p"
    "That'd be, like, waaaaaaaaaaah!\n"
    "Total terror!\p"
    "You don't seem to be scared.\n"
    "Want to try using ROCK SLIDE?$"
}

text Text_RockSlideDeclined {
    "Oh, so you are scared after all.$"
}

text Text_RockSlideWhichMon {
    "Which POKéMON should I teach\n"
    "ROCK SLIDE?$"
}

text Text_RockSlideTaught {
    "It might be scary to use it in this\n"
    "tunnel…$"
}

text SeafoamIslands_B4F_Text_BouldersMightChangeWaterFlow {
    "Hint: Boulders might change the\n"
    "flow of water.$"
}

text SeafoamIslands_B4F_Text_DangerFastCurrent {
    "DANGER\n"
    "Fast current!$"
}
