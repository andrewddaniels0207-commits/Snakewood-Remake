mapscripts MauvilleCity_GameCorner_MapScripts {
}

script MauvilleCity_GameCorner_EventScript_CoinsClerk {
    lock
    faceplayer
    msgbox(MauvilleCity_GameCorner_Text_ThisIsMauvilleGameCorner, MSGBOX_DEFAULT)
    checkitem(ITEM_COIN_CASE)
    if (var(VAR_RESULT) == FALSE) {
        goto(MauvilleCity_GameCorner_EventScript_NeedCoinCase)
    }
    message(MauvilleCity_GameCorner_Text_WereYouLookingForCoins)
    waitmessage()
    showmoneybox(0, 0)
    showcoinsbox(1, 6)
    goto(MauvilleCity_GameCorner_EventScript_ChooseCoinsDefault50)
}

script MauvilleCity_GameCorner_EventScript_ChooseCoinsDefault50 {
    multichoicedefault(15, 0, MULTI_GAME_CORNER_COINS, 0, FALSE)
    switch (var(VAR_RESULT)) {
        case 0:
            goto(MauvilleCity_GameCorner_EventScript_Buy50Coins)
        case 1:
            goto(MauvilleCity_GameCorner_EventScript_Buy500Coins)
    }
    goto(MauvilleCity_GameCorner_EventScript_CancelBuyCoins)
    end
}

script MauvilleCity_GameCorner_EventScript_ChooseCoinsDefault500 {
    multichoicedefault(15, 0, MULTI_GAME_CORNER_COINS, 1, FALSE)
    switch (var(VAR_RESULT)) {
        case 0:
            goto(MauvilleCity_GameCorner_EventScript_Buy50Coins)
        case 1:
            goto(MauvilleCity_GameCorner_EventScript_Buy500Coins)
    }
    goto(MauvilleCity_GameCorner_EventScript_CancelBuyCoins)
    end
}

script MauvilleCity_GameCorner_EventScript_Buy50Coins {
    checkcoins(VAR_TEMP_1)
    goto_if_ge(VAR_TEMP_1, (MAX_COINS + 1 - 50), MauvilleCity_GameCorner_EventScript_NoRoomForCoins)
    checkmoney(COINS_PRICE_50)
    if (var(VAR_RESULT) == FALSE) {
        goto(MauvilleCity_GameCorner_EventScript_NotEnoughMoney)
    }
    addcoins(50)
    removemoney(COINS_PRICE_50)
    updatemoneybox()
    updatecoinsbox(1, 6)
    playse(SE_SHOP)
    msgbox(MauvilleCity_GameCorner_Text_ThankYouHereAreYourCoins, MSGBOX_DEFAULT)
    hidemoneybox()
    hidecoinsbox(0, 5)
    release
    end
}

script MauvilleCity_GameCorner_EventScript_Buy500Coins {
    checkcoins(VAR_TEMP_1)
    goto_if_ge(VAR_TEMP_1, (MAX_COINS + 1 - 500), MauvilleCity_GameCorner_EventScript_NoRoomForCoins)
    checkmoney(COINS_PRICE_500)
    if (var(VAR_RESULT) == FALSE) {
        goto(MauvilleCity_GameCorner_EventScript_NotEnoughMoney)
    }
    addcoins(500)
    removemoney(COINS_PRICE_500)
    updatemoneybox()
    updatecoinsbox(1, 6)
    playse(SE_SHOP)
    msgbox(MauvilleCity_GameCorner_Text_ThankYouHereAreYourCoins, MSGBOX_DEFAULT)
    hidemoneybox()
    hidecoinsbox(0, 5)
    release
    end
}

script MauvilleCity_GameCorner_EventScript_NeedCoinCase {
    msgbox(MauvilleCity_GameCorner_Text_NeedCoinCaseForCoins, MSGBOX_DEFAULT)
    release
    end
}

script MauvilleCity_GameCorner_EventScript_NotEnoughMoney {
    msgbox(MauvilleCity_GameCorner_Text_DontHaveEnoughMoney, MSGBOX_DEFAULT)
    hidemoneybox()
    hidecoinsbox(0, 5)
    release
    end
}

script MauvilleCity_GameCorner_EventScript_CancelBuyCoins {
    msgbox(MauvilleCity_GameCorner_Text_DontNeedCoinsThen, MSGBOX_DEFAULT)
    hidemoneybox()
    hidecoinsbox(0, 5)
    release
    end
}

script MauvilleCity_GameCorner_EventScript_NoRoomForCoins {
    msgbox(MauvilleCity_GameCorner_Text_CoinCaseIsFull, MSGBOX_DEFAULT)
    hidemoneybox()
    hidecoinsbox(0, 5)
    release
    end
}

script MauvilleCity_GameCorner_EventScript_PrizeCornerDolls {
    lock
    faceplayer
    msgbox(MauvilleCity_GameCorner_Text_ExchangeCoinsForPrizes, MSGBOX_DEFAULT)
    checkitem(ITEM_COIN_CASE)
    if (var(VAR_RESULT) == TRUE) {
        goto(MauvilleCity_GameCorner_EventScript_ChooseDollPrizeMessage)
    }
    release
    end
}

script MauvilleCity_GameCorner_EventScript_ChooseDollPrizeMessage {
    message(MauvilleCity_GameCorner_Text_WhichPrize)
    waitmessage()
    setvar(VAR_TEMP_1, 0)
    showcoinsbox(1, 1)
    goto(MauvilleCity_GameCorner_EventScript_ChooseDollPrize)
}

script MauvilleCity_GameCorner_EventScript_ReturnToChooseDollPrize {
    message(MauvilleCity_GameCorner_Text_WhichPrize)
    waitmessage()
    goto(MauvilleCity_GameCorner_EventScript_ChooseDollPrize)
}

script MauvilleCity_GameCorner_EventScript_ChooseDollPrize {
    multichoice(12, 0, MULTI_GAME_CORNER_DOLLS, FALSE)
    switch (var(VAR_RESULT)) {
        case 0:
            goto(MauvilleCity_GameCorner_EventScript_TreeckoDoll)
        case 1:
            goto(MauvilleCity_GameCorner_EventScript_TorchicDoll)
        case 2:
            goto(MauvilleCity_GameCorner_EventScript_MudkipDoll)
        case 3:
            goto(MauvilleCity_GameCorner_EventScript_CancelDollSelect)
    }
    goto(MauvilleCity_GameCorner_EventScript_CancelDollSelect)
    end
}

script MauvilleCity_GameCorner_EventScript_TreeckoDoll {
    setvar(VAR_TEMP_1, 1)
    bufferdecorationname(STR_VAR_1, DECOR_TREECKO_DOLL)
    goto(MauvilleCity_GameCorner_EventScript_ConfirmDollPrize)
}

script MauvilleCity_GameCorner_EventScript_TorchicDoll {
    setvar(VAR_TEMP_1, 2)
    bufferdecorationname(STR_VAR_1, DECOR_TORCHIC_DOLL)
    goto(MauvilleCity_GameCorner_EventScript_ConfirmDollPrize)
}

script MauvilleCity_GameCorner_EventScript_MudkipDoll {
    setvar(VAR_TEMP_1, 3)
    bufferdecorationname(STR_VAR_1, DECOR_MUDKIP_DOLL)
    goto(MauvilleCity_GameCorner_EventScript_ConfirmDollPrize)
}

script MauvilleCity_GameCorner_EventScript_ConfirmDollPrize {
    msgbox(MauvilleCity_GameCorner_Text_SoYourChoiceIsX, MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        goto(MauvilleCity_GameCorner_EventScript_CancelDollSelect)
    }
    switch (var(VAR_TEMP_1)) {
        case 1:
            goto(MauvilleCity_GameCorner_EventScript_BuyTreeckoDoll)
        case 2:
            goto(MauvilleCity_GameCorner_EventScript_BuyTorchicDoll)
        case 3:
            goto(MauvilleCity_GameCorner_EventScript_BuyMudkipDoll)
    }
    end
}

script MauvilleCity_GameCorner_EventScript_BuyTreeckoDoll {
    checkcoins(VAR_TEMP_2)
    if (var(VAR_TEMP_2) < DOLL_COINS) {
        goto(MauvilleCity_GameCorner_EventScript_NotEnoughCoinsForDoll)
    }
    bufferdecorationname(STR_VAR_2, DECOR_TREECKO_DOLL)
    checkdecorspace(DECOR_TREECKO_DOLL)
    if (var(VAR_RESULT) == FALSE) {
        goto(MauvilleCity_GameCorner_EventScript_NoRoomForDoll)
    }
    removecoins(DOLL_COINS)
    adddecoration(DECOR_TREECKO_DOLL)
    updatecoinsbox(1, 1)
    playse(SE_SHOP)
    msgbox(MauvilleCity_GameCorner_Text_SendToYourHomePC, MSGBOX_DEFAULT)
    goto(MauvilleCity_GameCorner_EventScript_ReturnToChooseDollPrize)
    end
}

script MauvilleCity_GameCorner_EventScript_BuyTorchicDoll {
    checkcoins(VAR_TEMP_2)
    if (var(VAR_TEMP_2) < DOLL_COINS) {
