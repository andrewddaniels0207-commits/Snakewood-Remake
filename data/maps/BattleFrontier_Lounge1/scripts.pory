mapscripts BattleFrontier_Lounge1_MapScripts {}

script BattleFrontier_Lounge1_EventScript_Breeder {
    lock
    faceplayer
    if (!flag(FLAG_MET_BATTLE_FRONTIER_BREEDER)) {
        call(BattleFrontier_Lounge1_EventScript_BreederIntro)
    }
    if (flag(FLAG_MET_BATTLE_FRONTIER_BREEDER)) {
        call(BattleFrontier_Lounge1_EventScript_AlreadyMetBreeder)
    }
    setflag(FLAG_MET_BATTLE_FRONTIER_BREEDER)
    goto(BattleFrontier_Lounge1_EventScript_ChooseMonToShowBreeder)
    end
}

script BattleFrontier_Lounge1_EventScript_ChooseMonToShowBreeder {
    chooseboxmon()
    waitstate
    if (var(VAR_0x8004) != PARTY_NOTHING_CHOSEN) {
        goto(BattleFrontier_Lounge1_EventScript_ShowMonToBreeder)
    }
    if (var(VAR_0x8004) == PARTY_NOTHING_CHOSEN) {
        goto(BattleFrontier_Lounge1_EventScript_CancelMonSelect)
    }
    end
}

script BattleFrontier_Lounge1_EventScript_BreederIntro {
    msgbox(BattleFrontier_Lounge1_Text_PokemonBreederIntro, MSGBOX_DEFAULT)
    return
}

script BattleFrontier_Lounge1_EventScript_AlreadyMetBreeder {
    msgbox(BattleFrontier_Lounge1_Text_LetsLookAtYourPokemon, MSGBOX_DEFAULT)
    return
}

script BattleFrontier_Lounge1_EventScript_ShowMonToBreeder {
    specialvar(VAR_RESULT, ScriptGetPartyMonSpecies)
    if (var(VAR_RESULT) == SPECIES_EGG) {
        goto(BattleFrontier_Lounge1_EventScript_ShowEggToBreeder)
    }
    special(BufferVarsForIVRater)
    if (var(VAR_0x8005) <= 90) {
        goto(BattleFrontier_Lounge1_EventScript_AverageTotalIVs)
    }
    if (var(VAR_0x8005) <= 120) {
        goto(BattleFrontier_Lounge1_EventScript_AboveAverageTotalIVs)
    }
    if (var(VAR_0x8005) <= 150) {
        goto(BattleFrontier_Lounge1_EventScript_HighTotalIVs)
    }
    if (var(VAR_0x8005) >= 151) {
        goto(BattleFrontier_Lounge1_EventScript_VeryHighTotalIVs)
    }
    end
}

script BattleFrontier_Lounge1_EventScript_ShowEggToBreeder {
    msgbox(BattleFrontier_Lounge1_Text_EvenICantTell, MSGBOX_DEFAULT)
    goto(BattleFrontier_Lounge1_EventScript_ChooseMonToShowBreeder)
    end
}

script BattleFrontier_Lounge1_EventScript_HighestIVStat {
    if (var(VAR_0x8006) == STAT_HP) {
        goto(BattleFrontier_Lounge1_EventScript_HighestIVHP)
    }
    if (var(VAR_0x8006) == STAT_ATK) {
        goto(BattleFrontier_Lounge1_EventScript_HighestIVAtk)
    }
    if (var(VAR_0x8006) == STAT_DEF) {
        goto(BattleFrontier_Lounge1_EventScript_HighestIVDef)
    }
    if (var(VAR_0x8006) == STAT_SPEED) {
        goto(BattleFrontier_Lounge1_EventScript_HighestIVSpeed)
    }
    if (var(VAR_0x8006) == STAT_SPATK) {
        goto(BattleFrontier_Lounge1_EventScript_HighestIVSpAtk)
    }
    if (var(VAR_0x8006) == STAT_SPDEF) {
        goto(BattleFrontier_Lounge1_EventScript_HighestIVSpDef)
    }
    end
}

script BattleFrontier_Lounge1_EventScript_HighestIVValue {
    if (var(VAR_0x8007) <= 15) {
        goto(BattleFrontier_Lounge1_EventScript_HighestIVLow)
    }
    if (var(VAR_0x8007) <= 25) {
        goto(BattleFrontier_Lounge1_EventScript_HighestIVMid)
    }
    if (var(VAR_0x8007) <= 30) {
        goto(BattleFrontier_Lounge1_EventScript_HighestIVHigh)
    }
    if (var(VAR_0x8007) >= 31) {
        goto(BattleFrontier_Lounge1_EventScript_HighestIVMax)
    }
    end
}

script BattleFrontier_Lounge1_EventScript_EndBreederComments {
    release
    end
}

script BattleFrontier_Lounge1_EventScript_AverageTotalIVs {
    msgbox(BattleFrontier_Lounge1_Text_AverageAbility, MSGBOX_DEFAULT)
    goto(BattleFrontier_Lounge1_EventScript_HighestIVStat)
    end
}

script BattleFrontier_Lounge1_EventScript_AboveAverageTotalIVs {
