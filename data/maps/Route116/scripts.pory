mapscripts Route116_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Route116_OnTransition
    MAP_SCRIPT_ON_LOAD: Route116_OnLoad
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_SHOULD_END_ABNORMAL_WEATHER, 1: AbnormalWeather_EventScript_EndEventAndCleanup_1
    ]
}

script Route116_OnTransition {
    if (flag(FLAG_RECOVERED_DEVON_GOODS)) {
        call(Route116_EventScript_SetWandasBoyfriendPos)
    }
    if (var(VAR_SHOULD_END_ABNORMAL_WEATHER) == 1) {
        call(AbnormalWeather_EventScript_HideMapNamePopup)
    }
    if (var(VAR_ABNORMAL_WEATHER_LOCATION) == ABNORMAL_WEATHER_ROUTE_116_NORTH) {
        call(AbnormalWeather_StartGroudonWeather)
    }
    if (var(VAR_ABNORMAL_WEATHER_LOCATION) == ABNORMAL_WEATHER_ROUTE_116_SOUTH) {
        call(AbnormalWeather_StartGroudonWeather)
    }
    end
}

script Route116_EventScript_SetWandasBoyfriendPos {
    setobjectxyperm(LOCALID_ROUTE116_WANDAS_BF, 38, 10)
    return
}

script Route116_OnLoad {
    if (var(VAR_ABNORMAL_WEATHER_LOCATION) == ABNORMAL_WEATHER_ROUTE_116_NORTH) {
        call(AbnormalWeather_EventScript_PlaceTilesRoute116North)
    }
    if (var(VAR_ABNORMAL_WEATHER_LOCATION) == ABNORMAL_WEATHER_ROUTE_116_SOUTH) {
        call(AbnormalWeather_EventScript_PlaceTilesRoute116South)
    }
    end
}

script Route116_EventScript_WandasBoyfriend {
    lock
    faceplayer
    if (flag(FLAG_RECOVERED_DEVON_GOODS)) {
        goto(Route116_EventScript_BoyfriendGruntLeftTunnel)
    }
    if (flag(FLAG_DEVON_GOODS_STOLEN)) {
        goto(Route116_EventScript_BoyfriendGruntInTunnel)
    }
    msgbox(Route116_Text_WantToDigTunnel, MSGBOX_DEFAULT)
    release
    end
}

script Route116_EventScript_BoyfriendGruntLeftTunnel {
    msgbox(Route116_Text_GoonHightailedItOutOfTunnel, MSGBOX_DEFAULT)
    release
    end
}

script Route116_EventScript_BoyfriendGruntInTunnel {
    msgbox(Route116_Text_DiggingTunnelWhenGoonOrderedMeOut, MSGBOX_DEFAULT)
    release
    end
}

script Route116_EventScript_DevonEmployee {
    lock
    faceplayer
    if (flag(FLAG_MET_DEVON_EMPLOYEE)) {
        goto(Route116_EventScript_TryGiveRepeatBallAgain)
    }
    msgbox(Route116_Text_ThankYouTokenOfAppreciation, MSGBOX_DEFAULT)
    goto(Route116_EventScript_GiveRepeatBall)
    end
}

script Route116_EventScript_GiveRepeatBall {
    setflag(FLAG_MET_DEVON_EMPLOYEE)
    giveitem(ITEM_REPEAT_BALL)
    if (var(VAR_RESULT) == FALSE) {
        goto(Route116_EventScript_NoRoomForRepeatBall)
    }
    msgbox(Route116_Text_NewBallAvailableAtMart, MSGBOX_DEFAULT)
    closemessage
    if (var(VAR_FACING) == DIR_NORTH) {
        call(Route116_EventScript_DevonEmployeeExit)
    }
    if (var(VAR_FACING) == DIR_SOUTH) {
        call(Route116_EventScript_DevonEmployeeExit)
    }
    if (var(VAR_FACING) == DIR_WEST) {
        call(Route116_EventScript_DevonEmployeeExit)
    }
    if (var(VAR_FACING) == DIR_EAST) {
        call(Route116_EventScript_DevonEmployeeExitEast)
    }
    removeobject(VAR_LAST_TALKED)
    clearflag(FLAG_HIDE_RUSTBORO_CITY_DEVON_CORP_3F_EMPLOYEE)
    setflag(FLAG_RECEIVED_REPEAT_BALL)
    release
    end
}

script Route116_EventScript_DevonEmployeeExit {
    applymovement(VAR_LAST_TALKED, Route116_Movement_DevonEmployeeExit)
    waitmovement(0)
    return
}

script Route116_EventScript_DevonEmployeeExitEast {
    applymovement(VAR_LAST_TALKED, Route116_Movement_DevonEmployeeExitEast)
    waitmovement(0)
    return
}

script Route116_EventScript_TryGiveRepeatBallAgain {
    msgbox(Route116_Text_TokenOfAppreciation, MSGBOX_DEFAULT)
    goto(Route116_EventScript_GiveRepeatBall)
    end
}

script Route116_EventScript_NoRoomForRepeatBall {
    msgbox(Route116_Text_BagIsJamPacked, MSGBOX_DEFAULT)
    release
    end
}

movement Route116_Movement_DevonEmployeeExit {
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    step_end
}

movement Route116_Movement_DevonEmployeeExitEast {
    walk_down
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    step_end
}

script Route116_EventScript_RouteSignRustboro {
    msgbox(Route116_Text_RouteSignRustboro, MSGBOX_SIGN)
    end
}

script Route116_EventScript_RusturfTunnelSign {
    msgbox(Route116_Text_RusturfTunnelSign, MSGBOX_SIGN)
    end
}

script Route116_EventScript_TunnelersRestHouseSign {
    msgbox(Route116_Text_TunnelersRestHouse, MSGBOX_SIGN)
    end
}

script Route116_EventScript_TrainerTipsBToStopEvolution {
    msgbox(Route116_Text_TrainerTipsBToStopEvolution, MSGBOX_SIGN)
    end
}

script Route116_EventScript_TrainerTipsBagHasPockets {
    msgbox(Route116_Text_TrainerTipsBagHasPockets, MSGBOX_SIGN)
    end
}

script Route116_EventScript_Briney {
    lock
    faceplayer
    msgbox(Route116_Text_ScoundrelMadeOffWithPeeko, MSGBOX_DEFAULT)
    setvar(VAR_ROUTE116_STATE, 2)
    release
    end
}

script Route116_EventScript_BrineyTrigger {
    lockall
    applymovement(LOCALID_ROUTE116_BRINEY, Common_Movement_WalkInPlaceFasterRight)
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterLeft)
    waitmovement(0)
    msgbox(Route116_Text_ScoundrelMadeOffWithPeeko, MSGBOX_DEFAULT)
    setvar(VAR_ROUTE116_STATE, 2)
    releaseall
    end
}

script Route116_EventScript_GlassesMan {
    lock
    faceplayer
    checkitem(ITEM_BLACK_GLASSES)
    if (var(VAR_RESULT) == TRUE) {
        goto(Route116_EventScript_PlayerHasGlasses)
    }
    specialvar(VAR_RESULT, FoundBlackGlasses)
    if (var(VAR_RESULT) == TRUE) {
        goto(Route116_EventScript_FoundGlassesNotOnPlayer)
    }
    msgbox(Route116_Text_CanYouHelpMeFindGlasses, MSGBOX_DEFAULT)
    release
    end
}

script Route116_EventScript_FoundGlassesNotOnPlayer {
    msgbox(Route116_Text_CantFindGlassesNotHere, MSGBOX_DEFAULT)
    closemessage
    goto(Route116_EventScript_GlassesManExit)
    end
}

script Route116_EventScript_PlayerHasGlasses {
    msgbox(Route116_Text_CanYouHelpMeFindGlasses, MSGBOX_DEFAULT)
    msgbox(Route116_Text_MayISeeThoseGlasses, MSGBOX_DEFAULT)
    specialvar(VAR_RESULT, FoundBlackGlasses)
    if (var(VAR_RESULT) == TRUE) {
        goto(Route116_EventScript_FoundGlassesOnPlayer)
    }
    msgbox(Route116_Text_NotWhatImLookingFor, MSGBOX_DEFAULT)
    release
    end
}

script Route116_EventScript_FoundGlassesOnPlayer {
    msgbox(Route116_Text_NotWhatImLookingForMaybeTheyArentHere, MSGBOX_DEFAULT)
    closemessage
    goto(Route116_EventScript_GlassesManExit)
    end
}

script Route116_EventScript_GlassesManExit {
    delay(20)
    if (var(VAR_FACING) == DIR_NORTH) {
        call(Route116_EventScript_GlassesManExitNormal)
    }
    if (var(VAR_FACING) == DIR_SOUTH) {
        call(Route116_EventScript_GlassesManExitNormal)
    }
    if (var(VAR_FACING) == DIR_WEST) {
        call(Route116_EventScript_GlassesManExitNormal)
    }
    if (var(VAR_FACING) == DIR_EAST) {
        call(Route116_EventScript_GlassesManExitEast)
    }
    removeobject(VAR_LAST_TALKED)
    release
    end
}

script Route116_EventScript_GlassesManExitNormal {
    applymovement(VAR_LAST_TALKED, Route116_Movement_GlassesManExit)
    waitmovement(0)
    return
}

script Route116_EventScript_GlassesManExitEast {
    applymovement(VAR_LAST_TALKED, Route116_Movement_GlassesManExitEast)
    waitmovement(0)
    return
}

movement Route116_Movement_GlassesManExit {
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    step_end
}

movement Route116_Movement_GlassesManExitEast {
    walk_up
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    step_end
}

script Route116_EventScript_Joey {
    trainerbattle_single(TRAINER_JOEY, Route116_Text_JoeyIntro, Route116_Text_JoeyDefeat)
    msgbox(Route116_Text_JoeyPostBattle, MSGBOX_AUTOCLOSE)
    end
}

script Route116_EventScript_Jose {
    trainerbattle_single(TRAINER_JOSE, Route116_Text_JoseIntro, Route116_Text_JoseDefeat)
    msgbox(Route116_Text_JosePostBattle, MSGBOX_AUTOCLOSE)
    end
}

script Route116_EventScript_Jerry {
    trainerbattle_single(TRAINER_JERRY_1, Route116_Text_JerryIntro, Route116_Text_JerryDefeat, Route116_EventScript_TryRegisterJerryAfterBattle)
    specialvar(VAR_RESULT, ShouldTryRematchBattle)
    if (var(VAR_RESULT) == TRUE) {
        goto(Route116_EventScript_RematchJerry)
    }
    setvar(VAR_0x8004, TRAINER_JERRY_1)
    specialvar(VAR_RESULT, IsTrainerRegistered)
    if (var(VAR_RESULT) == FALSE) {
        goto(Route116_EventScript_TryRegisterJerry)
    }
    msgbox(Route116_Text_JerryPostBattle, MSGBOX_DEFAULT)
    release
    end
}

script Route116_EventScript_TryRegisterJerryAfterBattle {
    if (flag(FLAG_HAS_MATCH_CALL)) {
        goto(Route116_EventScript_RegisterJerryAfterBattle)
    }
    release
    end
}

script Route116_EventScript_RegisterJerryAfterBattle {
    special(PlayerFaceTrainerAfterBattle)
    waitmovement(0)
    msgbox(Route116_Text_JerryRegister2, MSGBOX_DEFAULT)
    register_matchcall(TRAINER_JERRY_1)
    release
    end
}

script Route116_EventScript_TryRegisterJerry {
    if (flag(FLAG_HAS_MATCH_CALL)) {
        goto(Route116_EventScript_RegisterJerry)
    }
    msgbox(Route116_Text_JerryPostBattle, MSGBOX_DEFAULT)
    release
    end
}

script Route116_EventScript_RegisterJerry {
    msgbox(Route116_Text_JerryRegister1, MSGBOX_DEFAULT)
    register_matchcall(TRAINER_JERRY_1)
    release
    end
}

script Route116_EventScript_RematchJerry {
    trainerbattle_rematch(TRAINER_JERRY_1, Route116_Text_JerryRematchIntro, Route116_Text_JerryRematchDefeat)
    msgbox(Route116_Text_JerryPostRematch, MSGBOX_AUTOCLOSE)
    end
}

