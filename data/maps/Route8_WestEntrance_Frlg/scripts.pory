mapscripts Route8_WestEntrance_Frlg_MapScripts {}

script Route8_WestEntrance_EventScript_Guard {
    msgbox(Route8_WestEntrance_Text_HiHowsItGoing, MSGBOX_NPC)
    end
}

script Route8_WestEntrance_EventScript_GuardTriggerTop {
    lockall
    setvar(VAR_TEMP_1, 0)
    goto(Route8_WestEntrance_EventScript_GuardTrigger)
    end
}

script Route8_WestEntrance_EventScript_GuardTriggerMid {
    lockall
    setvar(VAR_TEMP_1, 1)
    goto(Route8_WestEntrance_EventScript_GuardTrigger)
    end
}

script Route8_WestEntrance_EventScript_GuardTriggerBottom {
    lockall
    setvar(VAR_TEMP_1, 2)
    goto(Route8_WestEntrance_EventScript_GuardTrigger)
    end
}

script Route8_WestEntrance_EventScript_GuardTrigger {
    textcolor(NPC_TEXT_COLOR_MALE)
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    if (flag(FLAG_GOT_TEA)) {
        goto(Route8_WestEntrance_EventScript_GiveTea)
    }
    msgbox(Route8_WestEntrance_Text_ThirstyOnGuardDuty)
    closemessage
    applymovement(LOCALID_PLAYER, Route8_WestEntrance_Movement_BlockPlayerEntry)
    waitmovement(0)
    releaseall
    end
}

script Route8_WestEntrance_EventScript_GiveTea {
    removeitem(ITEM_TEA)
    goto(Route8_WestEntrance_EventScript_GuardDrinkTea)
    end
}

script Route8_WestEntrance_EventScript_GiveSodaPop {
    removeitem(ITEM_SODA_POP)
    goto(Route8_WestEntrance_EventScript_GuardDrinkTea)
    end
}

script Route8_WestEntrance_EventScript_GiveLemonade {
    removeitem(ITEM_LEMONADE)
    goto(Route8_WestEntrance_EventScript_GuardDrinkTea)
    end
}

script Route8_WestEntrance_EventScript_GuardDrinkTea {
    msgbox(Route8_WestEntrance_Text_ThatTeaLooksTasty)
    closemessage
    if (var(VAR_TEMP_1) == 0) {
        call(Route8_WestEntrance_EventScript_WalkToGuardTop)
    }
    if (var(VAR_TEMP_1) == 1) {
        call(Route8_WestEntrance_EventScript_WalkToGuardMid)
    }
    if (var(VAR_TEMP_1) == 2) {
        call(Route8_WestEntrance_EventScript_WalkToGuardBottom)
    }
    msgbox(Route8_WestEntrance_Text_ThanksIllShareTeaWithGuards)
    setvar(VAR_MAP_SCENE_ROUTE5_ROUTE6_ROUTE7_ROUTE8_GATES, 1)
    releaseall
    end
}

script Route8_WestEntrance_EventScript_WalkToGuardTop {
    applymovement(LOCALID_PLAYER, Route8_WestEntrance_Movement_WalkToGuardTop)
    waitmovement(0)
    return
}

script Route8_WestEntrance_EventScript_WalkToGuardMid {
    applymovement(LOCALID_PLAYER, Route8_WestEntrance_Movement_WalkToGuardMid)
    waitmovement(0)
    return
}

script Route8_WestEntrance_EventScript_WalkToGuardBottom {
    applymovement(LOCALID_PLAYER, Route8_WestEntrance_Movement_WalkToGuardBottom)
    waitmovement(0)
    return
}

movement Route8_WestEntrance_Movement_WalkToGuardMid {
    walk_up
    step_end
}

movement Route8_WestEntrance_Movement_WalkToGuardBottom {
    walk_up
    walk_up
    step_end
}

movement Route8_WestEntrance_Movement_WalkToGuardTop {
    walk_in_place_up
    step_end
}

movement Route8_WestEntrance_Movement_BlockPlayerEntry {
    walk_right
    step_end
}

text Route8_WestEntrance_Text_ThirstyOnGuardDuty {
    "I'm on guard duty.\n"
    "Gee, I'm thirsty, though!\p"
    "Oh, wait there, the road's closed.$"
}

text Route8_WestEntrance_Text_ThatTeaLooksTasty {
    "Oh, that TEA…\n"
    "It looks awfully tasty…$"
}

text Route8_WestEntrance_Text_ThanksIllShareTeaWithGuards {
    "Huh? I can have this drink?\n"
    "Gee, thanks!\l"
    "… …\l"
    "Glug, glug…\l"
    "… …\l"
    "Gulp…\l"
    "If you want to go to SAFFRON\l"
    "CITY…\l"
    "… …\l"
    "You can go on through.\p"
    "I'll share this TEA with the other\n"
    "guards!$"
}

text Route8_WestEntrance_Text_HiHowsItGoing {
    "Hi, how's it going?$"
}
