text Route110_TrickHousePuzzle5_Text_WroteSecretCodeLockOpened {
    "{PLAYER} wrote down the secret code\n"
    "on the door.\p"
    "“TRICK MASTER is a genius.”\n"
    "… … … … … … … …\p"
    "The lock clicked open!$"
}

text Route110_TrickHousePuzzle5_Text_Mechadoll1Intro {
    "CLICKETY-CLACK…\n"
    "MECHADOLL 1 AM I!\p"
    "IF YOU ANSWER QUIZZES CORRECTLY,\n"
    "THEN YOU WILL GO TO MECHADOLL 5.\l"
    "THEN YOU CAN OBTAIN THE SECRET CODE.$"
}

text Route110_TrickHousePuzzle5_Text_Mechadoll1Quiz1 {
    "MECHADOLL 1 QUIZ.\p"
    "One of these POKéMON is not found\n"
    "on ROUTE 110. Which one is it?$"
}

text Route110_TrickHousePuzzle5_Text_Mechadoll1Quiz2 {
    "MECHADOLL 1 QUIZ.\p"
    "One of these POKéMON is not of the\n"
    "WATER type. Which one is it?$"
}

text Route110_TrickHousePuzzle5_Text_Mechadoll1Quiz3 {
    "MECHADOLL 1 QUIZ.\p"
    "One of these POKéMON does not use\n"
    "LEECH LIFE. Which one is it?$"
}

text Route110_TrickHousePuzzle5_Text_CorrectGoThrough {
    "CONGRATULATIONS. CORRECT YOU ARE.\n"
    "GO THROUGH. PLEASE.$"
}

text Route110_TrickHousePuzzle5_Text_DisappointmentError {
    "BZZZT. DISAPPOINTMENT.\n"
    "ERROR.$"
}

text Route110_TrickHousePuzzle5_Text_Wahahahaha {
    "WAHAHAHAHA! WAHAHAHAHA!\n"
    "CLICKETY-CLACK!$"
}

text Route110_TrickHousePuzzle5_Text_WaitForNextChallenge {
    "YOUR NEXT CHALLENGE WE WAIT FOR.$"
}

text Route110_TrickHousePuzzle5_Text_Mechadoll2Intro {
    "CLICKETY-CLACK…\n"
    "MECHADOLL 2 AM I!\p"
    "MECHADOLL 1'S QUIZ DIFFICULTY LEVEL\n"
    "IS SET TOO LOW.$"
}

text Route110_TrickHousePuzzle5_Text_Mechadoll2Quiz1 {
    "MECHADOLL 2 QUIZ.\p"
    "Which of these POKéMON did WALLY\n"
    "borrow from your father?$"
}

text Route110_TrickHousePuzzle5_Text_Mechadoll2Quiz2 {
    "MECHADOLL 2 QUIZ.\p"
    "Which of these POKéMON was chasing\n"
    "PROF. BIRCH?$"
}

text Route110_TrickHousePuzzle5_Text_Mechadoll2Quiz3 {
    "MECHADOLL 2 QUIZ.\p"
    "Which of these POKéMON did TEAM AQUA\n"
    "use in PETALBURG FOREST?$"
}

text Route110_TrickHousePuzzle5_Text_Mechadoll3Intro {
    "CLICKETY-CLACK…\n"
    "MECHADOLL 3 AM I!\p"
    "MATTERS OF MONEY ARE MY SOLE FOCUS.$"
}

text Route110_TrickHousePuzzle5_Text_Mechadoll3Quiz1 {
    "MECHADOLL 3 QUIZ.\p"
    "Which costs more?\n"
    "Three HARBOR MAILS or one BURN HEAL?$"
}

text Route110_TrickHousePuzzle5_Text_Mechadoll3Quiz2 {
    "MECHADOLL 3 QUIZ.\p"
    "Sell one GREAT BALL and buy\n"
    "one POTION. How much money remains?$"
}

text Route110_TrickHousePuzzle5_Text_Mechadoll3Quiz3 {
    "MECHADOLL 3 QUIZ.\p"
    "Do one REPEL and SODA POP cost\n"
    "more than one SUPER POTION?$"
}

text Route110_TrickHousePuzzle5_Text_Mechadoll4Intro {
    "CLICKETY-CLACK…\n"
    "MECHADOLL 4 THAT IS ME!\p"
    "MY QUIZ IS AN OBJECT OF BEAUTY.$"
}

text Route110_TrickHousePuzzle5_Text_Mechadoll4Quiz1 {
    "MECHADOLL 4 QUIZ.\p"
    "In SEASHORE HOUSE, were there more men\n"
    "or women?$"
}

text Route110_TrickHousePuzzle5_Text_Mechadoll4Quiz2 {
    "MECHADOLL 4 QUIZ.\p"
    "In LAVARIDGE TOWN, were there more\n"
    "elderly men or elderly women?$"
}

text Route110_TrickHousePuzzle5_Text_Mechadoll4Quiz3 {
    "MECHADOLL 4 QUIZ.\p"
    "In the TRAINER'S SCHOOL, how many\n"
    "girl students were there?$"
}

text Route110_TrickHousePuzzle5_Text_Mechadoll5Intro {
    "CLICKETY-CLACK…\n"
    "MECHADOLL 5 AM I!\p"
    "THE MASTER'S BEST AND PROUDEST\n"
    "ACHIEVEMENT AM I.$"
}

text Route110_TrickHousePuzzle5_Text_Mechadoll5Quiz1 {
    "MECHADOLL 5 QUIZ.\p"
    "In SLATEPORT's POKéMON FAN CLUB,\n"
    "how many POKéMON were there?$"
}

text Route110_TrickHousePuzzle5_Text_Mechadoll5Quiz2 {
    "MECHADOLL 5 QUIZ.\p"
    "In FORTREE CITY, how many\n"
    "tree houses were there?$"
}

text Route110_TrickHousePuzzle5_Text_Mechadoll5Quiz3 {
    "MECHADOLL 5 QUIZ.\p"
    "On the CYCLING ROAD, how many\n"
    "TRIATHLETES were there?$"
}
