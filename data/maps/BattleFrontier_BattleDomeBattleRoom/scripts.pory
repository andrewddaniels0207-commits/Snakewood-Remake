    #(125 "data/maps/BattleFrontier_BattleDomeBattleRoom/scripts.pory")
    #(126 "data/maps/BattleFrontier_BattleDomeBattleRoom/scripts.pory")
    # orphan case 1 -> goto(BattleFrontier_BattleDomeBattleRoom_EventScript_Draw_5)
    return
}

