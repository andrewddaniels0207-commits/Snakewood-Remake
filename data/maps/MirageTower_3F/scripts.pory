mapscripts MirageTower_3F_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE: CaveHole_CheckFallDownHole
    MAP_SCRIPT_ON_TRANSITION: CaveHole_FixCrackedGround
    MAP_SCRIPT_ON_RESUME: MirageTower_3F_SetHoleWarp
}

script MirageTower_3F_SetHoleWarp {
    setstepcallback(STEP_CB_CRACKED_FLOOR)
    setholewarp(MAP_MIRAGE_TOWER_2F)
    end
}
