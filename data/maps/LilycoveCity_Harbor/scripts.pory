mapscripts LilycoveCity_Harbor_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: LilycoveCity_Harbor_OnTransition
}

script LilycoveCity_Harbor_OnTransition {
    setescapewarp(MAP_LILYCOVE_CITY, 12, 33)
    end
}

script LilycoveCity_Harbor_EventScript_FerryAttendant {
    lock
    faceplayer
    if (!flag(FLAG_SYS_GAME_CLEAR)) goto(LilycoveCity_Harbor_EventScript_FerryUnavailable)
    call(LilycoveCity_Harbor_EventScript_GetEonTicketState)
    call(LilycoveCity_Harbor_EventScript_GetAuroraTicketState)
    call(LilycoveCity_Harbor_EventScript_GetOldSeaMapState)
    call(LilycoveCity_Harbor_EventScript_GetMysticTicketState)
    call(LilycoveCity_Harbor_EventScript_GetFirstTimeShowingTicket)
    call(LilycoveCity_Harbor_EventScript_GetHasTicketsState)
    if (var(VAR_TEMP_C) == 2) goto(LilycoveCity_Harbor_EventScript_OldSeaMapFirstTime)
    if (var(VAR_TEMP_B) == 1) goto(LilycoveCity_Harbor_EventScript_EonTicketFirstTime)
    if (var(VAR_TEMP_B) == 2) goto(LilycoveCity_Harbor_EventScript_AuroraTicketFirstTime)
    if (var(VAR_TEMP_B) == 4) goto(LilycoveCity_Harbor_EventScript_OldSeaMapFirstTime)
    if (var(VAR_TEMP_B) == 8) goto(LilycoveCity_Harbor_EventScript_MysticTicketFirstTime)
    if (var(VAR_TEMP_B) != 0) goto(LilycoveCity_Harbor_EventScript_MultipleEventTicketsFirstTime)
    goto(LilycoveCity_Harbor_EventScript_NoFirstTimeEventTickets)
    end
}

script LilycoveCity_Harbor_EventScript_NoFirstTimeEventTickets {
    if (var(VAR_TEMP_A) == 0) goto(LilycoveCity_Harbor_EventScript_NoEventTickets)
    msgbox(LilycoveCity_Harbor_Text_MayISeeYourTicket, MSGBOX_DEFAULT)
    message(LilycoveCity_Harbor_Text_FlashTicketWhereTo)
    waitmessage()
    goto(LilycoveCity_Harbor_EventScript_FerryRegularLocationSelect)
    end
}

script LilycoveCity_Harbor_EventScript_FerryRegularLocationSelect {
    setvar(VAR_0x8004, 0)
    special(ScriptMenu_CreateLilycoveSSTidalMultichoice)
    waitstate
    special(GetLilycoveSSTidalSelection)
    switch(VAR_RESULT)
    case(0, LilycoveCity_Harbor_EventScript_GoToSlateport)
    case(1, LilycoveCity_Harbor_EventScript_GoToBattleFrontier)
    case(2, LilycoveCity_Harbor_EventScript_GoToSouthernIsland)
    case(3, LilycoveCity_Harbor_EventScript_GoToNavelRock)
    case(4, LilycoveCity_Harbor_EventScript_GoToBirthIsland)
    case(5, LilycoveCity_Harbor_EventScript_GoToFarawayIsland)
    case(6, LilycoveCity_Harbor_EventScript_ExitSailSelect)
    case(MULTI_B_PRESSED, LilycoveCity_Harbor_EventScript_ExitSailSelect)
    end
}

script LilycoveCity_Harbor_EventScript_GoToSouthernIsland {
    call(LilycoveCity_Harbor_EventScript_BoardFerry)
    warp(MAP_SOUTHERN_ISLAND_EXTERIOR, 13, 22)
    waitstate
    release
    end
}

script LilycoveCity_Harbor_EventScript_GoToNavelRock {
    call(LilycoveCity_Harbor_EventScript_BoardFerry)
    warp(MAP_NAVEL_ROCK_HARBOR, 8, 4)
    waitstate
    release
    end
}

script LilycoveCity_Harbor_EventScript_GoToBirthIsland {
    call(LilycoveCity_Harbor_EventScript_BoardFerry)
    warp(MAP_BIRTH_ISLAND_HARBOR, 8, 4)
    waitstate
    release
    end
}

script LilycoveCity_Harbor_EventScript_GoToFarawayIsland {
    call(LilycoveCity_Harbor_EventScript_BoardFerry)
    warp(MAP_FARAWAY_ISLAND_ENTRANCE, 13, 38)
    waitstate
    release
    end
}

script LilycoveCity_Harbor_EventScript_GoToSlateport {
    msgbox(LilycoveCity_Harbor_Text_SlateportItIs, MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) goto(LilycoveCity_Harbor_EventScript_FerryDestinationChangeMind)
    setvar(VAR_SS_TIDAL_STATE, SS_TIDAL_BOARD_LILYCOVE)
    call(LilycoveCity_Harbor_EventScript_BoardFerry)
    warp(MAP_SS_TIDAL_CORRIDOR, 1, 10)
    waitstate
    release
    end
}

script LilycoveCity_Harbor_EventScript_GoToBattleFrontier {
    msgbox(LilycoveCity_Harbor_Text_BattleFrontierItIs, MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) goto(LilycoveCity_Harbor_EventScript_FerryDestinationChangeMind)
    call(LilycoveCity_Harbor_EventScript_BoardFerry)
    warp(MAP_BATTLE_FRONTIER_OUTSIDE_WEST, 19, 67)
    waitstate
    release
    end
}

script LilycoveCity_Harbor_EventScript_GetEonTicketState {
    setvar(VAR_TEMP_E, 0)
    if (!flag(FLAG_ENABLE_SHIP_SOUTHERN_ISLAND)) goto(Common_EventScript_NopReturn)
    checkitem(ITEM_EON_TICKET)
    if (var(VAR_RESULT) == FALSE) goto(Common_EventScript_NopReturn)
    setvar(VAR_TEMP_E, 1)
    if (flag(FLAG_SHOWN_EON_TICKET)) goto(Common_EventScript_NopReturn)
    setvar(VAR_TEMP_E, 2)
    return
}

script LilycoveCity_Harbor_EventScript_GetAuroraTicketState {
    setvar(VAR_TEMP_D, 0)
    if (!flag(FLAG_ENABLE_SHIP_BIRTH_ISLAND)) goto(Common_EventScript_NopReturn)
    checkitem(ITEM_AURORA_TICKET)
    if (var(VAR_RESULT) == FALSE) goto(Common_EventScript_NopReturn)
    setvar(VAR_TEMP_D, 1)
    if (flag(FLAG_SHOWN_AURORA_TICKET)) goto(Common_EventScript_NopReturn)
    setvar(VAR_TEMP_D, 2)
    return
}

script LilycoveCity_Harbor_EventScript_GetOldSeaMapState {
    setvar(VAR_TEMP_C, 0)
    if (!flag(FLAG_ENABLE_SHIP_FARAWAY_ISLAND)) goto(Common_EventScript_NopReturn)
    checkitem(ITEM_OLD_SEA_MAP)
    if (var(VAR_RESULT) == FALSE) goto(Common_EventScript_NopReturn)
    setvar(VAR_TEMP_C, 1)
    if (flag(FLAG_SHOWN_OLD_SEA_MAP)) goto(Common_EventScript_NopReturn)
    setvar(VAR_TEMP_C, 2)
    return
}

script LilycoveCity_Harbor_EventScript_GetMysticTicketState {
    setvar(VAR_TEMP_9, 0)
    if (!flag(FLAG_ENABLE_SHIP_NAVEL_ROCK)) goto(Common_EventScript_NopReturn)
    checkitem(ITEM_MYSTIC_TICKET)
    if (var(VAR_RESULT) == FALSE) goto(Common_EventScript_NopReturn)
    setvar(VAR_TEMP_9, 1)
    if (flag(FLAG_SHOWN_MYSTIC_TICKET)) goto(Common_EventScript_NopReturn)
    setvar(VAR_TEMP_9, 2)
    return
}

script LilycoveCity_Harbor_EventScript_GetFirstTimeShowingTicket {
    setvar(VAR_TEMP_B, 0)
    if (var(VAR_TEMP_E) == 2) call(LilycoveCity_Harbor_EventScript_SetFirstTimeShowingEonTicket)
    if (var(VAR_TEMP_D) == 2) call(LilycoveCity_Harbor_EventScript_SetFirstTimeShowingAuroraTicket)
    if (var(VAR_TEMP_C) == 2) call(LilycoveCity_Harbor_EventScript_SetFirstTimeShowingOldSeaMap)
    if (var(VAR_TEMP_9) == 2) call(LilycoveCity_Harbor_EventScript_SetFirstTimeShowingMysticTicket)
    return
}

script LilycoveCity_Harbor_EventScript_SetFirstTimeShowingEonTicket {
    addvar(VAR_TEMP_B, 1)
    return
}

script LilycoveCity_Harbor_EventScript_SetFirstTimeShowingAuroraTicket {
    addvar(VAR_TEMP_B, 2)
    return
}

script LilycoveCity_Harbor_EventScript_SetFirstTimeShowingOldSeaMap {
    addvar(VAR_TEMP_B, 4)
    return
}

script LilycoveCity_Harbor_EventScript_SetFirstTimeShowingMysticTicket {
    addvar(VAR_TEMP_B, 8)
    return
}

script LilycoveCity_Harbor_EventScript_GetHasTicketsState {
    setvar(VAR_TEMP_A, 0)
    if (var(VAR_TEMP_E) == 1) call(LilycoveCity_Harbor_EventScript_SetHasEonTicket)
    if (var(VAR_TEMP_D) == 1) call(LilycoveCity_Harbor_EventScript_SetHasAuroraTicket)
    if (var(VAR_TEMP_C) == 1) call(LilycoveCity_Harbor_EventScript_SetHasOldSeaMap)
    if (var(VAR_TEMP_9) == 1) call(LilycoveCity_Harbor_EventScript_SetHasMysticTicket)
    return
}

script LilycoveCity_Harbor_EventScript_SetHasEonTicket {
    addvar(VAR_TEMP_A, 1)
    return
}

script LilycoveCity_Harbor_EventScript_SetHasAuroraTicket {
    addvar(VAR_TEMP_A, 2)
    return
}

script LilycoveCity_Harbor_EventScript_SetHasOldSeaMap {
    addvar(VAR_TEMP_A, 4)
    return
}

script LilycoveCity_Harbor_EventScript_SetHasMysticTicket {
    addvar(VAR_TEMP_A, 8)
    return
}

script LilycoveCity_Harbor_EventScript_EonTicketFirstTime {
    setflag(FLAG_SHOWN_EON_TICKET)
    msgbox(EventTicket_Text_ThatPass, MSGBOX_DEFAULT)
    closemessage
    call(LilycoveCity_Harbor_EventScript_GetEventTicketSailor)
    msgbox(EventTicket_Text_ShowEonTicket, MSGBOX_DEFAULT)
    goto(LilycoveCity_Harbor_EventScript_GoToSouthernIslandFirstTime)
    end
}

script LilycoveCity_Harbor_EventScript_GoToSouthernIslandFirstTime {
    closemessage
    call(LilycoveCity_Harbor_EventScript_BoardFerryWithSailor)
    warp(MAP_SOUTHERN_ISLAND_EXTERIOR, 13, 22)
    waitstate
    release
    end
}

script LilycoveCity_Harbor_EventScript_AuroraTicketFirstTime {
    setflag(FLAG_SHOWN_AURORA_TICKET)
    msgbox(EventTicket_Text_ThatPass, MSGBOX_DEFAULT)
    closemessage
    call(LilycoveCity_Harbor_EventScript_GetEventTicketSailor)
    msgbox(EventTicket_Text_OddTicketGetOnBoard, MSGBOX_DEFAULT)
    goto(LilycoveCity_Harbor_EventScript_GoToBirthIslandFirstTime)
    end
}

script LilycoveCity_Harbor_EventScript_GoToBirthIslandFirstTime {
    closemessage
    call(LilycoveCity_Harbor_EventScript_BoardFerryWithSailor)
    warp(MAP_BIRTH_ISLAND_HARBOR, 8, 4)
    waitstate
    release
    end
}

script LilycoveCity_Harbor_EventScript_OldSeaMapFirstTime {
    setflag(FLAG_SHOWN_OLD_SEA_MAP)
    msgbox(EventTicket_Text_ShowOldSeaMap, MSGBOX_DEFAULT)
    closemessage
    call(LilycoveCity_Harbor_EventScript_GetEventTicketSailor)
    msgbox(EventTicket_Text_OldSeaMapTooFar, MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_LILYCOVE_HARBOR_FERRY_SAILOR, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    playse(SE_PIN)
    applymovement(LOCALID_LILYCOVE_HARBOR_FERRY_SAILOR, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(LOCALID_LILYCOVE_HARBOR_FERRY_SAILOR, Common_Movement_Delay48)
    waitmovement(0)
    if (var(VAR_FACING) == DIR_NORTH) call(LilycoveCity_Harbor_EventScript_MoveSailorOutOfWayNorth)
    if (var(VAR_FACING) == DIR_EAST) call(LilycoveCity_Harbor_EventScript_MoveSailorOutOfWayEast)
    addobject(LOCALID_LILYCOVE_HARBOR_BRINEY)
    if (var(VAR_FACING) == DIR_NORTH) call(LilycoveCity_Harbor_EventScript_BrineyFaceSailorNorth)
    if (var(VAR_FACING) == DIR_EAST) call(LilycoveCity_Harbor_EventScript_BrineyFaceSailorEast)
    msgbox(EventTicket_Text_BrineyHoldOnASecond, MSGBOX_DEFAULT)
    if (var(VAR_FACING) == DIR_NORTH) call(LilycoveCity_Harbor_EventScript_BrineyFacePlayerNorth)
    if (var(VAR_FACING) == DIR_EAST) call(LilycoveCity_Harbor_EventScript_BrineyFacePlayerEast)
    msgbox(EventTicket_Text_BrineyLetsSail, MSGBOX_DEFAULT)
    closemessage
    if (var(VAR_FACING) == DIR_NORTH) call(LilycoveCity_Harbor_EventScript_BoardFerryWithBrineyAndSailorNorth)
    if (var(VAR_FACING) == DIR_EAST) call(LilycoveCity_Harbor_EventScript_BoardFerryWithBrineyAndSailorEast)
    setvar(VAR_0x8004, LOCALID_LILYCOVE_HARBOR_SS_TIDAL)
    call(Common_EventScript_FerryDepart)
    warp(MAP_FARAWAY_ISLAND_ENTRANCE, 13, 38)
    waitstate
    release
    end
}

script LilycoveCity_Harbor_EventScript_GoToFarawayIslandFirstTime {
    closemessage
    call(LilycoveCity_Harbor_EventScript_BoardFerryWithSailor)
    warp(MAP_FARAWAY_ISLAND_ENTRANCE, 13, 38)
    waitstate
    release
    end
}

script LilycoveCity_Harbor_EventScript_MysticTicketFirstTime {
    setflag(FLAG_SHOWN_MYSTIC_TICKET)
    msgbox(EventTicket_Text_ThatPass, MSGBOX_DEFAULT)
    closemessage
    call(LilycoveCity_Harbor_EventScript_GetEventTicketSailor)
    msgbox(EventTicket_Text_OddTicketGetOnBoard, MSGBOX_DEFAULT)
    goto(LilycoveCity_Harbor_EventScript_GoToNavelRockFirstTime)
    end
}

script LilycoveCity_Harbor_EventScript_GoToNavelRockFirstTime {
    closemessage
    call(LilycoveCity_Harbor_EventScript_BoardFerryWithSailor)
    warp(MAP_NAVEL_ROCK_HARBOR, 8, 4)
    waitstate
    release
    end
}

script LilycoveCity_Harbor_EventScript_MultipleEventTicketsFirstTime {
    msgbox(EventTicket_Text_ThatPass, MSGBOX_DEFAULT)
    closemessage
    call(LilycoveCity_Harbor_EventScript_GetEventTicketSailor)
    message(EventTicket_Text_OddTicketsWhereTo)
    waitmessage()
    setvar(VAR_0x8004, 1)
    special(ScriptMenu_CreateLilycoveSSTidalMultichoice)
    waitstate
    special(GetLilycoveSSTidalSelection)
    switch(VAR_RESULT)
    case(2, LilycoveCity_Harbor_EventScript_GoToSouthernIslandFirstTime)
    case(3, LilycoveCity_Harbor_EventScript_GoToNavelRockFirstTime)
    case(4, LilycoveCity_Harbor_EventScript_GoToBirthIslandFirstTime)
    case(5, LilycoveCity_Harbor_EventScript_GoToFarawayIslandFirstTime)
    case(6, LilycoveCity_Harbor_EventScript_ExitFirstTimeTicketSailSelect)
    case(MULTI_B_PRESSED, LilycoveCity_Harbor_EventScript_ExitFirstTimeTicketSailSelect)
    release
    end
}

script LilycoveCity_Harbor_EventScript_ExitFirstTimeTicketSailSelect {
    msgbox(EventTicket_Text_AsYouLike, MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_LILYCOVE_HARBOR_FERRY_SAILOR, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    delay(30)
    removeobject(LOCALID_LILYCOVE_HARBOR_FERRY_SAILOR)
    delay(30)
    applymovement(LOCALID_LILYCOVE_HARBOR_ATTENDANT, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    showobjectat(LOCALID_LILYCOVE_HARBOR_ATTENDANT, MAP_LILYCOVE_CITY_HARBOR)
    delay(30)
    msgbox(LilycoveCity_Harbor_Text_SailAnotherTime, MSGBOX_DEFAULT)
    release
    end
}

script LilycoveCity_Harbor_EventScript_GetEventTicketSailor {
    applymovement(VAR_LAST_TALKED, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    delay(30)
    hideobjectat(VAR_LAST_TALKED, MAP_LILYCOVE_CITY_HARBOR)
    delay(60)
    addobject(LOCALID_LILYCOVE_HARBOR_FERRY_SAILOR)
    delay(30)
    applymovement(LOCALID_LILYCOVE_HARBOR_FERRY_SAILOR, Common_Movement_FacePlayer)
    waitmovement(0)
    return
}

script LilycoveCity_Harbor_EventScript_BoardFerryWithSailor {
    applymovement(LOCALID_LILYCOVE_HARBOR_FERRY_SAILOR, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    delay(30)
    removeobject(LOCALID_LILYCOVE_HARBOR_FERRY_SAILOR)
    if (var(VAR_FACING) == DIR_NORTH) call(LilycoveCity_Harbor_EventScript_PlayerBoardFerryNorth)
    if (var(VAR_FACING) == DIR_EAST) call(LilycoveCity_Harbor_EventScript_PlayerBoardFerryEast)
    delay(30)
    hideplayer()
    setvar(VAR_0x8004, LOCALID_LILYCOVE_HARBOR_SS_TIDAL)
    call(Common_EventScript_FerryDepart)
    return
}

script LilycoveCity_Harbor_EventScript_FerryUnavailable {
    msgbox(LilycoveCity_Harbor_Text_FerryUnavailable, MSGBOX_DEFAULT)
    release
    end
}

script LilycoveCity_Harbor_EventScript_NoEventTickets {
    msgbox(LilycoveCity_Harbor_Text_MayISeeYourTicket, MSGBOX_DEFAULT)
    message(LilycoveCity_Harbor_Text_FlashTicketWhereTo)
    waitmessage()
    goto(LilycoveCity_Harbor_EventScript_FerryRegularLocationSelect)
    end
}

script LilycoveCity_Harbor_EventScript_NoTicket {
    msgbox(LilycoveCity_Harbor_Text_NoTicket, MSGBOX_DEFAULT)
    release
    end
}

script LilycoveCity_Harbor_EventScript_GoToSlateportUnused {
    msgbox(LilycoveCity_Harbor_Text_SlateportItIs, MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) goto(LilycoveCity_Harbor_EventScript_FerryDestinationChangeMind)
    setvar(VAR_SS_TIDAL_STATE, SS_TIDAL_BOARD_LILYCOVE)
    call(LilycoveCity_Harbor_EventScript_BoardFerry)
    warp(MAP_SS_TIDAL_CORRIDOR, 1, 10)
    waitstate
    release
    end
}

script LilycoveCity_Harbor_EventScript_GoToBattleFrontierUnused {
    msgbox(LilycoveCity_Harbor_Text_BattleFrontierItIs, MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) goto(LilycoveCity_Harbor_EventScript_FerryDestinationChangeMind)
    call(LilycoveCity_Harbor_EventScript_BoardFerry)
    warp(MAP_BATTLE_FRONTIER_OUTSIDE_WEST, 19, 67)
    waitstate
    release
    end
}

script LilycoveCity_Harbor_EventScript_FerryDestinationChangeMind {
    message(LilycoveCity_Harbor_Text_WhereWouldYouLikeToGo)
    waitmessage()
    goto(LilycoveCity_Harbor_EventScript_FerryRegularLocationSelect)
    end
}

script LilycoveCity_Harbor_EventScript_BoardFerry {
    msgbox(LilycoveCity_Harbor_Text_PleaseBoard, MSGBOX_DEFAULT)
    closemessage
    applymovement(VAR_LAST_TALKED, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    delay(30)
    hideobjectat(VAR_LAST_TALKED, MAP_LILYCOVE_CITY_HARBOR)
    if (var(VAR_FACING) == DIR_NORTH) call(LilycoveCity_Harbor_EventScript_PlayerBoardFerryNorth)
    if (var(VAR_FACING) == DIR_EAST) call(LilycoveCity_Harbor_EventScript_PlayerBoardFerryEast)
    delay(30)
    hideplayer()
    setvar(VAR_0x8004, LOCALID_LILYCOVE_HARBOR_SS_TIDAL)
    call(Common_EventScript_FerryDepart)
    return
}

script LilycoveCity_Harbor_EventScript_PlayerBoardFerryEast {
    applymovement(LOCALID_PLAYER, LilycoveCity_Harbor_Movement_PlayerBoardFerryEast)
    waitmovement(0)
    return
}

script LilycoveCity_Harbor_EventScript_PlayerBoardFerryNorth {
    applymovement(LOCALID_PLAYER, LilycoveCity_Harbor_Movement_PlayerBoardFerryNorth)
    waitmovement(0)
    return
}

script LilycoveCity_Harbor_EventScript_ExitSailSelect {
    msgbox(LilycoveCity_Harbor_Text_SailAnotherTime, MSGBOX_DEFAULT)
    release
    end
}

movement LilycoveCity_Harbor_Movement_PlayerBoardFerryEast {
    walk_right
    walk_in_place_faster_up
    step_end
}

movement LilycoveCity_Harbor_Movement_PlayerBoardFerryNorth {
    walk_up
    step_end
}

movement LilycoveCity_Harbor_Movement_UnusedBoardFerry {
    walk_up
    step_end
}

script LilycoveCity_Harbor_EventScript_Sailor {
    lock
    faceplayer
    if (flag(FLAG_SYS_GAME_CLEAR)) goto(LilycoveCity_Harbor_EventScript_SailorFerryAvailable)
    msgbox(LilycoveCity_Harbor_Text_SailorFerryUnavailable, MSGBOX_DEFAULT)
    release
    end
}

script LilycoveCity_Harbor_EventScript_SailorFerryAvailable {
    msgbox(LilycoveCity_Harbor_Text_SailorFerryAvailable, MSGBOX_DEFAULT)
    release
    end
}

script LilycoveCity_Harbor_EventScript_MoveSailorOutOfWayNorth {
    applymovement(LOCALID_LILYCOVE_HARBOR_FERRY_SAILOR, LilycoveCity_Harbor_Movement_SailorOutOfWayNorth)
    waitmovement(0)
    return
}

script LilycoveCity_Harbor_EventScript_MoveSailorOutOfWayEast {
    applymovement(LOCALID_LILYCOVE_HARBOR_FERRY_SAILOR, LilycoveCity_Harbor_Movement_SailorOutOfWayEast)
    waitmovement(0)
    return
}

script LilycoveCity_Harbor_Movement_SailorOutOfWayNorth {
    walk_in_place_faster_right()
    lock_facing_direction()
    walk_left()
    unlock_facing_direction()
    step_end()
}

script LilycoveCity_Harbor_Movement_SailorOutOfWayEast {
    lock_facing_direction()
    walk_down()
    unlock_facing_direction()
    step_end()
}

script LilycoveCity_Harbor_EventScript_BrineyFaceSailorNorth {
    applymovement(LOCALID_LILYCOVE_HARBOR_BRINEY, Common_Movement_WalkInPlaceFasterLeft)
    waitmovement(0)
    return
}

script LilycoveCity_Harbor_EventScript_BrineyFaceSailorEast {
    applymovement(LOCALID_LILYCOVE_HARBOR_BRINEY, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    return
}

script LilycoveCity_Harbor_EventScript_BrineyFacePlayerNorth {
    applymovement(LOCALID_LILYCOVE_HARBOR_BRINEY, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    return
}

script LilycoveCity_Harbor_EventScript_BrineyFacePlayerEast {
    applymovement(LOCALID_LILYCOVE_HARBOR_BRINEY, Common_Movement_WalkInPlaceFasterLeft)
    waitmovement(0)
    return
}

script LilycoveCity_Harbor_EventScript_BoardFerryWithBrineyAndSailorNorth {
    applymovement(LOCALID_LILYCOVE_HARBOR_BRINEY, LilycoveCity_Harbor_Movement_BrineyBoardFerry)
    applymovement(LOCALID_PLAYER, LilycoveCity_Harbor_Movement_PlayerBoardWithBrineyNorth)
    applymovement(LOCALID_LILYCOVE_HARBOR_FERRY_SAILOR, LilycoveCity_Harbor_Movement_SailorBoardWithBrineyNorth)
    waitmovement(0)
    return
}

script LilycoveCity_Harbor_EventScript_BoardFerryWithBrineyAndSailorEast {
    applymovement(LOCALID_LILYCOVE_HARBOR_BRINEY, LilycoveCity_Harbor_Movement_BrineyBoardFerry)
    applymovement(LOCALID_PLAYER, LilycoveCity_Harbor_Movement_PlayerBoardWithBrineyEast)
    applymovement(LOCALID_LILYCOVE_HARBOR_FERRY_SAILOR, LilycoveCity_Harbor_Movement_SailorBoardWithBrineyEast)
    waitmovement(0)
    return
}

movement LilycoveCity_Harbor_Movement_BrineyBoardFerry {
    walk_in_place_faster_up
    delay_8
    set_invisible
    step_end
}

movement LilycoveCity_Harbor_Movement_PlayerBoardWithBrineyNorth {
    delay_16
    walk_up
    delay_16
    set_invisible
    step_end
}

movement LilycoveCity_Harbor_Movement_SailorBoardWithBrineyNorth {
    delay_16
    delay_16
    delay_16
    walk_right
    walk_in_place_faster_up
    delay_16
    set_invisible
    step_end
}

movement LilycoveCity_Harbor_Movement_PlayerBoardWithBrineyEast {
    delay_16
    walk_right
    walk_in_place_faster_up
    delay_16
    set_invisible
