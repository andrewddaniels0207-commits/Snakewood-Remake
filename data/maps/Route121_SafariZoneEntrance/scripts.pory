# 91 "data/maps/Route121_SafariZoneEntrance/scripts.pory"
	warp MAP_SAFARI_ZONE_SOUTH, 32, 33
# 92 "data/maps/Route121_SafariZoneEntrance/scripts.pory"
	waitstate
	end

