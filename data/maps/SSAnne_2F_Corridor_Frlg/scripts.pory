mapscripts SSAnne_2F_Corridor_Frlg_MapScripts {}

script SSAnne_2F_Corridor_EventScript_RivalTriggerLeft {
    lockall
    setvar(VAR_TEMP_1, 0)
    goto(SSAnne_2F_Corridor_EventScript_RivalTrigger)
    end
}

script SSAnne_2F_Corridor_EventScript_RivalTriggerMid {
    lockall
    setvar(VAR_TEMP_1, 1)
    goto(SSAnne_2F_Corridor_EventScript_RivalTrigger)
    end
}

script SSAnne_2F_Corridor_EventScript_RivalTriggerRight {
    lockall
    setvar(VAR_TEMP_1, 2)
    goto(SSAnne_2F_Corridor_EventScript_RivalTrigger)
    end
}

script SSAnne_2F_Corridor_EventScript_RivalTrigger {
    textcolor(NPC_TEXT_COLOR_MALE)
    playse(SE_EXIT)
    delay(5)
    playbgm(MUS_RG_ENCOUNTER_RIVAL, 0)
    addobject(LOCALID_SS_ANNE_RIVAL)
    delay(10)
    applymovement(LOCALID_SS_ANNE_RIVAL, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    delay(20)
    if (var(VAR_TEMP_1) == 0) call(SSAnne_2F_Corridor_EventScript_RivalApproachLeft)
    if (var(VAR_TEMP_1) == 1) call(SSAnne_2F_Corridor_EventScript_RivalApproachMid)
    if (var(VAR_TEMP_1) == 2) call(SSAnne_2F_Corridor_EventScript_RivalApproachRight)
    msgbox(SSAnne_2F_Corridor_Text_RivalIntro)
    setvar(VAR_LAST_TALKED, LOCALID_SS_ANNE_RIVAL)
    if (var(VAR_STARTER_MON) == 2) call(SSAnne_2F_Corridor_EventScript_RivalSquirtle)
    if (var(VAR_STARTER_MON) == 1) call(SSAnne_2F_Corridor_EventScript_RivalBulbasaur)
    if (var(VAR_STARTER_MON) == 0) call(SSAnne_2F_Corridor_EventScript_RivalCharmander)
    msgbox(SSAnne_2F_Corridor_Text_RivalPostBattle)
    closemessage
    delay(10)
    playbgm(MUS_RG_RIVAL_EXIT, 0)
    if (var(VAR_TEMP_1) == 0) call(SSAnne_2F_Corridor_EventScript_RivalExitLeft)
    if (var(VAR_TEMP_1) == 1) call(SSAnne_2F_Corridor_EventScript_RivalExitMid)
    if (var(VAR_TEMP_1) == 2) call(SSAnne_2F_Corridor_EventScript_RivalExitRight)
    fadedefaultbgm()
    removeobject(LOCALID_SS_ANNE_RIVAL)
    setvar(VAR_MAP_SCENE_S_S_ANNE_2F_CORRIDOR, 1)
    releaseall
    end
}

script SSAnne_2F_Corridor_EventScript_RivalApproachLeft {
    applymovement(LOCALID_SS_ANNE_RIVAL, SSAnne_2F_Corridor_Movement_RivalApproachLeft)
    waitmovement(0)
    return
}

script SSAnne_2F_Corridor_EventScript_RivalApproachMid {
    applymovement(LOCALID_SS_ANNE_RIVAL, SSAnne_2F_Corridor_Movement_RivalApproachMid)
    applymovement(LOCALID_PLAYER, SSAnne_2F_Corridor_Movement_PlayerFaceRivalMid)
    waitmovement(0)
    return
}

script SSAnne_2F_Corridor_EventScript_RivalApproachRight {
    applymovement(LOCALID_PLAYER, SSAnne_2F_Corridor_Movement_PlayerFaceRivalRight)
    applymovement(LOCALID_SS_ANNE_RIVAL, SSAnne_2F_Corridor_Movement_RivalApproachRight)
    waitmovement(0)
    return
}

script SSAnne_2F_Corridor_EventScript_RivalSquirtle {
    trainerbattle_no_intro(TRAINER_RIVAL_SS_ANNE_SQUIRTLE, SSAnne_2F_Corridor_Text_RivalDefeat)
    return
}

script SSAnne_2F_Corridor_EventScript_RivalBulbasaur {
    trainerbattle_no_intro(TRAINER_RIVAL_SS_ANNE_BULBASAUR, SSAnne_2F_Corridor_Text_RivalDefeat)
    return
}

script SSAnne_2F_Corridor_EventScript_RivalCharmander {
    trainerbattle_no_intro(TRAINER_RIVAL_SS_ANNE_CHARMANDER, SSAnne_2F_Corridor_Text_RivalDefeat)
    return
}

script SSAnne_2F_Corridor_EventScript_RivalExitLeft {
    applymovement(LOCALID_SS_ANNE_RIVAL, SSAnne_2F_Corridor_Movement_RivalExitLeft)
    waitmovement(0)
    return
}

script SSAnne_2F_Corridor_EventScript_RivalExitMid {
    applymovement(LOCALID_SS_ANNE_RIVAL, SSAnne_2F_Corridor_Movement_RivalExitMid)
    waitmovement(0)
    return
}

script SSAnne_2F_Corridor_EventScript_RivalExitRight {
    applymovement(LOCALID_SS_ANNE_RIVAL, SSAnne_2F_Corridor_Movement_RivalExitRight)
    waitmovement(0)
    return
}

movement SSAnne_2F_Corridor_Movement_PlayerFaceRivalRight {
    delay_16
    delay_16
    delay_16
    delay_16
    walk_in_place_faster_left
    step_end
}

movement SSAnne_2F_Corridor_Movement_PlayerFaceRivalMid {
    delay_16
    delay_16
    delay_16
    delay_16
    walk_in_place_faster_left
    step_end
}

movement SSAnne_2F_Corridor_Movement_RivalApproachLeft {
    walk_down
    walk_down
    walk_down
    step_end
}

movement SSAnne_2F_Corridor_Movement_RivalApproachMid {
    walk_down
    walk_down
    walk_down
    walk_down
    walk_in_place_faster_right
    step_end
}

movement SSAnne_2F_Corridor_Movement_RivalApproachRight {
    walk_down
    walk_down
    walk_down
    walk_down
    walk_right
    delay_4
    step_end
}

movement SSAnne_2F_Corridor_Movement_RivalExitLeft {
    walk_right
    walk_down
    walk_down
    walk_down
    walk_down
    walk_down
    walk_down
    walk_down
    step_end
}

movement SSAnne_2F_Corridor_Movement_RivalExitMid {
    walk_down
    walk_down
    walk_down
    walk_down
    walk_down
    walk_down
    walk_down
    step_end
}

movement SSAnne_2F_Corridor_Movement_RivalExitRight {
    walk_down
    walk_down
    walk_down
    walk_down
    walk_down
    walk_down
    walk_down
    step_end
}

script SSAnne_2F_Corridor_EventScript_Sailor {
    msgbox(SSAnne_2F_Corridor_Text_ThisShipIsLuxuryLiner, MSGBOX_NPC)
    end
}

text SSAnne_2F_Corridor_Text_ThisShipIsLuxuryLiner {
    "This ship, she is a luxury liner for\n"
    "TRAINERS of the world!\p"
    "At every port, we hold parties with\n"
    "invited TRAINERS.$"
}

text SSAnne_2F_Corridor_Text_RivalIntro {
    "{RIVAL}: Bonjour!\n"
    "{PLAYER}!\p"
    "Imagine seeing you here!\n"
    "{PLAYER}, were you really invited?\p"
    "So how's your POKéDEX coming?\p"
    "I already caught 40 kinds, pal.\n"
    "Different kinds are everywhere.\p"
    "Crawl around in grassy areas, and\n"
    "look hard for them.$"
}

text SSAnne_2F_Corridor_Text_RivalDefeat {
    "Humph!\p"
    "At least you're raising your\n"
    "POKéMON!$"
}

text SSAnne_2F_Corridor_Text_RivalVictory {
    "{PLAYER}..！\n"
    "ふなよい　してるのか！\p"
    "もっと　からだ\n"
    "きたえた　ほうが　いいぜ！$"
}

text SSAnne_2F_Corridor_Text_RivalPostBattle {
    "{RIVAL}: I heard there was a CUT\n"
    "master on board.\p"
    "But he was just a seasick old man!\p"
    "CUT itself is really useful.\n"
    "Yup, it'll be handy.\p"
    "You should go see him, too.\n"
    "Smell ya!$"
}
