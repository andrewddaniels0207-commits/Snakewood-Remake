    #(31 "data/maps/AbandonedShip_Rooms2_1F/scripts.pory")
    register_matchcall(TRAINER_KIRA_AND_DAN_1)
    #(33 "data/maps/AbandonedShip_Rooms2_1F/scripts.pory")
    release
    end
}

