mapscripts PokemonLeague_BrunosRoom_Frlg_MapScripts {
    MAP_SCRIPT_ON_RESUME: PokemonLeague_BrunosRoom_OnResume
    MAP_SCRIPT_ON_LOAD: PokemonLeague_BrunosRoom_OnLoad
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE: PokemonLeague_BrunosRoom_OnWarp
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_MAP_SCENE_POKEMON_LEAGUE, 1: PokemonLeague_BrunosRoom_EventScript_EnterRoom
    ]
}

script PokemonLeague_BrunosRoom_OnResume {
    setvar(VAR_0x8004, 1)
    call(PokemonLeague_EventScript_DoLightingEffect)
    end
}

script PokemonLeague_BrunosRoom_OnLoad {
    if (flag(FLAG_DEFEATED_BRUNO)) call(PokemonLeague_BrunosRoom_EventScript_SetDoorOpen)
    if (var(VAR_MAP_SCENE_POKEMON_LEAGUE) == 2) call(PokemonLeague_BrunosRoom_EventScript_CloseEntry)
    end
}

script PokemonLeague_BrunosRoom_EventScript_CloseEntry {
    call(PokemonLeague_EventScript_CloseEntry)
    return
}

script PokemonLeague_BrunosRoom_EventScript_SetDoorOpen {
    call(PokemonLeague_EventScript_SetDoorOpen)
    return
}

raw `
PokemonLeague_BrunosRoom_OnWarp:
	map_script_2 VAR_TEMP_1, 0, PokemonLeague_BrunosRoom_EventScript_TurnPlayerNorth
	.2byte 0

`

script PokemonLeague_BrunosRoom_EventScript_TurnPlayerNorth {
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    end
}

script PokemonLeague_BrunosRoom_EventScript_EnterRoom {
    lockall
    call(PokemonLeague_EventScript_EnterRoom)
    setvar(VAR_MAP_SCENE_POKEMON_LEAGUE, 2)
    releaseall
    end
}

script PokemonLeague_BrunosRoom_EventScript_Bruno {
    lock
    faceplayer
    famechecker(FAMECHECKER_BRUNO, FCPICKSTATE_COLORED, UpdatePickStateFromSpecialVar8005)
    if (flag(FLAG_DEFEATED_BRUNO)) goto(PokemonLeague_BrunosRoom_EventScript_PostBattle)
    famechecker(FAMECHECKER_BRUNO, 0)
    famechecker(FAMECHECKER_BRUNO, 1)
    if (!flag(FLAG_SYS_GAME_CLEAR)) call(PokemonLeague_BrunosRoom_EventScript_Intro)
    if (flag(FLAG_SYS_GAME_CLEAR)) call(PokemonLeague_BrunosRoom_EventScript_RematchIntro)
    setflag(FLAG_TEMP_3)
    setflag(FLAG_TEMP_5)
    if (!flag(FLAG_IS_CHAMPION)) call(PokemonLeague_BrunosRoom_EventScript_Battle)
    if (flag(FLAG_IS_CHAMPION)) call(PokemonLeague_BrunosRoom_EventScript_Rematch)
    clearflag(FLAG_TEMP_5)
    goto(PokemonLeague_BrunosRoom_EventScript_DefeatedBruno)
    end
}

script PokemonLeague_BrunosRoom_EventScript_Intro {
    msgbox(PokemonLeague_BrunosRoom_Text_Intro)
    return
}

script PokemonLeague_BrunosRoom_EventScript_RematchIntro {
    msgbox(PokemonLeague_BrunosRoom_Text_RematchIntro)
    return
}

script PokemonLeague_BrunosRoom_EventScript_Battle {
    trainerbattle_no_intro(TRAINER_ELITE_FOUR_BRUNO, PokemonLeague_BrunosRoom_Text_Defeat)
    return
}

script PokemonLeague_BrunosRoom_EventScript_Rematch {
    trainerbattle_no_intro(TRAINER_ELITE_FOUR_BRUNO_2, PokemonLeague_BrunosRoom_Text_Defeat)
    return
}

script PokemonLeague_BrunosRoom_EventScript_PostBattle {
    msgbox(PokemonLeague_BrunosRoom_Text_PostBattle)
    closemessage
    if (var(VAR_FACING) == DIR_NORTH) call(PokemonLeague_BrunosRoom_EventScript_BrunoLookAwayRight)
    if (var(VAR_FACING) == DIR_SOUTH) call(PokemonLeague_BrunosRoom_EventScript_BrunoLookAwayLeft)
    if (var(VAR_FACING) == DIR_WEST) call(PokemonLeague_BrunosRoom_EventScript_BrunoLookAwayDown)
    if (var(VAR_FACING) == DIR_EAST) call(PokemonLeague_BrunosRoom_EventScript_BrunoLookAwayDown)
    release
    end
}

script PokemonLeague_BrunosRoom_EventScript_DefeatedBruno {
    setflag(FLAG_DEFEATED_BRUNO)
    call(PokemonLeague_EventScript_OpenDoor)
    msgbox(PokemonLeague_BrunosRoom_Text_PostBattle)
    closemessage
    if (var(VAR_FACING) == DIR_NORTH) call(PokemonLeague_BrunosRoom_EventScript_BrunoLookAwayRight)
    if (var(VAR_FACING) == DIR_SOUTH) call(PokemonLeague_BrunosRoom_EventScript_BrunoLookAwayLeft)
    if (var(VAR_FACING) == DIR_WEST) call(PokemonLeague_BrunosRoom_EventScript_BrunoLookAwayDown)
    if (var(VAR_FACING) == DIR_EAST) call(PokemonLeague_BrunosRoom_EventScript_BrunoLookAwayDown)
    release
    end
}

script PokemonLeague_BrunosRoom_EventScript_BrunoLookAwayLeft {
    applymovement(LOCALID_BRUNO, Common_Movement_WalkInPlaceFasterLeft)
    waitmovement(0)
    return
}

script PokemonLeague_BrunosRoom_EventScript_BrunoLookAwayRight {
    applymovement(LOCALID_BRUNO, Common_Movement_WalkInPlaceFasterRight)
    waitmovement(0)
    return
}

script PokemonLeague_BrunosRoom_EventScript_BrunoLookAwayDown {
    applymovement(LOCALID_BRUNO, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    return
}

text PokemonLeague_BrunosRoom_Text_Intro {
    "I am BRUNO of the ELITE FOUR!\p"
    "Through rigorous training, people\n"
    "and POKéMON can become stronger\l"
    "without limit.\p"
    "I've lived and trained with my\n"
    "fighting POKéMON!\l"
    "And that will never change!\p"
    "{PLAYER}!\p"
    "We will grind you down with our\n"
    "superior power!\p"
    "Hoo hah!{PLAY_BGM}{MUS_RG_ENCOUNTER_GYM_LEADER}$"
}

text PokemonLeague_BrunosRoom_Text_RematchIntro {
    "I am BRUNO of the ELITE FOUR!\p"
    "Through rigorous training, people\n"
    "and POKéMON can become stronger\l"
    "without limit.\p"
    "I've lived and trained with my\n"
    "fighting POKéMON!\l"
    "And that will never change!\p"
    "{PLAYER}!\p"
    "We will grind you down with our\n"
    "superior power!\p"
    "Hoo hah!{PLAY_BGM}{MUS_RG_ENCOUNTER_GYM_LEADER}$"
}

text PokemonLeague_BrunosRoom_Text_Defeat {
    "Why?\n"
    "How could I lose?$"
}

text PokemonLeague_BrunosRoom_Text_PostBattle {
    "My job is done.\n"
    "Go face your next challenge.$"
}
