    case(YES, BattleFrontier_BattleTowerLobby_EventScript_SaveBeforeDoublesChallenge)
    case(MULTI_B_PRESSED, BattleFrontier_BattleTowerLobby_EventScript_LoadPartyCancelChallenge)
}

