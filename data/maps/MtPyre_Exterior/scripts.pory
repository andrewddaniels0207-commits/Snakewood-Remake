mapscripts MtPyre_Exterior_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: MtPyre_Exterior_OnTransition
}

script MtPyre_Exterior_OnTransition {
    call(MtPyre_Exterior_EventScript_CheckEnterFromSummit)
    end
}

script MtPyre_Exterior_EventScript_CheckEnterFromSummit {
    getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
    if (var(VAR_TEMP_1) < 12) goto(MtPyre_Exterior_EventScript_EnterFromSummit)
    return
}

script MtPyre_Exterior_EventScript_EnterFromSummit {
    setweather(WEATHER_FOG_HORIZONTAL)
    return
}

script MtPyre_Exterior_EventScript_FogTrigger {
    setweather(WEATHER_FOG_HORIZONTAL)
    doweather()
    end
}

script MtPyre_Exterior_EventScript_SunTrigger {
    setweather(WEATHER_SUNNY)
    doweather()
    end
}
