mapscripts SixIsland_PatternBush_Frlg_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: SixIsland_PatternBush_OnTransition
}

script SixIsland_PatternBush_OnTransition {
    setworldmapflag(FLAG_WORLD_MAP_SIX_ISLAND_PATTERN_BUSH)
    getplayerxy(VAR_TEMP_1, VAR_TEMP_2)
    if (var(VAR_TEMP_1) >= 50) call(SixIsland_PatternBush_EventScript_SetEscapeRightExit)
    if (var(VAR_TEMP_1) <= 49) call(SixIsland_PatternBush_EventScript_SetEscapeLeftExit)
    end
}

script SixIsland_PatternBush_EventScript_SetEscapeRightExit {
    setescapewarp(MAP_SIX_ISLAND_GREEN_PATH, 255, 64, 10)
    return
}

script SixIsland_PatternBush_EventScript_SetEscapeLeftExit {
    setescapewarp(MAP_SIX_ISLAND_GREEN_PATH, 255, 45, 10)
    return
}

script SixIsland_PatternBush_EventScript_Bethany {
    trainerbattle_single(TRAINER_PKMN_BREEDER_BETHANY, SixIsland_PatternBush_Text_BethanyIntro, SixIsland_PatternBush_Text_BethanyDefeat)
    msgbox(SixIsland_PatternBush_Text_BethanyPostBattle, MSGBOX_AUTOCLOSE)
    end
}

