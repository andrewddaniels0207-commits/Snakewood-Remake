mapscripts CinnabarIsland_Frlg_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: CinnabarIsland_OnTransition
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_MAP_SCENE_CINNABAR_ISLAND_2, 1: CinnabarIsland_EventScript_ExitPokeCenterForOneIsland
        VAR_MAP_SCENE_CINNABAR_ISLAND, 1: CinnabarIsland_EventScript_BillScene
        VAR_MAP_SCENE_CINNABAR_ISLAND, 3: CinnabarIsland_EventScript_ReturnFromSeviiIslands
    ]
}

script CinnabarIsland_OnTransition {
    setworldmapflag(FLAG_WORLD_MAP_CINNABAR_ISLAND)
    call(CinnabarIsland_EventScript_CheckUnlockGym)
    if (var(VAR_MAP_SCENE_CINNABAR_ISLAND) == 1) call(CinnabarIsland_EventScript_ReadyObjectsSailToOneIsland)
    if (var(VAR_MAP_SCENE_CINNABAR_ISLAND) == 3) call(CinnabarIsland_EventScript_ReadyObjectsReturnFromSeviiIslands)
    if (var(VAR_MAP_SCENE_CINNABAR_ISLAND_2) == 1) call(CinnabarIsland_EventScript_ReadyObjectsSailToOneIslandFromPokeCenter)
    end
}

script CinnabarIsland_EventScript_ReadyObjectsSailToOneIslandFromPokeCenter {
    savebgm(MUS_FOLLOW_ME)
    setflag(FLAG_TEMP_2)
    setobjectxyperm(LOCALID_CINNABAR_BILL, 15, 12)
    setobjectmovementtype(LOCALID_CINNABAR_BILL, MOVEMENT_TYPE_FACE_LEFT)
    setobjectxyperm(LOCALID_CINNABAR_SEAGALLOP, 30, 12)
    return
}

script CinnabarIsland_EventScript_ReadyObjectsSailToOneIsland {
    getplayerxy(VAR_0x8004, VAR_0x8005)
    if (var(VAR_0x8004) >= 18) goto(CinnabarIsland_EventScript_MoveSeagallopDown)
    setflag(FLAG_TEMP_2)
    setobjectxyperm(LOCALID_CINNABAR_BILL, 18, 12)
    setobjectmovementtype(LOCALID_CINNABAR_BILL, MOVEMENT_TYPE_FACE_UP)
    setobjectxyperm(LOCALID_CINNABAR_SEAGALLOP, 30, 12)
    return
}

script CinnabarIsland_EventScript_MoveSeagallopDown {
    setobjectxyperm(LOCALID_CINNABAR_SEAGALLOP, 30, 8)
    return
}

script CinnabarIsland_EventScript_ReadyObjectsReturnFromSeviiIslands {
    setobjectxyperm(LOCALID_CINNABAR_BILL, 21, 8)
    setobjectmovementtype(LOCALID_CINNABAR_BILL, MOVEMENT_TYPE_FACE_UP)
    return
}

script CinnabarIsland_EventScript_CheckUnlockGym {
    if (flag(FLAG_HIDE_POKEMON_MANSION_B1F_SECRET_KEY)) goto(CinnabarIsland_EventScript_UnlockGym)
    return
}

script CinnabarIsland_EventScript_UnlockGym {
    setvar(VAR_TEMP_1, 1)
    return
}

script CinnabarIsland_EventScript_ExitPokeCenterForOneIsland {
    lockall
    clearflag(FLAG_DONT_TRANSITION_MUSIC)
    savebgm(MUS_DUMMY)
    textcolor(NPC_TEXT_COLOR_MALE)
    setvar(VAR_MAP_SCENE_CINNABAR_ISLAND_2, 2)
    delay(20)
    call(CinnabarIsland_EventScript_SailToOneIsland)
    releaseall
    end
}

script CinnabarIsland_EventScript_ReturnFromSeviiIslands {
    lockall
    textcolor(NPC_TEXT_COLOR_MALE)
    msgbox(CinnabarIsland_Text_IfYouHaveTriPassYouCanGoAgain)
    closemessage
    applymovement(LOCALID_CINNABAR_BILL, CinnabarIsland_Movement_BillExit)
    waitmovement(0)
    removeobject(LOCALID_CINNABAR_BILL)
    setvar(VAR_MAP_SCENE_CINNABAR_ISLAND, 4)
    setflag(FLAG_HIDE_TWO_ISLAND_GAME_CORNER_LOSTELLE)
    clearflag(FLAG_HIDE_LOSTELLE_IN_HER_HOME)
    releaseall
    end
}

movement CinnabarIsland_Movement_BillExit {
    walk_down
    walk_down
    walk_down
    walk_down
    walk_down
    walk_down
    step_end
}

script CinnabarIsland_EventScript_BillScene {
    lockall
    textcolor(NPC_TEXT_COLOR_MALE)
    if (!flag(FLAG_TEMP_2)) call(CinnabarIsland_EventScript_BillFacePlayer1)
    if (flag(FLAG_TEMP_2)) call(CinnabarIsland_EventScript_BillFacePlayer2)
    playse(SE_PIN)
    applymovement(LOCALID_CINNABAR_BILL, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(LOCALID_CINNABAR_BILL, Common_Movement_Delay48)
    waitmovement(0)
    if (!flag(FLAG_TEMP_2)) call(CinnabarIsland_EventScript_BillApproachPlayer1)
    if (flag(FLAG_TEMP_2)) call(CinnabarIsland_EventScript_BillApproachPlayer2)
    msgbox(CinnabarIsland_Text_HeyIfItIsntPlayer)
    msgbox(CinnabarIsland_Text_ComeWithMeToOneIsland, MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) goto(CinnabarIsland_EventScript_AgreeSailToOneIsland)
    if (var(VAR_RESULT) == NO) goto(CinnabarIsland_EventScript_DeclineSailToOneIsland)
    end
}

script CinnabarIsland_EventScript_BillFacePlayer1 {
    applymovement(LOCALID_CINNABAR_BILL, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    return
}

script CinnabarIsland_EventScript_BillFacePlayer2 {
    applymovement(LOCALID_CINNABAR_BILL, Common_Movement_WalkInPlaceFasterLeft)
    waitmovement(0)
    return
}

script CinnabarIsland_EventScript_BillApproachPlayer1 {
    applymovement(LOCALID_CINNABAR_BILL, CinnabarIsland_Movement_BillApproachPlayer1)
    waitmovement(0)
    return
}

script CinnabarIsland_EventScript_BillApproachPlayer2 {
    applymovement(LOCALID_CINNABAR_BILL, CinnabarIsland_Movement_BillApproachPlayer2)
    waitmovement(0)
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterRight)
    waitmovement(0)
    return
}

script CinnabarIsland_EventScript_AgreeSailToOneIsland {
    msgbox(CinnabarIsland_Text_AllRightLetsGo)
    closemessage
    call(CinnabarIsland_EventScript_SailToOneIsland)
    releaseall
    end
}

script CinnabarIsland_EventScript_DeclineSailToOneIsland {
    msgbox(CinnabarIsland_Text_IllBeWaitingInPokeCenter)
    closemessage
    if (!flag(FLAG_TEMP_2)) call(CinnabarIsland_EventScript_BillExitToPokeCenter)
    if (flag(FLAG_TEMP_2)) call(CinnabarIsland_EventScript_BillReturnToPokeCenter)
    removeobject(LOCALID_CINNABAR_BILL)
    setvar(VAR_MAP_SCENE_CINNABAR_ISLAND, 2)
    clearflag(FLAG_HIDE_CINNABAR_POKECENTER_BILL)
    releaseall
    end
}

script CinnabarIsland_EventScript_BillExitToPokeCenter {
    applymovement(LOCALID_CINNABAR_BILL, CinnabarIsland_Movement_BillExitToPokeCenter)
    waitmovement(0)
    return
}

movement CinnabarIsland_Movement_BillExitToPokeCenter {
    walk_right
    walk_down
    walk_down
    walk_down
    walk_down
    walk_down
    walk_down
    step_end
}

script CinnabarIsland_EventScript_BillReturnToPokeCenter {
    applymovement(LOCALID_PLAYER, CinnabarIsland_Movement_PlayerWatchBillExit)
    applymovement(LOCALID_CINNABAR_BILL, CinnabarIsland_Movement_BillApproachDoor)
    waitmovement(0)
    opendoor(14, 11)
    waitdooranim()
    applymovement(LOCALID_CINNABAR_BILL, CinnabarIsland_Movement_BillReEnterPokeCenter)
    waitmovement(0)
    closedoor(14, 11)
    waitdooranim()
    return
}

movement CinnabarIsland_Movement_PlayerWatchBillExit {
    walk_left
    walk_in_place_faster_right
    step_end
}

movement CinnabarIsland_Movement_BillApproachDoor {
    delay_16
    walk_left
    walk_in_place_faster_up
    step_end
}

movement CinnabarIsland_Movement_BillReEnterPokeCenter {
    walk_up
    delay_4
    set_invisible
    step_end
}

script CinnabarIsland_EventScript_SailToOneIsland {
    if (flag(FLAG_TEMP_2)) call(CinnabarIsland_EventScript_ApproachShore)
    addobject(LOCALID_CINNABAR_SEAGALLOP)
    if (!flag(FLAG_TEMP_2)) call(CinnabarIsland_EventScript_BoatArrive)
    if (flag(FLAG_TEMP_2)) call(CinnabarIsland_EventScript_BoatArriveExitedPokeCenter)
    msgbox(CinnabarIsland_Text_MyPalsBoatArrived)
    closemessage
    if (!flag(FLAG_TEMP_2)) call(CinnabarIsland_EventScript_BoardBoat)
    if (flag(FLAG_TEMP_2)) call(CinnabarIsland_EventScript_BoardBoatExitedPokeCenter)
    setvar(VAR_MAP_SCENE_CINNABAR_ISLAND, 2)
    removeobject(LOCALID_CINNABAR_BILL)
    delay(40)
    setflag(FLAG_HIDE_CINNABAR_SEAGALLOP)
    setvar(VAR_MAP_SCENE_ONE_ISLAND_HARBOR, 1)
    setvar(VAR_0x8004, SEAGALLOP_CINNABAR_ISLAND)
    setvar(VAR_0x8006, SEAGALLOP_ONE_ISLAND)
    goto(EventScript_SetSail)
    end
}

script CinnabarIsland_EventScript_ApproachShore {
    applymovement(LOCALID_CINNABAR_BILL, CinnabarIsland_Movement_ApproachShore)
    applymovement(LOCALID_PLAYER, CinnabarIsland_Movement_ApproachShore)
    waitmovement(0)
    return
}

script CinnabarIsland_EventScript_BoatArrive {
    applymovement(LOCALID_CINNABAR_BILL, CinnabarIsland_Movement_BillFaceBoat)
    applymovement(LOCALID_CINNABAR_SEAGALLOP, CinnabarIsland_Movement_BoatArrive)
    waitmovement(0)
    return
}

script CinnabarIsland_EventScript_BoatArriveExitedPokeCenter {
    applymovement(LOCALID_CINNABAR_SEAGALLOP, CinnabarIsland_Movement_BoatArrive)
    waitmovement(0)
    return
}

script CinnabarIsland_EventScript_BoardBoat {
    applymovement(LOCALID_CINNABAR_BILL, CinnabarIsland_Movement_BillBoardBoat)
    applymovement(LOCALID_PLAYER, CinnabarIsland_Movement_PlayerBoardBoat)
    waitmovement(0)
    return
}

script CinnabarIsland_EventScript_BoardBoatExitedPokeCenter {
    applymovement(LOCALID_CINNABAR_BILL, CinnabarIsland_Movement_BillBoardBoatFromShore)
    applymovement(LOCALID_PLAYER, CinnabarIsland_Movement_PlayerBoardBoatFromShore)
    waitmovement(0)
    return
}

movement CinnabarIsland_Movement_BoatArrive {
    delay_16
    delay_16
    walk_fast_left
    walk_fast_left
    walk_left
    walk_slow_left
    walk_slow_left
    step_end
}

movement CinnabarIsland_Movement_BillBoardBoat {
    walk_right
    walk_down
    walk_down
    walk_right
    delay_4
    set_invisible
    step_end
}

movement CinnabarIsland_Movement_BillApproachPlayer1 {
    walk_up
    step_end
}

movement CinnabarIsland_Movement_BillApproachPlayer2 {
    walk_left
    walk_left
    walk_left
    step_end
}

movement CinnabarIsland_Movement_BillFaceBoat {
    delay_16
    delay_16
    delay_8
    walk_in_place_faster_right
    step_end
}

movement CinnabarIsland_Movement_ApproachShore {
    walk_right
    walk_right
    walk_right
    walk_right
    walk_right
    walk_right
    step_end
}

movement CinnabarIsland_Movement_BillBoardBoatFromShore {
    walk_right
    delay_4
    set_invisible
    step_end
}

movement CinnabarIsland_Movement_PlayerBoardBoat {
    walk_down
    walk_right
    walk_down
    walk_down
    walk_in_place_faster_right
    delay_4
    walk_right
    delay_4
    set_invisible
    step_end
}

movement CinnabarIsland_Movement_PlayerBoardBoatFromShore {
    walk_right
    delay_4
    walk_right
    delay_4
    set_invisible
    step_end
}

script CinnabarIsland_EventScript_GymDoorLocked {
    lockall
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    delay(20)
    msgbox(CinnabarIsland_Text_DoorIsLocked)
    closemessage
    applymovement(LOCALID_PLAYER, CinnabarIsland_Movement_ForcePlayerFromDoor)
    waitmovement(0)
    releaseall
    end
}

movement CinnabarIsland_Movement_ForcePlayerFromDoor {
    walk_down
    step_end
}

script CinnabarIsland_EventScript_Woman {
    lock
    faceplayer
    famechecker(FAMECHECKER_BLAINE, 3)
    msgbox(CinnabarIsland_Text_BlaineLivedHereSinceBeforeLab)
    release
    end
}

script CinnabarIsland_EventScript_OldMan {
    msgbox(CinnabarIsland_Text_ScientistsExperimentInMansion, MSGBOX_NPC)
    end
}

script CinnabarIsland_EventScript_IslandSign {
    msgbox(CinnabarIsland_Text_IslandSign, MSGBOX_SIGN)
    end
}

script CinnabarIsland_EventScript_PokemonLabSign {
    msgbox(CinnabarIsland_Text_PokemonLab, MSGBOX_SIGN)
    end
}

script CinnabarIsland_EventScript_GymSign {
    lockall
    famechecker(FAMECHECKER_BLAINE, 0)
    msgbox(CinnabarIsland_Text_GymSign)
    releaseall
    end
}

text CinnabarIsland_Text_DoorIsLocked {
    "The door is locked…$"
}

text CinnabarIsland_Text_BlaineLivedHereSinceBeforeLab {
    "CINNABAR GYM's BLAINE is quite the\n"
    "odd fellow.\p"
    "He's lived on the island since way\n"
    "before the LAB was built.$"
}

text CinnabarIsland_Text_ScientistsExperimentInMansion {
    "Scientists conduct experiments \n"
    "in the burned-out building.\p"
    "You know, the one they call the\n"
    "POKéMON MANSION.$"
}

text CinnabarIsland_Text_IslandSign {
    "CINNABAR ISLAND\n"
    "The Fiery Town of Burning Desire$"
}

text CinnabarIsland_Text_PokemonLab {
    "POKéMON LAB$"
}

text CinnabarIsland_Text_GymSign {
    "CINNABAR ISLAND POKéMON GYM\n"
    "LEADER: BLAINE\l"
    "The Hotheaded Quiz Master!$"
}

text CinnabarIsland_Text_HeyIfItIsntPlayer {
    "Huh?\n"
    "Hey, if it isn't {PLAYER}!$"
}

text CinnabarIsland_Text_ComeWithMeToOneIsland {
    "Look, it's me, BILL.\n"
    "Long time no see!\p"
    "I hope you're still using my\n"
    "PC system.\p"
    "Well, listen, since we met up here,\n"
    "how about spending time with me?\p"
    "There's this little island in the far\n"
    "south called ONE ISLAND.\p"
    "A friend invited me, so I'm on my\n"
    "way out there.\p"
    "How about it?\n"
    "Do you feel like coming with me?$"
}

text CinnabarIsland_Text_AllRightLetsGo {
    "All right, then.\n"
    "Let's go!$"
}

text CinnabarIsland_Text_IllBeWaitingInPokeCenter {
    "What, are you too busy?\p"
    "Well, all right.\n"
    "The boat hasn't arrived yet anyway.\p"
    "I'll be waiting at the POKéMON\n"
    "CENTER over there.\p"
    "Come see me when you're done with\n"
    "your business here.$"
}

text CinnabarIsland_Text_MyPalsBoatArrived {
    "Looks like my pal's boat arrived,\n"
    "too.\p"
    "He sent it specially here to\n"
    "CINNABAR to pick me up.$"
}

text CinnabarIsland_Text_IfYouHaveTriPassYouCanGoAgain {
    "Hey, wasn't that a long cruise?\p"
    "My buddy CELIO seemed to enjoy\n"
    "your company.\p"
    "I'm sure he'd welcome you if you\n"
    "were to visit him again.\p"
    "If you have a TRI-PASS, you can\n"
    "always take a ferry there from\l"
    "VERMILION PORT.\p"
    "All right, thanks for your company!$"
}
