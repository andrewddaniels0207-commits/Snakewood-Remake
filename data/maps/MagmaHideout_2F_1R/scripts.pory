    trainerbattle_single(TRAINER_GRUNT_MAGMA_HIDEOUT_5, MagmaHideout_2F_1R_Text_Grunt5Intro, MagmaHideout_2F_1R_Text_Grunt5Defeat)
    msgbox(MagmaHideout_2F_1R_Text_Grunt5PostBattle, MSGBOX_AUTOCLOSE)
