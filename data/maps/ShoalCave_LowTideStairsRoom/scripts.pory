mapscripts ShoalCave_LowTideStairsRoom_MapScripts {
    MAP_SCRIPT_ON_LOAD: ShoalCave_LowTideStairsRoom_OnLoad
}

script ShoalCave_LowTideStairsRoom_OnLoad {
    call(ShoalCave_LowTideStairsRoom_EventScript_SetShoalItemMetatiles)
    end
}

script ShoalCave_LowTideStairsRoom_EventScript_SetShoalItemMetatiles {
    if (flag(FLAG_RECEIVED_SHOAL_SALT_3)) goto(ShoalCave_LowTideStairsRoom_EventScript_SetShoalItemMetatilesEnd)
    setmetatile(11, 11, METATILE_Cave_ShoalCave_DirtPile_Large, TRUE)
    return
}

script ShoalCave_LowTideStairsRoom_EventScript_SetShoalItemMetatilesEnd {
    return
}

script ShoalCave_LowTideStairsRoom_EventScript_ShoalSalt3 {
    lockall
    if (flag(FLAG_RECEIVED_SHOAL_SALT_3)) goto(ShoalCave_LowTideStairsRoom_EventScript_ReceivedShoalSalt)
    giveitem(ITEM_SHOAL_SALT)
    if (var(VAR_RESULT) == FALSE) goto(Common_EventScript_ShowBagIsFull)
    setmetatile(11, 11, METATILE_Cave_ShoalCave_DirtPile_Small, FALSE)
    special(DrawWholeMapView)
    setflag(FLAG_RECEIVED_SHOAL_SALT_3)
    releaseall
    end
}

script ShoalCave_LowTideStairsRoom_EventScript_ReceivedShoalSalt {
    msgbox(ShoalCave_Text_WasShoalSaltNowNothing, MSGBOX_DEFAULT)
    releaseall
    end
}
