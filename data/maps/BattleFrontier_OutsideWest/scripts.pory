script BattleFrontier_OutsideWest_EventScript_Fisherman2 {
    lock
    faceplayer
    message(BattleFrontier_OutsideWest_Text_GotSeasickOnWayHere)
    waitmessage()
    applymovement(LOCALID_FRONTIER_FISHERMAN_2, Common_Movement_FaceAwayPlayer)
    waitmovement(0)
    waitbuttonpress()
    release
    end
}

script BattleFrontier_OutsideWest_EventScript_Man1 {
    msgbox(BattleFrontier_OutsideWest_Text_OnlyToughTrainersBroughtHere, MSGBOX_NPC)
    end
}

script BattleFrontier_OutsideWest_EventScript_Maniac1 {
    lock
    goto(BattleFrontier_OutsideWest_EventScript_FactoryChallengersTalk)
    end
}

script BattleFrontier_OutsideWest_EventScript_Maniac2 {
    lock
    goto(BattleFrontier_OutsideWest_EventScript_FactoryChallengersTalk)
    end
}

script BattleFrontier_OutsideWest_EventScript_FactoryChallengersTalk {
    applymovement(LOCALID_FRONTIER_MANIAC_1, Common_Movement_WalkInPlaceFasterRight)
    waitmovement(0)
    msgbox(BattleFrontier_OutsideWest_Text_SureWeCanChallengeWithNoMons, MSGBOX_DEFAULT)
    applymovement(LOCALID_FRONTIER_MANIAC_2, Common_Movement_WalkInPlaceFasterLeft)
    waitmovement(0)
    msgbox(BattleFrontier_OutsideWest_Text_BigGuySaidIllLendYouMons, MSGBOX_DEFAULT)
    closemessage
    delay(25)
    applymovement(LOCALID_FRONTIER_MANIAC_1, Common_Movement_WalkInPlaceFasterUp)
    applymovement(LOCALID_FRONTIER_MANIAC_2, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    release
    end
}

script BattleFrontier_OutsideWest_EventScript_Camper {
    lock
    faceplayer
    delay(20)
    if (var(VAR_FACING) == DIR_NORTH) {
        call(BattleFrontier_OutsideWest_EventScript_CamperFaceFactory)
    }
    if (var(VAR_FACING) == DIR_SOUTH) {
        call(BattleFrontier_OutsideWest_EventScript_CamperAlreadyFacingFactory)
    }
    if (var(VAR_FACING) == DIR_WEST) {
        call(BattleFrontier_OutsideWest_EventScript_CamperFaceFactory)
    }
    if (var(VAR_FACING) == DIR_EAST) {
        call(BattleFrontier_OutsideWest_EventScript_CamperFaceFactory)
    }
    msgbox(BattleFrontier_OutsideWest_Text_WhosRaisingThoseRentalMons, MSGBOX_DEFAULT)
    release
    end
}

script BattleFrontier_OutsideWest_EventScript_CamperFaceFactory {
    applymovement(LOCALID_FRONTIER_CAMPER, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    return
}

script BattleFrontier_OutsideWest_EventScript_CamperAlreadyFacingFactory {
    return
}

script BattleFrontier_OutsideWest_EventScript_Girl {
    lock
    faceplayer
    message(BattleFrontier_OutsideWest_Text_ScaredOfPikeBecauseSeviper)
    waitmessage()
    if (var(VAR_FACING) == DIR_NORTH) {
        call(BattleFrontier_OutsideWest_EventScript_GirlShudderNorth)
    }
    if (var(VAR_FACING) == DIR_SOUTH) {
        call(BattleFrontier_OutsideWest_EventScript_GirlShudderSouth)
    }
    if (var(VAR_FACING) == DIR_WEST) {
        call(BattleFrontier_OutsideWest_EventScript_GirlShudderWest)
    }
    if (var(VAR_FACING) == DIR_EAST) {
        call(BattleFrontier_OutsideWest_EventScript_GirlShudderEast)
    }
    waitbuttonpress()
    release
    end
}

script BattleFrontier_OutsideWest_EventScript_GirlShudderNorth {
    applymovement(LOCALID_FRONTIER_GIRL, BattleFrontier_OutsideWest_Movement_GirlShudderNorth)
    waitmovement(0)
    return
}

script BattleFrontier_OutsideWest_EventScript_GirlShudderSouth {
    applymovement(LOCALID_FRONTIER_GIRL, BattleFrontier_OutsideWest_Movement_GirlShudderSouth)
    waitmovement(0)
    return
}

script BattleFrontier_OutsideWest_EventScript_GirlShudderWest {
    applymovement(LOCALID_FRONTIER_GIRL, BattleFrontier_OutsideWest_Movement_GirlShudderWest)
    waitmovement(0)
    return
}

script BattleFrontier_OutsideWest_EventScript_GirlShudderEast {
    applymovement(LOCALID_FRONTIER_GIRL, BattleFrontier_OutsideWest_Movement_GirlShudderEast)
    waitmovement(0)
    return
}

movement BattleFrontier_OutsideWest_Movement_GirlShudderNorth {
    walk_in_place_faster_down
    walk_in_place_faster_down
    step_end
}

movement BattleFrontier_OutsideWest_Movement_GirlShudderSouth {
    walk_in_place_faster_up
    walk_in_place_faster_up
    step_end
}

movement BattleFrontier_OutsideWest_Movement_GirlShudderWest {
    walk_in_place_faster_right
    walk_in_place_faster_right
    step_end
}

movement BattleFrontier_OutsideWest_Movement_GirlShudderEast {
    walk_in_place_faster_left
    walk_in_place_faster_left
    step_end
}

script BattleFrontier_OutsideWest_EventScript_Woman2 {
    lock
    faceplayer
    msgbox(BattleFrontier_OutsideWest_Text_LetsPlayRockPaperScissors, MSGBOX_DEFAULT)
    random(2)
    if (var(VAR_RESULT) == 1) {
        goto(BattleFrontier_OutsideWest_EventScript_WomanWonRockPaperScissors)
    }
    goto(BattleFrontier_OutsideWest_EventScript_WomanLostRockPaperScissors)
    end
}

