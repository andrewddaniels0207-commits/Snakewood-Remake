    msgbox(BattleFrontier_OutsideWest_Text_ThisIsBattleTower, MSGBOX_NPC)
    end
}

script BattleFrontier_OutsideWest_EventScript_UnusedNPC2 {
    msgbox(BattleFrontier_OutsideWest_Text_CantFindBattleTower, MSGBOX_NPC)
