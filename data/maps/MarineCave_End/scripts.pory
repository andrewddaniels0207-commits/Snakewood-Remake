mapscripts MarineCave_End_MapScripts {
    MAP_SCRIPT_ON_RESUME: MarineCave_End_OnResume
    MAP_SCRIPT_ON_TRANSITION: MarineCave_End_OnTransition
}

script MarineCave_End_OnResume {
    if (flag(FLAG_SYS_CTRL_OBJ_DELETE)) call(MarineCave_End_EventScript_TryRemoveKyogre)
    end
}

script MarineCave_End_EventScript_TryRemoveKyogre {
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) != B_OUTCOME_CAUGHT) goto(Common_EventScript_NopReturn)
    removeobject(LOCALID_MARINE_CAVE_KYOGRE)
    return
}

script MarineCave_End_OnTransition {
    if (!flag(FLAG_DEFEATED_KYOGRE)) call(MarineCave_End_EventScript_ShowKyogre)
    end
}

script MarineCave_End_EventScript_ShowKyogre {
    clearflag(FLAG_HIDE_MARINE_CAVE_KYOGRE)
    setvar(VAR_TEMP_1, 1)
    return
}

script MarineCave_End_EventScript_Kyogre {
    lockall
    applymovement(LOCALID_PLAYER, Common_Movement_FaceUp)
    waitmovement(0)
    applymovement(LOCALID_MARINE_CAVE_KYOGRE, MarineCave_End_Movement_KyogreApproach)
    waitmovement(0)
    waitse()
    playmoncry(SPECIES_KYOGRE, CRY_MODE_ENCOUNTER)
    delay(40)
    waitmoncry()
    setvar(VAR_LAST_TALKED, LOCALID_MARINE_CAVE_KYOGRE)
    setwildbattle(SPECIES_KYOGRE, 70)
    setflag(FLAG_SYS_CTRL_OBJ_DELETE)
    special(BattleSetup_StartLegendaryBattle)
    waitstate
    clearflag(FLAG_SYS_CTRL_OBJ_DELETE)
    setvar(VAR_TEMP_1, 0)
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) == B_OUTCOME_WON) goto(MarineCave_End_EventScript_DefeatedKyogre)
    if (var(VAR_RESULT) == B_OUTCOME_RAN) goto(MarineCave_End_EventScript_RanFromKyogre)
    if (var(VAR_RESULT) == B_OUTCOME_PLAYER_TELEPORTED) goto(MarineCave_End_EventScript_RanFromKyogre)
    setvar(VAR_SHOULD_END_ABNORMAL_WEATHER, 1)
    setflag(FLAG_DEFEATED_KYOGRE)
    releaseall
    end
}

script MarineCave_End_EventScript_DefeatedKyogre {
    setvar(VAR_SHOULD_END_ABNORMAL_WEATHER, 1)
    setflag(FLAG_DEFEATED_KYOGRE)
    goto(Common_EventScript_RemoveStaticPokemon)
    end
}

script MarineCave_End_EventScript_RanFromKyogre {
    setvar(VAR_0x8004, SPECIES_KYOGRE)
    goto(Common_EventScript_LegendaryFlewAway)
    end
}

script MarineCave_End_Movement_KyogreApproach {
    init_affine_anim()
    walk_down_start_affine()
    delay_16()
    delay_16()
    walk_down_affine()
    delay_16()
    delay_16()
    walk_down_affine()
    step_end()
}
