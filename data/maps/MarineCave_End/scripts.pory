	end


MarineCave_End_EventScript_RanFromKyogre::
# 76 "data/maps/MarineCave_End/scripts.pory"
	setvar VAR_0x8004, SPECIES_KYOGRE
# 77 "data/maps/MarineCave_End/scripts.pory"
	goto Common_EventScript_LegendaryFlewAway
	end


MarineCave_End_Movement_KyogreApproach::
# 82 "data/maps/MarineCave_End/scripts.pory"
	init_affine_anim
# 83 "data/maps/MarineCave_End/scripts.pory"
	walk_down_start_affine
# 84 "data/maps/MarineCave_End/scripts.pory"
	delay_16
# 85 "data/maps/MarineCave_End/scripts.pory"
	delay_16
# 86 "data/maps/MarineCave_End/scripts.pory"
	walk_down_affine
# 87 "data/maps/MarineCave_End/scripts.pory"
	delay_16
# 88 "data/maps/MarineCave_End/scripts.pory"
	delay_16
# 89 "data/maps/MarineCave_End/scripts.pory"
	walk_down_affine
# 90 "data/maps/MarineCave_End/scripts.pory"
	step_end
	return


`
