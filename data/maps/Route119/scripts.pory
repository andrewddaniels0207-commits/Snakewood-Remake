mapscripts Route119_MapScripts {
    MAP_SCRIPT_ON_RESUME: Route119_OnResume
    MAP_SCRIPT_ON_TRANSITION: Route119_OnTransition
}

script Route119_OnResume {
    if (flag(FLAG_SYS_CTRL_OBJ_DELETE)) {
        call(Route119_EventScript_TryRemoveKecleon)
    }
    end
}

script Route119_EventScript_TryRemoveKecleon {
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) != B_OUTCOME_CAUGHT) {
        goto(Common_EventScript_NopReturn)
    }
    removeobject(VAR_LAST_TALKED)
    return
}

script Route119_OnTransition {
    call(Common_EventScript_SetupRivalGfxId)
    call(Common_EventScript_SetupRivalOnBikeGfxId)
    if (var(VAR_WEATHER_INSTITUTE_STATE) == 1) {
        call(Route119_EventScript_MoveInstituteWorkersDownstairs)
    }
    special(SetRoute119Weather)
    end
}

script Route119_EventScript_MoveInstituteWorkersDownstairs {
    setflag(FLAG_HIDE_WEATHER_INSTITUTE_2F_WORKERS)
    clearflag(FLAG_HIDE_WEATHER_INSTITUTE_1F_WORKERS)
    setvar(VAR_WEATHER_INSTITUTE_STATE, 2)
    return
}

script Route119_EventScript_RivalTrigger1 {
    setvar(VAR_TEMP_1, 1)
    goto(Route119_EventScript_RivalEncounter)
    end
}

script Route119_EventScript_RivalTrigger2 {
    setvar(VAR_TEMP_1, 2)
    goto(Route119_EventScript_RivalEncounter)
    end
}

script Route119_EventScript_RivalEncounter {
    lockall
    addobject(LOCALID_ROUTE119_RIVAL_ON_BIKE)
    checkplayergender()
    if (var(VAR_RESULT) == MALE) {
        call(Route119_EventScript_PlayMayMusic)
    }
    if (var(VAR_RESULT) == FEMALE) {
        call(Route119_EventScript_PlayBrendanMusic)
    }
    delay(65)
    if (var(VAR_TEMP_1) == 1) {
        call(Route119_EventScript_RivalEnter1)
    }
    if (var(VAR_TEMP_1) == 2) {
        call(Route119_EventScript_RivalEnter2)
    }
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    delay(30)
    if (var(VAR_TEMP_1) == 1) {
        call(Route119_EventScript_SetRivalPos1)
    }
    if (var(VAR_TEMP_1) == 2) {
        call(Route119_EventScript_SetRivalPos2)
    }
    removeobject(LOCALID_ROUTE119_RIVAL_ON_BIKE)
    addobject(LOCALID_ROUTE119_RIVAL)
    delay(30)
    checkplayergender()
    if (var(VAR_RESULT) == MALE) {
        goto(Route119_EventScript_BattleMay)
    }
    if (var(VAR_RESULT) == FEMALE) {
        goto(Route119_EventScript_BattleBrendan)
    }
    releaseall
    end
}

script Route119_EventScript_PlayMayMusic {
    playbgm(MUS_ENCOUNTER_MAY, TRUE)
    return
}

script Route119_EventScript_PlayBrendanMusic {
    playbgm(MUS_ENCOUNTER_BRENDAN, TRUE)
    return
}

script Route119_EventScript_BattleMay {
    msgbox(Route119_Text_MayIntro, MSGBOX_DEFAULT)
    switch (var(VAR_STARTER_MON)) {
        case 0:
            goto(Route119_EventScript_BattleMayTreecko)
        case 1:
            goto(Route119_EventScript_BattleMayTorchic)
        case 2:
            goto(Route119_EventScript_BattleMayMudkip)
    }
    end
}

script Route119_EventScript_BattleMayTreecko {
    trainerbattle_no_intro(TRAINER_MAY_ROUTE_119_TREECKO, Route119_Text_MayDefeat)
    goto(Route119_EventScript_DefeatedMay)
    end
}

script Route119_EventScript_BattleMayTorchic {
    trainerbattle_no_intro(TRAINER_MAY_ROUTE_119_TORCHIC, Route119_Text_MayDefeat)
    goto(Route119_EventScript_DefeatedMay)
    end
}

script Route119_EventScript_BattleMayMudkip {
    trainerbattle_no_intro(TRAINER_MAY_ROUTE_119_MUDKIP, Route119_Text_MayDefeat)
    goto(Route119_EventScript_DefeatedMay)
    end
}

script Route119_EventScript_DefeatedMay {
    msgbox(Route119_Text_MayPresentForYou, MSGBOX_DEFAULT)
    call(Route119_EventScript_GiveFlyHM)
    msgbox(Route119_Text_MayExplainFly, MSGBOX_DEFAULT)
    goto(Route119_EventScript_RivalExitScottArrive)
    end
}

script Route119_EventScript_BattleBrendan {
    msgbox(Route119_Text_BrendanIntro, MSGBOX_DEFAULT)
    switch (var(VAR_STARTER_MON)) {
        case 0:
            goto(Route119_EventScript_BattleBrendanTreecko)
        case 1:
            goto(Route119_EventScript_BattleBrendanTorchic)
        case 2:
            goto(Route119_EventScript_BattleBrendanMudkip)
    }
    end
}

script Route119_EventScript_BattleBrendanTreecko {
    trainerbattle_no_intro(TRAINER_BRENDAN_ROUTE_119_TREECKO, Route119_Text_BrendanDefeat)
    goto(Route119_EventScript_DefeatedBrendan)
    end
}

script Route119_EventScript_BattleBrendanTorchic {
    trainerbattle_no_intro(TRAINER_BRENDAN_ROUTE_119_TORCHIC, Route119_Text_BrendanDefeat)
    goto(Route119_EventScript_DefeatedBrendan)
    end
}

script Route119_EventScript_BattleBrendanMudkip {
    trainerbattle_no_intro(TRAINER_BRENDAN_ROUTE_119_MUDKIP, Route119_Text_BrendanDefeat)
    goto(Route119_EventScript_DefeatedBrendan)
    end
}

script Route119_EventScript_DefeatedBrendan {
    msgbox(Route119_Text_BrendanIllGiveYouThis, MSGBOX_DEFAULT)
    call(Route119_EventScript_GiveFlyHM)
    msgbox(Route119_Text_BrendanExplainFly, MSGBOX_DEFAULT)
    goto(Route119_EventScript_RivalExitScottArrive)
    end
}

script Route119_EventScript_GiveFlyHM {
    giveitem(ITEM_HM_FLY)
    setflag(FLAG_RECEIVED_HM_FLY)
    return
}

script Route119_EventScript_RivalExitScottArrive {
    closemessage
    if (var(VAR_TEMP_1) == 1) {
        call(Route119_EventScript_SetRivalPos1)
    }
    if (var(VAR_TEMP_1) == 2) {
        call(Route119_EventScript_SetRivalPos2)
    }
    removeobject(LOCALID_ROUTE119_RIVAL)
    addobject(LOCALID_ROUTE119_RIVAL_ON_BIKE)
    delay(30)
    if (var(VAR_TEMP_1) == 1) {
        call(Route119_EventScript_RivalExit1)
    }
    if (var(VAR_TEMP_1) == 2) {
        call(Route119_EventScript_RivalExit2)
    }
    removeobject(LOCALID_ROUTE119_RIVAL_ON_BIKE)
    setvar(VAR_ROUTE119_STATE, 1)
    savebgm(MUS_DUMMY)
    fadedefaultbgm()
    delay(60)
    if (var(VAR_TEMP_1) == 1) {
        call(Route119_EventScript_SetScottPos1)
    }
    if (var(VAR_TEMP_1) == 2) {
        call(Route119_EventScript_SetScottPos2)
    }
    addobject(LOCALID_ROUTE119_SCOTT)
    applymovement(LOCALID_ROUTE119_SCOTT, Route119_Movement_ScottEnter)
    waitmovement(0)
    addvar(VAR_SCOTT_STATE, 1)
    msgbox(Route119_Text_ScottWayToGoBeSeeingYou, MSGBOX_DEFAULT)
    closemessage
    if (var(VAR_TEMP_1) == 1) {
        call(Route119_EventScript_ScottExit1)
    }
    if (var(VAR_TEMP_1) == 2) {
        call(Route119_EventScript_ScottExit2)
    }
    removeobject(LOCALID_ROUTE119_SCOTT)
    releaseall
    end
}

script Route119_EventScript_SetScottPos1 {
    setobjectxyperm(LOCALID_ROUTE119_SCOTT, 27, 25)
    return
}

script Route119_EventScript_SetScottPos2 {
    setobjectxyperm(LOCALID_ROUTE119_SCOTT, 28, 25)
    return
}

script Route119_EventScript_ScottExit1 {
    applymovement(LOCALID_ROUTE119_SCOTT, Route119_Movement_ScottExit1)
    waitmovement(0)
    return
}

script Route119_EventScript_ScottExit2 {
    applymovement(LOCALID_ROUTE119_SCOTT, Route119_Movement_ScottExit2)
    waitmovement(0)
    return
}

script Route119_EventScript_RivalEnter1 {
    applymovement(LOCALID_ROUTE119_RIVAL_ON_BIKE, Route119_Movement_RivalEnter1)
    waitmovement(0)
    return
}

script Route119_EventScript_RivalEnter2 {
    applymovement(LOCALID_ROUTE119_RIVAL_ON_BIKE, Route119_Movement_RivalEnter2)
    waitmovement(0)
    return
}

script Route119_EventScript_RivalExit1 {
    applymovement(LOCALID_PLAYER, Route119_Movement_PlayerWatchRivalExit1)
    applymovement(LOCALID_ROUTE119_RIVAL_ON_BIKE, Route119_Movement_RivalExit1)
    waitmovement(0)
    return
}

script Route119_EventScript_RivalExit2 {
    applymovement(LOCALID_PLAYER, Route119_Movement_PlayerWatchRivalExit2)
    applymovement(LOCALID_ROUTE119_RIVAL_ON_BIKE, Route119_Movement_RivalExit2)
    waitmovement(0)
    return
}

script Route119_EventScript_SetRivalPos1 {
    setobjectxyperm(LOCALID_ROUTE119_RIVAL, 25, 32)
    setobjectxyperm(LOCALID_ROUTE119_RIVAL_ON_BIKE, 25, 32)
    return
}

script Route119_EventScript_SetRivalPos2 {
    setobjectxyperm(LOCALID_ROUTE119_RIVAL, 26, 32)
    setobjectxyperm(LOCALID_ROUTE119_RIVAL_ON_BIKE, 26, 32)
    return
}

movement Route119_Movement_PlayerWatchRivalExit1 {
    delay_16
    walk_in_place_faster_right
    delay_8
    walk_in_place_faster_up
    step_end
}

movement Route119_Movement_PlayerWatchRivalExit2 {
    delay_16
    walk_in_place_faster_left
    delay_8
    walk_in_place_faster_up
    step_end
}

movement Route119_Movement_RivalEnter1 {
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_up
    step_end
}

movement Route119_Movement_RivalEnter2 {
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_up
    step_end
}

movement Route119_Movement_RivalExit1 {
    walk_fast_right
    walk_fast_up
    walk_fast_up
    walk_fast_up
    walk_fast_right
    walk_fast_up
    walk_fast_up
    walk_fast_up
    walk_fast_up
    step_end
}

movement Route119_Movement_RivalExit2 {
    walk_fast_left
    walk_fast_up
    walk_fast_up
    walk_fast_up
    walk_fast_right
    walk_fast_right
    walk_fast_up
    walk_fast_up
    walk_fast_up
    walk_fast_up
    step_end
}

movement Route119_Movement_ScottEnter {
    walk_down
    walk_down
    walk_down
    walk_down
    walk_left
    walk_left
    walk_down
    step_end
}

movement Route119_Movement_ScottExit1 {
    walk_up
    walk_right
    walk_right
    walk_up
    walk_up
    walk_up
    walk_up
    walk_up
    step_end
}

movement Route119_Movement_ScottExit2 {
    walk_up
    walk_right
    walk_up
    walk_up
    walk_up
    walk_up
    walk_up
    step_end
}

