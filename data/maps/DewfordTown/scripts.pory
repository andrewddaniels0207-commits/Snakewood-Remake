	goto_if_eq DewfordTown_EventScript_HowsFishing_2
DewfordTown_EventScript_HowsFishing_1:
# 133 "data/maps/DewfordTown/scripts.pory"
	compare VAR_RESULT, 1
	goto_if_eq DewfordTown_EventScript_HowsFishing_5
