	lock
# 94 "data/maps/DewfordTown/scripts.pory"
	faceplayer
# 95 "data/maps/DewfordTown/scripts.pory"
	goto_if_set FLAG_RECEIVED_OLD_ROD, DewfordTown_EventScript_OldRodFisherman_2
DewfordTown_EventScript_OldRodFisherman_1:
