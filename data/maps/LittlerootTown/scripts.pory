mapscripts LittlerootTown_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: LittlerootTown_OnTransition
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_SNAKEWOOD_INTRO_STATE, 0: LittlerootTown_EventScript_WakeUp
    ]
}

script LittlerootTown_OnTransition {
    setflag(FLAG_VISITED_LITTLEROOT_TOWN)
    setflag(FLAG_HIDE_LITTLEROOT_TOWN_MOM_OUTSIDE)
    setflag(FLAG_HIDE_LITTLEROOT_TOWN_FAT_MAN)
    setflag(FLAG_HIDE_LITTLEROOT_TOWN_RIVAL)
    setflag(FLAG_HIDE_LITTLEROOT_TOWN_BIRCH)
    end
}

script LittlerootTown_EventScript_WakeUp {
    lockall
    setvar(VAR_SNAKEWOOD_INTRO_STATE, 1)
    fadescreen(FADE_TO_BLACK)
    delay(30)
    fadescreen(FADE_FROM_BLACK)
    applymovement(LOCALID_PLAYER, LittlerootTown_Movement_PlayerLookAround)
    waitmovement(0)
    msgbox("Urgh\.\p"
           "Where am I?\p"
           "I can't seem to remember\.$")
    releaseall
    end
}

movement LittlerootTown_Movement_PlayerLookAround {
    walk_in_place_faster_down
    delay_16
    walk_in_place_faster_left
    delay_16
    walk_in_place_faster_right
    delay_16
    walk_in_place_faster_down
}

script LittlerootTown_EventScript_BirchsBag {
    lock
    faceplayer
    if (flag(FLAG_STARTER_CHOSEN)) {
        msgbox("The satchel is still here.\p"
               "Two empty slots stare back\n"
               "at you.\.$")
        release
        end
    }
    msgbox("A worn satchel, half-buried under\n"
           "a chunk of broken wall.\p"
           "Three POKéBALLS are\n"
           "nestled inside.$")
    msgbox("All three POKéBALLS are intact.\p"
           "I can feel movement from\n"
           "each of them.\.$")
    setflag(FLAG_SYS_POKEMON_GET)
    fadescreen(FADE_TO_BLACK)
    special(ChooseStarter)
    waitstate
    special(HealPlayerParty)
    setflag(FLAG_STARTER_CHOSEN)
    msgbox("At least I'm not completely\n"
           "alone out here.$")
    release
    end
}

script LittlerootTown_EventScript_CantLeaveWithoutStarter {
    if (flag(FLAG_STARTER_CHOSEN)) {
        end
    }
    lockall
    msgbox("Something is moving out there\n"
           "in the long grass.\p"
           "I can hear it.\p"
           "Going out there without a\n"
           "POKéMON would be suicide.$")
    closemessage
    applymovement(LOCALID_PLAYER, LittlerootTown_Movement_PushBackSouth)
    waitmovement(0)
    releaseall
    end
}

script LittlerootTown_EventScript_NeedPokemonTriggerRight {
    if (flag(FLAG_STARTER_CHOSEN)) {
        end
    }
    lockall
    msgbox("Something is moving out there\n"
           "in the long grass.\p"
           "I can hear it.\p"
           "Going out there without a\n"
           "POKéMON would be suicide.$")
    closemessage
    applymovement(LOCALID_PLAYER, LittlerootTown_Movement_PushBackSouth)
    waitmovement(0)
    releaseall
    end
}

movement LittlerootTown_Movement_PushBackSouth {
    walk_down
    walk_down
}

script LittlerootTown_EventScript_TownSign {
    msgbox("LITTLEROOT TOWN\n"
           "\qoA town that can't be shaded any hue.\qc\p"
           "Someone has written below in red:\n"
           "\qoHELP.\qc$", MSGBOX_SIGN)
    end
}

script LittlerootTown_EventScript_LabSign {
    msgbox("PROF. BIRCH'S POKéMON LAB\p"
           "The sign is half-buried\n"
           "under collapsed concrete.$", MSGBOX_SIGN)
    end
}