    step_end
}

movement LittlerootTown_BrendansHouse_2F_Movement_BrendanWalkToPCWest {
    walk_up
    walk_up
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_in_place_faster_up
    step_end
}

movement LittlerootTown_BrendansHouse_2F_Movement_PlayerWatchBrendanWest {
