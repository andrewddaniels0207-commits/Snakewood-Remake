mapscripts DewfordTown_Hall_MapScripts {}

script DewfordTown_Hall_EventScript_Girl {
    lock
    faceplayer
    call(Common_EventScript_BufferTrendyPhrase)
    special(IsTrendyPhraseBoring)
    if (var(VAR_RESULT) == TRUE) {
        goto(DewfordTown_Hall_EventScript_GirlBoredOfTrend)
    }
    msgbox(DewfordTown_Hall_Text_CantImagineLifeWithoutTrend, MSGBOX_DEFAULT)
    release
    end
}

script DewfordTown_Hall_EventScript_GirlBoredOfTrend {
    msgbox(DewfordTown_Hall_Text_GettingBoredOfTrend, MSGBOX_DEFAULT)
    release
    end
}

script DewfordTown_Hall_EventScript_Woman {
    lock
    faceplayer
    call(Common_EventScript_BufferTrendyPhrase)
    msgbox(DewfordTown_Hall_Text_TeachingMonAboutTrend, MSGBOX_DEFAULT)
    release
    end
}

script DewfordTown_Hall_EventScript_Man {
    lock
    faceplayer
    call(Common_EventScript_BufferTrendyPhrase)
    special(BufferDeepLinkPhrase)
    msgbox(DewfordTown_Hall_Text_DeepLinkBetweenXAndY, MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        goto(DewfordTown_Hall_EventScript_ConfirmTrendLink)
    }
    if (var(VAR_RESULT) == NO) {
        goto(DewfordTown_Hall_EventScript_RejectTrendLink)
    }
    end
}

script DewfordTown_Hall_EventScript_ConfirmTrendLink {
    msgbox(DewfordTown_Hall_Text_MyHunchWasRight, MSGBOX_DEFAULT)
    release
    end
}

script DewfordTown_Hall_EventScript_RejectTrendLink {
    msgbox(DewfordTown_Hall_Text_NotEasyToKeepUp, MSGBOX_DEFAULT)
    release
    end
}

script DewfordTown_Hall_EventScript_ExpertM {
    lock
    faceplayer
    call(Common_EventScript_BufferTrendyPhrase)
    msgbox(DewfordTown_Hall_Text_TVShowAboutTrend, MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_DEWFORD_HALL_EXPERT_M, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    release
    end
}

script DewfordTown_Hall_EventScript_Twin {
    lock
    faceplayer
    call(Common_EventScript_BufferTrendyPhrase)
    msgbox(DewfordTown_Hall_Text_IsTrendMorePopularAcrossSea, MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_DEWFORD_HALL_TWIN, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    release
    end
}

script DewfordTown_Hall_EventScript_LittleBoy {
    lock
    faceplayer
    call(Common_EventScript_BufferTrendyPhrase)
    msgbox(DewfordTown_Hall_Text_CollectTrendMerchandise, MSGBOX_DEFAULT)
    release
    end
}

script DewfordTown_Hall_EventScript_Bookshelf {
    lockall
    call(Common_EventScript_BufferTrendyPhrase)
    msgbox(DewfordTown_Hall_Text_BooksAboutTrend, MSGBOX_DEFAULT)
    releaseall
    end
}

script DewfordTown_Hall_EventScript_Painting {
    lockall
    call(Common_EventScript_BufferTrendyPhrase)
    special(GetDewfordHallPaintingNameIndex)
    switch(VAR_RESULT)
    case(0, DewfordTown_Hall_EventScript_ScreamTitle)
    case(4, DewfordTown_Hall_EventScript_ScreamTitle)
    case(1, DewfordTown_Hall_EventScript_SmileTitle)
    case(5, DewfordTown_Hall_EventScript_ScreamTitle)
    case(2, DewfordTown_Hall_EventScript_LastTitle)
    case(6, DewfordTown_Hall_EventScript_LastTitle)
    case(3, DewfordTown_Hall_EventScript_BirthTitle)
    case(7, DewfordTown_Hall_EventScript_LastTitle)
    end
}

script DewfordTown_Hall_EventScript_ScreamTitle {
    msgbox(DewfordTown_Hall_Text_TrendsScream, MSGBOX_DEFAULT)
    releaseall
    end
}

script DewfordTown_Hall_EventScript_SmileTitle {
    msgbox(DewfordTown_Hall_Text_TrendsSmile, MSGBOX_DEFAULT)
    releaseall
    end
}

script DewfordTown_Hall_EventScript_LastTitle {
    msgbox(DewfordTown_Hall_Text_LastTrend, MSGBOX_DEFAULT)
    releaseall
    end
}

script DewfordTown_Hall_EventScript_BirthTitle {
    msgbox(DewfordTown_Hall_Text_BirthOfTrend, MSGBOX_DEFAULT)
    releaseall
    end
}

script DewfordTown_Hall_EventScript_SchoolKidM {
    lockall
    setvar(VAR_0x8008, 0)
    goto(DewfordTown_Hall_EventScript_DoTrendDebate)
    end
}

script DewfordTown_Hall_EventScript_PsychicM {
    lockall
    setvar(VAR_0x8008, 1)
    goto(DewfordTown_Hall_EventScript_DoTrendDebate)
    end
}

script DewfordTown_Hall_EventScript_DoTrendDebate {
    call(Common_EventScript_BufferTrendyPhrase)
    special(GetDewfordHallPaintingNameIndex)
    switch(VAR_RESULT)
    case(0, DewfordTown_Hall_EventScript_TrendDebate1)
    case(1, DewfordTown_Hall_EventScript_TrendDebate1)
    case(2, DewfordTown_Hall_EventScript_TrendDebate2)
    case(3, DewfordTown_Hall_EventScript_TrendDebate2)
    case(4, DewfordTown_Hall_EventScript_TrendDebate3)
    case(5, DewfordTown_Hall_EventScript_TrendDebate3)
    case(6, DewfordTown_Hall_EventScript_TrendDebate4)
    case(7, DewfordTown_Hall_EventScript_TrendDebate5)
    end
}

script DewfordTown_Hall_EventScript_TrendDebate1 {
    call(DewfordTown_Hall_EventScript_DebateReact1)
    msgbox(DewfordTown_Hall_Text_SawTrendCoolestThing, MSGBOX_DEFAULT)
    call(DewfordTown_Hall_EventScript_DebateReact2)
    msgbox(DewfordTown_Hall_Text_AllegedTrendNotAuthentic, MSGBOX_DEFAULT)
    releaseall
    end
}

script DewfordTown_Hall_EventScript_TrendDebate2 {
    call(DewfordTown_Hall_EventScript_DebateReact1)
    msgbox(DewfordTown_Hall_Text_ComposedTrendThemeSong, MSGBOX_DEFAULT)
    call(DewfordTown_Hall_EventScript_DebateReact2)
    msgbox(DewfordTown_Hall_Text_WorkOnYourSinging, MSGBOX_DEFAULT)
    releaseall
    end
}

script DewfordTown_Hall_EventScript_TrendDebate3 {
    call(DewfordTown_Hall_EventScript_DebateReact1)
    msgbox(DewfordTown_Hall_Text_OrganizeTrendParty, MSGBOX_DEFAULT)
    call(DewfordTown_Hall_EventScript_DebateReact2)
    msgbox(DewfordTown_Hall_Text_BrilliantIndeed, MSGBOX_DEFAULT)
    releaseall
    end
}

script DewfordTown_Hall_EventScript_TrendDebate4 {
    call(DewfordTown_Hall_EventScript_DebateReact1)
    msgbox(DewfordTown_Hall_Text_TrendHasBecomePartOfLife, MSGBOX_DEFAULT)
    call(DewfordTown_Hall_EventScript_DebateReact2)
    msgbox(DewfordTown_Hall_Text_TrendWeighsHeavilyOnMind, MSGBOX_DEFAULT)
    releaseall
    end
}

script DewfordTown_Hall_EventScript_TrendDebate5 {
    call(DewfordTown_Hall_EventScript_DebateReact1)
    msgbox(DewfordTown_Hall_Text_IfWeTeamUpWellBeInvincible, MSGBOX_DEFAULT)
    call(DewfordTown_Hall_EventScript_DebateReact2)
    msgbox(DewfordTown_Hall_Text_WellBeTrendDuo, MSGBOX_DEFAULT)
    releaseall
    end
}

script DewfordTown_Hall_EventScript_DontMovePlayer1 {
    return
}

script DewfordTown_Hall_EventScript_DebateReact1 {
    applymovement(LOCALID_DEWFORD_HALL_PSYCHIC_M, DewfordTown_Hall_Movement_PsychicWalkInPlaceLeft)
    waitmovement(0)
    if (var(VAR_0x8008) == 0) {
        goto(DewfordTown_Hall_EventScript_PlayerReactWest)
    }
    if (var(VAR_0x8008) == 1) {
        goto(DewfordTown_Hall_EventScript_DontMovePlayer2)
    }
    end
}

script DewfordTown_Hall_EventScript_PlayerReactWest {
    if (var(VAR_FACING) == DIR_EAST) {
        goto(DewfordTown_Hall_EventScript_DontMovePlayer1)
    }
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterRight)
    waitmovement(0)
    return
}

script DewfordTown_Hall_EventScript_DontMovePlayer2 {
    return
}

script DewfordTown_Hall_EventScript_DebateReact2 {
    applymovement(LOCALID_DEWFORD_HALL_SCHOOL_KID_M, DewfordTown_Hall_Movement_SchoolKidWalkInPlaceRight)
    waitmovement(0)
    if (var(VAR_0x8008) == 0) {
        goto(DewfordTown_Hall_EventScript_PlayerReactNorthSouth)
    }
    if (var(VAR_0x8008) == 1) {
        goto(DewfordTown_Hall_EventScript_PlayerReactEast)
    }
    end
}

script DewfordTown_Hall_EventScript_PlayerReactNorthSouth {
    if (var(VAR_FACING) == DIR_NORTH) {
        call(DewfordTown_Hall_EventScript_PlayerWalkInPlaceUp)
    }
    if (var(VAR_FACING) == DIR_SOUTH) {
        call(DewfordTown_Hall_EventScript_PlayerWalkInPlaceDown)
    }
    return
}

script DewfordTown_Hall_EventScript_PlayerWalkInPlaceUp {
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    return
}

script DewfordTown_Hall_EventScript_PlayerWalkInPlaceDown {
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    return
}

script DewfordTown_Hall_EventScript_PlayerReactEast {
    if (var(VAR_FACING) == DIR_WEST) {
        goto(DewfordTown_Hall_EventScript_DontMovePlayer1)
    }
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterLeft)
    waitmovement(0)
    return
}

movement DewfordTown_Hall_Movement_PsychicWalkInPlaceLeft {
    walk_in_place_left
    step_end
}

movement DewfordTown_Hall_Movement_SchoolKidWalkInPlaceRight {
    walk_in_place_right
    step_end
}

script DewfordTown_Hall_EventScript_SludgeBombMan {
    lock
    faceplayer
    call(Common_EventScript_BufferTrendyPhrase)
    if (flag(FLAG_RECEIVED_TM_SLUDGE_BOMB)) {
        goto(DewfordTown_Hall_EventScript_ReceivedSludgeBomb)
    }
    msgbox(DewfordTown_Hall_Text_GiveYouSludgeBomb, MSGBOX_DEFAULT)
    giveitem(ITEM_TM_SLUDGE_BOMB)
    if (var(VAR_RESULT) == FALSE) {
        goto(Common_EventScript_ShowBagIsFull)
    }
    setflag(FLAG_RECEIVED_TM_SLUDGE_BOMB)
    release
    end
}

script DewfordTown_Hall_EventScript_ReceivedSludgeBomb {
    msgbox(DewfordTown_Hall_Text_LoveSludgeBombButTrendInToo, MSGBOX_DEFAULT)
    release
    end
}

text DewfordTown_Hall_Text_CantImagineLifeWithoutTrend {
    "What's in vogue? Why, it has to be\n"
    "“{STR_VAR_1}”!\p"
    "I can't imagine what life would be like\n"
    "without “{STR_VAR_1}”!$"
}

text DewfordTown_Hall_Text_GettingBoredOfTrend {
    "What's in vogue? Why, it has to be\n"
    "“{STR_VAR_1}”!\p"
    "But I'm getting kind of bored with it.\p"
    "I should look for the next big thing.$"
}

text DewfordTown_Hall_Text_TeachingMonAboutTrend {
    "I'm teaching my POKéMON about\n"
    "“{STR_VAR_1},”\l"
    "but it's not going well.\p"
    "It's a bit too much, I think.$"
}

text DewfordTown_Hall_Text_DeepLinkBetweenXAndY {
    "I'm studying up on the hip and trendy\n"
    "“{STR_VAR_1}” now.\p"
    "Is it true that there's a deep link\n"
    "between “{STR_VAR_1}”\l"
    "and “{STR_VAR_2}”?$"
}

text DewfordTown_Hall_Text_MyHunchWasRight {
    "Oh!\n"
    "So, my hunch was right!\p"
    "I'm one step closer to being hip and\n"
    "happening, yowza!$"
}

text DewfordTown_Hall_Text_NotEasyToKeepUp {
    "What?!\n"
    "Is that so?!\p"
    "It's not easy for an older fellow like\n"
    "me to keep up with trends!$"
}

text DewfordTown_Hall_Text_TVShowAboutTrend {
    "This whole business about\n"
    "“{STR_VAR_1}”…\l"
    "Isn't there a TV show on it?$"
}

text DewfordTown_Hall_Text_IsTrendMorePopularAcrossSea {
    "Across the sea…\p"
    "Is “{STR_VAR_1}”\n"
    "even more popular?$"
}

text DewfordTown_Hall_Text_CollectTrendMerchandise {
    "I collect official\n"
    "“{STR_VAR_1}”\l"
    "licensed merchandise.\p"
    "I have official\n"
    "“{STR_VAR_1}” DOLLS…\p"
    "Official “{STR_VAR_1}”\n"
    "brand clothing…\p"
    "And officially licensed\n"
    "“{STR_VAR_1}”\l"
    "picture books.\p"
    "Heheh, I own!\n"
    "I'm not sharing anything with you!$"
}

text DewfordTown_Hall_Text_BooksAboutTrend {
    "IDENTIFYING GOOD\n"
    "“{STR_VAR_1}” &\l"
    "BAD “{STR_VAR_1}”…\p"
    "THE LINK BETWEEN\n"
    "“{STR_VAR_1}” AND\l"
    "POKéMON…\p"
    "USEFUL\n"
    "“{STR_VAR_1}”…\p"
    "It's neatly jammed with books about\n"
    "“{STR_VAR_1}.”$"
}

text DewfordTown_Hall_Text_TrendsScream {
    "“{STR_VAR_1}'S\n"
    "SCREAM” is the title.$"
}

text DewfordTown_Hall_Text_TrendsSmile {
    "“{STR_VAR_1}'S\n"
    "SMILE” is the title.$"
}

text DewfordTown_Hall_Text_LastTrend {
    "It's titled “THE LAST\n"
    "{STR_VAR_1}”.$"
}

text DewfordTown_Hall_Text_BirthOfTrend {
    "It's titled “THE BIRTH OF\n"
    "{STR_VAR_1}”.$"
}

text DewfordTown_Hall_Text_SawTrendCoolestThing {
    "I saw “{STR_VAR_1}”!\n"
    "Cool, huh?\p"
    "It's, like, the coolest thing going!\p"
    "It was awesome!\n"
    "It was the real thing, oh yeah!$"
}

text DewfordTown_Hall_Text_AllegedTrendNotAuthentic {
    "Oh, no, no, no.\p"
    "That alleged\n"
    "“{STR_VAR_1}”\l"
    "you claim to have seen--it's not.\p"
    "The authentic article is much…\n"
    "How should I say it?\l"
    "Sharper, yet more mellow!\p"
    "Ah, no matter. It's astonishing!$"
}

text DewfordTown_Hall_Text_ComposedTrendThemeSong {
    "Hey, listen, I composed a theme song\n"
    "for “{STR_VAR_1}.”\p"
    "“{STR_VAR_1}”\n"
    "is really popular right now.\p"
    "Okay, listen!\n"
    "… …\p"
    "Oh!\n"
    "{STR_VAR_1}!\p"
    "Wonderful\n"
    "{STR_VAR_1}!$"
}

text DewfordTown_Hall_Text_WorkOnYourSinging {
    "… …\p"
    "I dare say, chap, it would pay for you\n"
    "to work on your singing before you\l"
    "trifle yourself with\l"
    "“{STR_VAR_1}.”$"
}

text DewfordTown_Hall_Text_OrganizeTrendParty {
    "Anyway, as I was saying earlier, we\n"
    "should get together and organize a\l"
    "“{STR_VAR_1}” party\l"
    "on the island.$"
}

text DewfordTown_Hall_Text_BrilliantIndeed {
    "Oh, a smashing good idea!\p"
    "It will settle once and for all\n"
    "who is the best at\l"
    "“{STR_VAR_1}.”\l"
    "Brilliant, indeed!\p"
    "Starting today, our lives will revolve\n"
    "around “{STR_VAR_1}”!$"
}

text DewfordTown_Hall_Text_TrendHasBecomePartOfLife {
    "I was thinking, though…\p"
    "Wouldn't you agree that\n"
    "“{STR_VAR_1}” has\l"
    "grown from being something trendy to\l"
    "being a part of our daily lives?$"
}

text DewfordTown_Hall_Text_TrendWeighsHeavilyOnMind {
    "Beg pardon?\n"
    "That much, what?\p"
    "However, it's true that\n"
    "“{STR_VAR_1}”\l"
    "weighs heavily on your mind, whether\l"
    "you're awake or asleep.\p"
    "Absolutely, you're the\n"
    "“{STR_VAR_1}”\l"
    "PROFESSOR, old sport!$"
}

text DewfordTown_Hall_Text_IfWeTeamUpWellBeInvincible {
    "If you and me team up as a combo,\n"
    "we'll be invincible when it comes to all\l"
    "things “{STR_VAR_1}”!$"
}

text DewfordTown_Hall_Text_WellBeTrendDuo {
    "Spot on, my friend!\p"
    "We shall be the\n"
    "“{STR_VAR_1}” DUO!\p"
    "Isn't that a ripe image?\n"
    "Hahahah!$"
}

text DewfordTown_Hall_Text_GiveYouSludgeBomb {
    "For me, SLUDGE BOMB is at the peak\n"
    "of popularity. It's the one.\p"
    "Hunh? You're telling me that you don't\n"
    "know about SLUDGE BOMB?\p"
    "That's outright pitiful.\n"
    "I'll give you one.$"
}

text DewfordTown_Hall_Text_LoveSludgeBombButTrendInToo {
    "I love SLUDGE BOMB.\p"
    "But POKéMON with the move\n"
    "“{STR_VAR_1}”\l"
    "are in, too.$"
}
