text AquaHideout_1F_Text_Grunt1Intro {
    "Ayiyiyi!\n"
    "Suspicious character spotted!$"
}

text AquaHideout_1F_Text_Grunt1Defeat {
    "Grrrrr…\n"
    "I lost it!$"
}

text AquaHideout_1F_Text_Grunt1PostBattle {
    "I took the loss for the TEAM,\n"
    "but I did my job…$"
}
