mapscripts DesertUnderpass_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: DesertUnderpass_OnTransition
}

script DesertUnderpass_OnTransition {
    setflag(FLAG_LANDMARK_DESERT_UNDERPASS)
    end
}

script DesertUnderpass_EventScript_Fossil {
    lock
    faceplayer
    if (flag(FLAG_CHOSE_ROOT_FOSSIL)) goto(DesertUnderpass_EventScript_GiveClawFossil)
    if (flag(FLAG_CHOSE_CLAW_FOSSIL)) goto(DesertUnderpass_EventScript_GiveRootFossil)
    release
    end
}

script DesertUnderpass_EventScript_GiveClawFossil {
    giveitem(ITEM_CLAW_FOSSIL)
    if (var(VAR_RESULT) == FALSE) goto(Common_EventScript_ShowBagIsFull)
    removeobject(LOCALID_UNDERPASS_FOSSIL)
    release
    end
}

script DesertUnderpass_EventScript_GiveRootFossil {
    giveitem(ITEM_ROOT_FOSSIL)
    if (var(VAR_RESULT) == FALSE) goto(Common_EventScript_ShowBagIsFull)
    removeobject(LOCALID_UNDERPASS_FOSSIL)
    release
    end
}

text DesertUnderpass_Text_FoundRootFossil {
    "{PLAYER} found the ROOT FOSSIL.$"
}

text DesertUnderpass_Text_FoundClawFossil {
    "{PLAYER} found the CLAW FOSSIL.$"
}
