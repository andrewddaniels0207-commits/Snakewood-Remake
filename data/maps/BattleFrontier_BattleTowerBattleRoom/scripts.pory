	.string "Your FRONTIER PASS, please…$"

BattleFrontier_BattleTowerBattleRoom_Text_AbilitySymbolTookGoldenShine::
# 716 "data/maps/BattleFrontier_BattleTowerBattleRoom/scripts.pory"
