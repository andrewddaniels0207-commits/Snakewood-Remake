mapscripts FuchsiaCity_PokemonCenter_1F_Frlg_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: FuchsiaCity_PokemonCenter_1F_OnTransition
    MAP_SCRIPT_ON_RESUME: CableClub_OnResume
}

script FuchsiaCity_PokemonCenter_1F_OnTransition {
    setrespawn(HEAL_LOCATION_FUCHSIA_CITY)
    end
}

script FuchsiaCity_PokemonCenter_1F_EventScript_Nurse {
    lock
    faceplayer
    call(EventScript_PkmnCenterNurse_Frlg)
    release
    end
}

script FuchsiaCity_PokemonCenter_1F_EventScript_Man {
    msgbox(FuchsiaCity_PokemonCenter_1F_Text_CantBecomeGoodTrainerWithOneMon, MSGBOX_NPC)
    end
}

script FuchsiaCity_PokemonCenter_1F_EventScript_CooltrainerF {
    msgbox(FuchsiaCity_PokemonCenter_1F_Text_PokemonLeagueWestOfViridian, MSGBOX_NPC)
    end
}

script FuchsiaCity_PokemonCenter_1F_EventScript_Youngster {
    msgbox(FuchsiaCity_PokemonCenter_1F_Text_VisitSafariZoneForPokedex, MSGBOX_NPC)
    end
}

text FuchsiaCity_PokemonCenter_1F_Text_CantBecomeGoodTrainerWithOneMon {
    "You can't become a good TRAINER\n"
    "with just one strong POKéMON.\p"
    "But raising many POKéMON evenly\n"
    "is no easy task, either.$"
}

text FuchsiaCity_PokemonCenter_1F_Text_PokemonLeagueWestOfViridian {
    "There's a narrow trail west of\n"
    "VIRIDIAN CITY.\p"
    "It goes to the POKéMON LEAGUE HQ.\n"
    "The HQ governs all TRAINERS.$"
}

text FuchsiaCity_PokemonCenter_1F_Text_VisitSafariZoneForPokedex {
    "If you're working on a POKéDEX,\n"
    "visit the SAFARI ZONE.\p"
    "All sorts of rare POKéMON breed\n"
    "there.$"
}
