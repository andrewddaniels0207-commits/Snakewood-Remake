mapscripts CeruleanCave_B1F_Frlg_MapScripts {
    MAP_SCRIPT_ON_RESUME: CeruleanCave_B1F_OnResume
    MAP_SCRIPT_ON_TRANSITION: CeruleanCave_B1F_OnTransition
}

script CeruleanCave_B1F_OnResume {
    if (flag(FLAG_SYS_CTRL_OBJ_DELETE)) {
        call(CeruleanCave_B1F_EventScript_TryRemoveMewtwo)
    }
    end
}

script CeruleanCave_B1F_EventScript_TryRemoveMewtwo {
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) != B_OUTCOME_CAUGHT) {
        goto(Common_EventScript_NopReturn)
    }
    removeobject(VAR_LAST_TALKED)
    return
}

script CeruleanCave_B1F_OnTransition {
    if (!flag(FLAG_FOUGHT_MEWTWO)) {
        call(CeruleanCave_B1F_EventScript_ShowMewtwo)
    }
    end
}

script CeruleanCave_B1F_EventScript_ShowMewtwo {
    clearflag(FLAG_HIDE_MEWTWO)
    return
}

script CeruleanCave_B1F_EventScript_Mewtwo {
    lock
    faceplayer
    waitse()
    playmoncry(SPECIES_MEWTWO, CRY_MODE_ENCOUNTER)
    message(CeruleanCave_B1F_Text_Mew)
    waitmessage()
    waitmoncry()
    delay(20)
    playbgm(MUS_RG_ENCOUNTER_GYM_LEADER, 0)
    waitbuttonpress()
    setwildbattle(SPECIES_MEWTWO, 70)
    setflag(FLAG_SYS_CTRL_OBJ_DELETE)
    special(BattleSetup_StartLegendaryBattle)
    waitstate
    clearflag(FLAG_SYS_CTRL_OBJ_DELETE)
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) == B_OUTCOME_WON) {
        goto(CeruleanCave_B1F_EventScript_DefeatedMewtwo)
    }
    if (var(VAR_RESULT) == B_OUTCOME_RAN) {
        goto(CeruleanCave_B1F_EventScript_RanFromMewtwo)
    }
    if (var(VAR_RESULT) == B_OUTCOME_PLAYER_TELEPORTED) {
        goto(CeruleanCave_B1F_EventScript_RanFromMewtwo)
    }
    setflag(FLAG_FOUGHT_MEWTWO)
    release
    end
}

script CeruleanCave_B1F_EventScript_DefeatedMewtwo {
    setflag(FLAG_FOUGHT_MEWTWO)
    goto(EventScript_RemoveStaticMon)
    end
}

script CeruleanCave_B1F_EventScript_RanFromMewtwo {
    setvar(VAR_0x8004, SPECIES_MEWTWO)
    goto(EventScript_MonFlewAway)
    end
}

text CeruleanCave_B1F_Text_Mew {
    "Mew!$"
}
