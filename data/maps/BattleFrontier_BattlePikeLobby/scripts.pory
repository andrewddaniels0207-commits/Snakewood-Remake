	setvar VAR_TEMP_CHALLENGE_STATUS, 255
# 180 "data/maps/BattleFrontier_BattlePikeLobby/scripts.pory"
	pike_savehelditems
# 181 "data/maps/BattleFrontier_BattlePikeLobby/scripts.pory"
