mapscripts SeafoamIslands_B3F_Frlg_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: SeafoamIslands_B3F_OnTransition
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_1, 1: SeafoamIslands_B3F_EventScript_EnterByFalling
    ]
}

script SeafoamIslands_B3F_OnTransition {
    if (!flag(FLAG_STOPPED_SEAFOAM_B3F_CURRENT)) call(SeafoamIslands_B3F_EventScript_CheckStoppedCurrent)
    if (flag(FLAG_STOPPED_SEAFOAM_B3F_CURRENT)) call(SeafoamIslands_B3F_EventScript_SetNoCurrentLayout)
    end
}

script SeafoamIslands_B3F_EventScript_CheckStoppedCurrent {
    setvar(NUM_BOULDERS_PRESENT, 0)
    if (!flag(FLAG_HIDE_SEAFOAM_B3F_BOULDER_1)) call(SeafoamIslands_B3F_EventScript_AddBoulderPresent)
    if (!flag(FLAG_HIDE_SEAFOAM_B3F_BOULDER_2)) call(SeafoamIslands_B3F_EventScript_AddBoulderPresent)
    if (var(NUM_BOULDERS_PRESENT) == 2) call(SeafoamIslands_B3F_EventScript_StoppedCurrent)
    return
}

script SeafoamIslands_B3F_EventScript_StoppedCurrent {
    setflag(FLAG_STOPPED_SEAFOAM_B3F_CURRENT)
    return
}

script SeafoamIslands_B3F_EventScript_SetNoCurrentLayout {
    setmaplayoutindex(LAYOUT_SEAFOAM_ISLANDS_B3F_CURRENT_STOPPED)
    return
}

script SeafoamIslands_B3F_EventScript_EnterByFalling {
    lockall
    setvar(NUM_BOULDERS_PRESENT, 0)
    if (!flag(FLAG_HIDE_SEAFOAM_B3F_BOULDER_1)) call(SeafoamIslands_B3F_EventScript_AddBoulderPresent)
    if (!flag(FLAG_HIDE_SEAFOAM_B3F_BOULDER_2)) call(SeafoamIslands_B3F_EventScript_AddBoulderPresent)
    if (var(NUM_BOULDERS_PRESENT) == 2) goto(SeafoamIslands_B3F_EventScript_CurrentBlocked)
    getplayerxy(VAR_0x8008, VAR_0x8009)
    if (var(VAR_0x8008) < 24) call(SeafoamIslands_B3F_EventScript_RideCurrentFar)
    if (var(VAR_0x8008) >= 24) call(SeafoamIslands_B3F_EventScript_RideCurrentClose)
    setvar(VAR_MAP_SCENE_SEAFOAM_ISLANDS_B4F, 1)
    warp(MAP_SEAFOAM_ISLANDS_B4F, 27, 21)
    waitstate
    releaseall
    end
}

script SeafoamIslands_B3F_EventScript_AddBoulderPresent {
    addvar(NUM_BOULDERS_PRESENT, 1)
    return
}

script SeafoamIslands_B3F_EventScript_RideCurrentFar {
    applymovement(LOCALID_PLAYER, SeafoamIslands_B3F_Movement_RideCurrentFar)
    waitmovement(0)
    return
}

script SeafoamIslands_B3F_EventScript_RideCurrentClose {
    applymovement(LOCALID_PLAYER, SeafoamIslands_B3F_Movement_RideCurrentClose)
    waitmovement(0)
    return
}

script SeafoamIslands_B3F_EventScript_CurrentBlocked {
    setvar(VAR_TEMP_1, 0)
    releaseall
    end
}

movement SeafoamIslands_B3F_Movement_RideCurrentFar {
    walk_fast_down
    walk_fast_down
    walk_fast_down
    walk_fast_down
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_down
    walk_fast_down
    walk_fast_down
    walk_fast_down
    walk_fast_down
    walk_fast_down
    step_end
}

movement SeafoamIslands_B3F_Movement_RideCurrentClose {
    walk_fast_down
    walk_fast_down
    walk_fast_down
    walk_fast_down
    walk_fast_right
    walk_fast_right
    walk_fast_down
    walk_fast_down
    walk_fast_down
    walk_fast_down
    walk_fast_down
    walk_fast_down
    step_end
}
