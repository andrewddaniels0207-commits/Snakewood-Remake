mapscripts Route101_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Route101_OnTransition
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_ROUTE101_STATE, 0: Route101_EventScript_HideMapNamePopup
    ]
}

script Route101_OnTransition {
    end
}

script Route101_EventScript_HideMapNamePopup {
    setflag(FLAG_HIDE_MAP_NAME_POPUP)
    setvar(VAR_ROUTE101_STATE, 1)
    end
}

// ------------------------------------------------------------
// Birch Rescue Scene
// Triggered when player walks north into the scene
// ------------------------------------------------------------

script Route101_EventScript_StartBirchRescue {
    lockall
    playbgm(MUS_HELP, TRUE)
    msgbox("Placeholder: Birch crying for help.$")
    closemessage
    applymovement(LOCALID_PLAYER, Route101_Movement_EnterScene)
    waitmovement(0)
    applymovement(LOCALID_ROUTE101_BIRCH, Route101_Movement_BirchRunAway)
    applymovement(LOCALID_ROUTE101_ZOMBIE, Route101_Movement_ZombieChase)
    waitmovement(0)
    applymovement(LOCALID_ROUTE101_ZOMBIE, Route101_Movement_ZombieChaseInCircles)
    applymovement(LOCALID_ROUTE101_BIRCH, Route101_Movement_BirchRunInCircles)
    waitmovement(0)
    applymovement(LOCALID_ROUTE101_ZOMBIE, Route101_Movement_ZombieFaceBirch)
    applymovement(LOCALID_ROUTE101_BIRCH, Route101_Movement_BirchFaceZombie)
    waitmovement(0)
    msgbox("Placeholder: Birch pleads for help.$")
    closemessage
    setvar(VAR_ROUTE101_STATE, 2)
    releaseall
    end
}

// ------------------------------------------------------------
// Exit blockers while Birch needs help
// ------------------------------------------------------------

script Route101_EventScript_PreventExitSouth {
    lockall
    msgbox("Placeholder: Don't leave me.$")
    closemessage
    applymovement(LOCALID_PLAYER, Route101_Movement_PreventExitSouth)
    waitmovement(0)
    releaseall
    end
}

script Route101_EventScript_PreventExitWest {
    lockall
    msgbox("Placeholder: Don't leave me.$")
    closemessage
    applymovement(LOCALID_PLAYER, Route101_Movement_PreventExitWest)
    waitmovement(0)
    releaseall
    end
}

script Route101_EventScript_PreventExitNorth {
    lockall
    msgbox("Placeholder: Don't leave me.$")
    closemessage
    applymovement(LOCALID_PLAYER, Route101_Movement_PreventExitNorth)
