movement Route101_Movement_PreventExitSouth {
    walk_up
}

movement Route101_Movement_PreventExitWest {
    walk_right
}

movement Route101_Movement_PreventExitNorth {
    walk_down
}

// ------------------------------------------------------------
// Zombie Trainer Battle
// Player interacts with zombie to trigger battle
// ------------------------------------------------------------

script Route101_EventScript_ZombieTrainer {
    lockall
    applymovement(LOCALID_ROUTE101_ZOMBIE, Common_Movement_WalkInPlaceFasterRight)
    waitmovement(0)
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterLeft)
    waitmovement(0)
    msgbox("Placeholder: Zombie trainer intro.$")
    closemessage
    trainerbattle_single(TRAINER_MAY_ROUTE_103_TREECKO, "Placeholder: Zombie intro.$", "Placeholder: Zombie defeat text.$")
    applymovement(LOCALID_ROUTE101_BIRCH, Route101_Movement_BirchApproachPlayer)
    waitmovement(0)
    msgbox("Thx lets go to Oldale$")
    closemessage
    special(HealPlayerParty)
    setflag(FLAG_HIDE_ROUTE_101_BIRCH_ZIGZAGOON_BATTLE)
    setflag(FLAG_HIDE_ROUTE_101_BIRCH_STARTERS_BAG)
    setvar(VAR_BIRCH_LAB_STATE, 2)
    setvar(VAR_ROUTE101_STATE, 3)
    setvar(VAR_SNAKEWOOD_INTRO_STATE, 2)
    clearflag(FLAG_HIDE_MAP_NAME_POPUP)
    warp(MAP_OLDALE_TOWN, 6, 17)
    waitstate
    releaseall
    end
}

// ------------------------------------------------------------
// Movements
// ------------------------------------------------------------

movement Route101_Movement_EnterScene {
    walk_in_place_faster_up
    walk_in_place_faster_left
}

// Birch starts x=5,y=14 — runs right along the bottom of the map
movement Route101_Movement_BirchRunAway {
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_down
    walk_fast_left
    walk_fast_left
    walk_fast_left
    walk_fast_left
    walk_fast_up
}

// Zombie starts x=6,y=14 — chases Birch right then circles
movement Route101_Movement_ZombieChase {
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_down
    walk_fast_left
    walk_fast_left
    walk_fast_left
    walk_fast_left
    walk_fast_up
}

// Zombie circles Birch horizontally — stays in y=14–16
movement Route101_Movement_ZombieChaseInCircles {
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_down
    walk_fast_left
    walk_fast_left
    walk_fast_left
    walk_fast_up
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_down
    walk_fast_left
    walk_fast_left
    walk_fast_left
    walk_fast_up
}

// Birch circles away from zombie — stays in y=14–16
movement Route101_Movement_BirchRunInCircles {
    walk_fast_left
    walk_fast_left
    walk_fast_left
    walk_fast_down
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_up
    walk_fast_left
    walk_fast_left
    walk_fast_left
    walk_fast_down
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_up
}

// End position: Zombie faces left toward Birch
movement Route101_Movement_ZombieFaceBirch {
    walk_in_place_faster_left
}

// End position: Birch faces right toward Zombie
movement Route101_Movement_BirchFaceZombie {
    walk_in_place_faster_right
}

movement Route101_Movement_BirchApproachPlayer {
    walk_right
}

