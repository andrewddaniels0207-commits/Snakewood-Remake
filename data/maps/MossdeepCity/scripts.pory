mapscripts MossdeepCity_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: MossdeepCity_OnTransition
}

script MossdeepCity_OnTransition {
    clearflag(FLAG_MOSSDEEP_GYM_SWITCH_1)
    clearflag(FLAG_MOSSDEEP_GYM_SWITCH_2)
    clearflag(FLAG_MOSSDEEP_GYM_SWITCH_3)
    clearflag(FLAG_MOSSDEEP_GYM_SWITCH_4)
    if (flag(FLAG_SYS_WEATHER_CTRL)) {
        call(Common_EventScript_SetAbnormalWeather)
    }
    end
}

script MossdeepCity_EventScript_PokefanF {
    lock
    faceplayer
    if (flag(FLAG_RECEIVED_HM_DIVE)) {
        goto(MossdeepCity_EventScript_PokefanFMagmaGone)
    }
    msgbox(MossdeepCity_Text_SpaceCenterReceivedLetter, MSGBOX_DEFAULT)
    release
    end
}

script MossdeepCity_EventScript_PokefanFMagmaGone {
    msgbox(MossdeepCity_Text_SpaceCenterLaunchingRockets, MSGBOX_DEFAULT)
    release
    end
}

