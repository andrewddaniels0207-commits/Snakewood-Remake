mapscripts CeladonCity_Condominiums_RoofRoom_Frlg_MapScripts {}

script CeladonCity_Condominiums_RoofRoom_EventScript_BlackBelt {
    msgbox(CeladonCity_Condominiums_RoofRoom_Text_TheresNothingIDontKnow, MSGBOX_NPC)
    end
}

script CeladonCity_Condominiums_RoofRoom_EventScript_EeveeBall {
    lock
    faceplayer
    setvar(VAR_TEMP_1, SPECIES_EEVEE)
    givemon(SPECIES_EEVEE, 25)
    if (var(VAR_RESULT) == 0) {
        goto(CeladonCity_Condominiums_RoofRoom_EventScript_GetEeveeParty)
    }
    if (var(VAR_RESULT) == 1) {
        goto(CeladonCity_Condominiums_RoofRoom_EventScript_GetEeveePC)
    }
    if (var(VAR_RESULT) == 2) {
        goto(Common_EventScript_NoMoreRoomForPokemon)
    }
    release
    end
}

script CeladonCity_Condominiums_RoofRoom_EventScript_GetEeveeParty {
    removeobject(LOCALID_EEVEE_POKEBALL)
    playfanfare(MUS_LEVEL_UP)
    message(CeladonCity_Condominiums_RoofRoom_Text_ObtainedAnEevee)
    waitmessage()
    waitfanfare()
    bufferspeciesname(STR_VAR_1, SPECIES_EEVEE)
    msgbox(gText_NicknameThisPokemon, MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        goto(CeladonCity_Condominiums_RoofRoom_EventScript_SetGotEevee)
    }
    call(Common_EventScript_GetGiftMonPartySlot)
    call(Common_EventScript_NameReceivedPartyMon)
    goto(CeladonCity_Condominiums_RoofRoom_EventScript_SetGotEevee)
    end
}

script CeladonCity_Condominiums_RoofRoom_EventScript_GetEeveePC {
    removeobject(LOCALID_EEVEE_POKEBALL)
    playfanfare(MUS_LEVEL_UP)
    message(CeladonCity_Condominiums_RoofRoom_Text_ObtainedAnEevee)
    waitmessage()
    waitfanfare()
    bufferspeciesname(STR_VAR_1, SPECIES_EEVEE)
    msgbox(gText_NicknameThisPokemon, MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        goto(CeladonCity_Condominiums_RoofRoom_EventScript_TransferEeveeToPC)
    }
    call(Common_EventScript_NameReceivedBoxMon)
    goto(CeladonCity_Condominiums_RoofRoom_EventScript_TransferEeveeToPC)
    end
}

script CeladonCity_Condominiums_RoofRoom_EventScript_TransferEeveeToPC {
    call(Common_EventScript_TransferredToPC)
    goto(CeladonCity_Condominiums_RoofRoom_EventScript_SetGotEevee)
    end
}

script CeladonCity_Condominiums_RoofRoom_EventScript_SetGotEevee {
    setflag(FLAG_GOT_EEVEE)
    release
    end
}

script CeladonCity_Condominiums_RoofRoom_EventScript_TMsPamphlet {
    msgbox(CeladonCity_Condominiums_RoofRoom_Text_PamphletOnTMs, MSGBOX_SIGN)
    end
}

script CeladonCity_Condominiums_RoofRoom_EventScript_Blackboard {
    lockall
    msgbox(CeladonCity_Condominiums_RoofRoom_Text_WirelessAdapterLecture)
    message(CeladonCity_Condominiums_RoofRoom_Text_ReadWhichHeading)
    waitmessage()
    setvar(VAR_0x8004, 4)
    multichoice(0, 0, MULTI_LINKED_DIRECT_UNION, FALSE)
    switch(VAR_RESULT)
    case(0, CeladonCity_Condominiums_RoofRoom_EventScript_WirelessClub)
    case(1, CeladonCity_Condominiums_RoofRoom_EventScript_DirectCorner)
    case(2, CeladonCity_Condominiums_RoofRoom_EventScript_UnionRoom)
    case(3, CeladonCity_Condominiums_RoofRoom_EventScript_ExitBlackboard)
    case(127, CeladonCity_Condominiums_RoofRoom_EventScript_ExitBlackboard)
    end
}

script CeladonCity_Condominiums_RoofRoom_EventScript_ReadAnotherHeading {
    message(CeladonCity_Condominiums_RoofRoom_Text_ReadWhichHeading)
    waitmessage()
    multichoice(0, 0, MULTI_LINKED_DIRECT_UNION, FALSE)
    switch(VAR_RESULT)
    case(0, CeladonCity_Condominiums_RoofRoom_EventScript_WirelessClub)
    case(1, CeladonCity_Condominiums_RoofRoom_EventScript_DirectCorner)
    case(2, CeladonCity_Condominiums_RoofRoom_EventScript_UnionRoom)
    case(3, CeladonCity_Condominiums_RoofRoom_EventScript_ExitBlackboard)
    case(127, CeladonCity_Condominiums_RoofRoom_EventScript_ExitBlackboard)
    end
}

script CeladonCity_Condominiums_RoofRoom_EventScript_WirelessClub {
    msgbox(CeladonCity_Condominiums_RoofRoom_Text_ExplainWirelessClub)
    goto(CeladonCity_Condominiums_RoofRoom_EventScript_ReadAnotherHeading)
    end
}

script CeladonCity_Condominiums_RoofRoom_EventScript_DirectCorner {
    msgbox(CeladonCity_Condominiums_RoofRoom_Text_ExplainDirectCorner)
    goto(CeladonCity_Condominiums_RoofRoom_EventScript_ReadAnotherHeading)
    end
}

script CeladonCity_Condominiums_RoofRoom_EventScript_UnionRoom {
    msgbox(CeladonCity_Condominiums_RoofRoom_Text_ExplainUnionRoom)
    goto(CeladonCity_Condominiums_RoofRoom_EventScript_ReadAnotherHeading)
    end
}

script CeladonCity_Condominiums_RoofRoom_EventScript_ExitBlackboard {
    releaseall
    end
}

text CeladonCity_Condominiums_RoofRoom_Text_TheresNothingIDontKnow {
    "There is nothing that I don't know,\n"
    "like I wrote on the blackboard.\p"
    "I know about the world of POKéMON\n"
    "in your GAME BOY ADVANCE!\p"
    "Get together with your friends and\n"
    "enjoy trading POKéMON!$"
}

text CeladonCity_Condominiums_RoofRoom_Text_ObtainedAnEevee {
    "{PLAYER} obtained an EEVEE!$"
}

text CeladonCity_Condominiums_RoofRoom_Text_BoxIsFull {
    "ポケモンが　いっぱいだ\n"
    "ボックスを　かえて　きなさい$"
}

text CeladonCity_Condominiums_RoofRoom_Text_WirelessAdapterLecture {
    "POKéMON Lecture\p"
    "Playing with the Wireless Adapter$"
}

text CeladonCity_Condominiums_RoofRoom_Text_ReadWhichHeading {
    "Which heading do you want to read?$"
}

text CeladonCity_Condominiums_RoofRoom_Text_ExplainWirelessClub {
    "The POKéMON WIRELESS CLUB is\n"
    "upstairs at any POKéMON CENTER.\p"
    "Visit one to link up with friend(s)\n"
    "using your Wireless Adapter.$"
}

text CeladonCity_Condominiums_RoofRoom_Text_ExplainDirectCorner {
    "To link only with a friend, go to\n"
    "the DIRECT CORNER.\p"
    "It is the right counter at the\n"
    "POKéMON WIRELESS CLUB.\p"
    "Go into the TRADE CORNER or the\n"
    "COLOSSEUM with your friend.$"
}

text CeladonCity_Condominiums_RoofRoom_Text_ExplainUnionRoom {
    "To link and communicate with\n"
    "anyone, go to the UNION ROOM.\p"
    "It is the left counter at the\n"
    "POKéMON WIRELESS CLUB.\p"
    "Go to the UNION ROOM and enjoy\n"
    "meeting other TRAINERS.$"
}

text CeladonCity_Condominiums_RoofRoom_Text_PamphletOnTMs {
    "It's a pamphlet on TMs.\p"
    "… …\p"
    "There are fifty TMs in all.\p"
    "There are also seven HMs that\n"
    "can be used repeatedly.\p"
    "SILPH CO.$"
}
