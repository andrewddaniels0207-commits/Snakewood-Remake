script BattleFrontier_BattleArenaBattleRoom_EventScript_SetPlayerGfxMale {
    #(33 "data/maps/BattleFrontier_BattleArenaBattleRoom/scripts.pory")
    setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_RIVAL_BRENDAN_NORMAL)
    return
}

script BattleFrontier_BattleArenaBattleRoom_EventScript_SetPlayerGfxFemale {
    #(38 "data/maps/BattleFrontier_BattleArenaBattleRoom/scripts.pory")
