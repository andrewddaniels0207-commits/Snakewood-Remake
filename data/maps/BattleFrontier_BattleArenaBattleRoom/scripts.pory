mapscripts BattleFrontier_BattleArenaBattleRoom_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: BattleFrontier_BattleArenaBattleRoom_OnTransition
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE: BattleFrontier_BattleArenaBattleRoom_OnWarp
    MAP_SCRIPT_ON_RESUME: BattleFrontier_BattleArenaBattleRoom_OnResume
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_0, 0: BattleFrontier_BattleArenaBattleRoom_EventScript_EnterRoom
    ]
}

script BattleFrontier_BattleArenaBattleRoom_OnResume {
    #(11 "data/maps/BattleFrontier_BattleArenaBattleRoom/scripts.pory")
    special(OffsetCameraForBattle)
    end
}

script BattleFrontier_BattleArenaBattleRoom_OnTransition {
    #(16 "data/maps/BattleFrontier_BattleArenaBattleRoom/scripts.pory")
    frontier_settrainers()
    #(17 "data/maps/BattleFrontier_BattleArenaBattleRoom/scripts.pory")
    call(BattleFrontier_BattleArenaBattleRoom_EventScript_SetPlayerGfx)
    end
}

script BattleFrontier_BattleArenaBattleRoom_EventScript_SetPlayerGfx {
    #(22 "data/maps/BattleFrontier_BattleArenaBattleRoom/scripts.pory")
    checkplayergender()
    #(23 "data/maps/BattleFrontier_BattleArenaBattleRoom/scripts.pory")
    compare(VAR_RESULT, MALE)
    goto_if_eq(BattleFrontier_BattleArenaBattleRoom_EventScript_SetPlayerGfx_2)
}

script BattleFrontier_BattleArenaBattleRoom_EventScript_SetPlayerGfx_1 {
    #(26 "data/maps/BattleFrontier_BattleArenaBattleRoom/scripts.pory")
    compare(VAR_RESULT, FEMALE)
    goto_if_eq(BattleFrontier_BattleArenaBattleRoom_EventScript_SetPlayerGfx_5)
}

script BattleFrontier_BattleArenaBattleRoom_EventScript_SetPlayerGfx_4 {
    return
}

script BattleFrontier_BattleArenaBattleRoom_EventScript_SetPlayerGfx_2 {
    #(24 "data/maps/BattleFrontier_BattleArenaBattleRoom/scripts.pory")
