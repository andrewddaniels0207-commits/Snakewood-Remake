script LilycoveCity_DepartmentStoreElevator_EventScript_ExitFloorSelect {
    special(CloseDeptStoreElevatorWindow)
    release
    end
}

script LilycoveCity_DepartmentStoreElevator_EventScript_MoveElevator {
    special(CloseDeptStoreElevatorWindow)
    closemessage
    applymovement(VAR_LAST_TALKED, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    waitse()
    special(MoveElevator)
    waitstate
    setflag(FLAG_TEMP_2)
    return
}

script LilycoveCity_DepartmentStoreElevator_EventScript_SetFloor {
    special(SetDeptStoreFloor)
    return
}
