mapscripts SixIsland_Mart_Frlg_MapScripts {}

script SixIsland_Mart_EventScript_Clerk {
    lock
    faceplayer
    message(gText_HowMayIServeYou)
    waitmessage()
    pokemart(SixIsland_Mart_Items)
    msgbox(gText_PleaseComeAgain)
    release
    end
}

script SixIsland_Mart_Items {
    release
    end
}

script SixIsland_Mart_EventScript_Picnicker {
    msgbox(SixIsland_Mart_Text_ShouldBuyMailAndWriteLetter, MSGBOX_NPC)
    end
}

text SixIsland_Mart_Text_AgathaOldestEverEliteFourMember {
    "Play with POKéMON lots and live\n"
    "a long life!\p"
    "Take AGATHA, for example.\p"
    "She set a record for being the\n"
    "oldest-ever ELITE FOUR member.\p"
    "She spurs me to do bigger things.$"
}

text SixIsland_Mart_Text_ShouldBuyMailAndWriteLetter {
    "I should buy some MAIL and write\n"
    "him a letter…$"
}
