mapscripts RustboroCity_PokemonSchool_MapScripts {}

script RustboroCity_PokemonSchool_EventScript_Blackboard {
    lockall
    msgbox(RustboroCity_PokemonSchool_Text_BlackboardListsStatusChanges, MSGBOX_DEFAULT)
    goto(RustboroCity_PokemonSchool_EventScript_ChooseBlackboardTopic)
    end
}

script RustboroCity_PokemonSchool_EventScript_ChooseBlackboardTopic {
    message(RustboroCity_PokemonSchool_Text_ReadWhichTopic)
    waitmessage()
    multichoicegrid(8, 1, MULTI_STATUS_INFO, 3, FALSE)
    switch(VAR_RESULT)
    case(0, RustboroCity_PokemonSchool_EventScript_Poison)
    case(1, RustboroCity_PokemonSchool_EventScript_Paralysis)
    case(2, RustboroCity_PokemonSchool_EventScript_Sleep)
    case(3, RustboroCity_PokemonSchool_EventScript_Burn)
    case(4, RustboroCity_PokemonSchool_EventScript_Freeze)
    case(5, RustboroCity_PokemonSchool_EventScript_ExitTopicSelect)
    case(MULTI_B_PRESSED, RustboroCity_PokemonSchool_EventScript_ExitTopicSelect)
    end
}

script RustboroCity_PokemonSchool_EventScript_Poison {
    msgbox(RustboroCity_PokemonSchool_Text_ExplainPoison, MSGBOX_DEFAULT)
    goto(RustboroCity_PokemonSchool_EventScript_ChooseBlackboardTopic)
    end
}

script RustboroCity_PokemonSchool_EventScript_Paralysis {
    msgbox(RustboroCity_PokemonSchool_Text_ExplainParalysis, MSGBOX_DEFAULT)
    goto(RustboroCity_PokemonSchool_EventScript_ChooseBlackboardTopic)
    end
}

script RustboroCity_PokemonSchool_EventScript_Sleep {
    msgbox(RustboroCity_PokemonSchool_Text_ExplainSleep, MSGBOX_DEFAULT)
    goto(RustboroCity_PokemonSchool_EventScript_ChooseBlackboardTopic)
    end
}

script RustboroCity_PokemonSchool_EventScript_Burn {
    msgbox(RustboroCity_PokemonSchool_Text_ExplainBurn, MSGBOX_DEFAULT)
    goto(RustboroCity_PokemonSchool_EventScript_ChooseBlackboardTopic)
    end
}

script RustboroCity_PokemonSchool_EventScript_Freeze {
    msgbox(RustboroCity_PokemonSchool_Text_ExplainFreeze, MSGBOX_DEFAULT)
    goto(RustboroCity_PokemonSchool_EventScript_ChooseBlackboardTopic)
    end
}

script RustboroCity_PokemonSchool_EventScript_ExitTopicSelect {
    releaseall
    end
}

script RustboroCity_PokemonSchool_EventScript_GameboyKid1 {
    msgbox(RustboroCity_PokemonSchool_Text_TradingRightNow, MSGBOX_NPC)
    end
}

script RustboroCity_PokemonSchool_EventScript_GameboyKid2 {
    msgbox(RustboroCity_PokemonSchool_Text_AlwaysWantedSeedot, MSGBOX_NPC)
    end
}

script RustboroCity_PokemonSchool_EventScript_RichBoy {
    msgbox(RustboroCity_PokemonSchool_Text_PokemontCantUseManMadeItems, MSGBOX_NPC)
    end
}

script RustboroCity_PokemonSchool_EventScript_Lass {
    msgbox(RustboroCity_PokemonSchool_Text_ConfusedPokemonAttacksItself, MSGBOX_NPC)
    end
}

script RustboroCity_PokemonSchool_EventScript_SchoolKidM {
    msgbox(RustboroCity_PokemonSchool_Text_PokemonHealItselfWithBerry, MSGBOX_NPC)
    end
}

script RustboroCity_PokemonSchool_EventScript_StudentNotebook {
    msgbox(RustboroCity_PokemonSchool_Text_StudentsNotes, MSGBOX_SIGN)
    end
}

script RustboroCity_PokemonSchool_EventScript_Teacher {
    lock
    faceplayer
    if (flag(FLAG_RECEIVED_QUICK_CLAW)) {
        goto(RustboroCity_PokemonSchool_EventScript_GaveQuickClaw)
    }
    if (var(VAR_FACING) == DIR_EAST) {
        call(RustboroCity_PokemonSchool_EventScript_TeacherCheckOnStudentsEast)
    }
    if (var(VAR_FACING) == DIR_WEST) {
        call(RustboroCity_PokemonSchool_EventScript_TeacherCheckOnStudentsWest)
    }
    msgbox(RustboroCity_PokemonSchool_Text_StudentsWhoDontStudyGetQuickClaw, MSGBOX_DEFAULT)
    giveitem(ITEM_QUICK_CLAW)
    if (var(VAR_RESULT) == 0) {
        goto(Common_EventScript_ShowBagIsFull)
    }
    closemessage
    applymovement(VAR_LAST_TALKED, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    setflag(FLAG_RECEIVED_QUICK_CLAW)
    release
    end
}

script RustboroCity_PokemonSchool_EventScript_TeacherCheckOnStudentsEast {
    applymovement(VAR_LAST_TALKED, RustboroCity_PokemonSchool_Movement_TeacherCheckOnStudentsEast)
    waitmovement(0)
    return
}

script RustboroCity_PokemonSchool_EventScript_TeacherCheckOnStudentsWest {
    applymovement(VAR_LAST_TALKED, RustboroCity_PokemonSchool_Movement_TeacherCheckOnStudentsWest)
    waitmovement(0)
    return
}

script RustboroCity_PokemonSchool_EventScript_GaveQuickClaw {
    msgbox(RustboroCity_PokemonSchool_Text_ExplainQuickClaw, MSGBOX_DEFAULT)
    closemessage
    applymovement(VAR_LAST_TALKED, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    release
    end
}

movement RustboroCity_PokemonSchool_Movement_TeacherCheckOnStudentsWest {
    walk_left
    walk_down
    walk_down
    walk_right
    walk_in_place_faster_down
    delay_16
    delay_16
    delay_16
    walk_down
    walk_in_place_faster_left
    delay_16
    delay_16
    walk_right
    delay_16
    delay_16
    delay_8
    walk_up
    walk_left
    walk_left
    walk_up
    walk_up
    walk_right
    step_end
}

movement RustboroCity_PokemonSchool_Movement_TeacherCheckOnStudentsEast {
    walk_right
    walk_right
    walk_down
    walk_down
    walk_left
    walk_left
    walk_in_place_faster_down
    delay_16
    delay_16
    delay_16
    walk_down
    walk_in_place_faster_left
    delay_16
    delay_16
    walk_right
    delay_16
    delay_16
    delay_8
    walk_up
    walk_right
    walk_up
    walk_up
    walk_left
    walk_left
    step_end
}

script RustboroCity_PokemonSchool_EventScript_Scott {
    lock
    faceplayer
    if (flag(FLAG_MET_SCOTT_AFTER_OBTAINING_STONE_BADGE)) {
        goto(RustboroCity_PokemonSchool_EventScript_ScottWatchStudents)
    }
    if (flag(FLAG_MET_SCOTT_RUSTBORO)) {
        goto(RustboroCity_PokemonSchool_EventScript_ScottSpokeAlready)
    }
    if (flag(FLAG_BADGE01_GET)) {
        goto(RustboroCity_PokemonSchool_EventScript_ScottGreetHasBadge)
    }
    msgbox(RustboroCity_PokemonSchool_Text_ScottMetAlreadyCut, MSGBOX_DEFAULT)
    addvar(VAR_SCOTT_STATE, 1)
    setflag(FLAG_MET_SCOTT_RUSTBORO)
    release
    end
}

script RustboroCity_PokemonSchool_EventScript_ScottSpokeAlready {
    if (flag(FLAG_BADGE01_GET)) {
        goto(RustboroCity_PokemonSchool_EventScript_ScottNoticeBadge)
    }
    msgbox(RustboroCity_PokemonSchool_Text_StudentTalentLevelUnknown, MSGBOX_DEFAULT)
    release
    end
}

script RustboroCity_PokemonSchool_EventScript_ScottGreetHasBadge {
    msgbox(RustboroCity_PokemonSchool_Text_ScottMetAlreadyStoneBadge, MSGBOX_DEFAULT)
    goto(RustboroCity_PokemonSchool_EventScript_MetScottAfterBadge)
    end
}

script RustboroCity_PokemonSchool_EventScript_ScottNoticeBadge {
    msgbox(RustboroCity_PokemonSchool_Text_ScottStoneBadge, MSGBOX_DEFAULT)
    goto(RustboroCity_PokemonSchool_EventScript_MetScottAfterBadge)
    end
}

script RustboroCity_PokemonSchool_EventScript_MetScottAfterBadge {
    addvar(VAR_SCOTT_STATE, 1)
    setflag(FLAG_MET_SCOTT_AFTER_OBTAINING_STONE_BADGE)
    release
    end
}

script RustboroCity_PokemonSchool_EventScript_ScottWatchStudents {
    msgbox(RustboroCity_PokemonSchool_Text_StudentTalentLevelUnknown, MSGBOX_DEFAULT)
    release
    end
}

text RustboroCity_PokemonSchool_Text_BlackboardListsStatusChanges {
    "The blackboard lists status changes\n"
    "that may affect POKéMON in battle.$"
}

text RustboroCity_PokemonSchool_Text_ReadWhichTopic {
    "Which topic do you want to read?$"
}

text RustboroCity_PokemonSchool_Text_ExplainPoison {
    "If a POKéMON is poisoned, it will\n"
    "steadily lose HP.\p"
    "The effects of poison remain after\n"
    "a battle.\p"
    "A poisoned POKéMON's HP will drop\n"
    "while it is traveling.\p"
    "Heal a poisoning using an ANTIDOTE.$"
}

text RustboroCity_PokemonSchool_Text_ExplainParalysis {
    "If a POKéMON becomes paralyzed,\n"
    "its SPEED drops.\p"
    "It may also not be able to move while\n"
    "it is in battle.\p"
    "Paralysis remains after battle.\n"
    "Cure it using a PARLYZ HEAL.$"
}

text RustboroCity_PokemonSchool_Text_ExplainSleep {
    "If a POKéMON falls asleep, it will be\n"
    "unable to attack.\p"
    "A POKéMON may wake up on its own,\n"
    "but if a battle ends while it is\l"
    "sleeping, it will stay asleep.\p"
    "Wake it up using an AWAKENING.$"
}

text RustboroCity_PokemonSchool_Text_ExplainBurn {
    "A burn reduces ATTACK power, and it\n"
    "steadily reduces the victim's HP.\p"
    "A burn lingers after battle.\n"
    "Cure a burn using a BURN HEAL.$"
}

text RustboroCity_PokemonSchool_Text_ExplainFreeze {
    "If a POKéMON is frozen, it becomes\n"
    "completely helpless.\p"
    "It will remain frozen after battle.\n"
    "Thaw it out using an ICE HEAL.$"
}

text RustboroCity_PokemonSchool_Text_StudentsWhoDontStudyGetQuickClaw {
    "Students who don't study get a little\n"
    "taste of my QUICK CLAW.\p"
    "Whether or not you are a good student \n"
    "will be evident from the way you use\l"
    "this item.$"
}

text RustboroCity_PokemonSchool_Text_ExplainQuickClaw {
    "A POKéMON holding the QUICK CLAW will\n"
    "occasionally speed up and get to move\l"
    "before its opponent.\p"
    "There are many other items that are\n"
    "meant to be held by POKéMON.\p"
    "Just those alone will give you many\n"
    "topics to study!$"
}

text RustboroCity_PokemonSchool_Text_TradingRightNow {
    "I'm trading POKéMON with my friend\n"
    "right now.$"
}

text RustboroCity_PokemonSchool_Text_AlwaysWantedSeedot {
    "I always wanted a SEEDOT, and\n"
    "I'm finally getting one!$"
}

text RustboroCity_PokemonSchool_Text_PokemontCantUseManMadeItems {
    "POKéMON can hold items, but they\n"
    "don't know what to do with man-made\l"
    "items like POTION and ANTIDOTE.$"
}

text RustboroCity_PokemonSchool_Text_ConfusedPokemonAttacksItself {
    "You know how some POKéMON moves can\n"
    "confuse a POKéMON?\p"
    "A confused POKéMON will sometimes\n"
    "attack itself without meaning to.\p"
    "But once it leaves battle, it will\n"
    "return to normal.$"
}

text RustboroCity_PokemonSchool_Text_PokemonHealItselfWithBerry {
    "A POKéMON holding a BERRY will heal\n"
    "itself…\p"
    "There are many kinds of items that\n"
    "POKéMON can hold…\p"
    "Boy, it sure is hard taking notes\n"
    "down…$"
}

text RustboroCity_PokemonSchool_Text_StudentsNotes {
    "It's this student's notebook…\p"
    "POKéMON are to be caught using\n"
    "POKé BALLS.\p"
    "Up to six POKéMON can accompany\n"
    "a TRAINER.\p"
    "A TRAINER is someone who catches\n"
    "POKéMON, raises them, and battles\l"
    "with them.\p"
    "A TRAINER's mission is to defeat\n"
    "the strong TRAINERS who await\l"
    "challengers in POKéMON GYMS.$"
}

text RustboroCity_PokemonSchool_Text_ScottMetAlreadyCut {
    "Hello? Didn't we meet before?\n"
    "I think back in PETALBURG CITY.\p"
    "Let me introduce myself.\n"
    "My name's SCOTT.\p"
    "I've been traveling everywhere in\n"
    "search of outstanding TRAINERS.\p"
    "More specifically, I'm looking for\n"
    "POKéMON battle experts.\p"
    "So, what brings you to this SCHOOL?\n"
    "Are you a TRAINER, too?\p"
    "The first thing you should do is to\n"
    "have a POKéMON learn the move CUT.\p"
    "If I remember correctly, someone in\n"
    "this town has CUT.$"
}

text RustboroCity_PokemonSchool_Text_StudentTalentLevelUnknown {
    "SCOTT: Hmm…\p"
    "The talent levels of the students here\n"
    "are unknown. The potential's there.$"
}

text RustboroCity_PokemonSchool_Text_ScottStoneBadge {
    "SCOTT: Oh, what's that?\p"
    "It's a STONE BADGE, isn't it?\n"
    "That's pretty impressive, I'd say.\p"
    "But, you know, I would've loved to see\n"
    "you in battle.\p"
    "It's hard to tell what you're like as\n"
    "a TRAINER from a LEAGUE BADGE.$"
}

text RustboroCity_PokemonSchool_Text_ScottMetAlreadyStoneBadge {
    "Hello? Didn't we meet before?\n"
    "I think back in PETALBURG CITY.\p"
    "Let me introduce myself.\n"
    "My name's SCOTT.\p"
    "I've been traveling everywhere in\n"
    "search of outstanding TRAINERS.\p"
    "More specifically, I'm looking for\n"
    "POKéMON battle experts.\p"
    "Oh, what's that?\n"
    "It's a STONE BADGE, isn't it?\p"
    "That's pretty impressive, I'd say, for\n"
    "a starting TRAINER like yourself.\p"
    "But, you know, I would've loved to see\n"
    "you in battle.\p"
    "It's hard to tell what you're like as\n"
    "a TRAINER from a LEAGUE BADGE.$"
}
