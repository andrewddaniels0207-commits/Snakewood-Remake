mapscripts RustboroCity_Mart_MapScripts {}

script RustboroCity_Mart_EventScript_Clerk {
    lock
    faceplayer
    message(gText_HowMayIServeYou)
    waitmessage()
    if (!flag(FLAG_MET_DEVON_EMPLOYEE)) goto(RustboroCity_Mart_EventScript_PokemartBasic)
    if (flag(FLAG_MET_DEVON_EMPLOYEE)) goto(RustboroCity_Mart_EventScript_PokemartExpanded)
    end
}

script RustboroCity_Mart_EventScript_PokemartBasic {
    pokemart(RustboroCity_Mart_Pokemart_Basic)
    msgbox(gText_PleaseComeAgain, MSGBOX_DEFAULT)
    release
    end
}

script RustboroCity_Mart_Pokemart_Basic {
    pokemartlistend()
}

script RustboroCity_Mart_EventScript_PokemartExpanded {
    pokemart(RustboroCity_Mart_Pokemart_Expanded)
    msgbox(gText_PleaseComeAgain, MSGBOX_DEFAULT)
    release
    end
}

script RustboroCity_Mart_Pokemart_Expanded {
    pokemartlistend()
}

script RustboroCity_Mart_EventScript_PokefanF {
    msgbox(RustboroCity_Mart_Text_BuyingHealsInCaseOfShroomish, MSGBOX_NPC)
    end
}

script RustboroCity_Mart_EventScript_Boy {
    msgbox(RustboroCity_Mart_Text_ShouldBuySuperPotionsInstead, MSGBOX_NPC)
    end
}

script RustboroCity_Mart_EventScript_BugCatcher {
    msgbox(RustboroCity_Mart_Text_GettingEscapeRopeJustInCase, MSGBOX_NPC)
    end
}

text RustboroCity_Mart_Text_BuyingHealsInCaseOfShroomish {
    "I'm buying some PARLYZ HEALS and\n"
    "ANTIDOTES.\p"
    "Just in case I run into SHROOMISH\n"
    "in PETALBURG WOODS.$"
}

text RustboroCity_Mart_Text_ShouldBuySuperPotionsInstead {
    "My POKéMON evolved.\n"
    "It has a lot of HP now.\p"
    "I should buy SUPER POTIONS for it\n"
    "instead of ordinary POTIONS.$"
}

text RustboroCity_Mart_Text_GettingEscapeRopeJustInCase {
    "I'm getting an ESCAPE ROPE just in\n"
    "case I get lost in a cave.\p"
    "I just need to use it to get back to\n"
    "the entrance.$"
}
