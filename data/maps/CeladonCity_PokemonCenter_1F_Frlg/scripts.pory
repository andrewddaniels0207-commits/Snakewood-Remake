mapscripts CeladonCity_PokemonCenter_1F_Frlg_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: CeladonCity_PokemonCenter_1F_OnTransition
    MAP_SCRIPT_ON_RESUME: CableClub_OnResume
}

script CeladonCity_PokemonCenter_1F_OnTransition {
    setrespawn(HEAL_LOCATION_CELADON_CITY)
    end
}

script CeladonCity_PokemonCenter_1F_EventScript_Nurse {
    lock
    faceplayer
    call(EventScript_PkmnCenterNurse_Frlg)
    release
    end
}

script CeladonCity_PokemonCenter_1F_EventScript_Gentleman {
    msgbox(CeladonCity_PokemonCenter_1F_Text_PokeFluteAwakensSleepingMons, MSGBOX_NPC)
    end
}

script CeladonCity_PokemonCenter_1F_EventScript_CooltrainerF {
    msgbox(CeladonCity_PokemonCenter_1F_Text_RodeHereFromFuchsia, MSGBOX_NPC)
    end
}

script CeladonCity_PokemonCenter_1F_EventScript_Youngster {
    msgbox(CeladonCity_PokemonCenter_1F_Text_GoToCyclingRoadIfIHadBike, MSGBOX_NPC)
    end
}

text CeladonCity_PokemonCenter_1F_Text_PokeFluteAwakensSleepingMons {
    "A POKé FLUTE awakens sleeping\n"
    "POKéMON. You know that.\p"
    "It does so with a sound that only\n"
    "they can hear.$"
}

text CeladonCity_PokemonCenter_1F_Text_RodeHereFromFuchsia {
    "I rode here from FUCHSIA.\p"
    "It's an uphill ride on CYCLING\n"
    "ROAD, so I'm exhausted.$"
}

text CeladonCity_PokemonCenter_1F_Text_GoToCyclingRoadIfIHadBike {
    "If I had a BIKE, I would go to\n"
    "CYCLING ROAD!$"
}
