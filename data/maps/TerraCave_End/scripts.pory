raw `
TerraCave_End_MapScripts::
# 2 "data/maps/TerraCave_End/scripts.pory"
	map_script MAP_SCRIPT_ON_RESUME, TerraCave_End_OnResume
# 3 "data/maps/TerraCave_End/scripts.pory"
