mapscripts TerraCave_End_MapScripts {
    MAP_SCRIPT_ON_RESUME: TerraCave_End_OnResume
    MAP_SCRIPT_ON_TRANSITION: TerraCave_End_OnTransition
}

script TerraCave_End_OnResume {
    if (flag(FLAG_SYS_CTRL_OBJ_DELETE)) {
        call(TerraCave_End_EventScript_TryRemoveGroudon)
    }
    end
}

script TerraCave_End_EventScript_TryRemoveGroudon {
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) != B_OUTCOME_CAUGHT) {
        goto(Common_EventScript_NopReturn)
    }
    removeobject(LOCALID_TERRA_CAVE_GROUDON)
    return
}

script TerraCave_End_OnTransition {
    if (!flag(FLAG_DEFEATED_GROUDON)) {
        call(TerraCave_End_EventScript_ShowGroudon)
    }
    end
}

script TerraCave_End_EventScript_ShowGroudon {
    clearflag(FLAG_HIDE_TERRA_CAVE_GROUDON)
    setvar(VAR_TEMP_1, 1)
    return
}

script TerraCave_End_EventScript_Groudon {
    lockall
    applymovement(LOCALID_PLAYER, Common_Movement_FaceUp)
    waitmovement(0)
    applymovement(LOCALID_TERRA_CAVE_GROUDON, TerraCave_End_Movement_GroudonApproach)
    waitmovement(0)
    waitse()
    playmoncry(SPECIES_GROUDON, CRY_MODE_ENCOUNTER)
    delay(40)
    waitmoncry()
    setvar(VAR_LAST_TALKED, LOCALID_TERRA_CAVE_GROUDON)
    setwildbattle(SPECIES_GROUDON, 70)
    setflag(FLAG_SYS_CTRL_OBJ_DELETE)
    special(BattleSetup_StartLegendaryBattle)
    waitstate
    clearflag(FLAG_SYS_CTRL_OBJ_DELETE)
    setvar(VAR_TEMP_1, 0)
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) == B_OUTCOME_WON) {
        goto(TerraCave_End_EventScript_DefeatedGroudon)
    }
    if (var(VAR_RESULT) == B_OUTCOME_RAN) {
        goto(TerraCave_End_EventScript_RanFromGroudon)
    }
    if (var(VAR_RESULT) == B_OUTCOME_PLAYER_TELEPORTED) {
        goto(TerraCave_End_EventScript_RanFromGroudon)
    }
    setvar(VAR_SHOULD_END_ABNORMAL_WEATHER, 1)
    setflag(FLAG_DEFEATED_GROUDON)
    releaseall
    end
}

script TerraCave_End_EventScript_DefeatedGroudon {
    setvar(VAR_SHOULD_END_ABNORMAL_WEATHER, 1)
    setflag(FLAG_DEFEATED_GROUDON)
    goto(Common_EventScript_RemoveStaticPokemon)
    end
}

script TerraCave_End_EventScript_RanFromGroudon {
    setvar(VAR_0x8004, SPECIES_GROUDON)
    goto(Common_EventScript_LegendaryFlewAway)
    end
}

script TerraCave_End_Movement_GroudonApproach {
    init_affine_anim()
    walk_down_start_affine()
    delay_16()
    delay_16()
    walk_down_affine()
    delay_16()
    delay_16()
    walk_down_affine()
    step_end()
}
