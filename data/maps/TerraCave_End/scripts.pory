	delay_16
# 85 "data/maps/TerraCave_End/scripts.pory"
	delay_16
# 86 "data/maps/TerraCave_End/scripts.pory"
	walk_down_affine
# 87 "data/maps/TerraCave_End/scripts.pory"
	delay_16
# 88 "data/maps/TerraCave_End/scripts.pory"
	delay_16
# 89 "data/maps/TerraCave_End/scripts.pory"
	walk_down_affine
