mapscripts Route25_SeaCottage_Frlg_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Route25_SeaCottage_OnTransition
}

script Route25_SeaCottage_OnTransition {
    if (!flag(FLAG_HELPED_BILL_IN_SEA_COTTAGE)) call(Route25_SeaCottage_EventScript_HideClefairyBill)
    if (flag(FLAG_GOT_SS_TICKET)) call(Route25_SeaCottage_EventScript_SetReturnedAfterSSTicket)
    end
}

script Route25_SeaCottage_EventScript_HideClefairyBill {
    clearflag(FLAG_HIDE_BILL_CLEFAIRY)
    setobjectxyperm(LOCALID_BILL_HUMAN, 3, 3)
    return
}

script Route25_SeaCottage_EventScript_SetReturnedAfterSSTicket {
    setflag(RETURN_AFTER_SS_TICKET)
    return
}

script Route25_SeaCottage_EventScript_Bill {
    lock
    faceplayer
    if (flag(RETURN_AFTER_SS_TICKET)) goto(Route25_SeaCottage_EventScript_BillGoLookAtPC)
    if (flag(FLAG_GOT_SS_TICKET)) goto(Route25_SeaCottage_EventScript_BillGoToSSAnne)
    if (flag(FLAG_HELPED_BILL_IN_SEA_COTTAGE)) goto(Route25_SeaCottage_EventScript_BillGiveSSTicket)
    checkplayergender()
    if (var(VAR_RESULT) == MALE) goto(Route25_SeaCottage_EventScript_BillAskForHelpMale)
    if (var(VAR_RESULT) == FEMALE) goto(Route25_SeaCottage_EventScript_BillAskForHelpFemale)
    end
}

script Route25_SeaCottage_EventScript_BillAskForHelpMale {
    msgbox(Route25_SeaCottage_Text_ImBillHelpMeOutPal, MSGBOX_YESNO)
    goto(Route25_SeaCottage_EventScript_BillAskForHelp)
    end
}

script Route25_SeaCottage_EventScript_BillAskForHelpFemale {
    msgbox(Route25_SeaCottage_Text_ImBillHelpMeOutLady, MSGBOX_YESNO)
    goto(Route25_SeaCottage_EventScript_BillAskForHelp)
    end
}

script Route25_SeaCottage_EventScript_BillAskForHelp {
    if (var(VAR_RESULT) == NO) call(Route25_SeaCottage_EventScript_DeclineHelpBill)
    msgbox(Route25_SeaCottage_Text_RunCellSeparationOnPC)
    closemessage
    delay(10)
    if (var(VAR_FACING) == DIR_SOUTH) call(Route25_SeaCottage_EventScript_BillWalkToTeleporterSouth)
    if (var(VAR_FACING) == DIR_NORTH) call(Route25_SeaCottage_EventScript_BillWalkToTeleporter)
    if (var(VAR_FACING) == DIR_WEST) call(Route25_SeaCottage_EventScript_BillWalkToTeleporter)
    if (var(VAR_FACING) == DIR_EAST) call(Route25_SeaCottage_EventScript_BillWalkToTeleporter)
    opendoor(10, 3)
    waitdooranim()
    applymovement(LOCALID_BILL_CLEFAIRY, Route25_SeaCottage_Movement_BillEnterTeleporter)
    waitmovement(0)
    removeobject(LOCALID_BILL_CLEFAIRY)
    playse(SE_CONTEST_CURTAIN_FALL)
    closedoor(10, 3)
    waitdooranim()
    setflag(BILL_IN_TELEPORTER)
    release
    end
}

script Route25_SeaCottage_EventScript_DeclineHelpBill {
    checkplayergender()
    if (var(VAR_RESULT) == MALE) call(Route25_SeaCottage_EventScript_DeclineHelpBillMale)
    if (var(VAR_RESULT) == FEMALE) call(Route25_SeaCottage_EventScript_DeclineHelpBillFemale)
    return
}

script Route25_SeaCottage_EventScript_DeclineHelpBillMale {
    msgbox(Route25_SeaCottage_Text_NoPleaseChief)
    return
}

script Route25_SeaCottage_EventScript_DeclineHelpBillFemale {
    msgbox(Route25_SeaCottage_Text_NoPleaseBeautiful)
    return
}

script Route25_SeaCottage_EventScript_BillWalkToTeleporterSouth {
    applymovement(LOCALID_BILL_CLEFAIRY, Route25_SeaCottage_Movement_BillWalkToTeleporterSouth)
    waitmovement(0)
    return
}

script Route25_SeaCottage_EventScript_BillWalkToTeleporter {
    applymovement(LOCALID_BILL_CLEFAIRY, Route25_SeaCottage_Movement_BillWalkToTeleporter)
    waitmovement(0)
    return
}

script Route25_SeaCottage_EventScript_BillGoToSSAnne {
    msgbox(Route25_SeaCottage_Text_SSAnnePartyYouGoInstead)
    release
    end
}

script Route25_SeaCottage_EventScript_BillGiveSSTicket {
    famechecker(FAMECHECKER_BILL, FCPICKSTATE_COLORED, UpdatePickStateFromSpecialVar8005)
    checkplayergender()
    if (var(VAR_RESULT) == MALE) call(Route25_SeaCottage_EventScript_BillThanksMale)
    if (var(VAR_RESULT) == FEMALE) call(Route25_SeaCottage_EventScript_BillThanksFemale)
    checkitemspace(ITEM_SS_TICKET)
    if (var(VAR_RESULT) == FALSE) goto(Route25_SeaCottage_EventScript_NoRoomForSSTicket)
    giveitem_msg(Route25_SeaCottage_Text_ReceivedSSTicketFromBill, ITEM_SS_TICKET, 1, MUS_RG_OBTAIN_KEY_ITEM)
    setflag(FLAG_GOT_SS_TICKET_DUP)
    setflag(FLAG_HIDE_NUGGET_BRIDGE_ROCKET)
    setflag(FLAG_GOT_SS_TICKET)
    setflag(FLAG_SYS_PC_LANETTE)
    goto(Route25_SeaCottage_EventScript_BillGoToSSAnne)
    end
}

script Route25_SeaCottage_EventScript_BillThanksMale {
    msgbox(Route25_SeaCottage_Text_ThanksBudTakeThis)
    return
}

script Route25_SeaCottage_EventScript_BillThanksFemale {
    msgbox(Route25_SeaCottage_Text_ThanksLadyTakeThis)
    return
}

script Route25_SeaCottage_EventScript_NoRoomForSSTicket {
    msgbox(Route25_SeaCottage_Text_YouveGotTooMuchStuff)
    release
    end
}

script Route25_SeaCottage_EventScript_BillGoLookAtPC {
    msgbox(Route25_SeaCottage_Text_CheckOutRareMonsOnPC)
    release
    end
}

movement Route25_SeaCottage_Movement_BillWalkToTeleporter {
    walk_up
    walk_up
    step_end
}

movement Route25_SeaCottage_Movement_BillWalkToTeleporterSouth {
    walk_right
    walk_up
    walk_up
    walk_left
    walk_in_place_faster_up
    step_end
}

movement Route25_SeaCottage_Movement_BillEnterTeleporter {
    walk_up
    step_end
}

script Route25_SeaCottage_EventScript_Computer {
    lockall
    if (flag(RETURN_AFTER_SS_TICKET)) goto(Route25_SeaCottage_EventScript_OpenBillsMonList)
    if (flag(BILL_IN_TELEPORTER)) goto(Route25_SeaCottage_EventScript_RunCellSeparator)
    msgbox(Route25_SeaCottage_Text_TeleporterIsDisplayed)
    releaseall
    end
}

script Route25_SeaCottage_EventScript_RunCellSeparator {
    fadeoutbgm(0)
    msgbox(Route25_SeaCottage_Text_InitiatedTeleportersCellSeparator)
    closemessage
    clearflag(BILL_IN_TELEPORTER)
    setflag(FLAG_HELPED_BILL_IN_SEA_COTTAGE)
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, Route25_SeaCottage_Movement_CameraPanToTeleporters)
    waitmovement(0)
    delay(35)
    playse(SE_PIN)
    waitse()
    setvar(VAR_0x8004, 0)
    special(AnimateTeleporterHousing)
    delay(10)
    call(Route25_SeaCottage_EventScript_PlayTeleporterBeepSE)
    call(Route25_SeaCottage_EventScript_PlayTeleporterBeepSE)
    call(Route25_SeaCottage_EventScript_PlayTeleporterBeepSE)
    call(Route25_SeaCottage_EventScript_PlayTeleporterBeepSE)
    call(Route25_SeaCottage_EventScript_PlayTeleporterBeepSE)
    call(Route25_SeaCottage_EventScript_PlayTeleporterBeepSE)
    call(Route25_SeaCottage_EventScript_PlayTeleporterBeepSE)
    setvar(VAR_0x8004, 1)
    special(AnimateTeleporterHousing)
    playse(SE_WARP_IN)
    special(AnimateTeleporterCable)
    waitse()
    call(Route25_SeaCottage_EventScript_PlayTeleporterBeepSE)
    call(Route25_SeaCottage_EventScript_PlayTeleporterBeepSE)
    call(Route25_SeaCottage_EventScript_PlayTeleporterBeepSE)
    call(Route25_SeaCottage_EventScript_PlayTeleporterBeepSE)
    call(Route25_SeaCottage_EventScript_PlayTeleporterBeepSE)
    opendoor(3, 3)
    waitdooranim()
    fadeinbgm(0)
    addobject(LOCALID_BILL_HUMAN)
    clearflag(FLAG_HIDE_BILL_HUMAN_SEA_COTTAGE)
    delay(50)
    playfanfare(MUS_LEVEL_UP)
    applymovement(LOCALID_BILL_HUMAN, Route25_SeaCottage_Movement_BillExitTeleporter)
    waitmovement(0)
    waitfanfare()
    applymovement(LOCALID_CAMERA, Route25_SeaCottage_Movement_CameraPanBackFromTeleporters)
    waitmovement(0)
    playse(SE_CONTEST_CURTAIN_FALL)
    closedoor(3, 3)
    waitdooranim()
    applymovement(LOCALID_BILL_HUMAN, Route25_SeaCottage_Movement_BillWalkToMiddleOfRoom)
    waitmovement(0)
    special(RemoveCameraObject)
    releaseall
    end
}

script Route25_SeaCottage_EventScript_PlayTeleporterBeepSE {
    playse(SE_BALL)
    waitse()
    delay(20)
    return
}

movement Route25_SeaCottage_Movement_CameraPanToTeleporters {
    walk_up
    walk_up
    walk_right
    walk_right
    step_end
}

movement Route25_SeaCottage_Movement_CameraPanBackFromTeleporters {
    delay_16
    delay_16
    walk_down
    walk_down
    walk_left
    walk_left
    step_end
}

script Route25_SeaCottage_EventScript_OpenBillsMonList {
    msgbox(Route25_SeaCottage_Text_BillsFavoriteMonList)
    goto(Route25_SeaCottage_EventScript_BillsMonList)
    end
}

script Route25_SeaCottage_EventScript_BillsMonList {
    message(Route25_SeaCottage_Text_SeeWhichMon)
    waitmessage()
    multichoice(0, 0, MULTI_EEVEELUTIONS, FALSE)
    switch(VAR_RESULT)
    case(0, Route25_SeaCottage_EventScript_ViewEevee)
    case(1, Route25_SeaCottage_EventScript_ViewFlareon)
    case(2, Route25_SeaCottage_EventScript_ViewJolteon)
    case(3, Route25_SeaCottage_EventScript_ViewVaporeon)
    case(4, Route25_SeaCottage_EventScript_ExitBillsMonList)
    case(127, Route25_SeaCottage_EventScript_ExitBillsMonList)
    end
}

script Route25_SeaCottage_EventScript_ViewEevee {
    showmonpic(SPECIES_EEVEE, 10, 3)
    waitbuttonpress()
    hidemonpic()
    setvar(VAR_0x8004, SPECIES_EEVEE)
    special(SetSeenMon)
    goto(Route25_SeaCottage_EventScript_BillsMonList)
    end
}

script Route25_SeaCottage_EventScript_ViewFlareon {
    showmonpic(SPECIES_FLAREON, 10, 3)
    waitbuttonpress()
    hidemonpic()
    setvar(VAR_0x8004, SPECIES_FLAREON)
    special(SetSeenMon)
    goto(Route25_SeaCottage_EventScript_BillsMonList)
    end
}

script Route25_SeaCottage_EventScript_ViewJolteon {
    showmonpic(SPECIES_JOLTEON, 10, 3)
    waitbuttonpress()
    hidemonpic()
    setvar(VAR_0x8004, SPECIES_JOLTEON)
    special(SetSeenMon)
    goto(Route25_SeaCottage_EventScript_BillsMonList)
    end
}

script Route25_SeaCottage_EventScript_ViewVaporeon {
    showmonpic(SPECIES_VAPOREON, 10, 3)
    waitbuttonpress()
    hidemonpic()
    setvar(VAR_0x8004, SPECIES_VAPOREON)
    special(SetSeenMon)
    goto(Route25_SeaCottage_EventScript_BillsMonList)
    end
}

script Route25_SeaCottage_EventScript_ExitBillsMonList {
    releaseall
    end
}

movement Route25_SeaCottage_Movement_BillWalkToMiddleOfRoom {
    walk_right
    walk_right
    walk_right
    walk_right
    walk_down
    walk_down
    step_end
}

movement Route25_SeaCottage_Movement_BillExitTeleporter {
    walk_down
    step_end
}

text Route25_SeaCottage_Text_ImBillHelpMeOutPal {
    "Hiya! I'm a POKéMON…\n"
    "…No I'm not!\p"
    "Call me BILL!\n"
    "I'm a true-blue POKéMANIAC!\p"
    "Hey!\n"
    "What's with that skeptical look?\p"
    "I'm not joshing you, pal.\p"
    "I screwed up an experiment and got\n"
    "combined with a POKéMON!\p"
    "So, how about it?\n"
    "Help me out here!$"
}

text Route25_SeaCottage_Text_ImBillHelpMeOutLady {
    "Hiya! I'm a POKéMON…\n"
    "…No I'm not!\p"
    "Call me BILL!\n"
    "I'm a true-blue POKéMANIAC!\p"
    "Hey!\n"
    "What's with that skeptical look?\p"
    "I'm not joshing you, lady.\p"
    "I screwed up an experiment and got\n"
    "combined with a POKéMON!\p"
    "So, how about it?\n"
    "Help me out here!$"
}

text Route25_SeaCottage_Text_RunCellSeparationOnPC {
    "Wait till I get inside the\n"
    "TELEPORTER.\p"
    "When I do, go to my PC and run\n"
    "the Cell Separation System.$"
}

text Route25_SeaCottage_Text_NoPleaseChief {
    "No!?\n"
    "Now don't be so cold!\p"
    "Come on, you gotta help a guy in\n"
    "deep, deep trouble!\p"
    "What do you say, chief?\n"
    "Please?\l"
    "Okay?\l"
    "All right!$"
}

text Route25_SeaCottage_Text_NoPleaseBeautiful {
    "No!?\n"
    "Now don't be so cold!\p"
    "Come on, you gotta help a guy in\n"
    "deep, deep trouble!\p"
    "What do you say, beautiful?\n"
    "Please?\l"
    "Okay?\l"
    "All right!$"
}

text Route25_SeaCottage_Text_ThanksBudTakeThis {
    "BILL: Yeehah!\n"
    "Thanks, bud! I owe you one!\p"
    "So, did you come to see my\n"
    "POKéMON collection?\p"
    "You didn't?\n"
    "That's a bummer.\p"
    "I've got to thank you…\n"
    "Oh, here, maybe this'll do.$"
}

text Route25_SeaCottage_Text_ThanksLadyTakeThis {
    "BILL: Yeehah!\n"
    "Thanks, lady! I owe you one!\p"
    "So, did you come to see my\n"
    "POKéMON collection?\p"
    "You didn't?\n"
    "That's a bummer.\p"
    "I've got to thank you…\n"
    "Oh, here, maybe this'll do.$"
