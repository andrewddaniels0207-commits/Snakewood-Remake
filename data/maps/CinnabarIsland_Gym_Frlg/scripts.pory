script CinnabarIsland_Gym_EventScript_AveryApproachLeft {
    applymovement(LOCALID_PLAYER, CinnabarIsland_Gym_Movement_PlayerFaceAvery)
    applymovement(LOCALID_AVERY, CinnabarIsland_Gym_Movement_AveryApproachLeft)
    waitmovement(0)
    return
}

script CinnabarIsland_Gym_EventScript_AveryApproachRight {
    applymovement(LOCALID_PLAYER, CinnabarIsland_Gym_Movement_PlayerFaceAvery)
    applymovement(LOCALID_AVERY, CinnabarIsland_Gym_Movement_AveryApproachRight)
    waitmovement(0)
    return
}

movement CinnabarIsland_Gym_Movement_AveryApproachLeft {
    walk_up
    walk_up
    walk_left
    step_end
}

movement CinnabarIsland_Gym_Movement_AveryApproachRight {
    walk_up
    walk_up
    walk_in_place_faster_left
    step_end
}

movement CinnabarIsland_Gym_Movement_PlayerFaceAvery {
    delay_16
    delay_16
    walk_in_place_faster_right
    step_end
}

