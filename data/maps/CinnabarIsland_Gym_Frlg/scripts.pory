script CinnabarIsland_Gym_EventScript_GymGuy {
    lock
    faceplayer
    if (flag(FLAG_DEFEATED_BLAINE)) goto(CinnabarIsland_Gym_EventScript_GymGuyPostVictory)
    msgbox(CinnabarIsland_Gym_Text_GymGuyAdvice)
    release
    end
}

script CinnabarIsland_Gym_EventScript_GymGuyPostVictory {
    msgbox(CinnabarIsland_Gym_Text_GymGuyPostVictory)
    release
    end
}

