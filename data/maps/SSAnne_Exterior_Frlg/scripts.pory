mapscripts SSAnne_Exterior_Frlg_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: SSAnne_Exterior_OnTransition
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_MAP_SCENE_VERMILION_CITY, 1: SSAnne_Exterior_ExitSSAnne
    ]
}

script SSAnne_Exterior_OnTransition {
    setworldmapflag(FLAG_WORLD_MAP_SSANNE_EXTERIOR)
    end
}

script SSAnne_Exterior_ExitSSAnne {
    lockall
    getplayerxy(VAR_0x8004, VAR_0x8005)
    if (var(VAR_0x8005) <= 6) call(SSAnne_Exterior_WalkDown)
    if (var(VAR_0x8005) >= 7) call(SSAnne_Exterior_WalkInPlaceDown)
    fadenewbgm(MUS_RG_SURF)
    delay(50)
    special(DoSSAnneDepartureCutscene)
    waitstate
    removeobject(LOCALID_SS_ANNE)
    applymovement(LOCALID_PLAYER, SSAnne_Exterior_Movement_Exit)
    waitmovement(0)
    setvar(VAR_MAP_SCENE_VERMILION_CITY, 2)
    setvar(VAR_VERMILION_CITY_TICKET_CHECK_TRIGGER, 0)
    warp(MAP_VERMILION_CITY, 23, 34)
    waitstate
    releaseall
    end
}

script SSAnne_Exterior_WalkDown {
    applymovement(LOCALID_PLAYER, SSAnne_Exterior_Movement_WalkDown)
    waitmovement(0)
    return
}

script SSAnne_Exterior_WalkInPlaceDown {
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    return
}

movement SSAnne_Exterior_Movement_Exit {
    walk_up
    walk_up
    walk_up
    walk_up
    walk_up
    walk_up
    walk_up
    walk_up
    walk_up
    step_end
}

movement SSAnne_Exterior_Movement_WalkDown {
    walk_down
    walk_down
    walk_down
    walk_down
    walk_down
    walk_down
    walk_down
    walk_down
    walk_down
    step_end
}
