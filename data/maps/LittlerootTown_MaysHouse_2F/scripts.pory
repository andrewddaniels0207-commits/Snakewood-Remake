mapscripts LittlerootTown_MaysHouse_2F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: LittlerootTown_MaysHouse_2F_OnTransition
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE: LittlerootTown_MaysHouse_2F_OnWarp
}

script LittlerootTown_MaysHouse_2F_OnTransition {
    if (var(VAR_LITTLEROOT_RIVAL_STATE) < 2) call(LittlerootTown_MaysHouse_2F_EventScript_CheckSetReadyToMeetMay)
    if (var(VAR_LITTLEROOT_RIVAL_STATE) >= 3) call(LittlerootTown_MaysHouse_2F_EventScript_CheckShouldUpdateMayPos)
    if (var(VAR_LITTLEROOT_INTRO_STATE) == 4) call(PlayersHouse_2F_EventScript_BlockStairsUntilClockIsSet)
    call(SecretBase_EventScript_SetDecorationFlags)
    setvar(VAR_SECRET_BASE_INITIALIZED, 0)
    end
}

script LittlerootTown_MaysHouse_2F_EventScript_CheckShouldUpdateMayPos {
    if (flag(FLAG_MET_RIVAL_LILYCOVE)) goto(LittlerootTown_MaysHouse_2F_EventScript_TryUpdateMayPos)
    if (var(VAR_BIRCH_LAB_STATE) >= 2) goto(LittlerootTown_MaysHouse_2F_EventScript_Ret)
    goto(LittlerootTown_MaysHouse_2F_EventScript_TryUpdateMayPos)
}

script LittlerootTown_MaysHouse_2F_EventScript_TryUpdateMayPos {
    checkplayergender()
    if (var(VAR_RESULT) == FEMALE) goto(LittlerootTown_MaysHouse_2F_EventScript_Ret)
    if (var(VAR_DEX_UPGRADE_JOHTO_STARTER_STATE) >= 2) goto(LittlerootTown_MaysHouse_2F_EventScript_Ret)
    setobjectxyperm(LOCALID_RIVALS_HOUSE_2F_RIVAL, 8, 2)
    setobjectmovementtype(LOCALID_RIVALS_HOUSE_2F_RIVAL, MOVEMENT_TYPE_FACE_UP)
    return
}

script LittlerootTown_MaysHouse_2F_EventScript_Ret {
    return
}

script LittlerootTown_MaysHouse_2F_EventScript_CheckSetReadyToMeetMay {
    checkplayergender()
    if (var(VAR_RESULT) == MALE) goto(LittlerootTown_MaysHouse_2F_EventScript_SetReadyToMeetMay)
    return
}

script LittlerootTown_MaysHouse_2F_EventScript_SetReadyToMeetMay {
    setvar(VAR_LITTLEROOT_RIVAL_STATE, 2)
    return
}

raw `
LittlerootTown_MaysHouse_2F_OnWarp:
	map_script_2 VAR_SECRET_BASE_INITIALIZED, 0, LittlerootTown_MaysHouse_2F_EventScript_CheckInitDecor
	.2byte 0

`

script LittlerootTown_MaysHouse_2F_EventScript_CheckInitDecor {
    checkplayergender()
    if (var(VAR_RESULT) == FEMALE) goto(SecretBase_EventScript_InitDecorations)
    end
}

script LittlerootTown_MaysHouse_2F_EventScript_RivalsPokeBall {
    lockall
    if (var(VAR_LITTLEROOT_RIVAL_STATE) == 2) goto(LittlerootTown_MaysHouse_2F_EventScript_MeetMay)
    msgbox(RivalsHouse_2F_Text_ItsRivalsPokeBall, MSGBOX_DEFAULT)
    releaseall
    end
}

script LittlerootTown_MaysHouse_2F_EventScript_MeetMay {
    delay(10)
    addobject(LOCALID_RIVALS_HOUSE_2F_RIVAL)
    applymovement(LOCALID_RIVALS_HOUSE_2F_RIVAL, LittlerootTown_MaysHouse_2F_Movement_MayEnters)
    waitmovement(0)
    playse(SE_PIN)
    applymovement(LOCALID_RIVALS_HOUSE_2F_RIVAL, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(LOCALID_RIVALS_HOUSE_2F_RIVAL, Common_Movement_Delay48)
    waitmovement(0)
    delay(10)
    playbgm(MUS_ENCOUNTER_MAY, TRUE)
    if (var(VAR_FACING) == DIR_NORTH) call(LittlerootTown_MaysHouse_2F_EventScript_MeetMayNorth)
    if (var(VAR_FACING) == DIR_SOUTH) call(LittlerootTown_MaysHouse_2F_EventScript_MeetMaySouth)
    if (var(VAR_FACING) == DIR_WEST) call(LittlerootTown_MaysHouse_2F_EventScript_MeetMayWest)
    if (var(VAR_FACING) == DIR_EAST) call(LittlerootTown_MaysHouse_2F_EventScript_MeetMayEast)
    setvar(VAR_LITTLEROOT_RIVAL_STATE, 3)
    setflag(FLAG_HIDE_LITTLEROOT_TOWN_MAYS_HOUSE_2F_POKE_BALL)
    clearflag(FLAG_HIDE_LITTLEROOT_TOWN_MAYS_HOUSE_RIVAL_BEDROOM)
    setvar(VAR_LITTLEROOT_TOWN_STATE, 1)
    savebgm(MUS_DUMMY)
    fadedefaultbgm()
    releaseall
    end
}

script LittlerootTown_MaysHouse_2F_EventScript_MeetMayNorth {
    applymovement(LOCALID_RIVALS_HOUSE_2F_RIVAL, LittlerootTown_MaysHouse_2F_Movement_MayApproachPlayerNorth)
    waitmovement(0)
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterLeft)
    waitmovement(0)
    msgbox(RivalsHouse_2F_Text_MayWhoAreYou, MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_PLAYER, LittlerootTown_MaysHouse_2F_Movement_PlayerWatchMayNorth)
    applymovement(LOCALID_RIVALS_HOUSE_2F_RIVAL, LittlerootTown_MaysHouse_2F_Movement_MayWalkToPCNorth)
    waitmovement(0)
    return
}

