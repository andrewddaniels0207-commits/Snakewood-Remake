# 345 "data/maps/VerdanturfTown_BattleTentLobby/scripts.pory"
	message BattleFrontier_BattlePalaceLobby_Text_ReadWhichHeading
# 346 "data/maps/VerdanturfTown_BattleTentLobby/scripts.pory"
	waitmessage
