mapscripts BattleFrontier_OutsideEast_MapScripts {
    MAP_SCRIPT_ON_RESUME: BattleFrontier_OutsideEast_OnResume
    MAP_SCRIPT_ON_TRANSITION: BattleFrontier_OutsideEast_OnTransition
}

script BattleFrontier_OutsideEast_OnResume {
    if (flag(FLAG_SYS_CTRL_OBJ_DELETE)) {
        call(BattleFrontier_OutsideEast_EventScript_TryRemoveSudowoodo)
    }
    end
}

script BattleFrontier_OutsideEast_EventScript_TryRemoveSudowoodo {
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) != B_OUTCOME_CAUGHT) {
        goto(Common_EventScript_NopReturn)
    }
    removeobject(VAR_LAST_TALKED)
    return
}

script BattleFrontier_OutsideEast_OnTransition {
    setvar(VAR_BRAVO_TRAINER_BATTLE_TOWER_ON, 0)
    setflag(FLAG_HIDE_BATTLE_TOWER_REPORTER)
    if (!flag(FLAG_DEFEATED_SUDOWOODO)) {
        call(BattleFrontier_OutsideEast_EventScript_ShowSudowoodo)
    }
    end
}

script BattleFrontier_OutsideEast_EventScript_ShowSudowoodo {
    clearflag(FLAG_HIDE_BATTLE_FRONTIER_SUDOWOODO)
    return
}

