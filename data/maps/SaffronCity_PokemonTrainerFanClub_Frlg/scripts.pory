}

text SaffronCity_PokemonTrainerFanClub_Text_OnlyMasterHasMyRespect {
    "Hiyah! There is but one TRAINER\n"
    "who has my respect.\p"
    "And that is none other than my\n"
    "MASTER at the FIGHTING DOJO.\p"
    "You should become a fan of my\n"
    "MASTER like me! Hiyah!$"
}

text SaffronCity_PokemonTrainerFanClub_Text_NeverBeFanOfAnyoneButMaster {
    "Hiyah! I respect my MASTER at the\n"
