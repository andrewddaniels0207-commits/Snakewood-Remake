mapscripts FarawayIsland_Interior_MapScripts {
    MAP_SCRIPT_ON_RESUME: FarawayIsland_Interior_OnResume
    MAP_SCRIPT_ON_TRANSITION: FarawayIsland_Interior_OnTransition
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_1, 0: FarawayIsland_Interior_EventScript_FindMew
    ]
    MAP_SCRIPT_ON_RETURN_TO_FIELD: FarawayIsland_Interior_OnReturnToField
}

script FarawayIsland_Interior_OnReturnToField {
    if (flag(FLAG_SYS_CTRL_OBJ_DELETE)) {
        call(FarawayIsland_Interior_EventScript_TrySetMewAboveGrass)
    }
    end
}

script FarawayIsland_Interior_EventScript_TrySetMewAboveGrass {
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) == B_OUTCOME_WON) {
        goto(FarawayIsland_Interior_EventScript_SetMewAboveGrass)
    }
    if (var(VAR_RESULT) == B_OUTCOME_RAN) {
        goto(FarawayIsland_Interior_EventScript_SetMewAboveGrass)
    }
    if (var(VAR_RESULT) == B_OUTCOME_PLAYER_TELEPORTED) {
        goto(FarawayIsland_Interior_EventScript_SetMewAboveGrass)
    }
    if (var(VAR_RESULT) == B_OUTCOME_MON_TELEPORTED) {
        goto(FarawayIsland_Interior_EventScript_SetMewAboveGrass)
    }
    return
}

script FarawayIsland_Interior_EventScript_SetMewAboveGrass {
    setvar(VAR_0x8004, 1)
    special(SetMewAboveGrass)
    return
}

script FarawayIsland_Interior_OnResume {
    if (flag(FLAG_SYS_CTRL_OBJ_DELETE)) {
        call(FarawayIsland_Interior_EventScript_TryRemoveMew)
    }
    end
}

script FarawayIsland_Interior_EventScript_TryRemoveMew {
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) != B_OUTCOME_CAUGHT) {
        goto(Common_EventScript_NopReturn)
    }
    removeobject(VAR_LAST_TALKED)
    return
}

script FarawayIsland_Interior_OnTransition {
    setvar(VAR_FARAWAY_ISLAND_STEP_COUNTER, 0)
    setvar(VAR_TEMP_1, 1)
    if (!flag(FLAG_CAUGHT_MEW)) {
        call(FarawayIsland_Interior_EventScript_TryShowMew)
    }
    end
}

script FarawayIsland_Interior_EventScript_TryShowMew {
    if (flag(FLAG_DEFEATED_MEW)) {
        goto(Common_EventScript_NopReturn)
    }
    clearflag(FLAG_HIDE_MEW)
    setvar(VAR_TEMP_1, 0)
    return
}

script FarawayIsland_Interior_EventScript_FindMew {
    lockall
    playse(SE_PIN)
    applymovement(LOCALID_FARAWAY_ISLAND_MEW, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(LOCALID_FARAWAY_ISLAND_MEW, Common_Movement_Delay48)
    waitmovement(0)
    applymovement(LOCALID_FARAWAY_ISLAND_MEW, FarawayIsland_Interior_Movement_MewMoveAndHide)
    waitmovement(0)
    copyobjectxytoperm(LOCALID_FARAWAY_ISLAND_MEW)
    setvar(VAR_TEMP_1, 1)
    releaseall
    end
}

movement FarawayIsland_Interior_Movement_MewMoveAndHide {
    walk_up
    walk_up
    walk_up
    walk_in_place_faster_down
    set_invisible
    step_end
}

movement FarawayIsland_Interior_Movement_MewAppear {
    set_visible
    step_end
}

script FarawayIsland_Interior_Movement_MewFloatUpNorth {
    lock_facing_direction()
    walk_fast_up()
    walk_fast_up()
    unlock_facing_direction()
    walk_in_place_down()
    walk_in_place_down()
    step_end()
}

script FarawayIsland_Interior_Movement_MewFloatUpSouth {
    lock_facing_direction()
    walk_fast_up()
    walk_fast_up()
    unlock_facing_direction()
    walk_in_place_up()
    walk_in_place_up()
    step_end()
}

script FarawayIsland_Interior_Movement_MewFloatUpWest {
    lock_facing_direction()
    walk_fast_up()
    walk_fast_up()
    unlock_facing_direction()
    walk_in_place_right()
    walk_in_place_right()
    step_end()
}

script FarawayIsland_Interior_Movement_MewFloatUpEast {
    lock_facing_direction()
    walk_fast_up()
    walk_fast_up()
    unlock_facing_direction()
    walk_in_place_left()
    walk_in_place_left()
    step_end()
}

script FarawayIsland_Interior_EventScript_Mew {
    lock
    faceplayer
    applymovement(LOCALID_FARAWAY_ISLAND_MEW, FarawayIsland_Interior_Movement_MewAppear)
    waitmovement(0)
    setvar(VAR_0x8004, 0)
    special(SetMewAboveGrass)
    message(FarawayIsland_Interior_Text_Mew)
    waitse()
    playmoncry(SPECIES_MEW, CRY_MODE_ENCOUNTER)
    if (var(VAR_FACING) == DIR_NORTH) {
        call(FarawayIsland_Interior_EventScript_FoundMewNorth)
    }
    if (var(VAR_FACING) == DIR_SOUTH) {
        call(FarawayIsland_Interior_EventScript_FoundMewSouth)
    }
    if (var(VAR_FACING) == DIR_WEST) {
        call(FarawayIsland_Interior_EventScript_FoundMewWest)
    }
    if (var(VAR_FACING) == DIR_EAST) {
        call(FarawayIsland_Interior_EventScript_FoundMewEast)
    }
    special(DestroyMewEmergingGrassSprite)
    delay(40)
    waitmoncry()
    seteventmon(SPECIES_MEW, 30)
    setflag(FLAG_SYS_CTRL_OBJ_DELETE)
    special(BattleSetup_StartLegendaryBattle)
    waitstate
    clearflag(FLAG_SYS_CTRL_OBJ_DELETE)
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) == B_OUTCOME_WON) {
        goto(FarawayIsland_Interior_EventScript_MewDefeated)
    }
    if (var(VAR_RESULT) == B_OUTCOME_RAN) {
        goto(FarawayIsland_Interior_EventScript_PlayerOrMewRan)
    }
    if (var(VAR_RESULT) == B_OUTCOME_PLAYER_TELEPORTED) {
        goto(FarawayIsland_Interior_EventScript_PlayerOrMewRan)
    }
    if (var(VAR_RESULT) == B_OUTCOME_MON_TELEPORTED) {
        goto(FarawayIsland_Interior_EventScript_PlayerOrMewRan)
    }
    setflag(FLAG_CAUGHT_MEW)
    release
    end
}

script FarawayIsland_Interior_EventScript_MewDefeated {
    setflag(FLAG_DEFEATED_MEW)
    setvar(VAR_0x8004, SPECIES_MEW)
    goto(Common_EventScript_LegendaryFlewAway)
    end
}

script FarawayIsland_Interior_EventScript_PlayerOrMewRan {
    setvar(VAR_0x8004, SPECIES_MEW)
    goto(Common_EventScript_LegendaryFlewAway)
    end
}

script FarawayIsland_Interior_EventScript_FoundMewNorth {
    applymovement(LOCALID_FARAWAY_ISLAND_MEW, FarawayIsland_Interior_Movement_MewFloatUpNorth)
    waitmovement(0)
    return
}

script FarawayIsland_Interior_EventScript_FoundMewSouth {
    applymovement(LOCALID_FARAWAY_ISLAND_MEW, FarawayIsland_Interior_Movement_MewFloatUpSouth)
    waitmovement(0)
    return
}

script FarawayIsland_Interior_EventScript_FoundMewWest {
    applymovement(LOCALID_FARAWAY_ISLAND_MEW, FarawayIsland_Interior_Movement_MewFloatUpWest)
    waitmovement(0)
    return
}

script FarawayIsland_Interior_EventScript_FoundMewEast {
    applymovement(LOCALID_FARAWAY_ISLAND_MEW, FarawayIsland_Interior_Movement_MewFloatUpEast)
    waitmovement(0)
    return
}

script FarawayIsland_Interior_EventScript_HideMewWhenGrassCut {
    lockall
    fadescreenswapbuffers(FADE_TO_BLACK)
    setflag(FLAG_HIDE_MEW)
    removeobject(LOCALID_FARAWAY_ISLAND_MEW)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    msgbox(FarawayIsland_Interior_Text_TheFeelingOfBeingWatchedFaded, MSGBOX_DEFAULT)
    closemessage
    releaseall
    end
}

text FarawayIsland_Interior_Text_TheFeelingOfBeingWatchedFaded {
    "The feeling of being watched faded…$"
}
