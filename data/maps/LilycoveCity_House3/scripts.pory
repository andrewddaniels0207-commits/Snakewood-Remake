mapscripts LilycoveCity_House3_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: LilycoveCity_House3_OnTransition
}

script LilycoveCity_House3_OnTransition {
    random(4)
    copyvar(VAR_TEMP_1, VAR_RESULT)
    end
}

script LilycoveCity_House3_EventScript_PokefanF {
    lock
    faceplayer
    msgbox(LilycoveCity_House3_Text_LearnFromMasterOfPokeblocks, MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        goto(LilycoveCity_House3_EventScript_DeclinePokeblockLearn)
    }
    msgbox(LilycoveCity_House3_Text_ExplainPokeblocks, MSGBOX_DEFAULT)
    closemessage
    applymovement(VAR_LAST_TALKED, Common_Movement_FaceOriginalDirection)
    waitmovement(0)
    release
    end
}

script LilycoveCity_House3_EventScript_DeclinePokeblockLearn {
    msgbox(LilycoveCity_House3_Text_OhAreYouSure, MSGBOX_DEFAULT)
    closemessage
    applymovement(VAR_LAST_TALKED, Common_Movement_FaceOriginalDirection)
    waitmovement(0)
    release
    end
}

script LilycoveCity_House3_EventScript_Man {
    lock
    faceplayer
    msgbox(LilycoveCity_House3_Text_HappyToHaveQuadruplets, MSGBOX_DEFAULT)
    closemessage
    applymovement(VAR_LAST_TALKED, Common_Movement_FaceOriginalDirection)
    waitmovement(0)
    release
    end
}

script LilycoveCity_House3_EventScript_GameBoyKid1 {
    lock
    faceplayer
    switch (var(VAR_TEMP_1)) {
        case 0:
            goto(LilycoveCity_House3_EventScript_WereDoingMultiBattle)
        case 1:
            goto(LilycoveCity_House3_EventScript_WereMixingRecords)
        case 2:
            goto(LilycoveCity_House3_EventScript_WereBlendingBerries)
        case 3:
            goto(LilycoveCity_House3_EventScript_WereDoingContest)
    }
    end
}

