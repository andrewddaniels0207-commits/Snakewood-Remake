mapscripts Route103_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        call(Common_EventScript_SetupRivalGfxId)
        call(ProfBirch_EventScript_UpdateLocation)
    }
    MAP_SCRIPT_ON_LOAD {
        if (flag(FLAG_SYS_GAME_CLEAR)) {
            call(Route103_EventScript_OpenAlteringCave)
        }
    }
}

script Route103_EventScript_OpenAlteringCave {
    setmetatile(45, 5, METATILE_General_CaveEntrance_Top, TRUE)
    setmetatile(45, 6, METATILE_General_CaveEntrance_Bottom, FALSE)
    return
}

// ============================================================
// Birch Egg Event (replaces vanilla rival battle)
// Gives the player a randomized egg and the PokéNav.
// Sets FLAG_RECEIVED_BIRCH_EGG to allow Alicia battle in Oldale.
// TODO: Replace SPECIES_WYNAUT with Miasby/Corrokid/Smushcum species
//       when those Pokémon are added to the game.
// ============================================================

script Route103_EventScript_Rival {
    lock
    faceplayer
    if (flag(FLAG_RECEIVED_BIRCH_EGG)) {
        msgbox("Placeholder: I've already given you an egg.\p"
               "Take good care of it!$")
        release
        end
    }
    msgbox("Placeholder: Birch greets the player.\p"
           "I've been looking for you!\p"
           "I have something important to give you.$")
    closemessage
    random(3)
    switch (var(VAR_RESULT)) {
        case 0:
            // TODO: Replace SPECIES_WYNAUT with Miasby
            giveegg(SPECIES_WYNAUT)
        case 1:
            // TODO: Replace SPECIES_WYNAUT with Corrokid
            giveegg(SPECIES_WYNAUT)
        case 2:
            // TODO: Replace SPECIES_WYNAUT with Smushcum
            giveegg(SPECIES_WYNAUT)
    }
    if (var(VAR_RESULT) == FALSE) {
        msgbox("Placeholder: Your bag is full - come back when you have space!$")
        release
        end
    }
    msgbox("Placeholder: Birch explains the egg.\p"
           "This egg was found near here.\p"
           "Something is alive inside it - take good care of it.$")
    closemessage
    playfanfare(MUS_OBTAIN_ITEM)
    msgbox("Placeholder: You received the PokéNav!$")
    waitfanfare
    setflag(FLAG_SYS_POKENAV_GET)
    setflag(FLAG_RECEIVED_POKENAV)
    msgbox("Placeholder: Birch explains the PokéNav and registers his number.\p"
           "You can reach me any time on that.$")
    closemessage
    setflag(FLAG_RECEIVED_BIRCH_EGG)
    msgbox("Placeholder: Good luck out there. Head back through Oldale when you're ready.$")
    release
    end
}

// ============================================================
// Trainer battles (placeholder text)
// ============================================================

script Route103_EventScript_Daisy {
    trainerbattle_single(TRAINER_DAISY, "Placeholder: Daisy intro.$", "Placeholder: Daisy defeated.$")
    msgbox("Placeholder: Daisy post-battle.$", MSGBOX_AUTOCLOSE)
    end
}

script Route103_EventScript_Amy {
    trainerbattle_double(TRAINER_AMY_AND_LIV_1,
        "Placeholder: Amy intro.$",
        "Placeholder: Amy defeated.$",
        "Placeholder: Amy not enough Pokémon.$",
        Route102_EventScript_AmyRegisterMatchCallAfterBattle)
    specialvar(VAR_RESULT, ShouldTryRematchBattle)
    if (var(VAR_RESULT) == TRUE) {
        call(Route102_EventScript_AmyRematch)
        end
    }
    msgbox("Placeholder: Amy post-battle.$", MSGBOX_AUTOCLOSE)
    end
}

script Route102_EventScript_AmyRegisterMatchCallAfterBattle {
    msgbox("Placeholder: Amy & Liv register.$")
    register_matchcall(TRAINER_AMY_AND_LIV_1)
    release
    end
}

script Route102_EventScript_AmyRematch {
    trainerbattle_rematch_double(TRAINER_AMY_AND_LIV_1,
        "Placeholder: Amy rematch intro.$",
        "Placeholder: Amy rematch defeated.$",
        "Placeholder: Amy rematch not enough Pokémon.$")
    msgbox("Placeholder: Amy rematch post-battle.$", MSGBOX_AUTOCLOSE)
    end
}

