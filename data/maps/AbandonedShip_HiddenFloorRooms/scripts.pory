mapscripts AbandonedShip_HiddenFloorRooms_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_1, 0: AbandonedShip_HiddenFloorRooms_EventScript_DoHiddenItemSparkle
    ]
}

script AbandonedShip_HiddenFloorRooms_EventScript_DoHiddenItemSparkle {
    setvar(VAR_TEMP_1, 1)
    getplayerxy(VAR_TEMP_2, VAR_TEMP_3)
    setvar(VAR_TEMP_4, 1)
    if (var(VAR_TEMP_2) == 21) {
        call(AbandonedShip_HiddenFloorRooms_EventScript_InMiddleRoomColumn)
    }
    if (var(VAR_TEMP_2) == 36) {
        call(AbandonedShip_HiddenFloorRooms_EventScript_InRightRoomColumn)
    }
    if (var(VAR_TEMP_3) == 2) {
        call(AbandonedShip_HiddenFloorRooms_EventScript_InUpperRoomRow)
    }
    switch (var(VAR_TEMP_4)) {
        case 1:
            goto(AbandonedShip_HiddenFloorRooms_EventScript_EnterRm1)
        case 2:
            goto(AbandonedShip_HiddenFloorRooms_EventScript_EnterRm2)
        case 3:
            goto(AbandonedShip_HiddenFloorRooms_EventScript_EnterRm3)
        case 4:
            goto(AbandonedShip_HiddenFloorRooms_EventScript_EnterRm4)
        case 5:
            goto(AbandonedShip_HiddenFloorRooms_EventScript_EnterRm5)
        case 6:
            goto(AbandonedShip_HiddenFloorRooms_EventScript_EnterRm6)
    }
    end
}

script AbandonedShip_HiddenFloorRooms_EventScript_InMiddleRoomColumn {
    addvar(VAR_TEMP_4, 1)
    return
}

script AbandonedShip_HiddenFloorRooms_EventScript_InRightRoomColumn {
    addvar(VAR_TEMP_4, 2)
    return
}

script AbandonedShip_HiddenFloorRooms_EventScript_InUpperRoomRow {
    addvar(VAR_TEMP_4, 3)
    return
}

script AbandonedShip_HiddenFloorRooms_EventScript_EnterRm1 {
    delay(20)
    dofieldeffectsparkle(10, 10, 0)
    specialvar(VAR_RESULT, FoundAbandonedShipRoom4Key)
    if (var(VAR_RESULT) == FALSE) {
        call(AbandonedShip_HiddenFloorRooms_EventScript_Rm4KeySparkle)
    }
    waitfieldeffect(FLDEFF_SPARKLE)
    delay(10)
    end
}

script AbandonedShip_HiddenFloorRooms_EventScript_EnterRm2 {
    end
}

script AbandonedShip_HiddenFloorRooms_EventScript_EnterRm3 {
    specialvar(VAR_RESULT, FoundAbandonedShipRoom1Key)
    if (var(VAR_RESULT) == TRUE) {
        goto(AbandonedShip_HiddenFloorRooms_EventScript_Rm3NoSparkle)
    }
    delay(20)
    if (var(VAR_RESULT) == FALSE) {
        call(AbandonedShip_HiddenFloorRooms_EventScript_Rm1KeySparkle)
    }
    waitfieldeffect(FLDEFF_SPARKLE)
    delay(10)
    end
}

script AbandonedShip_HiddenFloorRooms_EventScript_Rm3NoSparkle {
    end
}

script AbandonedShip_HiddenFloorRooms_EventScript_EnterRm4 {
    delay(20)
    dofieldeffectsparkle(8, 5, 0)
    dofieldeffectsparkle(11, 3, 0)
    specialvar(VAR_RESULT, FoundAbandonedShipRoom6Key)
    if (var(VAR_RESULT) == FALSE) {
        call(AbandonedShip_HiddenFloorRooms_EventScript_Rm6KeySparkle)
    }
    waitfieldeffect(FLDEFF_SPARKLE)
    delay(10)
    end
}

script AbandonedShip_HiddenFloorRooms_EventScript_EnterRm5 {
    delay(20)
    dofieldeffectsparkle(16, 3, 0)
    dofieldeffectsparkle(25, 2, 0)
    dofieldeffectsparkle(24, 6, 0)
    specialvar(VAR_RESULT, FoundAbandonedShipRoom2Key)
    if (var(VAR_RESULT) == FALSE) {
        call(AbandonedShip_HiddenFloorRooms_EventScript_Rm2KeySparkle)
    }
    waitfieldeffect(FLDEFF_SPARKLE)
    delay(10)
    end
}

script AbandonedShip_HiddenFloorRooms_EventScript_EnterRm6 {
    end
}

script AbandonedShip_HiddenFloorRooms_EventScript_Rm1KeySparkle {
    dofieldeffectsparkle(42, 10, 0)
    return
}

script AbandonedShip_HiddenFloorRooms_EventScript_Rm2KeySparkle {
    dofieldeffectsparkle(20, 5, 0)
    return
}

script AbandonedShip_HiddenFloorRooms_EventScript_Rm4KeySparkle {
    dofieldeffectsparkle(1, 12, 0)
    return
}

script AbandonedShip_HiddenFloorRooms_EventScript_Rm6KeySparkle {
    dofieldeffectsparkle(1, 2, 0)
    return
}

script AbandonedShip_HiddenFloorRooms_EventScript_Trash {
    lockall
    msgbox(AbandonedShip_HiddenFloorRooms_Text_BrightShinyTrash, MSGBOX_DEFAULT)
    releaseall
    end
}

text AbandonedShip_HiddenFloorRooms_Text_BrightShinyTrash {
    "It's bright and shiny!\n"
    "But it's just trash…$"
}
