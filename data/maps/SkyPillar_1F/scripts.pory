mapscripts SkyPillar_1F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: SkyPillar_1F_OnTransition
}

script SkyPillar_1F_OnTransition {
    if (var(VAR_SKY_PILLAR_STATE) < 2) call(SkyPillar_1F_EventScript_CleanFloor)
    end
}

script SkyPillar_1F_EventScript_CleanFloor {
    setmaplayoutindex(LAYOUT_SKY_PILLAR_1F_CLEAN)
    return
}
