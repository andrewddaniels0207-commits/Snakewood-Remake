# 55 "data/maps/BattleFrontier_BattlePalaceCorridor/scripts.pory"
	waitmovement 0
# 56 "data/maps/BattleFrontier_BattlePalaceCorridor/scripts.pory"
	closedoor 10, 3
# 57 "data/maps/BattleFrontier_BattlePalaceCorridor/scripts.pory"
	waitdooranim
	return


