mapscripts BirthIsland_Exterior_Frlg_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: BirthIsland_Exterior_Frlg_OnTransition
    MAP_SCRIPT_ON_RESUME: BirthIsland_Exterior_Frlg_OnResume
    MAP_SCRIPT_ON_RETURN_TO_FIELD: BirthIsland_Exterior_Frlg_OnReturnToField
}

script BirthIsland_Exterior_Frlg_OnReturnToField {
    special(SetDeoxysRockPalette)
    end
}

script BirthIsland_Exterior_Frlg_OnTransition {
    setworldmapflag(FLAG_WORLD_MAP_BIRTH_ISLAND_EXTERIOR)
    setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_DEOXYS_N)
    setvar(VAR_DEOXYS_INTERACTION_STEP_COUNTER, 0)
    setvar(VAR_DEOXYS_INTERACTION_NUM, 0)
    if (flag(FLAG_FOUGHT_DEOXYS)) {
        call(BirthIsland_Exterior_Frlg_EventScript_HideDeoxysAndPuzzle)
    }
    if (!flag(FLAG_FOUGHT_DEOXYS)) {
        call(BirthIsland_Exterior_Frlg_EventScript_TryShowDeoxysPuzzle)
    }
    end
}

script BirthIsland_Exterior_Frlg_EventScript_HideDeoxysAndPuzzle {
    setflag(FLAG_HIDE_DEOXYS)
    setflag(FLAG_HIDE_BIRTH_ISLAND_METEORITE)
    return
}

script BirthIsland_Exterior_Frlg_EventScript_TryShowDeoxysPuzzle {
    if (flag(FLAG_DEOXYS_FLEW_AWAY)) {
        goto(Common_EventScript_NopReturn)
    }
    clearflag(FLAG_HIDE_BIRTH_ISLAND_METEORITE)
    clearflag(FLAG_DEOXYS_ROCK_COMPLETE)
    return
}

script BirthIsland_Exterior_Frlg_OnResume {
    if (flag(FLAG_SYS_CTRL_OBJ_DELETE)) {
        call(BirthIsland_Exterior_Frlg_EventScript_TryRemoveDeoxys)
    }
    end
}

script BirthIsland_Exterior_Frlg_EventScript_TryRemoveDeoxys {
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) != B_OUTCOME_CAUGHT) {
        goto(Common_EventScript_NopReturn)
    }
    removeobject(LOCALID_BIRTH_ISLAND_DEOXYS)
    return
}

script BirthIsland_Exterior_Frlg_EventScript_Triangle {
    lock
    faceplayer
    special(DoDeoxysRockInteraction)
    waitstate
    switch (var(VAR_RESULT)) {
        case 0:
            goto(BirthIsland_Exterior_EventScript_NotSolved1)
        case 1:
            goto(BirthIsland_Exterior_EventScript_NotSolved2)
        case 2:
            goto(BirthIsland_Exterior_Frlg_EventScript_Deoxys)
        case 3:
            goto(BirthIsland_Exterior_EventScript_NotSolved3)
    }
    end
}

script BirthIsland_Exterior_EventScript_NotSolved1 {
    release
    end
}

script BirthIsland_Exterior_EventScript_NotSolved2 {
    release
    end
}

script BirthIsland_Exterior_EventScript_NotSolved3 {
    release
    end
}

script BirthIsland_Exterior_Frlg_EventScript_Deoxys {
    addobject(LOCALID_BIRTH_ISLAND_DEOXYS)
    waitse()
    setfieldeffectargument(0, LOCALID_BIRTH_ISLAND_EXTERIOR_ROCK)
    setfieldeffectargument(1, MAP_NUM(MAP_BIRTH_ISLAND_EXTERIOR_FRLG))
    setfieldeffectargument(2, MAP_GROUP(MAP_BIRTH_ISLAND_EXTERIOR_FRLG))
    dofieldeffect(FLDEFF_DESTROY_DEOXYS_ROCK)
    playbgm(MUS_RG_ENCOUNTER_DEOXYS, 0)
    waitfieldeffect(FLDEFF_DESTROY_DEOXYS_ROCK)
    applymovement(LOCALID_BIRTH_ISLAND_DEOXYS, Movement_DeoxysApproach)
    waitmovement(0)
    waitse()
    playmoncry(SPECIES_DEOXYS, CRY_MODE_ENCOUNTER)
    delay(40)
    waitmoncry()
    setvar(VAR_LAST_TALKED, LOCALID_BIRTH_ISLAND_DEOXYS)
    seteventmon(SPECIES_DEOXYS, 30)
    setflag(FLAG_SYS_CTRL_OBJ_DELETE)
    special(BattleSetup_StartLegendaryBattle)
    waitstate
    clearflag(FLAG_SYS_CTRL_OBJ_DELETE)
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) == B_OUTCOME_WON) {
        goto(BirthIsland_Exterior_Frlg_EventScript_DefeatedDeoxys)
    }
    if (var(VAR_RESULT) == B_OUTCOME_RAN) {
        goto(BirthIsland_Exterior_Frlg_EventScript_RanFromDeoxys)
    }
    if (var(VAR_RESULT) == B_OUTCOME_PLAYER_TELEPORTED) {
        goto(BirthIsland_Exterior_Frlg_EventScript_RanFromDeoxys)
    }
    setflag(FLAG_FOUGHT_DEOXYS)
    release
    end
}

script BirthIsland_Exterior_Frlg_EventScript_DefeatedDeoxys {
    setflag(FLAG_DEOXYS_FLEW_AWAY)
    setvar(VAR_0x8004, SPECIES_DEOXYS)
    goto(EventScript_MonFlewAway)
    end
}

script BirthIsland_Exterior_Frlg_EventScript_RanFromDeoxys {
    setvar(VAR_0x8004, SPECIES_DEOXYS)
    goto(EventScript_MonFlewAway)
    end
}

movement Movement_DeoxysApproach {
    walk_slow_down
    walk_slow_down
    walk_slow_down
    walk_slow_down
    walk_slow_down
    walk_slow_down
    walk_slow_down
    step_end
}
