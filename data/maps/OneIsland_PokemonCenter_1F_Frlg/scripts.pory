script OneIsland_PokemonCenter_1F_EventScript_LeaveOneIslandTriggerTop {
    lockall
    setvar(VAR_TEMP_1, 1)
    goto(OneIsland_PokemonCenter_1F_EventScript_LeaveOneIslandScene)
    end
}

script OneIsland_PokemonCenter_1F_EventScript_LeaveOneIslandTriggerMidTop {
    lockall
    setvar(VAR_TEMP_1, 2)
    goto(OneIsland_PokemonCenter_1F_EventScript_LeaveOneIslandScene)
    end
}

script OneIsland_PokemonCenter_1F_EventScript_LeaveOneIslandTriggerMidBottom {
    lockall
    setvar(VAR_TEMP_1, 3)
    goto(OneIsland_PokemonCenter_1F_EventScript_LeaveOneIslandScene)
    end
}

script OneIsland_PokemonCenter_1F_EventScript_LeaveOneIslandTriggerBottom {
    lockall
    setvar(VAR_TEMP_1, 4)
    goto(OneIsland_PokemonCenter_1F_EventScript_LeaveOneIslandScene)
    end
}

script OneIsland_PokemonCenter_1F_EventScript_LeaveOneIslandScene {
    textcolor(NPC_TEXT_COLOR_MALE)
    playse(SE_PIN)
    applymovement(LOCALID_ONE_ISLAND_POKEMON_CENTER_BILL, Common_Movement_ExclamationMark)
    waitmovement(0)
    msgbox(OneIsland_PokemonCenter_1F_Text_BillOhHeyPlayer)
    closemessage
    if (var(VAR_TEMP_1) == 1) call(OneIsland_PokemonCenter_1F_EventScript_PlayerWalkToBillTop)
    if (var(VAR_TEMP_1) == 2) call(OneIsland_PokemonCenter_1F_EventScript_PlayerWalkToBillMidTop)
    if (var(VAR_TEMP_1) == 3) call(OneIsland_PokemonCenter_1F_EventScript_PlayerWalkToBillMidBottom)
    if (var(VAR_TEMP_1) == 4) call(OneIsland_PokemonCenter_1F_EventScript_PlayerWalkToBillBottom)
    delay(10)
    msgbox(OneIsland_PokemonCenter_1F_Text_BillWeGotItDone)
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    msgbox(OneIsland_PokemonCenter_1F_Text_CelioJobWentQuick)
    applymovement(LOCALID_ONE_ISLAND_POKEMON_CENTER_BILL, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    applymovement(LOCALID_CELIO, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    msgbox(OneIsland_PokemonCenter_1F_Text_BillYouveLearnedALot)
    msgbox(OneIsland_PokemonCenter_1F_Text_CelioOhReallyEhehe)
    closemessage
    applymovement(LOCALID_ONE_ISLAND_POKEMON_CENTER_BILL, Common_Movement_WalkInPlaceFasterLeft)
    waitmovement(0)
    delay(10)
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterRight)
    waitmovement(0)
    delay(15)
    msgbox(OneIsland_PokemonCenter_1F_Text_BillWeShouldHeadBackToKanto)
    closemessage
    applymovement(LOCALID_ONE_ISLAND_POKEMON_CENTER_BILL, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    delay(15)
    applymovement(LOCALID_CELIO, Common_Movement_WalkInPlaceFasterLeft)
    waitmovement(0)
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    msgbox(OneIsland_PokemonCenter_1F_Text_CelioPromiseIllShowYouAroundSometime)
    closemessage
    delay(25)
    applymovement(LOCALID_PLAYER, OneIsland_PokemonCenter_1F_Movement_PlayerExit)
    applymovement(LOCALID_ONE_ISLAND_POKEMON_CENTER_BILL, OneIsland_PokemonCenter_1F_Movement_BillExit)
    waitmovement(0)
    playse(SE_EXIT)
    setflag(FLAG_HIDE_ONE_ISLAND_POKECENTER_BILL)
    setvar(VAR_MAP_SCENE_ONE_ISLAND_POKEMON_CENTER_1F, 3)
    clearflag(FLAG_HIDE_CINNABAR_BILL)
    setvar(VAR_MAP_SCENE_CINNABAR_ISLAND, 3)
    setvar(VAR_0x8004, SEAGALLOP_ONE_ISLAND)
    setvar(VAR_0x8006, SEAGALLOP_CINNABAR_ISLAND)
    goto(EventScript_SetSail)
    end
}

script OneIsland_PokemonCenter_1F_EventScript_PlayerWalkToBillTop {
    applymovement(LOCALID_PLAYER, OneIsland_PokemonCenter_1F_Movement_PlayerWalkToBillTop)
    waitmovement(0)
    return
}

script OneIsland_PokemonCenter_1F_EventScript_PlayerWalkToBillMidTop {
    applymovement(LOCALID_PLAYER, OneIsland_PokemonCenter_1F_Movement_PlayerWalkToBillMidTop)
    waitmovement(0)
    return
}

script OneIsland_PokemonCenter_1F_EventScript_PlayerWalkToBillMidBottom {
    applymovement(LOCALID_PLAYER, OneIsland_PokemonCenter_1F_Movement_PlayerWalkToBillMidBottom)
    waitmovement(0)
    return
}

script OneIsland_PokemonCenter_1F_EventScript_PlayerWalkToBillBottom {
    applymovement(LOCALID_PLAYER, OneIsland_PokemonCenter_1F_Movement_PlayerWalkToBillBottom)
    waitmovement(0)
    return
}

movement OneIsland_PokemonCenter_1F_Movement_PlayerWalkToBillTop {
    walk_right
    walk_down
    walk_in_place_faster_right
    step_end
}

movement OneIsland_PokemonCenter_1F_Movement_PlayerWalkToBillMidTop {
    walk_right
    step_end
}

movement OneIsland_PokemonCenter_1F_Movement_PlayerWalkToBillMidBottom {
    walk_right
    walk_up
    walk_in_place_faster_right
    step_end
}

movement OneIsland_PokemonCenter_1F_Movement_PlayerWalkToBillBottom {
    walk_right
    walk_up
    walk_up
    walk_in_place_faster_right
    step_end
}

movement OneIsland_PokemonCenter_1F_Movement_DelayWalkInPlaceLeft {
    delay_16
    delay_16
    delay_4
    walk_in_place_faster_left
    step_end
}

script OneIsland_PokemonCenter_1F_Movement_WalkInPlaceDown {
    walk_in_place_fast_down()
    step_end()
}

movement OneIsland_PokemonCenter_1F_Movement_PlayerExit {
    walk_left
    walk_left
    walk_left
    walk_left
    walk_down
    walk_down
    step_end
}

movement OneIsland_PokemonCenter_1F_Movement_BillExit {
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_down
    step_end
}

text OneIsland_PokemonCenter_1F_Text_BillHeyThereCelio {
    "BILL: Hey, there!\n"
    "CELIO!$"
}

text OneIsland_PokemonCenter_1F_Text_CelioCantBelieveYouCameOut {
    "CELIO: BILL!\n"
    "I can't believe you came out here.$"
}

text OneIsland_PokemonCenter_1F_Text_BillHowsYourResearchComing {
    "BILL: Well, absolutely!\n"
    "How's your research coming along?\p"
    "…Oh, wait a sec.$"
}

text OneIsland_PokemonCenter_1F_Text_ThisIsMyBuddyCelio {
    "{PLAYER}, this is my buddy CELIO.\n"
    "He's one dedicated PC MANIAC!$"
}

text OneIsland_PokemonCenter_1F_Text_PlayerIsRisingPokemonChamp {
    "CELIO, this is {PLAYER}, a rising\n"
    "contender as the POKéMON CHAMP!$"
}

text OneIsland_PokemonCenter_1F_Text_PlayerIsReigningPokemonChamp {
    "CELIO, this is {PLAYER}, the\n"
    "reigning POKéMON CHAMP!$"
}

text OneIsland_PokemonCenter_1F_Text_CelioThatsReallyImpressive {
    "CELIO: That's really impressive.\p"
    "I hate to say it, but I have zero\n"
    "aptitude for battling.\p"
    "Anyways, I'm glad to meet you.$"
}

text OneIsland_PokemonCenter_1F_Text_BillBringMeUpToSpeed {
    "BILL: So, bring me up to speed.\n"
    "How's your machine running?$"
}

text OneIsland_PokemonCenter_1F_Text_CelioPCsCantLinkWithYours {
    "CELIO: It's running fine, but we're\n"
    "too remote out here.\p"
    "The PCs on this island just can't\n"
    "link with your PC, BILL.$"
}

text OneIsland_PokemonCenter_1F_Text_BillLetMeHelpYou {
    "BILL: Oh, yeah?\n"
    "Okay, let me take a look-see.\p"
    "…Hang on here…\n"
    "I think we can make it work.\l"
    "Let me help you, okay?$"
}

text OneIsland_PokemonCenter_1F_Text_CanYouDeliverThisMeteoritePlayer {
    "{PLAYER}, can I get you to wait for\n"
    "me just a bit?\p"
    "…Actually, can I get you to do\n"
    "me a favor?\p"
    "The island next to this one's\n"
    "called TWO ISLAND.\p"
    "There's a guy there that runs\n"
    "a GAME CORNER.\p"
    "He has this thing for rare rocks\n"
    "and gems.\p"
    "We keep in touch, being fellow\n"
    "maniacs.\p"
    "So, can I get you to deliver this\n"
    "METEORITE to him?$"
}

text OneIsland_PokemonCenter_1F_Text_AcceptedMeteoriteFromBill {
    "{PLAYER} accepted the METEORITE\n"
    "from BILL.$"
}

text OneIsland_PokemonCenter_1F_Text_CelioPleaseTakeThis {
    "CELIO: {PLAYER}, if you are going\n"
    "to TWO ISLAND, please take this.$"
}

text OneIsland_PokemonCenter_1F_Text_PassLetsYouTravelBetweenIslands {
    "It's a PASS for the ferry service\n"
    "serving the local islands.\p"
    "It will let you travel between the\n"
    "ISLANDS ONE, TWO, and THREE.\p"
    "Oh, you should have this, too.$"
}

text OneIsland_PokemonCenter_1F_Text_ReceivedExtraPageForTownMap {
    "{PLAYER} received an extra page\n"
    "for the TOWN MAP!$"
}

text OneIsland_PokemonCenter_1F_Text_ReceivedTownMap {
    "{PLAYER} received\n"
    "a TOWN MAP!$"
}

text OneIsland_PokemonCenter_1F_Text_BillCatchYouLater {
    "BILL: I'll catch you later!\n"
    "Say hi to the guy for me!$"
}

text OneIsland_PokemonCenter_1F_Text_HmmHowAboutLikeThis {
    "Hmm…\p"
    "How about we try this like this…$"
}

text OneIsland_PokemonCenter_1F_Text_GotPCWorkingStrollAWhileMore {
    "Oh, hey, {PLAYER}!\p"
    "Did you see?\n"
    "We got the PC working!\p"
    "I've got a few things to show\n"
    "CELIO here.\p"
    "Can you go out on a stroll or\n"
    "something for a while more?$"
}

text OneIsland_PokemonCenter_1F_Text_SorryForBeingPoorHost {
    "I'm sorry for taking up so much of\n"
    "BILL's time.\p"
    "I'm also sorry for being such a \n"
    "poor host on your visit here.$"
}

text OneIsland_PokemonCenter_1F_Text_UsualPCServicesUnavailable {
    "The usual PC services aren't\n"
    "available…$"
}

text OneIsland_PokemonCenter_1F_Text_BillOhHeyPlayer {
    "BILL: Oh, hey!\n"
    "{PLAYER}!$"
}

text OneIsland_PokemonCenter_1F_Text_BillWeGotItDone {
    "BILL: What kept you so long?\n"
    "Been out having a good time?\p"
    "We got it done.\n"
    "The PCs are up and running!$"
}

text OneIsland_PokemonCenter_1F_Text_CelioJobWentQuick {
    "CELIO: The job went incredibly\n"
    "quick.\p"
    "BILL is one amazing guy…$"
}

text OneIsland_PokemonCenter_1F_Text_BillYouveLearnedALot {
    "BILL: No, no! There was almost\n"
    "nothing left for me to do.\p"
    "CELIO, I have to hand it to you.\n"
    "You've learned a lot.$"
}

text OneIsland_PokemonCenter_1F_Text_CelioOhReallyEhehe {
    "CELIO: Oh, really?\n"
    "Ehehe…$"
}

text OneIsland_PokemonCenter_1F_Text_BillWeShouldHeadBackToKanto {
    "BILL: Well, there you have it.\n"
    "I'm finished with the job.\l"
    "We should head back to KANTO.\p"
    "CELIO, I'll be seeing you again.$"
}

text OneIsland_PokemonCenter_1F_Text_CelioPromiseIllShowYouAroundSometime {
    "CELIO: {PLAYER}, I'm really sorry\n"
    "that we sent you off alone today.\p"
    "I promise, I will show you around\n"
    "these islands sometime.$"
}

text OneIsland_PokemonCenter_1F_Text_CelioImModifyingMyNetworkMachine {
    "CELIO: Hello!\n"
    "You look awfully busy as always.\p"
    "How am I doing?\p"
    "Well, I'm modifying my Network\n"
    "Machine.\p"
    "When I get done with the machine,\n"
    "I hope you'll be first to use it,\l"
    "{PLAYER}.$"
}

text OneIsland_PokemonCenter_1F_Text_CelioCaughtMoreMonMaybeICanBeUseful {
    "CELIO: {PLAYER}, how have things\n"
    "been for you?\p"
    "Oh, is that right?\n"
    "You've caught more POKéMON.\p"
    "Do you know what?\n"
    "Maybe I can be useful to you.$"
}

text OneIsland_PokemonCenter_1F_Text_YoullBeTradingFromTrainersFarAway {
    "I'm modifying the Network Machine\n"
    "right now.\p"
    "I'm changing it so it can handle\n"
    "trades over long distances.\p"
    "When I get finished, you'll be\n"
    "trading for exotic POKéMON from\l"
    "TRAINERS far away.$"
}

text OneIsland_PokemonCenter_1F_Text_NeedsSpecialGemstone {
    "But, there is a slight catch.\p"
    "For the link to work, the Machine\n"
    "needs a special gemstone.\p"
    "It's supposed to be on ONE ISLAND,\n"
    "but I haven't found one yet.\p"
    "Who knows where it could be.$"
}

text OneIsland_PokemonCenter_1F_Text_TryingToFindGem {
    "I was trying to find the gem\n"
    "even while I was studying.\p"
    "As a result, I've made no headway\n"
    "in both my search and studies…\p"
    "If I relied on BILL, I'm sure my\n"
    "research would progress.\p"
    "But this time, I want to try to do\n"
    "things by myself.$"
}

text OneIsland_PokemonCenter_1F_Text_OhThats {
    "Oh!\n"
    "Th-that's…$"
}

text OneIsland_PokemonCenter_1F_Text_HandedRubyToCelio {
    "{PLAYER} handed the RUBY\n"
    "to CELIO.$"
}

text OneIsland_PokemonCenter_1F_Text_MayIAskOneMoreFavor {
    "Thank you!\n"
    "{PLAYER}, you're simply amazing.\p"
    "… … …  … … …\p"
    "Um… May I ask one more giant favor\n"
    "of you?$"
}

text OneIsland_PokemonCenter_1F_Text_PleaseINeedYourHelp {
    "It… It's not anything weird.\n"
    "Please, I need your help.$"
}

text OneIsland_PokemonCenter_1F_Text_AnotherGemstoneInSeviiIslands {
    "While I was studying gemstones,\n"
    "I discovered something important.\p"
    "There is another gem that forms\n"
    "a pair with this RUBY.\p"
    "That other gemstone is supposed to\n"
    "be in the SEVII ISLANDS.\p"
    "{PLAYER}, please, I need you to go\n"
    "find the other gem.\p"
    "{PLAYER}, may I have your ferry\n"
    "PASS and the TOWN MAP?$"
}

text OneIsland_PokemonCenter_1F_Text_ReturnedTriPassForRainbowPass {
    "{PLAYER} returned the TRI-PASS and\n"
    "received the RAINBOW PASS.$"
}

text OneIsland_PokemonCenter_1F_Text_ObtainedExtraMapPage {
    "Obtained an extra page for the\n"
    "TOWN MAP!$"
}

text OneIsland_PokemonCenter_1F_Text_PassLetYouGetToAllIslands {
    "This is my own ferry PASS.\p"
    "It will let you get to all the\n"
    "SEVII ISLANDS.\p"
    "{PLAYER}, please, I can't do\n"
    "it without your help.$"
}

text OneIsland_PokemonCenter_1F_Text_HandedSapphireToCelio {
    "{PLAYER} handed the SAPPHIRE\n"
    "to CELIO.$"
}

text OneIsland_PokemonCenter_1F_Text_ThankYouGiveMeTime {
    "CELIO: So this is the gem that\n"
    "forms a pair with the RUBY…\p"
    "{PLAYER}, you've gone through a lot\n"
    "to get this, didn't you?\p"
    "You don't have to tell me. I know\n"
    "it wasn't easy.\p"
    "Thank you so much!\p"
    "Now it's my turn to work for you!\n"
    "Please give me a little time.$"
}

text OneIsland_PokemonCenter_1F_Text_OkayThisIsGood {
    "Okay, this is good…$"
}

text OneIsland_PokemonCenter_1F_Text_LinkedUpWithLanette {
    "I did it!\n"
    "I linked up with LANETTE!$"
}

text OneIsland_PokemonCenter_1F_Text_ManagedToLinkWithHoennThankYou {
    "{PLAYER}…\n"
    "{PLAYER}, I did it!\p"
    "I've managed to link up with\n"
    "TRAINERS in the HOENN region!\p"
    "Finally, the Network Machine is\n"
    "fully operational!\p"
    "{PLAYER}, I owe it all to you!\p"
    "Thanks to you, my dream came\n"
    "true…$"
}

text OneIsland_PokemonCenter_1F_Text_WishYouBestOfLuck {
    "I…\n"
    "I'm not crying.\p"
    "That's enough about me!\p"
    "{PLAYER}, you're going to keep\n"
    "looking for exotic POKéMON, right?\p"
    "I wish you the best of luck!$"
}

text OneIsland_PokemonCenter_1F_Text_CelioHearingRumorsAboutYou {
    "CELIO: Hello!\p"
    "{PLAYER}, I've been hearing rumors\n"
    "about you.$"
}

text OneIsland_PokemonCenter_1F_Text_BillsFirstMonWasAbra {
    "{PLAYER}, what's your favorite kind\n"
    "of POKéMON?\p"
    "BILL is a POKéMANIAC, so he loves\n"
    "every kind.\p"
    "Apparently, the first one he caught\n"
    "was an ABRA.$"
}

text OneIsland_PokemonCenter_1F_Text_BillsHometownInGoldenrod {
    "By the way, {PLAYER}, you're from\n"
    "PALLET TOWN, aren't you?\p"
    "I've heard that it's a quiet and\n"
    "pleasant place.\p"
    "BILL's hometown is GOLDENROD CITY,\n"
    "where his folks still live.\p"
    "I've heard that it's quite the\n"
    "festive, bustling city.\p"
    "I'd like to go there one day.$"
}

text OneIsland_PokemonCenter_1F_Text_BillCantStomachMilk {
    "{PLAYER}, is there anything that\n"
    "you can't stand?\p"
    "Apparently, BILL simply can't\n"
    "stomach milk at all.$"
}

text OneIsland_PokemonCenter_1F_Text_CameFromPalletDontKnowIt {
    "Oh, you're a stranger here!\n"
    "Hi! Where did you come from?\p"
    "…PALLET TOWN?\n"
    "I don't know it!$"
}

text OneIsland_PokemonCenter_1F_Text_EnormousVolcanoOnIsland {
    "On this island, there's an enormous\n"
    "volcano.\p"
    "It hasn't erupted lately, so why\n"
    "not enjoy a hike?$"
}

text OneIsland_PokemonCenter_1F_Text_WishICouldTradeWithBoyfriend {
    "I wish I could trade POKéMON with\n"
