script OneIsland_PokemonCenter_1F_EventScript_NetworkMachine {
    lockall
    if (flag(FLAG_IS_CHAMPION)) goto(OneIsland_PokemonCenter_1F_EventScript_NetworkMachineLinkedWithHoenn)
    if (flag(FLAG_SEVII_DETOUR_FINISHED)) goto(OneIsland_PokemonCenter_1F_EventScript_NetworkMachineLinkedWithKanto)
    msgbox(OneIsland_PokemonCenter_1F_Text_MachineUnderAdjustment)
    releaseall
    end
}

script OneIsland_PokemonCenter_1F_EventScript_NetworkMachineLinkedWithKanto {
