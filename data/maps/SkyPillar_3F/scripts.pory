mapscripts SkyPillar_3F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: SkyPillar_3F_OnTransition
}

script SkyPillar_3F_OnTransition {
    if (var(VAR_SKY_PILLAR_STATE) < 2) {
        call(SkyPillar_3F_EventScript_CleanFloor)
    }
    end
}

script SkyPillar_3F_EventScript_CleanFloor {
    setmaplayoutindex(LAYOUT_SKY_PILLAR_3F_CLEAN)
    return
}
