mapscripts BattleFrontier_BattlePyramidFloor_MapScripts {
    MAP_SCRIPT_ON_RESUME: BattleFrontier_BattlePyramidFloor_OnResume
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_D, 1: BattleFrontier_BattlePyramidFloor_EventScript_UpdateLight
        VAR_TEMP_PLAYING_PYRAMID_MUSIC, 0: BattleFrontier_BattlePyramidFloor_EventScript_PlayPyramidMusic
        VAR_TEMP_F, 1: BattleFrontier_BattlePyramidFloor_EventScript_ShowMapName
    ]
    MAP_SCRIPT_ON_TRANSITION: BattleFrontier_BattlePyramidFloor_OnTransition
}

script BattleFrontier_BattlePyramidFloor_EventScript_UpdateLight {
    lockall
    setvar(VAR_0x8004, BATTLE_PYRAMID_FUNC_UPDATE_LIGHT)
    setvar(VAR_0x8005, 4)
    setvar(VAR_0x8006, PYRAMID_LIGHT_INCR_RADIUS)
    setvar(VAR_0x8007, SE_SAVE)
    setvar(VAR_RESULT, 0)
}

script BattleFrontier_BattlePyramidFloor_EventScript_UpdateLightLoop {
    special(CallBattlePyramidFunction)
    delay(2)
    if (var(VAR_RESULT) != 2) {
        goto(BattleFrontier_BattlePyramidFloor_EventScript_UpdateLightLoop)
    }
    setvar(VAR_TEMP_D, 0)
    releaseall
    end
}

script BattleFrontier_BattlePyramidFloor_EventScript_ShowMapName {
    special(ShowMapNamePopup)
    setvar(VAR_TEMP_F, 0)
    end
}

script BattleFrontier_BattlePyramidFloor_EventScript_PlayPyramidMusic {
    playbgm(MUS_B_PYRAMID, FALSE)
    setvar(VAR_TEMP_PLAYING_PYRAMID_MUSIC, 1)
    end
}

script BattleFrontier_BattlePyramidFloor_OnResume {
    pyramid_setfloorpal()
    frontier_getstatus()
    switch (var(VAR_TEMP_CHALLENGE_STATUS)) {
        case 0:
            goto(BattleFrontier_BattlePyramidFloor_EventScript_ReadyChallenge)
        case CHALLENGE_STATUS_SAVING:
            goto(BattleFrontier_BattlePyramid_EventScript_WarpToLobby)
        case CHALLENGE_STATUS_PAUSED:
            goto(BattleFrontier_BattlePyramidFloor_EventScript_ReadyChallenge)
    }
    frontier_get(FRONTIER_DATA_BATTLE_OUTCOME)
    if (var(VAR_RESULT) == B_OUTCOME_RAN) {
        goto(BattleFrontier_BattlePyramidFloor_EventScript_ResetParty)
    }
    if (var(VAR_RESULT) == B_OUTCOME_PLAYER_TELEPORTED) {
        goto(BattleFrontier_BattlePyramidFloor_EventScript_ResetParty)
    }
    if (var(VAR_RESULT) == 0) {
        goto(BattleFrontier_BattlePyramidFloor_EventScript_ResetParty)
    }
    if (var(VAR_RESULT) == B_OUTCOME_LOST) {
        goto(BattleFrontier_BattlePyramid_EventScript_WarpToLobbyLost)
    }
    if (var(VAR_RESULT) == B_OUTCOME_DREW) {
        goto(BattleFrontier_BattlePyramid_EventScript_WarpToLobbyLost)
    }
    if (var(VAR_RESULT) == B_OUTCOME_FORFEITED) {
        goto(BattleFrontier_BattlePyramid_EventScript_WarpToLobbyLost)
    }
    frontier_isbattletype(BATTLE_TYPE_TRAINER)
    setvar(VAR_TEMP_D, 1)
}

script BattleFrontier_BattlePyramidFloor_EventScript_ResetParty {
    pyramid_resetparty()
    end
}

script BattleFrontier_BattlePyramid_EventScript_WarpToLobbyLost {
    frontier_set(FRONTIER_DATA_CHALLENGE_STATUS, CHALLENGE_STATUS_LOST)
    pyramid_set(PYRAMID_DATA_TRAINER_FLAGS, 255)
}

script BattleFrontier_BattlePyramid_EventScript_WarpToLobby {
    pyramid_updatelight(0, PYRAMID_LIGHT_SET_RADIUS)
    pyramid_clearhelditems()
    special(HealPlayerParty)
    warpsilent(MAP_BATTLE_FRONTIER_BATTLE_PYRAMID_LOBBY, 7, 13)
    waitstate
    end
}

script BattleFrontier_BattlePyramidFloor_EventScript_ReadyChallenge {
    pyramid_save(CHALLENGE_STATUS_SAVING)
    special(SavePlayerParty)
    frontier_set(FRONTIER_DATA_CHALLENGE_STATUS, 0)
    pyramid_settrainers()
    frontier_setpartyorder(FRONTIER_PARTY_SIZE)
    setvar(VAR_TEMP_F, 1)
    end
}

script BattleFrontier_BattlePyramidFloor_OnTransition {
    call(BattleFrontier_BattlePyramidFloor_EventScript_SetLightRadius)
    setvar(VAR_TEMP_F, 1)
    end
}

script BattleFrontier_BattlePyramidFloor_EventScript_SetLightRadius {
    pyramid_updatelight(32, PYRAMID_LIGHT_SET_RADIUS)
    return
}

script BattlePyramid_WarpToNextFloor {
    call(BattleFrontier_EventScript_IncrementWinStreak)
    frontier_get(FRONTIER_DATA_BATTLE_NUM)
    addvar(VAR_RESULT, 1)
    frontier_set(FRONTIER_DATA_BATTLE_NUM, VAR_RESULT)
    if (var(VAR_RESULT) == 7) {
        goto(BattlePyramid_WarpToTop)
    }
    pyramid_seedfloor()
    frontier_set(FRONTIER_DATA_CHALLENGE_STATUS, 0)
    setvar(VAR_RESULT, 0)
    warp(MAP_BATTLE_FRONTIER_BATTLE_PYRAMID_FLOOR, 1, 1)
    waitstate
    end
}

script BattlePyramid_WarpToTop {
    warp(MAP_BATTLE_FRONTIER_BATTLE_PYRAMID_TOP, 17, 17)
    waitstate
    end
}

script BattlePyramid_TrainerBattle {
    facilitytrainerbattle(FACILITY_BATTLE_PYRAMID)
    pyramid_showhint()
    waitmessage()
    waitbuttonpress()
    closemessage
    releaseall
    end
}

script BattlePyramid_FindItemBall {
    pyramid_setitem()
    callstd(STD_FIND_ITEM)
    if (var(VAR_0x8007) == 0) {
        goto(BattlePyramid_FindItemBallEnd)
    }
    pyramid_hideitem()
}

script BattlePyramid_FindItemBallEnd {
    end
}

script BattlePyramid_Retire {
    goto(BattleFrontier_BattlePyramid_EventScript_WarpToLobbyLost)
}

