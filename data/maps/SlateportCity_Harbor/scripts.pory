mapscripts SlateportCity_Harbor_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: SlateportCity_Harbor_OnTransition
}

script SlateportCity_Harbor_OnTransition {
    setescapewarp(MAP_SLATEPORT_CITY, 28, 13)
    setvar(VAR_TEMP_1, 0)
    if (var(VAR_SLATEPORT_HARBOR_STATE) == 1) call(SlateportCity_Harbor_EventScript_ReadyAquaEscapeScene)
    if (flag(FLAG_SYS_GAME_CLEAR)) call(SlateportCity_Harbor_EventScript_ShowSSTidal)
    end
}

script SlateportCity_Harbor_EventScript_ShowSSTidal {
    clearflag(FLAG_HIDE_SLATEPORT_CITY_HARBOR_SS_TIDAL)
    return
}

script SlateportCity_Harbor_EventScript_ReadyAquaEscapeScene {
    savebgm(MUS_ENCOUNTER_AQUA)
    setobjectxyperm(LOCALID_SLATEPORT_HARBOR_CAPT_STERN, 12, 13)
    setobjectmovementtype(LOCALID_SLATEPORT_HARBOR_CAPT_STERN, MOVEMENT_TYPE_FACE_LEFT)
    setflag(FLAG_HIDE_SLATEPORT_CITY_HARBOR_PATRONS)
    return
}

script SlateportCity_Harbor_EventScript_AquaEscapeTrigger0 {
    lockall
    setvar(VAR_0x8008, 0)
    goto(SlateportCity_Harbor_EventScript_AquaEscapeScene)
    end
}

script SlateportCity_Harbor_EventScript_AquaEscapeTrigger1 {
    lockall
    setvar(VAR_0x8008, 1)
    goto(SlateportCity_Harbor_EventScript_AquaEscapeScene)
    end
}

script SlateportCity_Harbor_EventScript_AquaEscapeTrigger2 {
    lockall
    setvar(VAR_0x8008, 2)
    goto(SlateportCity_Harbor_EventScript_AquaEscapeScene)
    end
}

script SlateportCity_Harbor_EventScript_AquaEscapeTrigger3 {
    lockall
    setvar(VAR_0x8008, 3)
    applymovement(LOCALID_PLAYER, SlateportCity_Harbor_Movement_PlayerWalkUp)
    waitmovement(0)
    goto(SlateportCity_Harbor_EventScript_AquaEscapeScene)
    end
}

script SlateportCity_Harbor_EventScript_AquaEscapeScene {
    applymovement(LOCALID_SLATEPORT_HARBOR_ARCHIE, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    applymovement(LOCALID_SLATEPORT_HARBOR_GRUNT, Common_Movement_WalkInPlaceFasterDown)
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    msgbox(SlateportCity_Harbor_Text_ArchieYouAgainHideoutInLilycove, MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_SLATEPORT_HARBOR_GRUNT, SlateportCity_Harbor_Movement_AquaBoardSub)
    applymovement(LOCALID_SLATEPORT_HARBOR_ARCHIE, SlateportCity_Harbor_Movement_AquaBoardSub)
    applymovement(LOCALID_SLATEPORT_HARBOR_SUBMARINE, SlateportCity_Harbor_Movement_SubmarineExit)
    waitmovement(0)
    removeobject(LOCALID_SLATEPORT_HARBOR_GRUNT)
    removeobject(LOCALID_SLATEPORT_HARBOR_ARCHIE)
    removeobject(LOCALID_SLATEPORT_HARBOR_SUBMARINE)
    setvar(VAR_SLATEPORT_HARBOR_STATE, 2)
    setflag(FLAG_MET_TEAM_AQUA_HARBOR)
    setflag(FLAG_HIDE_LILYCOVE_MOTEL_SCOTT)
    if (var(VAR_0x8008) == 0) call(SlateportCity_Harbor_EventScript_SternApproachPlayer0)
    if (var(VAR_0x8008) == 1) call(SlateportCity_Harbor_EventScript_SternApproachPlayer1)
    if (var(VAR_0x8008) == 2) call(SlateportCity_Harbor_EventScript_SternApproachPlayer)
    if (var(VAR_0x8008) == 3) call(SlateportCity_Harbor_EventScript_SternApproachPlayer)
    msgbox(SlateportCity_Harbor_Text_CaptSternWhyStealMySubmarine, MSGBOX_DEFAULT)
    closemessage
    setflag(FLAG_HIDE_AQUA_HIDEOUT_1F_GRUNT_1_BLOCKING_ENTRANCE)
    setflag(FLAG_HIDE_AQUA_HIDEOUT_1F_GRUNT_2_BLOCKING_ENTRANCE)
    copyobjectxytoperm(LOCALID_SLATEPORT_HARBOR_CAPT_STERN)
    setobjectmovementtype(LOCALID_SLATEPORT_HARBOR_CAPT_STERN, MOVEMENT_TYPE_FACE_RIGHT)
    releaseall
    end
}

script SlateportCity_Harbor_EventScript_SternApproachPlayer0 {
    applymovement(LOCALID_SLATEPORT_HARBOR_CAPT_STERN, SlateportCity_Harbor_Movement_SternApproachPlayer0)
    waitmovement(0)
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    return
}

script SlateportCity_Harbor_EventScript_SternApproachPlayer1 {
    applymovement(LOCALID_SLATEPORT_HARBOR_CAPT_STERN, SlateportCity_Harbor_Movement_SternApproachPlayer1)
    waitmovement(0)
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterRight)
    waitmovement(0)
    return
}

script SlateportCity_Harbor_EventScript_SternApproachPlayer {
    applymovement(LOCALID_SLATEPORT_HARBOR_CAPT_STERN, SlateportCity_Harbor_Movement_SternApproachPlayer)
    waitmovement(0)
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterRight)
    waitmovement(0)
    return
}

movement SlateportCity_Harbor_Movement_AquaBoardSub {
    delay_16
    delay_16
    jump_up
    set_invisible
    step_end
}

movement SlateportCity_Harbor_Movement_ArchieBoardSub {
    delay_16
    delay_16
    jump_up
    set_invisible
    step_end
}

movement SlateportCity_Harbor_Movement_SubmarineExit {
    delay_16
    delay_16
    delay_16
    delay_16
    walk_right
    walk_right
    walk_right
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_right
    step_end
}

movement SlateportCity_Harbor_Movement_SternApproachPlayer0 {
    walk_left
    walk_left
    walk_left
    walk_left
    walk_up
    step_end
}

movement SlateportCity_Harbor_Movement_SternApproachPlayer1 {
    walk_left
    walk_left
    walk_up
    walk_left
    step_end
}

movement SlateportCity_Harbor_Movement_SternApproachPlayer {
    walk_left
    walk_left
    walk_left
    step_end
}

movement SlateportCity_Harbor_Movement_PlayerWalkUp {
    walk_up
    step_end
}

script SlateportCity_Harbor_EventScript_FerryAttendant {
    lock
    faceplayer
    if (flag(FLAG_SYS_GAME_CLEAR)) goto(SlateportCity_Harbor_EventScript_AskForTicket)
    msgbox(SlateportCity_Harbor_Text_FerryServiceUnavailable, MSGBOX_DEFAULT)
    release
    end
}

script SlateportCity_Harbor_EventScript_AskForTicket {
    msgbox(SlateportCity_Harbor_Text_MayISeeYourTicket, MSGBOX_DEFAULT)
    message(SlateportCity_Harbor_Text_FlashedTicketWhereTo)
    waitmessage()
    goto(SlateportCity_Harbor_EventScript_ChooseDestination)
    end
}

script SlateportCity_Harbor_EventScript_ChooseDestination {
    if (flag(FLAG_MET_SCOTT_ON_SS_TIDAL)) goto(SlateportCity_Harbor_EventScript_ChooseDestinationWithBattleFrontier)
    multichoicedefault(18, 8, MULTI_SSTIDAL_SLATEPORT_NO_BF, 2, FALSE)
    switch(VAR_RESULT)
    case(0, SlateportCity_Harbor_EventScript_Lilycove)
    case(1, SlateportCity_Harbor_EventScript_CancelDestinationSelect)
    case(MULTI_B_PRESSED, SlateportCity_Harbor_EventScript_CancelDestinationSelect)
    end
}

script SlateportCity_Harbor_EventScript_ChooseDestinationWithBattleFrontier {
    multichoicedefault(17, 6, MULTI_SSTIDAL_SLATEPORT_WITH_BF, 2, FALSE)
    switch(VAR_RESULT)
    case(0, SlateportCity_Harbor_EventScript_Lilycove)
    case(1, SlateportCity_Harbor_EventScript_BattleFrontier)
    case(2, SlateportCity_Harbor_EventScript_CancelDestinationSelect)
    case(MULTI_B_PRESSED, SlateportCity_Harbor_EventScript_CancelDestinationSelect)
    end
}

script SlateportCity_Harbor_EventScript_NoTicket {
    msgbox(SlateportCity_Harbor_Text_YouMustHaveTicket, MSGBOX_DEFAULT)
    release
    end
}

script SlateportCity_Harbor_EventScript_Lilycove {
    msgbox(SlateportCity_Harbor_Text_LilycoveItIs, MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) goto(SlateportCity_Harbor_EventScript_ChooseNewDestination)
    setvar(VAR_SS_TIDAL_STATE, SS_TIDAL_BOARD_SLATEPORT)
    call(SlateportCity_Harbor_EventScript_BoardFerry)
    warp(MAP_SS_TIDAL_CORRIDOR, 1, 10)
    waitstate
    release
    end
}

script SlateportCity_Harbor_EventScript_BattleFrontier {
    msgbox(SlateportCity_Harbor_Text_BattleFrontierItIs, MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) goto(SlateportCity_Harbor_EventScript_ChooseNewDestination)
    call(SlateportCity_Harbor_EventScript_BoardFerry)
    warp(MAP_BATTLE_FRONTIER_OUTSIDE_WEST, 19, 67)
    waitstate
    release
    end
}

script SlateportCity_Harbor_EventScript_ChooseNewDestination {
    message(SlateportCity_Harbor_Text_WhereWouldYouLikeToGo)
    waitmessage()
    goto(SlateportCity_Harbor_EventScript_ChooseDestination)
    end
}

script SlateportCity_Harbor_EventScript_BoardFerry {
    msgbox(SlateportCity_Harbor_Text_PleaseBoardFerry, MSGBOX_DEFAULT)
    closemessage
    applymovement(VAR_LAST_TALKED, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    delay(30)
    hideobjectat(VAR_LAST_TALKED, MAP_SLATEPORT_CITY_HARBOR)
    if (var(VAR_FACING) == DIR_NORTH) call(SlateportCity_Harbor_EventScript_BoardFerryNorth)
    if (var(VAR_FACING) == DIR_EAST) call(SlateportCity_Harbor_EventScript_BoardFerryEast)
    delay(30)
    hideplayer()
    setvar(VAR_0x8004, LOCALID_SLATEPORT_HARBOR_SS_TIDAL)
    call(Common_EventScript_FerryDepart)
    return
}

script SlateportCity_Harbor_EventScript_CancelDestinationSelect {
    msgbox(SlateportCity_Harbor_Text_SailAnotherTime, MSGBOX_DEFAULT)
    release
    end
}

script SlateportCity_Harbor_EventScript_BoardFerryEast {
    applymovement(LOCALID_PLAYER, SlateportCity_Harbor_Movement_BoardFerryEast)
    waitmovement(0)
    return
}

script SlateportCity_Harbor_EventScript_BoardFerryNorth {
    applymovement(LOCALID_PLAYER, SlateportCity_Harbor_Movement_BoardFerryNorth)
    waitmovement(0)
    return
}

movement SlateportCity_Harbor_Movement_BoardFerryEast {
    walk_right
    walk_in_place_faster_up
    step_end
}

movement SlateportCity_Harbor_Movement_BoardFerryNorth {
    walk_up
    step_end
}

script SlateportCity_Harbor_EventScript_Sailor {
    lock
    faceplayer
    if (!flag(FLAG_SYS_GAME_CLEAR)) goto(SlateportCity_Harbor_EventScript_SailorNoAbnormalWeather)
    setvar(VAR_0x8004, 0)
    if (flag(FLAG_DEFEATED_KYOGRE)) call(SlateportCity_Harbor_EventScript_CountDefeatedLegendary)
    if (flag(FLAG_DEFEATED_GROUDON)) call(SlateportCity_Harbor_EventScript_CountDefeatedLegendary)
    if (var(VAR_0x8004) == 2) goto(SlateportCity_Harbor_EventScript_SailorNoAbnormalWeather)
    msgbox(SlateportCity_Harbor_Text_AbnormalWeather, MSGBOX_DEFAULT)
    release
    end
}

script SlateportCity_Harbor_EventScript_SailorNoAbnormalWeather {
    msgbox(SlateportCity_Harbor_Text_LoveToGoDeepUnderwaterSomeday, MSGBOX_DEFAULT)
    release
    end
}

script SlateportCity_Harbor_EventScript_CountDefeatedLegendary {
    addvar(VAR_0x8004, 1)
    return
}

script SlateportCity_Harbor_EventScript_FatMan {
    msgbox(SlateportCity_Harbor_Text_SubTooSmallForMe, MSGBOX_NPC)
    end
}

script SlateportCity_Harbor_EventScript_CaptStern {
    lock
    faceplayer
    if (flag(FLAG_BADGE07_GET)) goto(SlateportCity_Harbor_EventScript_CaptSternFerryOrScannerComment)
    if (flag(FLAG_EVIL_TEAM_ESCAPED_STERN_SPOKE)) goto(SlateportCity_Harbor_EventScript_NeedDive)
    if (flag(FLAG_TEAM_AQUA_ESCAPED_IN_SUBMARINE)) goto(SlateportCity_Harbor_EventScript_TeamAquaLeftNeedDive)
    if (var(VAR_SLATEPORT_HARBOR_STATE) == 2) goto(SlateportCity_Harbor_EventScript_WhyStealSubmarine)
    msgbox(SlateportCity_Harbor_Text_SameThugsTriedToRobAtMuseum, MSGBOX_DEFAULT)
    closemessage
    applymovement(VAR_LAST_TALKED, Common_Movement_FaceOriginalDirection)
    waitmovement(0)
    release
    end
}

script SlateportCity_Harbor_EventScript_WhyStealSubmarine {
    msgbox(SlateportCity_Harbor_Text_CaptSternWhyStealMySubmarine, MSGBOX_DEFAULT)
    release
    end
}

script SlateportCity_Harbor_EventScript_TeamAquaLeftNeedDive {
    setflag(FLAG_EVIL_TEAM_ESCAPED_STERN_SPOKE)
    msgbox(SlateportCity_Harbor_Text_TeamAquaLeftNeedDive, MSGBOX_DEFAULT)
    release
    end
}

script SlateportCity_Harbor_EventScript_NeedDive {
    msgbox(SlateportCity_Harbor_Text_NeedDiveToCatchSub, MSGBOX_DEFAULT)
    release
    end
}

script SlateportCity_Harbor_EventScript_CaptSternFerryOrScannerComment {
    if (var(VAR_TEMP_1) == 1) goto(SlateportCity_Harbor_EventScript_TradedScanner)
    checkitem(ITEM_SCANNER)
    if (var(VAR_RESULT) == TRUE) goto(SlateportCity_Harbor_EventScript_AskToTradeScanner)
    if (flag(FLAG_SYS_GAME_CLEAR)) goto(SlateportCity_Harbor_EventScript_FerryFinished)
    msgbox(SlateportCity_Harbor_Text_WontBeLongBeforeWeFinishFerry, MSGBOX_DEFAULT)
    release
    end
}

script SlateportCity_Harbor_EventScript_FerryFinished {
    msgbox(SlateportCity_Harbor_Text_FinishedMakingFerry, MSGBOX_DEFAULT)
    release
    end
}

script SlateportCity_Harbor_EventScript_AskToTradeScanner {
    message(SlateportCity_Harbor_Text_WouldYouTradeScanner)
    waitmessage()
    goto(SlateportCity_Harbor_EventScript_ChooseScannerTrade)
    end
}

script SlateportCity_Harbor_EventScript_ChooseScannerTrade {
    multichoice(0, 0, MULTI_STERN_DEEPSEA, FALSE)
    switch(VAR_RESULT)
    case(0, SlateportCity_Harbor_EventScript_DeepSeaTooth)
    case(1, SlateportCity_Harbor_EventScript_DeepSeaScale)
    case(2, SlateportCity_Harbor_EventScript_DeclineTrade)
    case(MULTI_B_PRESSED, SlateportCity_Harbor_EventScript_DeclineTrade)
    end
}

script SlateportCity_Harbor_EventScript_DeepSeaTooth {
    msgbox(SlateportCity_Harbor_Text_TradeForDeepSeaTooth, MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) goto(SlateportCity_Harbor_EventScript_ChooseDifferentTrade)
    giveitem(ITEM_DEEP_SEA_TOOTH)
    if (var(VAR_RESULT) == FALSE) goto(Common_EventScript_ShowBagIsFull)
    removeitem(ITEM_SCANNER)
    msgbox(SlateportCity_Harbor_Text_HandedScannerToStern, MSGBOX_DEFAULT)
    setflag(FLAG_EXCHANGED_SCANNER)
    goto(SlateportCity_Harbor_EventScript_TradedScanner)
    end
}

script SlateportCity_Harbor_EventScript_DeepSeaScale {
    msgbox(SlateportCity_Harbor_Text_TradeForDeepSeaScale, MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) goto(SlateportCity_Harbor_EventScript_ChooseDifferentTrade)
    giveitem(ITEM_DEEP_SEA_SCALE)
    if (var(VAR_RESULT) == FALSE) goto(Common_EventScript_ShowBagIsFull)
    removeitem(ITEM_SCANNER)
    msgbox(SlateportCity_Harbor_Text_HandedScannerToStern, MSGBOX_DEFAULT)
    setflag(FLAG_EXCHANGED_SCANNER)
    goto(SlateportCity_Harbor_EventScript_TradedScanner)
    end
}

script SlateportCity_Harbor_EventScript_DeclineTrade {
    msgbox(SlateportCity_Harbor_Text_IfYouWantToTradeLetMeKnow, MSGBOX_DEFAULT)
    release
    end
}

script SlateportCity_Harbor_EventScript_ChooseDifferentTrade {
    message(SlateportCity_Harbor_Text_WhichOneDoYouWant)
    waitmessage()
    goto(SlateportCity_Harbor_EventScript_ChooseScannerTrade)
    end
}

script SlateportCity_Harbor_EventScript_TradedScanner {
    setvar(VAR_TEMP_1, 1)
    msgbox(SlateportCity_Harbor_Text_ThisWillHelpResearch, MSGBOX_DEFAULT)
    release
    end
}

text SlateportCity_Harbor_Text_FerryServiceUnavailable {
    "I beg your pardon?\n"
    "You're looking for a ship?\p"
    "I'm sorry, the ferry service isn't\n"
    "available at present…$"
}

text SlateportCity_Harbor_Text_MayISeeYourTicket {
    "Hello, are you here for the ferry?\n"
    "May I see your TICKET?$"
}

text SlateportCity_Harbor_Text_YouMustHaveTicket {
    "{PLAYER} doesn't have the TICKET…\p"
    "I'm terribly sorry.\p"
    "You must have a TICKET to board\n"
    "the ferry.$"
}

text SlateportCity_Harbor_Text_FlashedTicketWhereTo {
    "{PLAYER} flashed the TICKET.\p"
    "Perfect! That's all you need!\p"
    "And where would you like to go?$"
}

text SlateportCity_Harbor_Text_SailAnotherTime {
    "Please sail with us another time!$"
}

text SlateportCity_Harbor_Text_LilycoveItIs {
    "LILYCOVE CITY it is, then!$"
}

text SlateportCity_Harbor_Text_BattleFrontierItIs {
    "BATTLE FRONTIER it is, then!$"
}

text SlateportCity_Harbor_Text_PleaseBoardFerry {
    "Please board the ferry and wait for\n"
    "departure.$"
}

text SlateportCity_Harbor_Text_WhereWouldYouLikeToGo {
    "Then, where would you like to go?$"
}

text SlateportCity_Harbor_Text_LoveToGoDeepUnderwaterSomeday {
    "A journey to the bottom of the sea…\n"
    "I wonder what it'd be like?\p"
    "I'd love to go deep underwater like\n"
    "that someday.$"
}

text SlateportCity_Harbor_Text_AbnormalWeather {
    "For a ship to sail safely, we need to\n"
    "know about the weather!\p"
    "Speaking of weather, I heard something\n"
    "from a guy at the WEATHER INSTITUTE.\p"
    "He was saying abnormal weather has\n"
    "been reported all over the place!\p"
    "You should visit the WEATHER INSTITUTE\n"
    "and ask around!$"
}

text SlateportCity_Harbor_Text_SubTooSmallForMe {
    "I wanted to go with CAPT. STERN on\n"
    "the ocean floor exploration.\p"
    "But the sub's too small for me.\p"
    "If I squeezed in, there wouldn't be\n"
    "any room for the CAPTAIN…$"
}

text SlateportCity_Harbor_Text_SameThugsTriedToRobAtMuseum {
    "CAPT. STERN: Those thugs…\p"
    "They're the same lot who tried to rob\n"
    "the DEVON GOODS at the MUSEUM.$"
}

text SlateportCity_Harbor_Text_ArchieYouAgainHideoutInLilycove {
    "ARCHIE: Oh?\n"
    "Not you again…\p"
    "You are tenacious to track us here,\n"
    "that much I will give you.\p"
    "But now…\n"
    "No one can stop us! No one!\p"
    "Or, will you follow us back to our\n"
    "HIDEOUT in LILYCOVE CITY?\p"
    "Fwahahahaha…$"
}

text SlateportCity_Harbor_Text_CaptSternWhyStealMySubmarine {
    "CAPT. STERN: Why…\p"
    "Why would TEAM AQUA steal my\n"
    "SUBMARINE EXPLORER 1?\p"
    "They can't be after the slumbering\n"
    "POKéMON at the bottom of the sea…\p"
    "But even if I were to chase them,\n"
    "I don't stand a chance against them…$"
}

text SlateportCity_Harbor_Text_TeamAquaLeftNeedDive {
    "CAPT. STERN: Oh, {PLAYER}{KUN}…\p"
    "Okay… So TEAM AQUA left before you\n"
    "could stop them…\p"
    "Oh, no, don't blame yourself.\n"
    "You're not responsible for this.\p"
    "Trying to catch a submarine…\n"
    "It's impossible for most people.\p"
    "You would need a POKéMON that knows\n"
    "how to DIVE…\p"
    "Perhaps if you went out to\n"
    "MOSSDEEP CITY…\p"
    "A lot of divers live out there, so\n"
    "someone might teach you…$"
}

text SlateportCity_Harbor_Text_NeedDiveToCatchSub {
    "CAPT. STERN: Trying to catch a\n"
    "submarine… It's impossible.\p"
    "You would need a POKéMON that knows\n"
    "how to DIVE…\p"
    "Perhaps if you went out to\n"
    "MOSSDEEP CITY…\p"
    "A lot of divers live out there, so\n"
    "someone might teach you…$"
}

text SlateportCity_Harbor_Text_WontBeLongBeforeWeFinishFerry {
    "CAPT. STERN: Oh, yes.\n"
    "MR. BRINEY came to our SHIPYARD.\p"
    "It won't be long now before we finish\n"
    "making the ferry!$"
}

text SlateportCity_Harbor_Text_FinishedMakingFerry {
    "CAPT. STERN: {PLAYER}{KUN}!\p"
    "We finally finished making the ferry\n"
    "S.S. TIDAL!\p"
    "We couldn't have done it without\n"
    "your friend MR. BRINEY.\p"
    "Please go for a short cruise on it!$"
}

text SlateportCity_Harbor_Text_WouldYouTradeScanner {
    "CAPT. STERN: Oh?\n"
    "{PLAYER}{KUN}, that item you have…\p"
    "That's a SCANNER! That would sure\n"
    "help us on our explorations.\p"
    "{PLAYER}{KUN}, would you trade your\n"
    "SCANNER for something?\p"
    "Like, say, a DEEPSEATOOTH or\n"
    "a DEEPSEASCALE that I have?$"
}

text SlateportCity_Harbor_Text_IfYouWantToTradeLetMeKnow {
    "CAPT. STERN: Are you certain?\n"
    "It's useless to you, {PLAYER}{KUN}…\p"
    "Well, okay, then. If you want to trade\n"
    "your SCANNER, let me know.$"
}

text SlateportCity_Harbor_Text_TradeForDeepSeaTooth {
    "CAPT. STERN: So you'll trade it for\n"
    "my DEEPSEATOOTH?$"
}

text SlateportCity_Harbor_Text_TradeForDeepSeaScale {
    "CAPT. STERN: So you'll trade it for\n"
    "my DEEPSEASCALE?$"
}

text SlateportCity_Harbor_Text_WhichOneDoYouWant {
    "CAPT. STERN: Which one do you want?$"
}

text SlateportCity_Harbor_Text_HandedScannerToStern {
    "{PLAYER} handed the SCANNER to\n"
    "CAPT. STERN.$"
}

text SlateportCity_Harbor_Text_ThisWillHelpResearch {
    "CAPT. STERN: Thanks, {PLAYER}{KUN}!\n"
    "This will help our research a lot!$"
}
