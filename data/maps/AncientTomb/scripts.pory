mapscripts AncientTomb_MapScripts {
    MAP_SCRIPT_ON_RESUME: AncientTomb_OnResume
    MAP_SCRIPT_ON_LOAD: AncientTomb_OnLoad
    MAP_SCRIPT_ON_TRANSITION: AncientTomb_OnTransition
}

script AncientTomb_OnResume {
    if (flag(FLAG_SYS_CTRL_OBJ_DELETE)) call(AncientTomb_EventScript_TryRemoveRegisteel)
    end
}

script AncientTomb_EventScript_TryRemoveRegisteel {
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) != B_OUTCOME_CAUGHT) goto(Common_EventScript_NopReturn)
    removeobject(VAR_LAST_TALKED)
    return
}

script AncientTomb_OnTransition {
    setflag(FLAG_LANDMARK_ANCIENT_TOMB)
    if (!flag(FLAG_DEFEATED_REGISTEEL)) call(AncientTomb_EventScript_ShowRegisteel)
    end
}

script AncientTomb_EventScript_ShowRegisteel {
    clearflag(FLAG_HIDE_REGISTEEL)
    return
}

script AncientTomb_OnLoad {
    if (!flag(FLAG_SYS_REGISTEEL_PUZZLE_COMPLETED)) call(AncientTomb_EventScript_HideRegiEntrance)
    end
}

script AncientTomb_EventScript_HideRegiEntrance {
    setmetatile(7, 19, METATILE_Cave_EntranceCover, TRUE)
    setmetatile(8, 19, METATILE_Cave_EntranceCover, TRUE)
    setmetatile(9, 19, METATILE_Cave_EntranceCover, TRUE)
    setmetatile(7, 20, METATILE_Cave_SealedChamberBraille_Mid, TRUE)
    setmetatile(8, 20, METATILE_Cave_SealedChamberBraille_Mid, TRUE)
    setmetatile(9, 20, METATILE_Cave_SealedChamberBraille_Mid, TRUE)
    return
}

script AncientTomb_EventScript_CaveEntranceMiddle {
    lockall
    if (flag(FLAG_SYS_REGISTEEL_PUZZLE_COMPLETED)) goto(AncientTomb_EventScript_BigHoleInWall)
    braillemsgbox(AncientTomb_Braille_ShineInTheMiddle)
    releaseall
    end
}

script AncientTomb_EventScript_BigHoleInWall {
    msgbox(gText_BigHoleInTheWall, MSGBOX_DEFAULT)
    releaseall
    end
}

script AncientTomb_EventScript_CaveEntranceSide {
    lockall
    braillemsgbox(AncientTomb_Braille_ShineInTheMiddle)
    releaseall
    end
}

script AncientTomb_EventScript_Registeel {
    lock
    faceplayer
    waitse()
    playmoncry(SPECIES_REGISTEEL, CRY_MODE_ENCOUNTER)
    delay(40)
    waitmoncry()
    setwildbattle(SPECIES_REGISTEEL, 40)
    setflag(FLAG_SYS_CTRL_OBJ_DELETE)
    special(StartRegiBattle)
    waitstate
    clearflag(FLAG_SYS_CTRL_OBJ_DELETE)
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) == B_OUTCOME_WON) goto(AncientTomb_EventScript_DefeatedRegisteel)
    if (var(VAR_RESULT) == B_OUTCOME_RAN) goto(AncientTomb_EventScript_RanFromRegisteel)
    if (var(VAR_RESULT) == B_OUTCOME_PLAYER_TELEPORTED) goto(AncientTomb_EventScript_RanFromRegisteel)
    setflag(FLAG_DEFEATED_REGISTEEL)
    release
    end
}

script AncientTomb_EventScript_DefeatedRegisteel {
    setflag(FLAG_DEFEATED_REGISTEEL)
    goto(Common_EventScript_RemoveStaticPokemon)
    end
}

script AncientTomb_EventScript_RanFromRegisteel {
    setvar(VAR_0x8004, SPECIES_REGISTEEL)
    goto(Common_EventScript_LegendaryFlewAway)
    end
}
