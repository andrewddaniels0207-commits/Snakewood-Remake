SilphCo_6F_OnLoad::
# 6 "data/maps/SilphCo_6F_Frlg/scripts.pory"
	goto_if_unset FLAG_SILPH_6F_DOOR, SilphCo_6F_OnLoad_2
SilphCo_6F_OnLoad_1:
	end

SilphCo_6F_OnLoad_2:
# 7 "data/maps/SilphCo_6F_Frlg/scripts.pory"
	call EventScript_Close6FDoor
	goto SilphCo_6F_OnLoad_1


