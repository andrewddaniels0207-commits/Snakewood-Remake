script Route110_TrickHousePuzzle_EventScript_FoundScroll {
    playfanfare(MUS_OBTAIN_ITEM)
    message(Route110_TrickHousePuzzle_Text_FoundAScroll)
    waitfanfare()
    msgbox(Route110_TrickHousePuzzle_Text_MemorizedSecretCode, MSGBOX_DEFAULT)
    releaseall
    end
}

script Route110_TrickHouseEntrance_EventScript_TrickMasterHiding {
    lockall
    msgbox(Route110_TrickHouseEntrance_Text_YoureBeingWatched, MSGBOX_DEFAULT)
    releaseall
    if (var(VAR_TRICK_HOUSE_LEVEL) == 0) {
        call(Route110_TrickHouseEntrance_EventScript_DoHidingSpotSparkle1)
    }
    if (var(VAR_TRICK_HOUSE_LEVEL) == 1) {
        call(Route110_TrickHouseEntrance_EventScript_DoHidingSpotSparkle2)
    }
    if (var(VAR_TRICK_HOUSE_LEVEL) == 2) {
        call(Route110_TrickHouseEntrance_EventScript_DoHidingSpotSparkle3)
    }
    setvar(VAR_TRICK_HOUSE_BEING_WATCHED_STATE, 1)
    end
}

script Route110_TrickHouseEntrance_EventScript_DoHidingSpotSparkle1 {
    setvar(VAR_0x8004, 6)
    setvar(VAR_0x8005, 3)
    call(Route110_TrickHouseEntrance_EventScript_DoHidingSpotSparkle)
    return
}

script Route110_TrickHouseEntrance_EventScript_DoHidingSpotSparkle2 {
    setvar(VAR_0x8004, 11)
    setvar(VAR_0x8005, 5)
    call(Route110_TrickHouseEntrance_EventScript_DoHidingSpotSparkle)
    return
}

script Route110_TrickHouseEntrance_EventScript_DoHidingSpotSparkle3 {
    setvar(VAR_0x8004, 9)
    setvar(VAR_0x8005, 2)
    call(Route110_TrickHouseEntrance_EventScript_DoHidingSpotSparkle)
    return
}

script Route110_TrickHouseEntrance_EventScript_DoHidingSpotSparkle {
    setvar(VAR_0x8006, 0)
    dofieldeffectsparkle(VAR_0x8004, VAR_0x8005, VAR_0x8006)
    waitfieldeffect(FLDEFF_SPARKLE)
    delay(10)
    return
}

text Route110_TrickHouseEntrance_Text_YoureBeingWatched {
    "You're being watched…$"
}

text Route110_TrickHouseEntrance_Text_ConcealedBeneathDesk {
    "Hah? Grrr…\p"
    "How did you know I concealed myself\n"
    "beneath this desk? You're sharp!$"
}

text Route110_TrickHouseEntrance_Text_ConcealedBehindTree {
    "Hah? Grrr…\p"
    "How did you know I concealed myself\n"
    "behind this tree? You're sharp!$"
}

text Route110_TrickHouseEntrance_Text_ConcealedInDresser {
    "Hah? Grrr…\p"
    "How did you know I concealed myself\n"
    "in this dresser? You're sharp!$"
}

text Route110_TrickHouseEntrance_Text_ConealedBeyondWindow {
    "Hah? Grrr…\p"
    "How did you know I concealed myself\n"
    "beyond this window? You're sharp!$"
}

text Route110_TrickHouseEntrance_Text_ConcealedInPlanter {
    "Hah? Grrr…\p"
    "How did you know I concealed myself\n"
    "in this planter? You're sharp!$"
}

text Route110_TrickHouseEntrance_Text_ConcealedInCupboard {
    "Hah? Grrr…\p"
    "How did you know I concealed myself\n"
    "in this cupboard? You're sharp!$"
}

text Route110_TrickHouseEntrance_Text_ConcealedBehindWindow {
    "Hah? Grrr…\p"
    "How did you know I concealed myself\n"
    "behind this window? You're sharp!$"
}

text Route110_TrickHouseEntrance_Text_ConcealedBeneathCushion {
    "Hah? Grrr…\p"
    "How did you know I concealed myself\n"
    "beneath this cushion? You're sharp!$"
}

text Route110_TrickHouseEntrance_Text_TheyCallMeTrickMaster {
    "Behold!\p"
    "For I am the greatest living mystery\n"
    "of a man in all of HOENN!\l"
    "They call me…\p"
    "The TRICK MASTER!\n"
    "Wahahaha! Glad to meet you!$"
}

text Route110_TrickHouseEntrance_Text_ComeToChallengeTrickHouse {
    "You, you've come to challenge\n"
    "my TRICK HOUSE, haven't you?\p"
    "That's why you're here, isn't it?\n"
    "Yes, it is!\p"
    "Consider your challenge accepted!\p"
    "Enter through the scroll there,\n"
    "and let your challenge commence!\p"
    "I shall be waiting in the back!$"
}

text Route110_TrickHouseEntrance_Text_ItsAScroll {
    "It's a scroll.$"
}

text Route110_TrickHouseEntrance_Text_GoInHoleBehindScroll {
    "There is a big hole behind the scroll!\p"
    "Want to go in?$"
}

text Route110_TrickHouseEntrance_Text_LeavingOnJourneyNote {
    "There is a note affixed to the scroll…\p"
    "“I am leaving on a journey.\n"
    "Don't look for me. TRICK MASTER”$"
}

text Route110_TrickHouseEntrance_Text_NextTimeUseThisTrick {
    "For the next time, I'll use this trick,\n"
    "and that scheme, and those ruses…\p"
    "Mufufufu… If I may say so, it's\n"
    "brilliantly difficult, even for me!$"
}

text Route110_TrickHouseEntrance_Text_InMidstOfDevisingNewChallenges {
    "Hah? What?!\n"
    "Oh, it's you!\p"
    "I'm in the midst of devising new tricky\n"
    "challenges!\p"
    "It's not too much to ask for a bit more\n"
    "time for me to think, is it now?\l"
    "You wouldn't begrudge me that?\l"
    "Come back in a little while!$"
}

text Route110_TrickHouseEntrance_Text_YoureHereToAcceptReward {
    "Ah, it's you! You're here to accept the\n"
    "reward from before, isn't that right?\l"
    "Yes, right I am!\p"
    "Here!\n"
    "I'll give it to you now!$"
}

text Route110_TrickHouseEntrance_Text_DidYouNotComeToClaimReward {
    "Hah?\n"
    "Did you not come to claim your reward?$"
}

text Route110_TrickHouseEntrance_Text_MechadollWhichTent {
    "MECHADOLL 5 I AM!\n"
    "IF REWARD IS NOT TAKEN BY YOU,\l"
    "THEN TRICK MASTER YOU CANNOT FOLLOW.\p"
    "RED TENT OR BLUE TENT,\n"
    "WHICH DO YOU PREFER?$"
}

text Route110_TrickHouseEntrance_Text_ThenFarewell {
    "THEN FAREWELL.$"
}

text Route110_TrickHouseEntrance_Text_PCFullAgain {
    "YOUR PC STATUS: FULL AGAIN.\n"
    "MEAN, YOU ARE.$"
}

text Route110_TrickHousePuzzle_Text_FoundAScroll {
    "{PLAYER} found a scroll.$"
}

text Route110_TrickHousePuzzle_Text_MemorizedSecretCode {
    "{PLAYER} memorized the secret code\n"
    "written on the scroll.$"
}

text Route110_TrickHousePuzzle_Text_SecretCodeWrittenOnIt {
    "A secret code is written on it.$"
}

text Route110_TrickHouseEntrance_Text_DoorLockedWriteSecretCodeHere {
    "The door is locked.\p"
    "…On closer inspection, this is written\n"
    "on it: “Write the secret code here.”$"
}
