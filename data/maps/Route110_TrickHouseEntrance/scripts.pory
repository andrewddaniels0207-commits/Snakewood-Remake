Route110_TrickHouseEntrance_Text_InMidstOfDevisingNewChallenges::
# 1056 "data/maps/Route110_TrickHouseEntrance/scripts.pory"
	.string "Hah? What?!\n"
	.string "Oh, it's you!\p"
	.string "I'm in the midst of devising new tricky\n"
