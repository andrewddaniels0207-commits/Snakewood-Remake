}

text BattleFrontier_BattlePalaceBattleRoom_Text_AnnounceArrivalOfSpenser {
    "Let great fanfare announce the arrival\n"
    "of the PALACE MAVEN, SPENSER!$"
}

text BattleFrontier_BattlePalaceBattleRoom_Text_SpenserFirstIntro {
    "SPENSER: My physical being is with\n"
    "POKéMON always!\p"
    "My heart beats as one with\n"
    "POKéMON always!\p"
    "Young one of a TRAINER!\n"
    "Do you believe in your POKéMON?\p"
    "Can you believe them through\n"
    "and through?\p"
    "If your bonds of trust are frail,\n"
    "you will never beat my brethren!$"
}

text BattleFrontier_BattlePalaceBattleRoom_Text_ProveYourBondWithMons {
    "The bond you share with your POKéMON!\n"
    "Prove it to me here!$"
}

text BattleFrontier_BattlePalaceBattleRoom_Text_SpenserPostSilverBattle {
    "SPENSER: Gwahahah!\p"
    "Hah, you never fell for my bluster!\n"
    "Sorry for trying that stunt!\p"
    "Here!\n"
    "Bring me the thing!$"
}

text BattleFrontier_BattlePalaceBattleRoom_Text_LetsSeeFrontierPass {
    "My, my, if only you could maintain that\n"
    "facade of distinguished authority…\p"
    "Here!\n"
    "Let's see your FRONTIER PASS!$"
}

text BattleFrontier_BattlePalaceBattleRoom_Text_ReceivedSpiritsSymbol {
    "The Spirits Symbol was embossed on\n"
    "the FRONTIER PASS!$"
}

text BattleFrontier_BattlePalaceBattleRoom_Text_SpenserAwaitNextTime {
    "SPENSER: Your POKéMON's eyes are \n"
    "truly clear and unclouded.\p"
    "I will eagerly await the next\n"
    "opportunity to see you.$"
}

text BattleFrontier_BattlePalaceBattleRoom_Text_SpenserThisTimeWontHoldBack {
    "SPENSER: Gwahahah!\n"
    "You've battled your way up again?\p"
    "You must have developed a truly\n"
    "formidable bond with your POKéMON.\p"
    "So be it!\p"
    "This time, I won't bluster or hold back.\n"
    "This time, there's no fooling around.\p"
    "Ready now?\n"
    "Prepare to lose!$"
}

text BattleFrontier_BattlePalaceBattleRoom_Text_Kaaah {
    "… … …Kaaah!$"
}

text BattleFrontier_BattlePalaceBattleRoom_Text_SpenserYourTeamIsAdmirable {
    "SPENSER: Well, that was some display!\n"
    "Even fully unleashed, my brethren\l"
    "could not overpower you.\p"
    "Your team spirit is truly admirable!\p"
    "Here!\n"
    "Bring me that thing, will you?$"
}

text BattleFrontier_BattlePalaceBattleRoom_Text_HurryWithFrontierPass {
    "My, my, if only you could maintain\n"
    "a certain level of decorum…\p"
    "Gaaah, here!\n"
    "Hurry with that FRONTIER PASS, you!$"
}

text BattleFrontier_BattlePalaceBattleRoom_Text_SpiritsSymbolTookGoldenShine {
    "The Spirits Symbol took on\n"
    "a golden shine!$"
}

text BattleFrontier_BattlePalaceBattleRoom_Text_SpenserComeSeeMeAgain {
    "SPENSER: Gwahahah!\p"
    "Come see me time and again!\n"
    "My brethren and I will be waiting!$"
}
