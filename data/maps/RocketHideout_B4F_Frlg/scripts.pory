# 9 "data/maps/RocketHideout_B4F_Frlg/scripts.pory"
	compare NUM_DOOR_GRUNTS_DEFEATED, 2
	goto_if_ne RocketHideout_B4F_OnLoad_2
RocketHideout_B4F_OnLoad_1:
	end

