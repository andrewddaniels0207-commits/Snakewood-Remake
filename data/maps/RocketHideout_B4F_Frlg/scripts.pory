RocketHideout_B4F_OnLoad::
# 6 "data/maps/RocketHideout_B4F_Frlg/scripts.pory"
	setvar NUM_DOOR_GRUNTS_DEFEATED, 0
# 7 "data/maps/RocketHideout_B4F_Frlg/scripts.pory"
