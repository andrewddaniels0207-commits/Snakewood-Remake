script CeruleanCity_EventScript_Woman {
    lock
    faceplayer
    msgbox(CeruleanCity_Text_WantBrightRedBicycle)
    closemessage
    applymovement(LOCALID_CERULEAN_WOMAN, Common_Movement_FaceOriginalDirection)
    waitmovement(0)
    release
    end
}

script CeruleanCity_EventScript_Lass {
    lock
    random(3)
    copyvar(VAR_0x8008, VAR_RESULT)
    if (var(VAR_0x8008) == 0) call(CeruleanCity_EventScript_SlowbroCommand1)
    if (var(VAR_0x8008) == 1) call(CeruleanCity_EventScript_SlowbroCommand2)
    if (var(VAR_0x8008) == 2) call(CeruleanCity_EventScript_SlowbroCommand3)
    waitmessage()
    delay(40)
    playse(SE_PIN)
    applymovement(LOCALID_CERULEAN_SLOWBRO, Common_Movement_QuestionMark)
    waitmovement(0)
    delay(30)
    if (var(VAR_0x8008) == 0) call(CeruleanCity_EventScript_SlowbroFailed1)
    if (var(VAR_0x8008) == 1) call(CeruleanCity_EventScript_SlowbroFailed2)
    if (var(VAR_0x8008) == 2) call(CeruleanCity_EventScript_SlowbroFailed3)
    release
    end
}

script CeruleanCity_EventScript_SlowbroCommand1 {
    message(CeruleanCity_Text_SlowbroUseSonicboom)
    return
}

script CeruleanCity_EventScript_SlowbroCommand2 {
    message(CeruleanCity_Text_SlowbroPunch)
    return
}

script CeruleanCity_EventScript_SlowbroCommand3 {
    message(CeruleanCity_Text_SlowbroWithdraw)
    return
}

script CeruleanCity_EventScript_SlowbroFailed1 {
    msgbox(CeruleanCity_Text_SlowbroPayAttention)
    return
}

script CeruleanCity_EventScript_SlowbroFailed2 {
    msgbox(CeruleanCity_Text_NoYouBlewItAgain)
    return
}

script CeruleanCity_EventScript_SlowbroFailed3 {
    msgbox(CeruleanCity_Text_HardToControlMonsObedience)
    return
}

script CeruleanCity_EventScript_Slowbro {
    lock
    random(4)
    copyvar(VAR_0x8008, VAR_RESULT)
    if (var(VAR_0x8008) == 0) call(CeruleanCity_EventScript_SlowbroText1)
    if (var(VAR_0x8008) == 1) call(CeruleanCity_EventScript_SlowbroText2)
    if (var(VAR_0x8008) == 2) call(CeruleanCity_EventScript_SlowbroText3)
    if (var(VAR_0x8008) == 3) call(CeruleanCity_EventScript_SlowbroText4)
    release
    end
}

script CeruleanCity_EventScript_SlowbroText1 {
    msgbox(CeruleanCity_Text_SlowbroTookSnooze)
    return
}

script CeruleanCity_EventScript_SlowbroText2 {
    msgbox(CeruleanCity_Text_SlowbroLoafingAround)
    return
}

script CeruleanCity_EventScript_SlowbroText3 {
    msgbox(CeruleanCity_Text_SlowbroTurnedAway)
    return
}

script CeruleanCity_EventScript_SlowbroText4 {
    msgbox(CeruleanCity_Text_SlowbroIgnoredOrders)
    return
}

script CeruleanCity_EventScript_CitySign {
