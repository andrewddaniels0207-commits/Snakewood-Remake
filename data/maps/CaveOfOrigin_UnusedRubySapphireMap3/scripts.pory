mapscripts CaveOfOrigin_UnusedRubySapphireMap3_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: CaveOfOrigin_UnusedRubySapphireMap3_OnTransition
}

script CaveOfOrigin_UnusedRubySapphireMap3_OnTransition {
    if (flag(FLAG_UNUSED_RS_LEGENDARY_BATTLE_DONE)) call(CaveOfOrigin_EventScript_DisableTriggers)
    end
}
