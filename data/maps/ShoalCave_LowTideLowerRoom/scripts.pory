mapscripts ShoalCave_LowTideLowerRoom_MapScripts {
    MAP_SCRIPT_ON_LOAD: ShoalCave_LowTideLowerRoom_OnLoad
}

script ShoalCave_LowTideLowerRoom_OnLoad {
    call(ShoalCave_LowTideLowerRoom_EventScript_SetShoalItemMetatiles)
    end
}

script ShoalCave_LowTideLowerRoom_EventScript_SetShoalItemMetatiles {
    if (flag(FLAG_RECEIVED_SHOAL_SALT_4)) goto(ShoalCave_LowTideLowerRoom_EventScript_SetShoalItemMetatilesEnd)
    setmetatile(18, 2, METATILE_Cave_ShoalCave_DirtPile_Large, TRUE)
    return
}

script ShoalCave_LowTideLowerRoom_EventScript_SetShoalItemMetatilesEnd {
    return
}

script ShoalCave_LowTideLowerRoom_EventScript_ShoalSalt4 {
    lockall
    if (flag(FLAG_RECEIVED_SHOAL_SALT_4)) goto(ShoalCave_LowTideLowerRoom_EventScript_ReceivedShoalSalt)
    giveitem(ITEM_SHOAL_SALT)
    if (var(VAR_RESULT) == FALSE) goto(Common_EventScript_ShowBagIsFull)
    setmetatile(18, 2, METATILE_Cave_ShoalCave_DirtPile_Small, FALSE)
    special(DrawWholeMapView)
    setflag(FLAG_RECEIVED_SHOAL_SALT_4)
    releaseall
    end
}

script ShoalCave_LowTideLowerRoom_EventScript_ReceivedShoalSalt {
    msgbox(ShoalCave_Text_WasShoalSaltNowNothing, MSGBOX_DEFAULT)
    releaseall
    end
}

script ShoalCave_LowTideLowerRoom_EventScript_BlackBelt {
    lock
    faceplayer
    if (flag(FLAG_RECEIVED_FOCUS_BAND)) goto(ShoalCave_LowTideLowerRoom_EventScript_ReceivedFocusBand)
    msgbox(ShoalCave_LowTideLowerRoom_Text_CanOvercomeColdWithFocus, MSGBOX_DEFAULT)
    giveitem(ITEM_FOCUS_BAND)
    if (var(VAR_RESULT) == FALSE) goto(Common_EventScript_ShowBagIsFull)
    setflag(FLAG_RECEIVED_FOCUS_BAND)
    release
    end
}

script ShoalCave_LowTideLowerRoom_EventScript_ReceivedFocusBand {
    msgbox(ShoalCave_LowTideLowerRoom_Text_EverythingStartsWithFocus, MSGBOX_DEFAULT)
    release
    end
}

text ShoalCave_LowTideLowerRoom_Text_CanOvercomeColdWithFocus {
    "The penetrating cold around these\n"
    "parts is an impediment to training.\p"
    "But with focus, one can overcome!\p"
    "With this FOCUS BAND, buckle down and\n"
    "withstand the cold!$"
}

text ShoalCave_LowTideLowerRoom_Text_EverythingStartsWithFocus {
    "Everything starts with focus!$"
}
