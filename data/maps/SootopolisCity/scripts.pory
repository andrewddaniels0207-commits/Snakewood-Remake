    msgbox(SootopolisCity_Text_SawLegendWithOwnEyes, MSGBOX_DEFAULT)
    releaseall
    end
}

script SootopolisCity_EventScript_Wallace {
    lock
    faceplayer
    if (var(VAR_SOOTOPOLIS_CITY_STATE) == 4) {
        goto(SootopolisCity_EventScript_GoToSkyPillar)
    }
    if (flag(FLAG_RECEIVED_HM_WATERFALL)) {
        goto(SootopolisCity_EventScript_GoToGym)
    }
    if (flag(FLAG_SOOTOPOLIS_ARCHIE_MAXIE_LEAVE)) {
        goto(SootopolisCity_EventScript_GiveWaterfall)
    }
    msgbox(SootopolisCity_Text_AquaMagmaDidntMeanHarm, MSGBOX_DEFAULT)
    release
    end
}

script SootopolisCity_EventScript_GiveWaterfall {
    msgbox(SootopolisCity_Text_ThankYouForHelpAcceptThis, MSGBOX_DEFAULT)
    giveitem(ITEM_HM_WATERFALL)
    setflag(FLAG_RECEIVED_HM_WATERFALL)
    msgbox(SootopolisCity_Text_ExplainWaterfallGoToGym, MSGBOX_DEFAULT)
    closemessage
    if (var(VAR_FACING) == DIR_NORTH) {
        call(SootopolisCity_EventScript_WallaceMoveFromGym)
    }
    if (var(VAR_FACING) == DIR_EAST) {
        call(SootopolisCity_EventScript_WallaceMoveFromGym)
    }
    if (var(VAR_FACING) == DIR_WEST) {
        call(SootopolisCity_EventScript_WallaceMoveFromGymWest)
    }
    release
    end
}

script SootopolisCity_EventScript_WallaceMoveFromGym {
    applymovement(LOCALID_SOOTOPOLIS_WALLACE, SootopolisCity_Movement_WallaceMoveFromGym)
    waitmovement(0)
    copyobjectxytoperm(LOCALID_SOOTOPOLIS_WALLACE)
    setvar(VAR_SOOTOPOLIS_WALLACE_STATE, 1)
    return
}

script SootopolisCity_EventScript_WallaceMoveFromGymWest {
    applymovement(LOCALID_SOOTOPOLIS_WALLACE, SootopolisCity_Movement_WallaceMoveFromGymWest)
    waitmovement(0)
    copyobjectxytoperm(LOCALID_SOOTOPOLIS_WALLACE)
    setvar(VAR_SOOTOPOLIS_WALLACE_STATE, 2)
    return
}

script SootopolisCity_EventScript_GoToSkyPillar {
    msgbox(SootopolisCity_Text_HaventYouScaledSkyPillar, MSGBOX_DEFAULT)
    release
    end
}

script SootopolisCity_EventScript_GoToGym {
    msgbox(SootopolisCity_Text_DazzledByMentor, MSGBOX_DEFAULT)
    release
    end
}

movement SootopolisCity_Movement_WallaceMoveFromGym {
    walk_right
    walk_in_place_faster_down
    step_end
}

movement SootopolisCity_Movement_WallaceMoveFromGymWest {
    walk_left
    walk_in_place_faster_down
    step_end
}

script SootopolisCity_EventScript_Maxie {
    lockall
    if (var(VAR_SOOTOPOLIS_CITY_STATE) == 5) {
        goto(SootopolisCity_EventScript_MaxieRayquaza)
    }
    msgbox(SootopolisCity_Text_GroudonPleaseStop, MSGBOX_DEFAULT)
    closemessage
    releaseall
    end
}

script SootopolisCity_EventScript_MaxieRayquaza {
    msgbox(SootopolisCity_Text_AfterAllOurScheming, MSGBOX_DEFAULT)
    setflag(FLAG_MET_MAXIE_SOOTOPOLIS)
    if (flag(FLAG_MET_ARCHIE_SOOTOPOLIS)) {
        goto(SootopolisCity_EventScript_MaxieArchieLeave)
    }
    releaseall
    end
}

script SootopolisCity_EventScript_Archie {
    lockall
    if (var(VAR_SOOTOPOLIS_CITY_STATE) == 5) {
        goto(SootopolisCity_EventScript_ArchieRayquaza)
    }
    msgbox(SootopolisCity_Text_KyogreCalmDown, MSGBOX_DEFAULT)
    closemessage
    releaseall
    end
}

script SootopolisCity_EventScript_ArchieRayquaza {
    msgbox(SootopolisCity_Text_TryingMeaninglessToPokemon, MSGBOX_DEFAULT)
    setflag(FLAG_MET_ARCHIE_SOOTOPOLIS)
    if (flag(FLAG_MET_MAXIE_SOOTOPOLIS)) {
        goto(SootopolisCity_EventScript_MaxieArchieLeave)
    }
    releaseall
    end
}

script SootopolisCity_EventScript_MaxieArchieLeave {
    setflag(FLAG_HIDE_SOOTOPOLIS_CITY_MAXIE)
    setflag(FLAG_HIDE_SOOTOPOLIS_CITY_ARCHIE)
    setflag(FLAG_SOOTOPOLIS_ARCHIE_MAXIE_LEAVE)
    clearflag(FLAG_HIDE_MT_PYRE_SUMMIT_MAXIE)
    clearflag(FLAG_HIDE_MT_PYRE_SUMMIT_ARCHIE)
    setvar(VAR_MT_PYRE_STATE, 2)
    warpsilent(MAP_SOOTOPOLIS_CITY, 31, 34)
    waitstate
    releaseall
    end
}

script SootopolisCity_Movement_Levitate {
    levitate()
    step_end()
}

script SootopolisCity_Movement_DestroyTask {
    destroy_extra_task()
    step_end()
}

text SootopolisCity_Text_GymSign {
    "SOOTOPOLIS CITY POKéMON GYM\n"
    "LEADER: JUAN\p"
    "“The GYM LEADER with the beauty\n"
    "of pure water!”$"
}

text SootopolisCity_Text_CitySign {
    "SOOTOPOLIS CITY\p"
    "“The mystical city where history\n"
    "slumbers.”$"
}

text SootopolisCity_Text_DoorIsClosed {
    "The door is closed.$"
}

text SootopolisCity_Text_PhysicallyFitLivingHere {
    "Diving in the sea. Climbing up and\n"
    "down stairs all the time…\p"
    "If you live in this town, you end up\n"
    "getting physically fit.$"
}

text SootopolisCity_Text_GiantPokemonSuddenlyAppeared {
    "These giant POKéMON suddenly appeared\n"
    "in the middle of the city!\p"
    "And, I've never seen them before!\p"
    "Why are they smashing into each\n"
    "other like that?\p"
    "Why can't they be friends, those\n"
    "POKéMON?$"
}

text SootopolisCity_Text_WhatIsThatGreenPokemon {
    "What? What? What?\n"
    "What is that green POKéMON?!$"
}

text SootopolisCity_Text_WhereDidLegendariesGo {
    "GROUDON and KYOGRE…\n"
    "Where did they go?\p"
    "Will they cause droughts or downpours\n"
    "somewhere else?$"
}

text SootopolisCity_Text_TwoPokemonArentAngry {
    "I just get this sense somehow that\n"
    "the two POKéMON aren't angry.\p"
    "I think… They probably can't control\n"
    "their own power…$"
}

text SootopolisCity_Text_FlyingMonStoppedRampage {
    "That flying POKéMON came down from\n"
    "the sky and stopped the rampaging\l"
    "POKéMON…$"
}

text SootopolisCity_Text_WonderWhatWorldIsLike {
    "I… I've never been out of this city.\p"
    "I wonder what the world is like on\n"
    "the other side of this round sky?$"
}

text SootopolisCity_Text_ThisIsWicked {
    "Wow!\n"
    "This is wicked!$"
}

text SootopolisCity_Text_ThatWasWicked {
    "Wow!\n"
    "That was wicked!$"
}

text SootopolisCity_Text_GoRedAndBlueMon {
    "Go for it, red POKéMON!\n"
    "Don't back off, blue POKéMON!$"
}

text SootopolisCity_Text_DoYouKnowMonNames {
    "… … … … … …\p"
    "Hi, do you know the names of those\n"
    "POKéMON fighting over there?$"
}

text SootopolisCity_Text_GreenOneSettlesThings {
    "I was wondering which one would win,\n"
    "the red one or the blue one, but, oh no,\l"
    "it's the green one that settles things!\p"
    "Talk about a huge turn of events!$"
}

text SootopolisCity_Text_SeeingLegendWithOwnEyes {
    "There's an ancient legend that claims\n"
    "the land and sea were shaped by\l"
    "a colossal battle between POKéMON.\p"
    "Well, I'm seeing that happen with\n"
    "my very own eyes!\p"
    "Whoa! I never expected to be\n"
    "witness to something this huge!$"
}

text SootopolisCity_Text_SawLegendWithOwnEyes {
    "There's an ancient legend that claims\n"
    "the land and sea were shaped by\l"
    "a colossal battle between POKéMON.\p"
    "Well, I saw that happen with\n"
    "my very own eyes!\p"
    "Whoa! I never expected to be\n"
    "witness to something this huge!$"
}

text SootopolisCity_Text_BigPokemonFighting {
    "A big POKéMON is fighting with\n"
    "another big POKéMON!\p"
    "Please, someone make them stop!$"
}

text SootopolisCity_Text_PrettyMonCameFromSky {
    "A pretty POKéMON came down from\n"
    "the sky…$"
}

text SootopolisCity_Text_SootopolisWillBeWrecked {
    "Oh, no!\n"
    "SOOTOPOLIS CITY will get wrecked!$"
}

text SootopolisCity_Text_SootopolisDidntGetWrecked {
    "SOOTOPOLIS CITY didn't get wrecked!$"
}

text SootopolisCity_Text_NoOrdinaryTourist {
    "Hm!\n"
    "You've come all the way to SOOTOPOLIS?\l"
    "You're no ordinary tourist.\p"
    "But I suppose that doesn't make you\n"
    "an extraordinary tourist, either.$"
}

text SootopolisCity_Text_CityRegainedCalm {
    "The city has regained its calm…$"
}

text SootopolisCity_Text_CaveOfOriginPleaseLeave {
    "Who might you be?\p"
    "This is the CAVE OF ORIGIN.\p"
    "The spirits of POKéMON, becalmed at\n"
    "MT. PYRE, are said to be revived here.\p"
    "Please leave.$"
}

text SootopolisCity_Text_LeadSuperiorTrainerToCave {
    "A person with a strong will and\n"
    "superior talent…\p"
    "A TRAINER who has knowledge and\n"
    "experience of many kinds of POKéMON…\p"
    "If such a person were to appear, I was\n"
    "instructed by WALLACE to lead that\l"
    "TRAINER to this CAVE.$"
}

text SootopolisCity_Text_AwakenedPokemonClash {
    "Oh, my…\p"
    "The clash between the two awakened\n"
    "POKéMON was quelled by the awakening\l"
    "of a third POKéMON…$"
}

text SootopolisCity_Text_CaveOfOriginSleepsToo {
    "This is the CAVE OF ORIGIN…\p"
    "With the passing of the crisis,\n"
    "the cave, too, shall sleep…$"
}

text SootopolisCity_Text_SootopolisSkyBeautiful {
    "SOOTOPOLIS sprang up as a town in\n"
    "the crater of a volcano.\p"
    "If you look up at the sky, the lip of\n"
    "the crater is also visible.\l"
    "So, all you see is the sky in a circle.\p"
    "But that's what makes the sky above\n"
    "SOOTOPOLIS the most beautiful.$"
}

text SootopolisCity_Text_GiganticPokemonFight {
    "When two POKéMON that gigantic\n"
    "are fighting that savagely, there's\l"
    "not much that we can do.$"
}

text SootopolisCity_Text_FearedWorstWhenPokemonFlewDown {
    "When that third POKéMON flew down,\n"
    "I feared the worst.$"
}

text SootopolisCity_Text_NightSkyFavoriteScenery {
    "A circle of a night sky framed by\n"
    "the crater of a volcano…\p"
    "And in that ring, stars flicker and\n"
    "blink as if they were alive…\l"
    "It's my favorite scenery.$"
}

text SootopolisCity_Text_WeatherWentWild {
    "The weather was clear this morning,\n"
    "but…\p"
    "All of a sudden, dark clouds brewed up,\n"
    "rain started falling in sheets, and\l"
    "there was thunder and lightning, too.\p"
    "The weather just went completely\n"
    "wild!\p"
    "Is all of this because of those\n"
    "POKéMON?$"
}

text SootopolisCity_Text_YouBroughtFlyingMon {
    "Oh?\p"
    "It was you who brought that flying\n"
    "POKéMON here?\p"
    "Well, aren't you amazing!$"
}

text SootopolisCity_Text_GroudonPleaseStop {
    "MAXIE: G… GROUDON…\n"
    "Please! Stop what you're doing!\p"
    "I know the extent of your power now!\p"
    "If you keep going, all HOENN, not just\n"
    "SOOTOPOLIS, will be utterly ruined!$"
}

text SootopolisCity_Text_AfterAllOurScheming {
    "MAXIE: So the super-ancient POKéMON\n"
    "weren't only GROUDON and KYOGRE…\p"
    "After all our fruitless scheming and\n"
    "frantic efforts, that one POKéMON's\l"
    "simple action puts everything right\l"
    "again as if nothing had happened…\p"
    "Fu…\n"
    "Fuhahaha…$"
}

text SootopolisCity_Text_KyogreCalmDown {
    "ARCHIE: KYOGRE! What's wrong?!\n"
    "Look over here! It's the RED ORB!\l"
    "Calm down! KYOGRE!\p"
    "… … … … … …\n"
    "… … … … … …\p"
    "It's no good!\n"
    "It's not responding at all!$"
}

text SootopolisCity_Text_TryingMeaninglessToPokemon {
    "ARCHIE: KYOGRE and GROUDON both\n"
    "flew off to who knows where.\p"
    "The weather in HOENN has returned\n"
    "to its normal state…\p"
    "Haha…\n"
    "Hahaha…\p"
    "Maybe what we were trying to do was\n"
    "something small, even meaningless,\l"
    "to POKéMON…$"
}

text SootopolisCity_Text_InvolvedWithCrisisComeWithMe {
    "STEVEN: Those POKéMON fighting…\n"
    "GROUDON… And KYOGRE…\p"
    "The two super-ancient POKéMON\n"
    "were awakened from a long sleep…\p"
    "And now they are smashing each other\n"
    "with their uncontrollable energy…\p"
    "…{PLAYER}{KUN}.\p"
    "You being here now I'll take to mean\n"
    "that you're prepared to become\l"
    "involved in this crisis.\p"
    "Well, then, there's someone that\n"
    "I'd like you to meet.\p"
    "Come with me, please.$"
}

text SootopolisCity_Text_DoesThisMakeYourFearPokemon {
    "STEVEN: Listen, {PLAYER}{KUN}.\p"
    "Does seeing GROUDON and KYOGRE make\n"
    "you think POKéMON are to be feared?\p"
    "But that's not true.\n"
    "POKéMON are really more…\p"
    "…Why am I asking you this?\n"
    "You already know.$"
}

text SootopolisCity_Text_HereWereAreHelpWallace {
    "STEVEN: Okay, here we are!\p"
    "Inside here you'll find someone named\n"
    "WALLACE.\p"
    "I think you have what's needed to\n"
    "help him…$"
}

text SootopolisCity_Text_KnowWhatsNeededToHelpHim {
    "STEVEN: I think you have what's\n"
    "needed to help him…$"
}

text SootopolisCity_Text_NeverBeenToSkyPillar {
    "STEVEN: The SKY PILLAR…\p"
    "I've never been there.\n"
    "I wonder where it could be?$"
}

text SootopolisCity_Text_SoThatsRayquaza {
    "STEVEN: So that's RAYQUAZA…\p"
    "It's incredible how the two rampaging\n"
    "POKéMON would flee from it in fear…$"
}

text SootopolisCity_Text_MaxieArchieLeft {
    "STEVEN: It looks like both MAXIE and\n"
    "ARCHIE have gone away somewhere.\p"
    "Perhaps they've gone to MT. PYRE to\n"
    "return those ORBS…$"
}

text SootopolisCity_Text_HaventYouScaledSkyPillar {
    "WALLACE: Oh?\n"
    "{PLAYER}{KUN}?\p"
    "Haven't you scaled the SKY PILLAR\n"
    "yet?\p"
    "I'm sure that you can make it to\n"
    "the top of the SKY PILLAR…$"
}

text SootopolisCity_Text_AquaMagmaDidntMeanHarm {
    "WALLACE: {PLAYER}{KUN}…\p"
    "The leaders of TEAM MAGMA and AQUA,\n"
    "I don't think they meant harm.\p"
    "It wouldn't hurt to hear what they\n"
    "have to say for themselves.$"
}

text SootopolisCity_Text_ThankYouForHelpAcceptThis {
    "WALLACE: {PLAYER}{KUN}…\n"
    "My eyes didn't deceive me.\p"
    "Thanks to your help, SOOTOPOLIS…\n"
    "No, all of HOENN was saved.\p"
    "On behalf of the people, I thank you.\p"
    "This is a gift from me.\n"
    "Please accept it.$"
}

text SootopolisCity_Text_ExplainWaterfallGoToGym {
    "That HIDDEN MACHINE contains\n"
    "WATERFALL.\p"
    "If you have the RAIN BADGE, a POKéMON\n"
    "that has learned that HM move can\l"
    "force its way up waterfalls.\p"
    "And where does one get the RAIN BADGE?\n"
    "You know, don't you?\p"
    "That's right! You have to beat\n"
    "the SOOTOPOLIS GYM LEADER.\p"
    "When you're all set to go, step through\n"
    "that door.$"
}

text SootopolisCity_Text_DazzledByMentor {
    "WALLACE: I'm sure that you will be\n"
    "dazzled by my mentor's breathtakingly\l"
    "elegant battle style.$"
}
