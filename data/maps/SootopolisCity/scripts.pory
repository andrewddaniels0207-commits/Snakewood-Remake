    step_end
}

movement SootopolisCity_Movement_ExpertMoveAside {
    walk_slow_left
    walk_in_place_faster_right
    step_end
}

movement SootopolisCity_Movement_StevenArriveCaveEntrance {
    walk_down
    walk_down
    walk_left
    delay_8
    walk_right
    walk_up
    walk_up
    walk_up
    walk_right
    walk_in_place_faster_left
    step_end
}

movement SootopolisCity_Movement_PlayerArriveCaveEntrance {
    delay_16
    delay_16
    delay_16
    delay_8
    walk_right
    walk_right
    walk_up
    walk_up
    walk_up
    walk_in_place_faster_right
    step_end
}

movement SootopolisCity_Movement_PlayerEnterCaveOfOrigin {
    walk_up
    walk_up
    step_end
}

script SootopolisCity_EventScript_Boy2 {
    lockall
    applymovement(LOCALID_SOOTOPOLIS_BOY_2, Common_Movement_FacePlayer)
    waitmovement(0)
    if (var(VAR_SOOTOPOLIS_CITY_STATE) == 5) {
        goto(SootopolisCity_EventScript_Boy2Rayquaza)
    }
    msgbox(SootopolisCity_Text_TwoPokemonArentAngry, MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_SOOTOPOLIS_BOY_2, Common_Movement_FaceOriginalDirection)
    waitmovement(0)
    releaseall
    end
}

script SootopolisCity_EventScript_Boy2Rayquaza {
    msgbox(SootopolisCity_Text_FlyingMonStoppedRampage, MSGBOX_DEFAULT)
    closemessage
    releaseall
    end
}

