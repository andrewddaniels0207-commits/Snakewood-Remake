mapscripts SilphCo_7F_Frlg_MapScripts {
    MAP_SCRIPT_ON_LOAD: SilphCo_7F_OnLoad
    MAP_SCRIPT_ON_TRANSITION: SilphCo_7F_OnTransition
}

script SilphCo_7F_OnLoad {
    if (!flag(FLAG_SILPH_7F_DOOR_1)) call(EventScript_Close7FDoor1)
    if (!flag(FLAG_SILPH_7F_DOOR_2)) call(EventScript_Close7FDoor2)
    if (!flag(FLAG_SILPH_7F_DOOR_3)) call(EventScript_Close7FDoor3)
    end
}

script SilphCo_7F_OnTransition {
    if (var(VAR_MAP_SCENE_SILPH_CO_11F) >= 1) call(SilphCo_7F_EventScript_SetObjRocketsGone)
    end
}

script SilphCo_7F_EventScript_SetObjRocketsGone {
    setobjectmovementtype(LOCALID_SILPH_CO_7F_WORKER_M2, MOVEMENT_TYPE_FACE_UP)
    return
}

script SilphCo_7F_EventScript_RivalTriggerTop {
    lockall
    setvar(VAR_TEMP_1, 0)
    goto(SilphCo_7F_EventScript_RivalScene)
    end
}

script SilphCo_7F_EventScript_RivalTriggerBottom {
    lockall
    setvar(VAR_TEMP_1, 1)
    goto(SilphCo_7F_EventScript_RivalScene)
    end
}

script SilphCo_7F_EventScript_RivalScene {
    textcolor(NPC_TEXT_COLOR_MALE)
    playbgm(MUS_RG_ENCOUNTER_RIVAL, 0)
    applymovement(LOCALID_SILPH_CO_RIVAL, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterDown)
    applymovement(LOCALID_SILPH_CO_RIVAL, Common_Movement_Delay48)
    waitmovement(0)
    msgbox(SilphCo_7F_Text_RivalWhatKeptYou)
    if (var(VAR_TEMP_1) == 0) call(SilphCo_7F_EventScript_RivalApproachTop)
    if (var(VAR_TEMP_1) == 1) call(SilphCo_7F_EventScript_RivalApproachBottom)
    msgbox(SilphCo_7F_Text_RivalIntro)
    setvar(VAR_LAST_TALKED, LOCALID_SILPH_CO_RIVAL)
    if (var(VAR_STARTER_MON) == 2) call(SilphCo_7F_EventScript_RivalSquirtle)
    if (var(VAR_STARTER_MON) == 1) call(SilphCo_7F_EventScript_RivalBulbasaur)
    if (var(VAR_STARTER_MON) == 0) call(SilphCo_7F_EventScript_RivalCharmander)
    msgbox(SilphCo_7F_Text_RivalPostBattle)
    closemessage
    playbgm(MUS_RG_RIVAL_EXIT, 0)
    if (var(VAR_TEMP_1) == 0) call(SilphCo_7F_EventScript_RivalExitTop)
    if (var(VAR_TEMP_1) == 1) call(SilphCo_7F_EventScript_RivalExitBottom)
    playse(SE_WARP_IN)
    fadedefaultbgm()
    removeobject(LOCALID_SILPH_CO_RIVAL)
    waitse()
    setvar(VAR_MAP_SCENE_SILPH_CO_7F, 1)
    releaseall
    end
}

script SilphCo_7F_EventScript_RivalApproachTop {
    closemessage
    applymovement(LOCALID_SILPH_CO_RIVAL, SilphCo_7F_Movement_RivalApproachTop)
    waitmovement(0)
    return
}

script SilphCo_7F_EventScript_RivalApproachBottom {
    return
}

script SilphCo_7F_EventScript_RivalSquirtle {
    trainerbattle_no_intro(TRAINER_RIVAL_SILPH_SQUIRTLE, SilphCo_7F_Text_RivalDefeat)
    return
}

script SilphCo_7F_EventScript_RivalBulbasaur {
    trainerbattle_no_intro(TRAINER_RIVAL_SILPH_BULBASAUR, SilphCo_7F_Text_RivalDefeat)
    return
}

script SilphCo_7F_EventScript_RivalCharmander {
    trainerbattle_no_intro(TRAINER_RIVAL_SILPH_CHARMANDER, SilphCo_7F_Text_RivalDefeat)
    return
}

script SilphCo_7F_EventScript_RivalExitTop {
    applymovement(LOCALID_SILPH_CO_RIVAL, SilphCo_7F_Movement_RivalExitTop)
    waitmovement(0)
    return
}

script SilphCo_7F_EventScript_RivalExitBottom {
    applymovement(LOCALID_SILPH_CO_RIVAL, SilphCo_7F_Movement_RivalExitBottom)
    waitmovement(0)
    return
}

movement SilphCo_7F_Movement_RivalApproachTop {
    walk_up
    step_end
}

movement SilphCo_7F_Movement_RivalExitTop {
    walk_right
    walk_right
    walk_right
    walk_up
    delay_16
    step_end
}

movement SilphCo_7F_Movement_RivalExitBottom {
    walk_left
    walk_up
    walk_up
    walk_right
    walk_right
    walk_right
    walk_right
    delay_16
    step_end
}

script SilphCo_7F_EventScript_LaprasGuy {
    lock
    faceplayer
    if (flag(FLAG_GOT_LAPRAS_FROM_SILPH)) goto(SilphCo_7F_EventScript_AlreadyGotLapras)
    msgbox(SilphCo_7F_Text_HaveMonForSavingUs)
    setvar(VAR_TEMP_1, SPECIES_LAPRAS)
    givemon(SPECIES_LAPRAS, 25)
    if (var(VAR_RESULT) == 0) goto(SilphCo_7F_EventScript_ReceiveLaprasParty)
    if (var(VAR_RESULT) == 1) goto(SilphCo_7F_EventScript_ReceiveLaprasPC)
    if (var(VAR_RESULT) == 2) goto(Common_EventScript_NoMoreRoomForPokemon)
    release
    end
}

script SilphCo_7F_EventScript_ReceiveLaprasParty {
    textcolor(NPC_TEXT_COLOR_NEUTRAL)
    playfanfare(MUS_LEVEL_UP)
    message(SilphCo_7F_Text_ObtainedLaprasFromEmployee)
    waitmessage()
    waitfanfare()
    bufferspeciesname(STR_VAR_1, SPECIES_LAPRAS)
    msgbox(gText_NicknameThisPokemon, MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) goto(SilphCo_7F_EventScript_EndReceiveLapras)
    call(Common_EventScript_GetGiftMonPartySlot)
    call(Common_EventScript_NameReceivedPartyMon)
    goto(SilphCo_7F_EventScript_EndReceiveLapras)
    end
}

script SilphCo_7F_EventScript_ReceiveLaprasPC {
    textcolor(NPC_TEXT_COLOR_NEUTRAL)
    playfanfare(MUS_LEVEL_UP)
    message(SilphCo_7F_Text_ObtainedLaprasFromEmployee)
    waitmessage()
    waitfanfare()
    bufferspeciesname(STR_VAR_1, SPECIES_LAPRAS)
    msgbox(gText_NicknameThisPokemon, MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) goto(SilphCo_7F_EventScript_LaprasTransferredToPC)
    call(Common_EventScript_NameReceivedBoxMon)
    goto(SilphCo_7F_EventScript_LaprasTransferredToPC)
    end
}

script SilphCo_7F_EventScript_LaprasTransferredToPC {
    call(Common_EventScript_TransferredToPC)
    goto(SilphCo_7F_EventScript_EndReceiveLapras)
    end
}

script SilphCo_7F_EventScript_EndReceiveLapras {
    textcolor(NPC_TEXT_COLOR_MALE)
    msgbox(SilphCo_7F_Text_ExplainLapras)
    setflag(FLAG_GOT_LAPRAS_FROM_SILPH)
    release
    end
}

script SilphCo_7F_EventScript_AlreadyGotLapras {
    msgbox(SilphCo_7F_Text_RocketBossWentToBoardroom)
    release
    end
}

script SilphCo_7F_EventScript_WorkerM1 {
    lock
    faceplayer
    if (var(VAR_MAP_SCENE_SILPH_CO_11F) >= 1) goto(SilphCo_7F_EventScript_WorkerM1RocketsGone)
    msgbox(SilphCo_7F_Text_RocketsAfterMasterBall)
    release
    end
}

script SilphCo_7F_EventScript_WorkerM1RocketsGone {
