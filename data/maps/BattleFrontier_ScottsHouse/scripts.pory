	setflag FLAG_SCOTT_GIVES_BATTLE_POINTS
# 287 "data/maps/BattleFrontier_ScottsHouse/scripts.pory"
	setflag FLAG_TEMP_2
# 288 "data/maps/BattleFrontier_ScottsHouse/scripts.pory"
	release
	end


