mapscripts ThreeIsland_DunsparceTunnel_Frlg_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: ThreeIsland_DunsparceTunnel_OnTransition
}

script ThreeIsland_DunsparceTunnel_OnTransition {
    setworldmapflag(FLAG_WORLD_MAP_THREE_ISLAND_DUNSPARCE_TUNNEL)
    specialvar(VAR_RESULT, IsNationalPokedexEnabled)
    copyvar(VAR_0x8008, VAR_RESULT)
    if (var(VAR_0x8008) == TRUE) {
        call(ThreeIsland_DunsparceTunnel_EventScript_SetLayoutDugOut)
    }
    if (var(VAR_0x8008) == FALSE) {
        call(ThreeIsland_DunsparceTunnel_EventScript_MoveProspectorToWall)
    }
    end
}

script ThreeIsland_DunsparceTunnel_EventScript_SetLayoutDugOut {
    setmaplayoutindex(LAYOUT_THREE_ISLAND_DUNSPARCE_TUNNEL_DUG_OUT)
    return
}

script ThreeIsland_DunsparceTunnel_EventScript_MoveProspectorToWall {
    setobjectxyperm(LOCALID_PROSPECTOR, 6, 3)
    setobjectmovementtype(LOCALID_PROSPECTOR, MOVEMENT_TYPE_FACE_RIGHT)
    return
}

script ThreeIsland_DunsparceTunnel_EventScript_Prospector {
    lock
    faceplayer
    if (flag(FLAG_GOT_NUGGET_FROM_DUNSPARCE_TUNNEL)) {
        goto(ThreeIsland_DunsparceTunnel_EventScript_ProspectorAlreadyGaveNugget)
    }
    specialvar(VAR_RESULT, IsNationalPokedexEnabled)
    if (var(VAR_RESULT) == TRUE) {
        goto(ThreeIsland_DunsparceTunnel_EventScript_ProspectorStruckGold)
    }
    msgbox(ThreeIsland_DunsparceTunnel_Text_ProspectingForGold)
    closemessage
    applymovement(LOCALID_PROSPECTOR, Common_Movement_FaceOriginalDirection)
    waitmovement(0)
    release
    end
}

script ThreeIsland_DunsparceTunnel_EventScript_ProspectorStruckGold {
    msgbox(ThreeIsland_DunsparceTunnel_Text_StruckGoldThisIsForYou)
    giveitem(ITEM_NUGGET)
    if (var(VAR_RESULT) == FALSE) {
        goto(ThreeIsland_DunsparceTunnel_EventScript_NoRoomForNugget)
    }
    setflag(FLAG_GOT_NUGGET_FROM_DUNSPARCE_TUNNEL)
    goto(ThreeIsland_DunsparceTunnel_EventScript_ProspectorAlreadyGaveNugget)
    end
}

script ThreeIsland_DunsparceTunnel_EventScript_NoRoomForNugget {
    msgbox(ThreeIsland_DunsparceTunnel_Text_WhoopsBagCrammedFull)
    release
    end
}

script ThreeIsland_DunsparceTunnel_EventScript_ProspectorAlreadyGaveNugget {
    msgbox(ThreeIsland_DunsparceTunnel_Text_ThatsANugget)
    release
    end
}

text ThreeIsland_DunsparceTunnel_Text_ProspectingForGold {
    "Hey, there!\n"
    "How's it going?\p"
    "What am I doing here, you ask?\n"
    "Why, I'm prospecting for gold!\p"
    "When I strike it rich, I'm buying\n"
    "a house in KANTO.$"
}

text ThreeIsland_DunsparceTunnel_Text_StruckGoldThisIsForYou {
    "Hey, there! How's it going?\n"
    "Did you hear? I've struck gold!\p"
    "You remembered that I was\n"
    "prospecting, didn't you?\p"
    "You can't begin to imagine just\n"
    "how happy I am.\p"
    "So, I'll show you!\n"
    "This is for you!$"
}

text ThreeIsland_DunsparceTunnel_Text_ThatsANugget {
    "That's a NUGGET!\p"
    "I can't give you any nuggets of\n"
    "wisdom, so that'll have to do!$"
}

text ThreeIsland_DunsparceTunnel_Text_WhoopsBagCrammedFull {
    "Whoops, your BAG is crammed full!\n"
    "I'll give this to you later.$"
}
