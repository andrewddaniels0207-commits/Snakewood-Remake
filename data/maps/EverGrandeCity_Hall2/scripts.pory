mapscripts EverGrandeCity_Hall2_MapScripts {
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE: EverGrandeCity_Hall2_OnWarp
}

raw `
EverGrandeCity_Hall2_OnWarp:
	map_script_2 VAR_TEMP_1, 0, EverGrandeCity_Hall2_EventScript_TurnPlayerNorth
	.2byte 0

`

script EverGrandeCity_Hall2_EventScript_TurnPlayerNorth {
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    end
}
