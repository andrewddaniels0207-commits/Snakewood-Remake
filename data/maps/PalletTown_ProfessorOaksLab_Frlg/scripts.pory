script PalletTown_ProfessorOaksLab_EventScript_EndRivalBattle {
    special(HealPlayerParty)
    msgbox(PalletTown_ProfessorOaksLab_Text_RivalGoToughenMyMon)
    closemessage
    playbgm(MUS_RG_RIVAL_EXIT, 0)
    if (var(VAR_TEMP_2) == 1) call(PalletTown_ProfessorOaksLab_EventScript_RivalExitAfterBattleLeft)
    if (var(VAR_TEMP_2) == 2) call(PalletTown_ProfessorOaksLab_EventScript_RivalExitAfterBattleMid)
    if (var(VAR_TEMP_2) == 3) call(PalletTown_ProfessorOaksLab_EventScript_RivalExitAfterBattleRight)
    removeobject(LOCALID_OAKS_LAB_RIVAL)
    playse(SE_EXIT)
    fadedefaultbgm()
    setvar(VAR_MAP_SCENE_PALLET_TOWN_PROFESSOR_OAKS_LAB, 4)
    setflag(FLAG_BEAT_RIVAL_IN_OAKS_LAB)
    releaseall
    end
}

script PalletTown_ProfessorOaksLab_EventScript_RivalExitAfterBattleLeft {
    applymovement(LOCALID_OAKS_LAB_RIVAL, PalletTown_ProfessorOaksLab_Movement_RivalExitAfterBattleLeft)
    applymovement(LOCALID_PLAYER, PalletTown_ProfessorOaksLab_Movement_PlayerWatchRivalExitAfterBattle)
    waitmovement(LOCALID_OAKS_LAB_RIVAL)
    return
}

