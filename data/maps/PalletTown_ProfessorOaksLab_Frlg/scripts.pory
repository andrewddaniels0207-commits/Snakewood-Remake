    lock
    faceplayer
    setvar(PLAYER_STARTER_NUM, 2)
    setvar(PLAYER_STARTER_SPECIES, SPECIES_CHARMANDER)
    setvar(RIVAL_STARTER_SPECIES, SPECIES_SQUIRTLE)
    setvar(RIVAL_STARTER_ID, LOCALID_SQUIRTLE_BALL)
    if (var(VAR_MAP_SCENE_PALLET_TOWN_PROFESSOR_OAKS_LAB) >= 3) goto(PalletTown_ProfessorOaksLab_EventScript_LastPokeBall)
    if (var(VAR_MAP_SCENE_PALLET_TOWN_PROFESSOR_OAKS_LAB) == 2) goto(PalletTown_ProfessorOaksLab_EventScript_ConfirmStarterChoice)
    msgbox(PalletTown_ProfessorOaksLab_Text_ThoseArePokeBalls)
    release
    end
}

script PalletTown_ProfessorOaksLab_EventScript_LastPokeBall {
    msgbox(PalletTown_ProfessorOaksLab_Text_OaksLastMon)
    release
    end
}

