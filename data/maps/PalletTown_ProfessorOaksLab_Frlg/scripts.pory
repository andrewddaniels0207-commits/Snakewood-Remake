script PalletTown_ProfessorOaksLab_EventScript_Rival {
    lock
    faceplayer
    if (var(VAR_MAP_SCENE_PALLET_TOWN_PROFESSOR_OAKS_LAB) == 3) goto(PalletTown_ProfessorOaksLab_EventScript_RivalChoseStarter)
    if (var(VAR_MAP_SCENE_PALLET_TOWN_PROFESSOR_OAKS_LAB) == 2) goto(PalletTown_ProfessorOaksLab_EventScript_RivalWaitingForStarter)
    msgbox(PalletTown_ProfessorOaksLab_Text_RivalGrampsIsntAround)
    release
    end
}

script PalletTown_ProfessorOaksLab_EventScript_RivalWaitingForStarter {
    msgbox(PalletTown_ProfessorOaksLab_Text_RivalGoChoosePlayer)
    release
    end
}

script PalletTown_ProfessorOaksLab_EventScript_RivalChoseStarter {
    msgbox(PalletTown_ProfessorOaksLab_Text_RivalMyMonLooksTougher)
    release
    end
}

script PalletTown_ProfessorOaksLab_EventScript_ProfOak {
    lock
    faceplayer
    if (flag(SHOWED_OAK_COMPLETE_DEX)) goto(PalletTown_ProfessorOaksLab_EventScript_OakJustShownCompleteDex)
    if (var(VAR_MAP_SCENE_PALLET_TOWN_PROFESSOR_OAKS_LAB) == 9) goto(PalletTown_ProfessorOaksLab_EventScript_RatePokedex)
    if (var(VAR_MAP_SCENE_PALLET_TOWN_PROFESSOR_OAKS_LAB) == 8) goto(PalletTown_ProfessorOaksLab_EventScript_MonsAroundWorldWait)
    if (flag(FLAG_SYS_GAME_CLEAR)) goto(PalletTown_ProfessorOaksLab_EventScript_TryStartNationalDexScene)
    if (var(VAR_MAP_SCENE_CERULEAN_CITY_RIVAL) == 1) goto(PalletTown_ProfessorOaksLab_EventScript_RatePokedex)
    if (var(VAR_MAP_SCENE_PALLET_TOWN_PROFESSOR_OAKS_LAB) == 6) goto(PalletTown_ProfessorOaksLab_EventScript_RatePokedexOrTryGiveBalls)
    if (var(VAR_MAP_SCENE_VIRIDIAN_CITY_MART) >= 1) goto(PalletTown_ProfessorOaksLab_EventScript_ReceiveDexScene)
    if (var(VAR_MAP_SCENE_PALLET_TOWN_PROFESSOR_OAKS_LAB) == 4) goto(PalletTown_ProfessorOaksLab_EventScript_OakBattleMonForItToGrow)
    if (var(VAR_MAP_SCENE_PALLET_TOWN_PROFESSOR_OAKS_LAB) == 3) goto(PalletTown_ProfessorOaksLab_EventScript_OakCanReachNextTownWithMon)
    msgbox(PalletTown_ProfessorOaksLab_Text_OakWhichOneWillYouChoose)
    release
    end
}

script PalletTown_ProfessorOaksLab_EventScript_OakJustShownCompleteDex {
    msgbox(PokedexRating_Text_ThankYouMadeDreamReality)
    release
    end
}

script PalletTown_ProfessorOaksLab_EventScript_OakCanReachNextTownWithMon {
    msgbox(PalletTown_ProfessorOaksLab_Text_OakCanReachNextTownWithMon)
    release
    end
}

script PalletTown_ProfessorOaksLab_EventScript_OakBattleMonForItToGrow {
    msgbox(PalletTown_ProfessorOaksLab_Text_OakBattleMonForItToGrow)
    release
    end
}

script PalletTown_ProfessorOaksLab_EventScript_ReceiveDexScene {
    msgbox(PalletTown_ProfessorOaksLab_Text_OakHaveSomethingForMe)
    textcolor(NPC_TEXT_COLOR_NEUTRAL)
    playfanfare(MUS_OBTAIN_TMHM)
    message(PalletTown_ProfessorOaksLab_Text_DeliveredOaksParcel)
    waitmessage()
    waitfanfare()
    call(EventScript_RestorePrevTextColor)
    removeitem(ITEM_OAKS_PARCEL)
    msgbox(PalletTown_ProfessorOaksLab_Text_OakCustomBallIOrdered)
    playbgm(MUS_RG_ENCOUNTER_RIVAL, 0)
    msgbox(PalletTown_ProfessorOaksLab_Text_RivalGramps)
    closemessage
    if (var(VAR_FACING) == DIR_NORTH) call(PalletTown_ProfessorOaksLab_EventScript_DexSceneRivalEnterNorth)
    if (var(VAR_FACING) == DIR_SOUTH) call(PalletTown_ProfessorOaksLab_EventScript_DexSceneRivalEnterSouth)
    if (var(VAR_FACING) == DIR_EAST) call(PalletTown_ProfessorOaksLab_EventScript_DexSceneRivalEnterEastWest)
    if (var(VAR_FACING) == DIR_WEST) call(PalletTown_ProfessorOaksLab_EventScript_DexSceneRivalEnterEastWest)
    fadedefaultbgm()
    msgbox(PalletTown_ProfessorOaksLab_Text_RivalWhatDidYouCallMeFor)
    closemessage
    delay(30)
    playse(SE_PIN)
    applymovement(LOCALID_OAKS_LAB_PROF_OAK, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(LOCALID_OAKS_LAB_PROF_OAK, Common_Movement_Delay48)
    waitmovement(0)
    if (var(VAR_FACING) == DIR_SOUTH) call(PalletTown_ProfessorOaksLab_EventScript_DexSceneOakFacePlayerAndRivalSouth)
    if (var(VAR_FACING) == DIR_EAST) call(PalletTown_ProfessorOaksLab_EventScript_DexSceneOakFacePlayerAndRivalEast)
    if (var(VAR_FACING) == DIR_WEST) call(PalletTown_ProfessorOaksLab_EventScript_DexSceneOakFacePlayerAndRivalWest)
    if (var(VAR_FACING) == DIR_NORTH) call(PalletTown_ProfessorOaksLab_EventScript_DexSceneOakFacePlayerAndRivalNorth)
    msgbox(PalletTown_ProfessorOaksLab_Text_OakHaveRequestForYouTwo)
    closemessage
    if (var(VAR_FACING) == DIR_NORTH) call(PalletTown_ProfessorOaksLab_EventScript_DexSceneOakWalkToDeskNorth)
    if (var(VAR_FACING) == DIR_SOUTH) call(PalletTown_ProfessorOaksLab_EventScript_DexSceneOakWalkToDeskSouth)
    if (var(VAR_FACING) == DIR_EAST) call(PalletTown_ProfessorOaksLab_EventScript_DexSceneOakWalkToDeskEast)
    if (var(VAR_FACING) == DIR_WEST) call(PalletTown_ProfessorOaksLab_EventScript_DexSceneOakWalkToDeskWest)
    msgbox(PalletTown_ProfessorOaksLab_Text_OakPokedexOnDesk)
    closemessage
    delay(40)
    msgbox(PalletTown_ProfessorOaksLab_Text_OakTakeTheseWithYou)
    closemessage
    applymovement(LOCALID_OAKS_LAB_PROF_OAK, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    removeobject(LOCALID_POKEDEX_1)
    delay(10)
    removeobject(LOCALID_POKEDEX_2)
    delay(25)
    if (var(VAR_FACING) == DIR_NORTH) call(PalletTown_ProfessorOaksLab_EventScript_OakBringDexesOverNorth)
    if (var(VAR_FACING) == DIR_SOUTH) call(PalletTown_ProfessorOaksLab_EventScript_OakBringDexesOverSouth)
    if (var(VAR_FACING) == DIR_EAST) call(PalletTown_ProfessorOaksLab_EventScript_OakBringDexesOverEast)
    if (var(VAR_FACING) == DIR_WEST) call(PalletTown_ProfessorOaksLab_EventScript_OakBringDexesOverWest)
    delay(10)
    textcolor(NPC_TEXT_COLOR_NEUTRAL)
    playfanfare(MUS_RG_OBTAIN_KEY_ITEM)
    message(PalletTown_ProfessorOaksLab_Text_ReceivedPokedexFromOak)
    waitmessage()
    waitfanfare()
    call(EventScript_RestorePrevTextColor)
    setflag(FLAG_SYS_POKEDEX_GET)
    special(SetUnlockedPokedexFlags)
    setvar(VAR_MAP_SCENE_POKEMON_CENTER_TEALA, 1)
    msgbox(PalletTown_ProfessorOaksLab_Text_OakCatchMonsForDataTakeThese)
    giveitem_msg(PalletTown_ProfessorOaksLab_Text_ReceivedFivePokeBalls, ITEM_POKE_BALL, 5)
    msgbox(PalletTown_ProfessorOaksLab_Text_OakExplainCatching)
    famechecker(FAMECHECKER_OAK, 1)
    msgbox(PalletTown_ProfessorOaksLab_Text_OakCompleteMonGuideWasMyDream)
    msgbox(PalletTown_ProfessorOaksLab_Text_RivalLeaveItToMeGramps)
    if (var(VAR_FACING) == DIR_NORTH) call(PalletTown_ProfessorOaksLab_EventScript_DexSceneRivalFacePlayerNorth)
    if (var(VAR_FACING) == DIR_SOUTH) call(PalletTown_ProfessorOaksLab_EventScript_DexSceneRivalFacePlayerSouth)
    if (var(VAR_FACING) == DIR_EAST) call(PalletTown_ProfessorOaksLab_EventScript_DexSceneRivalFacePlayerEastWest)
    if (var(VAR_FACING) == DIR_WEST) call(PalletTown_ProfessorOaksLab_EventScript_DexSceneRivalFacePlayerEastWest)
    msgbox(PalletTown_ProfessorOaksLab_Text_RivalTellSisNotToGiveYouMap)
    closemessage
    playbgm(MUS_RG_RIVAL_EXIT, 0)
    if (var(VAR_FACING) == DIR_NORTH) call(PalletTown_ProfessorOaksLab_EventScript_RivalExitNorth)
    if (var(VAR_FACING) == DIR_SOUTH) call(PalletTown_ProfessorOaksLab_EventScript_RivalExit)
    if (var(VAR_FACING) == DIR_EAST) call(PalletTown_ProfessorOaksLab_EventScript_RivalExit)
    if (var(VAR_FACING) == DIR_WEST) call(PalletTown_ProfessorOaksLab_EventScript_RivalExit)
    removeobject(LOCALID_OAKS_LAB_RIVAL)
    fadedefaultbgm()
    setvar(VAR_MAP_SCENE_PALLET_TOWN_PROFESSOR_OAKS_LAB, 6)
    setvar(VAR_MAP_SCENE_VIRIDIAN_CITY_MART, 2)
    setvar(VAR_MAP_SCENE_VIRIDIAN_CITY_OLD_MAN, 1)
    setvar(VAR_MAP_SCENE_PALLET_TOWN_RIVALS_HOUSE, 1)
    setvar(VAR_MAP_SCENE_ROUTE22, 1)
    release
    end
}

