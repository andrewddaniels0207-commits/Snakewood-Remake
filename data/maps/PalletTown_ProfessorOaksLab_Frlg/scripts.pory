script PalletTown_ProfessorOaksLab_EventScript_RivalBattleSquirtle {
    trainerbattle_earlyrival(TRAINER_RIVAL_OAKS_LAB_SQUIRTLE, RIVAL_BATTLE_TUTORIAL, PalletTown_ProfessorOaksLab_Text_RivalDefeat, Text_RivalVictory)
    goto(PalletTown_ProfessorOaksLab_EventScript_EndRivalBattle)
    end
}

movement PalletTown_ProfessorOaksLab_Movement_RivalApproachForBattleSquirtleLeft {
    walk_left
    walk_left
    walk_left
    walk_left
    walk_down
    walk_down
    step_end
}

