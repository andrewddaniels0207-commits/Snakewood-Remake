    walk_up
    step_end
}

script PalletTown_ProfessorOaksLab_EventScript_RivalBattleTriggerLeft {
    lockall
    setvar(VAR_TEMP_2, 1)
    goto(PalletTown_ProfessorOaksLab_EventScript_RivalBattle)
    end
}

script PalletTown_ProfessorOaksLab_EventScript_RivalBattleTriggerMid {
    lockall
    setvar(VAR_TEMP_2, 2)
    goto(PalletTown_ProfessorOaksLab_EventScript_RivalBattle)
    end
}

script PalletTown_ProfessorOaksLab_EventScript_RivalBattleTriggerRight {
    lockall
    setvar(VAR_TEMP_2, 3)
    goto(PalletTown_ProfessorOaksLab_EventScript_RivalBattle)
    end
}

script PalletTown_ProfessorOaksLab_EventScript_RivalBattle {
    textcolor(NPC_TEXT_COLOR_MALE)
    playbgm(MUS_RG_ENCOUNTER_RIVAL, 0)
    applymovement(LOCALID_OAKS_LAB_RIVAL, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    msgbox(PalletTown_ProfessorOaksLab_Text_RivalLetsCheckOutMons)
    closemessage
    applymovement(LOCALID_OAKS_LAB_PROF_OAK, Common_Movement_FaceDown)
    waitmovement(0)
    if (var(VAR_STARTER_MON) == 0) goto(PalletTown_ProfessorOaksLab_EventScript_RivalApproachForBattleCharmander)
    if (var(VAR_STARTER_MON) == 1) goto(PalletTown_ProfessorOaksLab_EventScript_RivalApproachForBattleBulbasaur)
    if (var(VAR_STARTER_MON) == 2) goto(PalletTown_ProfessorOaksLab_EventScript_RivalApproachForBattleSquirtle)
    end
}

script PalletTown_ProfessorOaksLab_EventScript_RivalApproachForBattleSquirtle {
    if (var(VAR_TEMP_2) == 1) goto(PalletTown_ProfessorOaksLab_EventScript_RivalApproachForBattleSquirtleLeft)
    if (var(VAR_TEMP_2) == 2) goto(PalletTown_ProfessorOaksLab_EventScript_RivalApproachForBattleSquirtleMid)
    if (var(VAR_TEMP_2) == 3) goto(PalletTown_ProfessorOaksLab_EventScript_RivalApproachForBattleSquirtleRight)
    end
}

