mapscripts MtEmber_Summit_Frlg_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: MtEmber_Summit_OnTransition
    MAP_SCRIPT_ON_RESUME: MtEmber_Summit_OnResume
}

script MtEmber_Summit_OnResume {
    if (flag(FLAG_SYS_CTRL_OBJ_DELETE)) {
        call(MtEmber_Summit_EventScript_TryRemoveMoltres)
    }
    end
}

script MtEmber_Summit_EventScript_TryRemoveMoltres {
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) != B_OUTCOME_CAUGHT) {
        goto(Common_EventScript_NopReturn)
    }
    removeobject(VAR_LAST_TALKED)
    return
}

script MtEmber_Summit_OnTransition {
    if (!flag(FLAG_FOUGHT_MOLTRES)) {
        call(MtEmber_Summit_EventScript_ShowMoltres)
    }
    end
}

script MtEmber_Summit_EventScript_ShowMoltres {
    clearflag(FLAG_HIDE_MOLTRES)
    return
}

script MtEmber_Summit_EventScript_Moltres {
    lock
    faceplayer
    setwildbattle(SPECIES_MOLTRES, 50)
    waitse()
    playmoncry(SPECIES_MOLTRES, CRY_MODE_ENCOUNTER)
    message(Text_Gyaoo)
    waitmessage()
    waitmoncry()
    delay(10)
    playbgm(MUS_RG_ENCOUNTER_GYM_LEADER, 0)
    waitbuttonpress()
    setflag(FLAG_SYS_CTRL_OBJ_DELETE)
    special(BattleSetup_StartLegendaryBattle)
    waitstate
    clearflag(FLAG_SYS_CTRL_OBJ_DELETE)
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) == B_OUTCOME_WON) {
        goto(MtEmber_Summit_EventScript_DefeatedMoltres)
    }
    if (var(VAR_RESULT) == B_OUTCOME_RAN) {
        goto(MtEmber_Summit_EventScript_RanFromMoltres)
    }
    if (var(VAR_RESULT) == B_OUTCOME_PLAYER_TELEPORTED) {
        goto(MtEmber_Summit_EventScript_RanFromMoltres)
    }
    setflag(FLAG_FOUGHT_MOLTRES)
    release
    end
}

script MtEmber_Summit_EventScript_DefeatedMoltres {
    setflag(FLAG_FOUGHT_MOLTRES)
    goto(EventScript_RemoveStaticMon)
    end
}

script MtEmber_Summit_EventScript_RanFromMoltres {
    setvar(VAR_0x8004, SPECIES_MOLTRES)
    goto(EventScript_MonFlewAway)
    end
}
