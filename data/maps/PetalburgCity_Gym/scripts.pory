mapscripts PetalburgCity_Gym_MapScripts {
    MAP_SCRIPT_ON_LOAD: PetalburgCity_Gym_OnLoad
    MAP_SCRIPT_ON_TRANSITION: PetalburgCity_Gym_OnTransition
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE: PetalburgCity_Gym_OnWarp
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_PETALBURG_GYM_STATE, 1: PetalburgCity_Gym_EventScript_ReturnFromWallyTutorial
    ]
}

script PetalburgCity_Gym_OnLoad {
    if (var(VAR_PETALBURG_GYM_STATE) == 6) {
        goto(PetalburgCity_Gym_EventScript_OpenUnlockedDoors)
    }
    if (var(VAR_PETALBURG_GYM_STATE) >= 7) {
        call(PetalburgCity_Gym_EventScript_UnlockAllDoors)
    }
    end
}

script PetalburgCity_Gym_EventScript_OpenUnlockedDoors {
    setvar(VAR_0x8005, 1)
    call(PetalburgCity_Gym_EventScript_OpenGymEntranceDoors)
    call_if_defeated(TRAINER_RANDALL, PetalburgCity_Gym_EventScript_OpenSpeedRoomDoors)
    call_if_defeated(TRAINER_MARY, PetalburgCity_Gym_EventScript_OpenAccuracyRoomDoors)
    call_if_defeated(TRAINER_PARKER, PetalburgCity_Gym_EventScript_OpenConfusionRoomDoors)
    call_if_defeated(TRAINER_ALEXIA, PetalburgCity_Gym_EventScript_OpenDefenseRoomDoors)
    call_if_defeated(TRAINER_GEORGE, PetalburgCity_Gym_EventScript_OpenRecoveryRoomDoors)
    call_if_defeated(TRAINER_JODY, PetalburgCity_Gym_EventScript_OpenStrengthRoomDoors)
    call_if_defeated(TRAINER_BERKE, PetalburgCity_Gym_EventScript_OpenOHKORoomDoors)
    end
}

script PetalburgCity_Gym_EventScript_UnlockAllDoors {
    setvar(VAR_0x8005, 1)
    call(PetalburgCity_Gym_EventScript_OpenGymEntranceDoors)
    call(PetalburgCity_Gym_EventScript_OpenSpeedRoomDoors)
    call(PetalburgCity_Gym_EventScript_OpenAccuracyRoomDoors)
    call(PetalburgCity_Gym_EventScript_OpenConfusionRoomDoors)
    call(PetalburgCity_Gym_EventScript_OpenDefenseRoomDoors)
    call(PetalburgCity_Gym_EventScript_OpenRecoveryRoomDoors)
    call(PetalburgCity_Gym_EventScript_OpenStrengthRoomDoors)
    call(PetalburgCity_Gym_EventScript_OpenOHKORoomDoors)
    return
}

script PetalburgCity_Gym_OnTransition {
    if (var(VAR_PETALBURG_GYM_STATE) == 1) {
        call(PetalburgCity_Gym_EventScript_MoveWallyToEntrance)
    }
    if (var(VAR_PETALBURG_GYM_STATE) < 6) {
        call(PetalburgCity_Gym_EventScript_MoveNormanToEntrance)
    }
    if (flag(FLAG_SYS_GAME_CLEAR)) {
        call(PetalburgCity_Gym_EventScript_CheckNormanForRematch)
    }
    end
}

script PetalburgCity_Gym_EventScript_MoveWallyToEntrance {
    setobjectxyperm(LOCALID_PETALBURG_GYM_WALLY, 5, 108)
    return
}

script PetalburgCity_Gym_EventScript_MoveNormanToEntrance {
    setobjectxyperm(LOCALID_PETALBURG_GYM_NORMAN, 4, 107)
    return
}

script PetalburgCity_Gym_EventScript_CheckNormanForRematch {
    setorcopyvar(VAR_TRAINER_BATTLE_OPPONENT_A, TRAINER_NORMAN_1)
    specialvar(VAR_RESULT, IsTrainerReadyForRematch)
    if (var(VAR_RESULT) == TRUE) {
        goto(PetalburgCity_Gym_EventScript_DontMoveNormanToFront)
    }
    if (var(VAR_PETALBURG_GYM_STATE) == 8) {
        goto(PetalburgCity_Gym_EventScript_DontMoveNormanToFront)
    }
    setobjectxyperm(LOCALID_PETALBURG_GYM_NORMAN, 4, 107)
    return
}

script PetalburgCity_Gym_EventScript_DontMoveNormanToFront {
    setvar(VAR_PETALBURG_GYM_STATE, 8)
    end
}

raw `
PetalburgCity_Gym_OnWarp:
	map_script_2 VAR_PETALBURG_GYM_STATE, 1, PetalburgCity_Gym_EventScript_TurnPlayerNorth
	.2byte 0

`

script PetalburgCity_Gym_EventScript_TurnPlayerNorth {
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    end
}

script PetalburgCity_Gym_EventScript_ReturnFromWallyTutorial {
    lockall
    msgbox(PetalburgCity_Gym_Text_DadSoDidItWorkOut, MSGBOX_DEFAULT)
    msgbox(PetalburgCity_Gym_Text_WallyThankYouBye, MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterDown)
    applymovement(LOCALID_PETALBURG_GYM_WALLY, PetalburgCity_Gym_Movement_WallyExitGym)
    waitmovement(0)
    playse(SE_EXIT)
    removeobject(LOCALID_PETALBURG_GYM_WALLY)
    setflag(FLAG_HIDE_PETALBURG_CITY_WALLY)
    delay(30)
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    msgbox(PetalburgCity_Gym_Text_DadGoCollectBadges, MSGBOX_DEFAULT)
    setvar(VAR_PETALBURG_GYM_STATE, 2)
    releaseall
    end
}

movement PetalburgCity_Gym_Movement_WallyExitGym {
    walk_down
    walk_down
    walk_down
    delay_16
    step_end
}

script PetalburgCity_Gym_EventScript_Norman {
    vsseeker_rematchid(TRAINER_NORMAN_1)
    lock
    faceplayer
    switch (var(VAR_PETALBURG_GYM_STATE)) {
        case 2:
            goto(PetalburgCity_Gym_EventScript_NormanNoBadges)
        case 3:
            goto(PetalburgCity_Gym_EventScript_NormanOneBadge)
        case 4:
            goto(PetalburgCity_Gym_EventScript_NormanTwoBadges)
        case 5:
            goto(PetalburgCity_Gym_EventScript_NormanThreeBadges)
        case 6:
            goto(PetalburgCity_Gym_EventScript_NormanBattle)
        case 7:
            goto(PetalburgCity_Gym_EventScript_NormanPostBattle)
        case 8:
            goto(PetalburgCity_Gym_EventScript_NormanRematch)
    }
    msgbox(PetalburgCity_Gym_Text_DadYoureHereWithYourPokemon, MSGBOX_DEFAULT)
    closemessage
    switch (var(VAR_FACING)) {
        case DIR_SOUTH:
            goto(PetalburgCity_Gym_EventScript_BeginWallyTutorialSouth)
        case DIR_NORTH:
            goto(PetalburgCity_Gym_EventScript_BeginWallyTutorialNorth)
        case DIR_WEST:
            goto(PetalburgCity_Gym_EventScript_BeginWallyTutorialWest)
        case DIR_EAST:
            goto(PetalburgCity_Gym_EventScript_BeginWallyTutorialEast)
    }
    end
}

script PetalburgCity_Gym_EventScript_BeginWallyTutorialSouth {
    setvar(VAR_0x8008, 0)
    goto(PetalburgCity_Gym_EventScript_BeginWallyTutorial)
    end
}

script PetalburgCity_Gym_EventScript_BeginWallyTutorialNorth {
    setvar(VAR_0x8008, 1)
    goto(PetalburgCity_Gym_EventScript_BeginWallyTutorial)
    end
}

script PetalburgCity_Gym_EventScript_BeginWallyTutorialWest {
    setvar(VAR_0x8008, 2)
    goto(PetalburgCity_Gym_EventScript_BeginWallyTutorial)
    end
}

script PetalburgCity_Gym_EventScript_BeginWallyTutorialEast {
    setvar(VAR_0x8008, 3)
    goto(PetalburgCity_Gym_EventScript_BeginWallyTutorial)
    end
}

script PetalburgCity_Gym_EventScript_BeginWallyTutorial {
    addobject(LOCALID_PETALBURG_GYM_WALLY)
    playse(SE_DOOR)
    if (var(VAR_0x8008) == 0) {
        call(PetalburgCity_Gym_EventScript_WallyArriveSouth)
    }
    if (var(VAR_0x8008) == 1) {
        call(PetalburgCity_Gym_EventScript_WallyArriveNorth)
    }
    if (var(VAR_0x8008) == 2) {
        call(PetalburgCity_Gym_EventScript_WallyArriveWestEast)
    }
    if (var(VAR_0x8008) == 3) {
        call(PetalburgCity_Gym_EventScript_WallyArriveWestEast)
    }
    msgbox(PetalburgCity_Gym_Text_WallyIdLikeAPokemon, MSGBOX_DEFAULT)
    msgbox(PetalburgCity_Gym_Text_DadOhYoureWallyRight, MSGBOX_DEFAULT)
    msgbox(PetalburgCity_Gym_Text_WallyIveNeverCaughtAPokemon, MSGBOX_DEFAULT)
    msgbox(PetalburgCity_Gym_Text_DadHmISee, MSGBOX_DEFAULT)
    if (var(VAR_0x8008) == 0) {
        call(PetalburgCity_Gym_EventScript_NormanAddressPlayerSouth)
    }
    if (var(VAR_0x8008) == 1) {
        call(PetalburgCity_Gym_EventScript_NormanAddressPlayerNorth)
    }
    if (var(VAR_0x8008) == 2) {
        call(PetalburgCity_Gym_EventScript_NormanAddressPlayerWest)
    }
    if (var(VAR_0x8008) == 3) {
        call(PetalburgCity_Gym_EventScript_NormanAddressPlayerEast)
    }
    msgbox(PetalburgCity_Gym_Text_DadPlayerGoWithWally, MSGBOX_DEFAULT)
    if (var(VAR_0x8008) == 0) {
        call(PetalburgCity_Gym_EventScript_NormanAddressWallySouth)
    }
    if (var(VAR_0x8008) == 1) {
        call(PetalburgCity_Gym_EventScript_NormanAddressWallyNorth)
    }
    if (var(VAR_0x8008) == 2) {
        call(PetalburgCity_Gym_EventScript_NormanAddressWallyWest)
    }
    if (var(VAR_0x8008) == 3) {
        call(PetalburgCity_Gym_EventScript_NormanAddressWallyEast)
    }
    msgbox(PetalburgCity_Gym_Text_IllLoanYouMyZigzagoon, MSGBOX_DEFAULT)
    msgbox(PetalburgCity_Gym_Text_WallyThankYouAndDadGivesPokeBall, MSGBOX_DEFAULT)
    msgbox(PetalburgCity_Gym_Text_WallyOhWowThankYou, MSGBOX_DEFAULT)
    if (var(VAR_0x8008) == 0) {
        call(PetalburgCity_Gym_EventScript_NormanFaceDoorSouth)
    }
    if (var(VAR_0x8008) == 1) {
        call(PetalburgCity_Gym_EventScript_NormanFaceDoorNorth)
    }
    if (var(VAR_0x8008) == 2) {
        call(PetalburgCity_Gym_EventScript_NormanFaceDoorWest)
    }
    if (var(VAR_0x8008) == 3) {
        call(PetalburgCity_Gym_EventScript_NormanFaceDoorEast)
    }
    if (var(VAR_0x8008) == 0) {
        call(PetalburgCity_Gym_EventScript_WallyFacePlayer)
    }
    if (var(VAR_0x8008) == 1) {
        call(PetalburgCity_Gym_EventScript_WallyFaceDown)
    }
    if (var(VAR_0x8008) == 2) {
        call(PetalburgCity_Gym_EventScript_WallyFacePlayer)
    }
    if (var(VAR_0x8008) == 3) {
        call(PetalburgCity_Gym_EventScript_WallyFacePlayer)
    }
    msgbox(PetalburgCity_Gym_Text_WouldYouReallyComeWithMe, MSGBOX_DEFAULT)
    closemessage
    setflag(FLAG_DONT_TRANSITION_MUSIC)
    playbgm(MUS_FOLLOW_ME, FALSE)
    if (var(VAR_0x8008) == 0) {
        call(PetalburgCity_Gym_EventScript_ExitGymWithWallySouth)
    }
    if (var(VAR_0x8008) == 1) {
        call(PetalburgCity_Gym_EventScript_ExitGymWithWallyNorth)
    }
    if (var(VAR_0x8008) == 2) {
        call(PetalburgCity_Gym_EventScript_ExitGymWithWallyWest)
    }
    if (var(VAR_0x8008) == 3) {
        call(PetalburgCity_Gym_EventScript_ExitGymWithWallyEast)
    }
    removeobject(LOCALID_PETALBURG_GYM_WALLY)
    setflag(FLAG_HIDE_PETALBURG_CITY_WALLYS_MOM)
    setvar(VAR_PETALBURG_GYM_STATE, 1)
    setvar(VAR_PETALBURG_CITY_STATE, 2)
    clearflag(FLAG_HIDE_PETALBURG_CITY_WALLY)
    clearflag(FLAG_HIDE_PETALBURG_GYM_WALLY)
    setflag(FLAG_HIDE_LITTLEROOT_TOWN_BIRCHS_LAB_RIVAL)
    special(InitBirchState)
    warp(MAP_PETALBURG_CITY, 15, 8)
    waitstate
    release
    end
}

