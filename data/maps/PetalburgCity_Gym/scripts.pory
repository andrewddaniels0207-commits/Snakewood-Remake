    applymovement(LOCALID_PETALBURG_GYM_NORMAN, Common_Movement_WalkInPlaceFasterRight)
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterRight)
    waitmovement(0)
    return
}

