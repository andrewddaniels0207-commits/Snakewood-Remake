    applymovement(LOCALID_PETALBURG_GYM_NORMAN, Common_Movement_WalkInPlaceFasterDown)
    applymovement(LOCALID_PETALBURG_GYM_WALLY, PetalburgCity_Gym_Movement_WallyArrive)
    waitmovement(0)
    return
}

