mapscripts SafariZone_South_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: SafariZone_South_OnTransition
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_SAFARI_ZONE_STATE, 2: SafariZone_South_EventScript_EnterSafariZone
    ]
}

script SafariZone_South_EventScript_EnterSafariZone {
    lockall
    applymovement(LOCALID_PLAYER, SafariZone_South_Movement_PlayerEnter)
    waitmovement(0)
    applymovement(LOCALID_SAFARI_EXIT_ATTENDANT, SafariZone_South_Movement_ExitAttendantBlockDoor)
    waitmovement(0)
    setobjectxyperm(LOCALID_SAFARI_EXIT_ATTENDANT, 32, 34)
    setvar(VAR_SAFARI_ZONE_STATE, 0)
    releaseall
    end
}

script SafariZone_South_OnTransition {
    if (var(VAR_SAFARI_ZONE_STATE) == 2) {
        call(SafariZone_South_EventScript_SetExitAttendantAside)
    }
    end
}

script SafariZone_South_EventScript_SetExitAttendantAside {
    setobjectxyperm(LOCALID_SAFARI_EXIT_ATTENDANT, 31, 34)
    return
}

movement SafariZone_South_Movement_PlayerEnter {
    walk_down
    step_end
}

movement SafariZone_South_Movement_ExitAttendantBlockDoor {
    walk_right
    walk_in_place_faster_down
    step_end
}

script SafariZone_South_EventScript_Boy {
    msgbox(SafariZone_South_Text_Boy, MSGBOX_NPC)
    end
}

script SafariZone_South_EventScript_Man {
    msgbox(SafariZone_South_Text_Man, MSGBOX_NPC)
    end
}

script SafariZone_South_EventScript_Youngster {
    msgbox(SafariZone_South_Text_Youngster, MSGBOX_NPC)
    end
}

script SafariZone_South_EventScript_ExitAttendant {
    lock
    faceplayer
    if (!flag(FLAG_GOOD_LUCK_SAFARI_ZONE)) {
        goto(SafariZone_South_EventScript_GoodLuck)
    }
    msgbox(SafariZone_South_Text_StillHaveTimeExit, MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        goto(SafariZone_South_EventScript_ExitEarly)
    }
    msgbox(SafariZone_South_Text_EnjoyTheRestOfYourAdventure, MSGBOX_DEFAULT)
    release
    end
}

script SafariZone_South_EventScript_GoodLuck {
    setflag(FLAG_GOOD_LUCK_SAFARI_ZONE)
    msgbox(SafariZone_South_Text_GoodLuck, MSGBOX_DEFAULT)
    release
    end
}

script SafariZone_South_EventScript_ExitEarly {
    msgbox(SafariZone_South_Text_ExitEarlyThankYouForPlaying, MSGBOX_DEFAULT)
    closemessage
    switch(VAR_FACING)
    case(DIR_NORTH, SafariZone_South_EventScript_ExitEarlyNorth)
    case(DIR_EAST, SafariZone_South_EventScript_ExitEarlyEast)
    end
}

script SafariZone_South_EventScript_ExitEarlyNorth {
    applymovement(LOCALID_SAFARI_EXIT_ATTENDANT, SafariZone_South_Movement_MoveExitAttendantNorth)
    waitmovement(0)
    applymovement(LOCALID_PLAYER, SafariZone_South_Movement_PlayerExitNorth)
    waitmovement(0)
    goto(SafariZone_South_EventScript_Exit)
    end
}

script SafariZone_South_EventScript_ExitEarlyEast {
    applymovement(LOCALID_SAFARI_EXIT_ATTENDANT, SafariZone_South_Movement_MoveExitAttendantEast)
    waitmovement(0)
    applymovement(LOCALID_PLAYER, SafariZone_South_Movement_PlayerExitEast)
    waitmovement(0)
    goto(SafariZone_South_EventScript_Exit)
    end
}

script SafariZone_South_EventScript_Exit {
    setvar(VAR_SAFARI_ZONE_STATE, 1)
    special(ExitSafariMode)
    warpdoor(MAP_ROUTE121_SAFARI_ZONE_ENTRANCE, 2, 5)
    waitstate
    end
}

movement SafariZone_South_Movement_PlayerExitNorth {
    walk_up
    step_end
}

movement SafariZone_South_Movement_PlayerExitEast {
    walk_right
    walk_in_place_faster_up
    step_end
}

movement SafariZone_South_Movement_MoveExitAttendantNorth {
    walk_left
    walk_in_place_faster_right
    step_end
}

movement SafariZone_South_Movement_MoveExitAttendantEast {
    walk_down
    walk_in_place_faster_up
    step_end
}

script SafariZone_South_EventScript_ConstructionWorker1 {
    msgbox(SafariZone_South_Text_AreaOffLimits1, MSGBOX_NPC)
    end
}

