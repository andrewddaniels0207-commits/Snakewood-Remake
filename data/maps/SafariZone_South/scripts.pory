# 83 "data/maps/SafariZone_South/scripts.pory"
	switch VAR_FACING
# 84 "data/maps/SafariZone_South/scripts.pory"
	case DIR_NORTH, SafariZone_South_EventScript_ExitEarly_3
# 86 "data/maps/SafariZone_South/scripts.pory"
