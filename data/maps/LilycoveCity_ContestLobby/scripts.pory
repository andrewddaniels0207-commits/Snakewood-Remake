script LilycoveCity_ContestLobby_EventScript_StartLinkContest {
    special(GetContestPlayerId)
    addvar(VAR_0x8004, 1)
    buffernumberstring(STR_VAR_2, VAR_0x8004)
    messageautoscroll(LilycoveCity_ContestLobby_Text_YourMonIsEntryNumX)
    waitmessage()
    subvar(VAR_0x8004, 1)
    call(LilycoveCity_ContestLobby_EventScript_LeadToLinkContestHall)
    setvar(VAR_CONTEST_HALL_STATE, 1)
    special(SetLinkContestPlayerGfx)
    setvar(VAR_CONTEST_TYPE, CONTEST_TYPE_LINK)
    setvar(VAR_CONTEST_RANK, CONTEST_RANK_MASTER)
    call(LilycoveCity_ContestLobby_EventScript_WarpToContestHall)
    end
}

script LilycoveCity_ContestLobby_EventScript_SetLinkGroupType {
    if (var(VAR_CONTEST_CATEGORY) == CONTEST_CATEGORY_COOL) {
        call(LilycoveCity_ContestLobby_EventScript_SetLinkGroupCoolContest)
    }
    if (var(VAR_CONTEST_CATEGORY) == CONTEST_CATEGORY_BEAUTY) {
        call(LilycoveCity_ContestLobby_EventScript_SetLinkGroupBeautyContest)
    }
    if (var(VAR_CONTEST_CATEGORY) == CONTEST_CATEGORY_CUTE) {
        call(LilycoveCity_ContestLobby_EventScript_SetLinkGroupCuteContest)
    }
    if (var(VAR_CONTEST_CATEGORY) == CONTEST_CATEGORY_SMART) {
        call(LilycoveCity_ContestLobby_EventScript_SetLinkGroupSmartContest)
    }
    if (var(VAR_CONTEST_CATEGORY) == CONTEST_CATEGORY_TOUGH) {
        call(LilycoveCity_ContestLobby_EventScript_SetLinkGroupToughContest)
    }
    goto(LilycoveCity_ContestLobby_EventScript_DecideLinkLeader)
    end
}

script LilycoveCity_ContestLobby_EventScript_SetLinkGroupCoolContest {
    setvar(VAR_0x8004, LINK_GROUP_COOL_CONTEST)
    return
}

script LilycoveCity_ContestLobby_EventScript_SetLinkGroupBeautyContest {
    setvar(VAR_0x8004, LINK_GROUP_BEAUTY_CONTEST)
    return
}

script LilycoveCity_ContestLobby_EventScript_SetLinkGroupCuteContest {
    setvar(VAR_0x8004, LINK_GROUP_CUTE_CONTEST)
    return
}

script LilycoveCity_ContestLobby_EventScript_SetLinkGroupSmartContest {
    setvar(VAR_0x8004, LINK_GROUP_SMART_CONTEST)
    return
}

script LilycoveCity_ContestLobby_EventScript_SetLinkGroupToughContest {
    setvar(VAR_0x8004, LINK_GROUP_TOUGH_CONTEST)
    return
}

script LilycoveCity_ContestLobby_EventScript_DecideLinkLeader {
    message(LilycoveCity_ContestLobby_Text_PleaseDecideLinkLeader)
    waitmessage()
    multichoice(16, 6, MULTI_LINK_LEADER, FALSE)
    switch (var(VAR_RESULT)) {
        case 0:
            goto(LilycoveCity_ContestLobby_EventScript_TryJoinGroup)
        case 1:
            goto(LilycoveCity_ContestLobby_EventScript_TryLeadGroup)
        case 2:
            goto(LilycoveCity_ContestLobby_EventScript_CancelLinkContest)
        case MULTI_B_PRESSED:
            goto(LilycoveCity_ContestLobby_EventScript_CancelLinkContest)
    }
    end
}

script LilycoveCity_ContestLobby_EventScript_TryLeadGroup {
    call(LilycoveCity_ContestLobby_EventScript_TryBecomeLinkLeader)
    if (var(VAR_RESULT) == LINKUP_SUCCESS) {
        goto(LilycoveCity_ContestLobby_EventScript_LinkLeaderDecided)
    }
    if (var(VAR_RESULT) == LINKUP_FAILED) {
        goto(LilycoveCity_ContestLobby_EventScript_DecideLinkLeader)
    }
    if (var(VAR_RESULT) == LINKUP_RETRY_ROLE_ASSIGN) {
        goto(LilycoveCity_ContestLobby_EventScript_TryLeadGroup)
    }
    release
    end
}

script LilycoveCity_ContestLobby_EventScript_TryJoinGroup {
    call(LilycoveCity_ContestLobby_EventScript_TryJoinLinkGroup)
    if (var(VAR_RESULT) == LINKUP_SUCCESS) {
        goto(LilycoveCity_ContestLobby_EventScript_LinkLeaderDecided)
    }
    if (var(VAR_RESULT) == LINKUP_FAILED) {
        goto(LilycoveCity_ContestLobby_EventScript_DecideLinkLeader)
    }
    if (var(VAR_RESULT) == LINKUP_RETRY_ROLE_ASSIGN) {
        goto(LilycoveCity_ContestLobby_EventScript_TryJoinGroup)
    }
    release
    end
}

script LilycoveCity_ContestLobby_EventScript_TryBecomeLinkLeader {
    special(TryBecomeLinkLeader)
    waitstate
    return
}

script LilycoveCity_ContestLobby_EventScript_TryJoinLinkGroup {
    special(TryJoinLinkGroup)
    waitstate
    return
}

script LilycoveCity_ContestLobby_EventScript_LinkLeaderDecided {
    messageinstant(LilycoveCity_ContestLobby_Text_Transmitting)
    contestlinktransfer()
    goto(LilycoveCity_ContestLobby_EventScript_StartLinkContest)
    end
}

script LilycoveCity_ContestLobby_EventScript_LeadToLinkContestHall {
    messageautoscroll(LilycoveCity_ContestLobby_Text_ContestBeginShortly)
    waitmessage()
    delay(20)
    closemessage
    applymovement(LOCALID_CONTEST_LOBBY_LINK_RECEPTIONIST, LilycoveCity_ContestLobby_Movement_LinkReceptionistApproachCounter)
    waitmovement(0)
    playse(SE_BRIDGE_WALK)
    setmetatile(17, 2, METATILE_Contest_WallShadow, TRUE)
    setmetatile(17, 3, METATILE_Contest_FloorShadow, TRUE)
    special(DrawWholeMapView)
    applymovement(LOCALID_CONTEST_LOBBY_LINK_RECEPTIONIST, LilycoveCity_ContestLobby_Movement_LinkReceptionistExitCounter)
    waitmovement(0)
    playse(SE_BRIDGE_WALK)
    setmetatile(17, 2, METATILE_Contest_CounterFlap_Top, TRUE)
    setmetatile(17, 3, METATILE_Contest_CounterFlap_Bottom, TRUE)
    special(DrawWholeMapView)
    delay(20)
    applymovement(LOCALID_CONTEST_LOBBY_LINK_RECEPTIONIST, LilycoveCity_ContestLobby_Movement_LinkReceptionistFacePlayer)
    waitmovement(0)
    applymovement(LOCALID_PLAYER, LilycoveCity_ContestLobby_Movement_PlayerApproachLinkReceptionist)
    waitmovement(0)
    messageautoscroll(LilycoveCity_ContestLobby_Text_ComeThroughHere)
    waitmessage()
    delay(20)
    closemessage
    call(LilycoveCity_ContestLobby_EventScript_DelayIfContestWithRSPlayer)
    applymovement(LOCALID_CONTEST_LOBBY_LINK_RECEPTIONIST, LilycoveCity_ContestLobby_Movement_LinkReceptionistWalkToContestHall)
    applymovement(LOCALID_PLAYER, LilycoveCity_ContestLobby_Movement_PlayerWalkToLinkContestHall)
    waitmovement(0)
    release
    return
}

movement LilycoveCity_ContestLobby_Movement_PlayerWalkToLinkContestHall {
    walk_right
    walk_right
    walk_right
    walk_right
    walk_right
    walk_up
    walk_up
    walk_up
    delay_8
    set_invisible
    step_end
}

movement LilycoveCity_ContestLobby_Movement_PlayerApproachLinkReceptionist {
    walk_right
    step_end
}

movement LilycoveCity_ContestLobby_Movement_LinkReceptionistApproachCounter {
    walk_right
    walk_right
    walk_in_place_faster_down
    step_end
}

movement LilycoveCity_ContestLobby_Movement_LinkReceptionistExitCounter {
    walk_down
    walk_down
    walk_in_place_faster_up
    step_end
}

movement LilycoveCity_ContestLobby_Movement_LinkReceptionistWalkToContestHall {
    walk_right
    walk_right
    walk_right
    walk_right
    walk_up
    walk_up
    walk_up
    delay_8
    set_invisible
    step_end
}

movement LilycoveCity_ContestLobby_Movement_LinkReceptionistFacePlayer {
    walk_in_place_faster_left
    step_end
}

script LilycoveCity_ContestLobby_EventScript_LittleGirl {
    lock
    faceplayer
    if (flag(FLAG_RECEIVED_POKEBLOCK_CASE)) {
        goto(LilycoveCity_ContestLobby_EventScript_LittleGirlHaveCase)
    }
    msgbox(LilycoveCity_ContestLobby_Text_LadyGaveMePokeblockCase, MSGBOX_DEFAULT)
    release
    end
}

script LilycoveCity_ContestLobby_EventScript_LittleGirlHaveCase {
    msgbox(LilycoveCity_ContestLobby_Text_MakePokeblocksDifferentBerries, MSGBOX_DEFAULT)
    release
    end
}

text LilycoveCity_ContestLobby_Text_LadyGaveMePokeblockCase {
    "Yippee!\p"
    "The lady at the reception counter\n"
    "gave me a case for {POKEBLOCK}S!$"
}

text LilycoveCity_ContestLobby_Text_MakePokeblocksDifferentBerries {
    "Make {POKEBLOCK}S and put them in there.\p"
    "When you make a {POKEBLOCK}, everyone\n"
    "has to put in a different BERRY.$"
}

text LilycoveCity_ContestLobby_Text_YourPokemonSpurredMeToPaint {
    "Congratulations!\p"
    "I did a painting of your POKéMON to\n"
    "commemorate its victory…\p"
    "Well, your POKéMON's appeals were\n"
    "so fantastic, it spurred me into\l"
    "painting better than I usually do.\l"
    "Look, see?$"
}

text LilycoveCity_ContestLobby_Text_ShouldITakePaintingToMuseum {
    "What do you think? I'm confident in\n"
    "what I've done, but do you like it?\p"
    "A work of this caliber, it wouldn't look\n"
    "out of place in an art museum.\p"
    "Huh? An art museum really is looking\n"
    "for paintings?\p"
    "Do you think I should take this there?$"
}

text LilycoveCity_ContestLobby_Text_IllTakePaintingToMuseum {
    "What, really? Then, sure, I will take\n"
    "this painting there right now.\p"
    "I'll give it a proper title, too.\p"
    "I hope they'll like it and consider\n"
    "exhibiting this.\p"
    "Please check if they did accept this.\n"
    "Thank you!$"
}

text LilycoveCity_ContestLobby_Text_TakeMementoOfPainting {
    "Oh, that's right!\p"
    "As a memento of me painting your\n"
    "POKéMON, please take this.$"
}

text LilycoveCity_ContestLobby_Text_ReceivedARibbon {
    "{PLAYER} received a RIBBON.$"
}

text LilycoveCity_ContestLobby_Text_PutTheRibbonOnMon {
    "{PLAYER} put the RIBBON on\n"
    "{STR_VAR_1}.$"
}

text LilycoveCity_ContestLobby_Text_OkaySeeYou {
    "Okay, see you!$"
}

text LilycoveCity_ContestLobby_Text_TakeHomeButIdLikeToTakeToMuseum {
    "Oh… Then, I guess I'll just take\n"
    "this home with me…\p"
    "But, you know, I would like to take\n"
    "this to the art museum… Okay?$"
}

text LilycoveCity_ContestLobby_Text_FineThatsTheWayItIs {
    "Oh, fine, that's the way it is.\n"
    "I will hang this in my own house.\p"
    "I'll just have to try harder next time.\n"
    "Well, be seeing you.$"
}

text LilycoveCity_ContestLobby_Text_MasterRankHereICome {
    "Hoo, boy… Master Rank CONTESTS,\n"
    "here I come.\p"
    "The world will know that my dearest\n"
    "POKéMON is the cutest being in all\l"
    "existence. The time has come!\l"
    "Uheheheh.$"
}

text LilycoveCity_ContestLobby_Text_WholeVarietyOfPokemonHere {
    "You can see a whole variety of\n"
    "POKéMON here.\p"
    "That's why I make this place a regular\n"
    "part of my daily stroll.$"
}

text LilycoveCity_ContestLobby_Text_ContestFeastForEyes {
    "Wow, coming out to a CONTEST is\n"
    "a feast for these eyes!\p"
    "Would you look at all the POKéMON\n"
    "that just scream to be painted?$"
}

text LilycoveCity_ContestLobby_Text_ToughContestIsExtreme {
    "The TOUGHNESS CONTEST is like\n"
    "extreme, man!\p"
    "Those muscular appeals…\n"
    "Cascading sweat… I swoon!$"
}

text LilycoveCity_ContestLobby_Text_LavishedCareOnMon {
    "Day in and day out, I lavished my care\n"
    "on this POKéMON.\p"
    "Its condition is peaking.\n"
    "Today, victory is mine!$"
}

text LilycoveCity_ContestLobby_Text_MadePokeblocksWithFamily {
    "I made {POKEBLOCK}S with Mom, Dad, and\n"
    "Big Sister. They turned out great!\p"
    "I bet you can make smoother, better\n"
    "{POKEBLOCK}S if you have more people.$"
}
