mapscripts CaveOfOrigin_UnusedRubySapphireMap1_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: CaveOfOrigin_UnusedRubySapphireMap1_OnTransition
}

script CaveOfOrigin_UnusedRubySapphireMap1_OnTransition {
    if (flag(FLAG_UNUSED_RS_LEGENDARY_BATTLE_DONE)) call(CaveOfOrigin_EventScript_DisableTriggers)
    end
}
