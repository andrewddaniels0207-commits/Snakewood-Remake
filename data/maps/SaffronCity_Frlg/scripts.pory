SaffronCity_EventScript_Pidgeot::
# 93 "data/maps/SaffronCity_Frlg/scripts.pory"
	lock
# 94 "data/maps/SaffronCity_Frlg/scripts.pory"
	faceplayer
# 95 "data/maps/SaffronCity_Frlg/scripts.pory"
	waitse
# 96 "data/maps/SaffronCity_Frlg/scripts.pory"
