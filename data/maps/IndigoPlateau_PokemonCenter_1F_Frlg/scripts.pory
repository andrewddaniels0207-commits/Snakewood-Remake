	goto IndigoPlateau_PokemonCenter_1F_EventScript_DoorGuard_1


IndigoPlateau_PokemonCenter_1F_EventScript_CheckSeviiIslandComplete::
# 36 "data/maps/IndigoPlateau_PokemonCenter_1F_Frlg/scripts.pory"
