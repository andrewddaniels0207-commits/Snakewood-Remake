script SlateportCity_PokemonFanClub_EventScript_NoRoomForScarf {
    msgbox(SlateportCity_PokemonFanClub_Text_NoSpaceForReward, MSGBOX_DEFAULT)
    release
    end
}

script SlateportCity_PokemonFanClub_EventScript_CheckMonCool {
    specialvar(VAR_RESULT, CheckLeadMonCool)
    if (var(VAR_RESULT) == TRUE) call(SlateportCity_PokemonFanClub_EventScript_SetMonCool)
    return
}

script SlateportCity_PokemonFanClub_EventScript_SetMonCool {
    setvar(VAR_TEMP_1, 1)
    return
}

script SlateportCity_PokemonFanClub_EventScript_CheckMonBeauty {
    specialvar(VAR_RESULT, CheckLeadMonBeauty)
    if (var(VAR_RESULT) == TRUE) call(SlateportCity_PokemonFanClub_EventScript_SetMonBeauty)
    return
}

script SlateportCity_PokemonFanClub_EventScript_SetMonBeauty {
    setvar(VAR_TEMP_1, 2)
    return
}

script SlateportCity_PokemonFanClub_EventScript_CheckMonCute {
    specialvar(VAR_RESULT, CheckLeadMonCute)
    if (var(VAR_RESULT) == TRUE) call(SlateportCity_PokemonFanClub_EventScript_SetMonCute)
    return
}

script SlateportCity_PokemonFanClub_EventScript_SetMonCute {
    setvar(VAR_TEMP_1, 3)
    return
}

script SlateportCity_PokemonFanClub_EventScript_CheckMonSmart {
    specialvar(VAR_RESULT, CheckLeadMonSmart)
    if (var(VAR_RESULT) == TRUE) call(SlateportCity_PokemonFanClub_EventScript_SetMonSmart)
    return
}

script SlateportCity_PokemonFanClub_EventScript_SetMonSmart {
    setvar(VAR_TEMP_1, 4)
    return
}

