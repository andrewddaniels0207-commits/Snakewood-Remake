    lock
    faceplayer
    waitse()
    playmoncry(SPECIES_ZIGZAGOON, CRY_MODE_NORMAL)
    msgbox(SlateportCity_PokemonFanClub_Text_Zigzagoon, MSGBOX_DEFAULT)
    waitmoncry()
    release
    end
}

