    lock
    faceplayer
    waitse()
    playmoncry(SPECIES_AZUMARILL, CRY_MODE_NORMAL)
    msgbox(SlateportCity_PokemonFanClub_Text_Azumarill, MSGBOX_DEFAULT)
    waitmoncry()
    release
    end
}

text SlateportCity_PokemonFanClub_Text_MeetChairman {
    "Er-hem! I am the CHAIRMAN of the\n"
    "POKéMON FAN CLUB!\p"
    "Being the CHAIRMAN, I am naturally\n"
    "the most important!\p"
    "No one can best me when it comes\n"
    "to raising POKéMON. No one!\p"
    "Well, let me tell you about\n"
    "POKéMON CONTESTS.\p"
    "They're events where one can show off\n"
    "POKéMON for the world to see!\p"
    "However, they're held in far-off towns,\n"
    "so I cannot participate often enough.\p"
    "That is why we gather here to show\n"
    "off our POKéMON, and have others\l"
    "show us theirs.$"
}

text SlateportCity_PokemonFanClub_Text_LikeToSeeEnteredContestPokemon {
    "The POKéMON of a TRAINER who has\n"
    "entered a POKéMON CONTEST…\l"
    "That, I would like to see.$"
}

text SlateportCity_PokemonFanClub_Text_AllowMeToExamineYourPokemon {
    "Er-hem! I see you've participated in\n"
    "a POKéMON CONTEST!\p"
    "Please! Allow me to examine how you\n"
    "have raised your POKéMON.\p"
    "It delights me no end to see POKéMON\n"
    "raised by other TRAINERS.\p"
    "The happy expressions of POKéMON\n"
    "raised with proper care…\p"
    "The kindly eyes of the TRAINER that\n"
    "nurtured and raised the POKéMON…\p"
    "The very thought fills my heart to\n"
    "overwhelming with joy.\p"
    "Oh! I do beg your pardon!\n"
    "Forgive me for prattling on so!\p"
    "Please! Allow me to examine how much\n"
    "your POKéMON has grown!$"
}

text SlateportCity_PokemonFanClub_Text_HowIsYourPokemonGrowing {
    "How is your POKéMON growing?\n"
    "Allow me to examine it.$"
}

text SlateportCity_PokemonFanClub_Text_HmHmISee {
    "Hm, hm…\n"
    "I see…$"
}

text SlateportCity_PokemonFanClub_Text_GiveMonMorePokeblocks {
    "Hmmm… It's not bad, but it's not\n"
    "good, either…\p"
    "You, the TRAINER, must put more\n"
    "effort into raising this POKéMON!\p"
    "For instance, may I suggest that\n"
    "you give it more {POKEBLOCK}S?$"
}

text SlateportCity_PokemonFanClub_Text_NoSpaceForReward {
    "Oh, my…\p"
    "Your POKéMON is growing quite well,\n"
    "so you deserve a reward.\p"
    "Unfortunately, you have no space for\n"
    "this in your BAG.$"
}

text SlateportCity_PokemonFanClub_Text_MonMostImpressiveGiveItThis {
    "Your {STR_VAR_1}, it is growing in\n"
    "a most impressive manner!\l"
    "It is one fine specimen!\p"
    "But! If you were to give it this,\n"
    "it would grow even better! Indeed!$"
}

text SlateportCity_PokemonFanClub_Text_ExplainRedScarf {
    "Let a POKéMON hold that RED SCARF.\p"
    "Everyone will recognize the coolness\n"
    "of that POKéMON!$"
}

text SlateportCity_PokemonFanClub_Text_ExplainBlueScarf {
    "Let a POKéMON hold that BLUE SCARF.\p"
    "Its beauty will be accentuated much\n"
    "more than now!$"
}

text SlateportCity_PokemonFanClub_Text_ExplainPinkScarf {
    "Let a POKéMON hold that PINK SCARF.\p"
    "It will draw out the cuteness of\n"
    "the POKéMON some more!$"
}

text SlateportCity_PokemonFanClub_Text_ExplainGreenScarf {
    "Let a POKéMON hold that GREEN SCARF.\p"
    "That will enhance the\n"
    "smartness of POKéMON!$"
}

text SlateportCity_PokemonFanClub_Text_ExplainYellowScarf {
    "Let a POKéMON hold that YELLOW SCARF.\p"
    "It will bolster your POKéMON's\n"
    "toughness so much more!$"
}

text SlateportCity_PokemonFanClub_Text_NothingElseToGiveYou {
    "I'm sorry, but I've nothing else to\n"
    "give you! None at all!\p"
    "After all, you're blessed with the gift\n"
    "of raising POKéMON without resorting\l"
    "to any items!$"
}

text SlateportCity_PokemonFanClub_Text_ShowMePokemonThatLoveYou {
    "I love seeing POKéMON that love\n"
    "their TRAINERS.\p"
    "POKéMON are very sensitive to\n"
    "the feelings of their TRAINERS.\p"
    "If you treat your POKéMON with love\n"
    "and care, they'll love you back.\p"
    "When your POKéMON grow to love you,\n"
    "please come show me.$"
}

text SlateportCity_PokemonFanClub_Text_PokemonAdoresYou {
    "Your POKéMON really adores you.\p"
    "For you, a most compassionate\n"
    "TRAINER, a gift from the FAN CLUB!$"
}

text SlateportCity_PokemonFanClub_Text_TreatPokemonWithLove {
    "POKéMON are very sensitive to\n"
    "the feelings of their TRAINERS.\p"
    "If you treat your POKéMON with love\n"
    "and care, they'll love you back.$"
}

text SlateportCity_PokemonFanClub_Text_PokemonDontLikeFainting {
    "If you keep letting a POKéMON faint\n"
    "in battle, it'll come to resent it.\p"
    "Soon, it will become less trusting\n"
    "of the TRAINER.\p"
    "In other words, it certainly won't\n"
    "like you very much.$"
}

text SlateportCity_PokemonFanClub_Text_MonEnjoyedProtein {
    "Do POKéMON enjoy having items used\n"
    "on them?\p"
    "Mine acted really happy when I gave\n"
    "it some PROTEIN.$"
}

text SlateportCity_PokemonFanClub_Text_Skitty {
    "SKITTY: Fffnyaaaah…$"
}

text SlateportCity_PokemonFanClub_Text_Zigzagoon {
    "ZIGZAGOON: Kyuuu…$"
}

text SlateportCity_PokemonFanClub_Text_Azumarill {
    "AZUMARILL: Marimari?$"
}
