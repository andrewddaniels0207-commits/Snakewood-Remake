    return
}

script BattleFrontier_BattleFactoryPreBattleRoom_EventScript_ReadyFor7thOpponent {
    message(BattleFrontier_BattleFactoryPreBattleRoom_Text_ReadyFor7thOpponent)
    waitmessage()
    return
}

script BattleFrontier_BattleFactoryPreBattleRoom_EventScript_PauseChallenge {
    message(BattleFrontier_BattleFactoryPreBattleRoom_Text_SavingDataPleaseWait)
    waitmessage()
    factory_save(CHALLENGE_STATUS_PAUSED)
    playse(SE_SAVE)
    waitse()
    fadescreen(FADE_TO_BLACK)
    frontier_reset()
    end
}

script BattleFrontier_BattleFactoryPreBattleRoom_EventScript_ResumeChallenge {
    special(SavePlayerParty)
    factory_setparties(0)
    frontier_set(FRONTIER_DATA_RECORD_DISABLED, TRUE)
    special(CalculatePlayerPartyCount)
    goto(BattleFrontier_BattleFactoryPreBattleRoom_EventScript_AskReadyForOpponent)
}

script BattleFrontier_BattleFactoryPreBattleRoom_EventScript_CommentOnOpponentType {
    msgbox(BattleFrontier_BattleFactoryPreBattleRoom_Text_InvestigatedUpcomingOpponent, MSGBOX_DEFAULT)
    if (var(VAR_0x8005) == TYPE_NORMAL) call(BattleFrontier_BattleFactoryPreBattleRoom_EventScript_OpponentUsesNormal)
    if (var(VAR_0x8005) == TYPE_FIGHTING) call(BattleFrontier_BattleFactoryPreBattleRoom_EventScript_OpponentUsesFighting)
    if (var(VAR_0x8005) == TYPE_FLYING) call(BattleFrontier_BattleFactoryPreBattleRoom_EventScript_OpponentUsesFlying)
    if (var(VAR_0x8005) == TYPE_POISON) call(BattleFrontier_BattleFactoryPreBattleRoom_EventScript_OpponentUsesPoison)
    if (var(VAR_0x8005) == TYPE_GROUND) call(BattleFrontier_BattleFactoryPreBattleRoom_EventScript_OpponentUsesGround)
    if (var(VAR_0x8005) == TYPE_ROCK) call(BattleFrontier_BattleFactoryPreBattleRoom_EventScript_OpponentUsesRock)
    if (var(VAR_0x8005) == TYPE_BUG) call(BattleFrontier_BattleFactoryPreBattleRoom_EventScript_OpponentUsesBug)
    if (var(VAR_0x8005) == TYPE_GHOST) call(BattleFrontier_BattleFactoryPreBattleRoom_EventScript_OpponentUsesGhost)
    if (var(VAR_0x8005) == TYPE_STEEL) call(BattleFrontier_BattleFactoryPreBattleRoom_EventScript_OpponentUsesSteel)
    if (var(VAR_0x8005) == TYPE_FIRE) call(BattleFrontier_BattleFactoryPreBattleRoom_EventScript_OpponentUsesFire)
    if (var(VAR_0x8005) == TYPE_WATER) call(BattleFrontier_BattleFactoryPreBattleRoom_EventScript_OpponentUsesWater)
    if (var(VAR_0x8005) == TYPE_GRASS) call(BattleFrontier_BattleFactoryPreBattleRoom_EventScript_OpponentUsesGrass)
    if (var(VAR_0x8005) == TYPE_ELECTRIC) call(BattleFrontier_BattleFactoryPreBattleRoom_EventScript_OpponentUsesElectric)
    if (var(VAR_0x8005) == TYPE_PSYCHIC) call(BattleFrontier_BattleFactoryPreBattleRoom_EventScript_OpponentUsesPsychic)
    if (var(VAR_0x8005) == TYPE_ICE) call(BattleFrontier_BattleFactoryPreBattleRoom_EventScript_OpponentUsesIce)
    if (var(VAR_0x8005) == TYPE_DRAGON) call(BattleFrontier_BattleFactoryPreBattleRoom_EventScript_OpponentUsesDragon)
    if (var(VAR_0x8005) == TYPE_DARK) call(BattleFrontier_BattleFactoryPreBattleRoom_EventScript_OpponentUsesDark)
    if (var(VAR_0x8005) == TYPE_FAIRY) call(BattleFrontier_BattleFactoryPreBattleRoom_EventScript_OpponentUsesFairy)
    if (var(VAR_0x8005) == NUMBER_OF_MON_TYPES) call(BattleFrontier_BattleFactoryPreBattleRoom_EventScript_OpponentHasNoMostCommonType)
    return
}

