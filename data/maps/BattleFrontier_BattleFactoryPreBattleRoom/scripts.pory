script BattleFrontier_BattleFactoryPreBattleRoom_EventScript_CommentOnOpponentStyle {
    if (var(VAR_0x8006) == FACTORY_STYLE_NONE) call(BattleFrontier_BattleFactoryPreBattleRoom_EventScript_StyleUnrestrained)
    if (var(VAR_0x8006) == FACTORY_STYLE_PREPARATION) call(BattleFrontier_BattleFactoryPreBattleRoom_EventScript_StyleTotalPreparation)
    if (var(VAR_0x8006) == FACTORY_STYLE_SLOW_STEADY) call(BattleFrontier_BattleFactoryPreBattleRoom_EventScript_StyleSlowAndSteady)
    if (var(VAR_0x8006) == FACTORY_STYLE_ENDURANCE) call(BattleFrontier_BattleFactoryPreBattleRoom_EventScript_StyleEndurance)
    if (var(VAR_0x8006) == FACTORY_STYLE_HIGH_RISK) call(BattleFrontier_BattleFactoryPreBattleRoom_EventScript_StyleHighRisk)
    if (var(VAR_0x8006) == FACTORY_STYLE_WEAKENING) call(BattleFrontier_BattleFactoryPreBattleRoom_EventScript_StyleWeakenFoe)
    if (var(VAR_0x8006) == FACTORY_STYLE_UNPREDICTABLE) call(BattleFrontier_BattleFactoryPreBattleRoom_EventScript_StyleImpossibleToPredict)
    if (var(VAR_0x8006) == FACTORY_STYLE_WEATHER) call(BattleFrontier_BattleFactoryPreBattleRoom_EventScript_StyleDependsOnFlow)
    if (var(VAR_0x8006) == FACTORY_NUM_STYLES) call(BattleFrontier_BattleFactoryPreBattleRoom_EventScript_StyleFlexible)
    return
}

script BattleFrontier_BattleFactoryPreBattleRoom_EventScript_StyleUnrestrained {
    msgbox(BattleFrontier_BattleFactoryPreBattleRoom_Text_StyleUnrestrained, MSGBOX_DEFAULT)
    return
}

