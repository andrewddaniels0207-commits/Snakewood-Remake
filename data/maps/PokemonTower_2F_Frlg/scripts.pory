mapscripts PokemonTower_2F_Frlg_MapScripts {}

script PokemonTower_2F_EventScript_Channeler {
    msgbox(PokemonTower_2F_Text_SilphScopeCouldUnmaskGhosts, MSGBOX_NPC)
    end
}

script PokemonTower_2F_EventScript_RivalTriggerRight {
    lockall
    setvar(VAR_TEMP_1, 0)
    goto(PokemonTower_2F_EventScript_Rival)
    end
}

script PokemonTower_2F_EventScript_RivalTriggerDown {
    lockall
    setvar(VAR_TEMP_1, 1)
    goto(PokemonTower_2F_EventScript_Rival)
    end
}

script PokemonTower_2F_EventScript_Rival {
    textcolor(NPC_TEXT_COLOR_MALE)
    playbgm(MUS_RG_ENCOUNTER_RIVAL, 0)
    if (var(VAR_TEMP_1) == 0) call(PokemonTower_2F_EventScript_RivalFacePlayerRight)
    if (var(VAR_TEMP_1) == 1) call(PokemonTower_2F_EventScript_RivalFacePlayerDown)
    applymovement(LOCALID_POKEMON_TOWER_RIVAL, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(LOCALID_POKEMON_TOWER_RIVAL, Common_Movement_Delay48)
    waitmovement(0)
    msgbox(PokemonTower_2F_Text_RivalIntro)
    setvar(VAR_LAST_TALKED, LOCALID_POKEMON_TOWER_RIVAL)
    if (var(VAR_STARTER_MON) == 2) call(PokemonTower_2F_EventScript_RivalSquirtle)
    if (var(VAR_STARTER_MON) == 1) call(PokemonTower_2F_EventScript_RivalBulbasaur)
    if (var(VAR_STARTER_MON) == 0) call(PokemonTower_2F_EventScript_RivalCharmander)
    msgbox(PokemonTower_2F_Text_RivalPostBattle)
    closemessage
    playbgm(MUS_RG_RIVAL_EXIT, 0)
    if (var(VAR_TEMP_1) == 0) call(PokemonTower_2F_EventScript_RivalExitRight)
    if (var(VAR_TEMP_1) == 1) call(PokemonTower_2F_EventScript_RivalExitDown)
    playse(SE_EXIT)
    delay(25)
    fadedefaultbgm()
    removeobject(LOCALID_POKEMON_TOWER_RIVAL)
    setvar(VAR_MAP_SCENE_POKEMON_TOWER_2F, 1)
    releaseall
    end
}

script PokemonTower_2F_EventScript_RivalFacePlayerRight {
    applymovement(LOCALID_POKEMON_TOWER_RIVAL, Common_Movement_WalkInPlaceFasterRight)
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterLeft)
    waitmovement(0)
    return
}

script PokemonTower_2F_EventScript_RivalFacePlayerDown {
    applymovement(LOCALID_POKEMON_TOWER_RIVAL, Common_Movement_WalkInPlaceFasterDown)
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    return
}

script PokemonTower_2F_EventScript_RivalSquirtle {
    trainerbattle_no_intro(TRAINER_RIVAL_POKEMON_TOWER_SQUIRTLE, PokemonTower_2F_Text_RivalDefeat)
    return
}

script PokemonTower_2F_EventScript_RivalBulbasaur {
    trainerbattle_no_intro(TRAINER_RIVAL_POKEMON_TOWER_BULBASAUR, PokemonTower_2F_Text_RivalDefeat)
    return
}

script PokemonTower_2F_EventScript_RivalCharmander {
    trainerbattle_no_intro(TRAINER_RIVAL_POKEMON_TOWER_CHARMANDER, PokemonTower_2F_Text_RivalDefeat)
    return
}

script PokemonTower_2F_EventScript_RivalExitRight {
    applymovement(LOCALID_POKEMON_TOWER_RIVAL, PokemonTower_2F_Movement_RivalExitRight)
    waitmovement(0)
    return
}

script PokemonTower_2F_EventScript_RivalExitDown {
    applymovement(LOCALID_POKEMON_TOWER_RIVAL, PokemonTower_2F_Movement_RivalExitDown)
    waitmovement(0)
    return
}

movement PokemonTower_2F_Movement_RivalExitRight {
    walk_down
    walk_right
    walk_right
    walk_down
    walk_down
    walk_down
    walk_down
    walk_in_place_faster_right
    step_end
}

movement PokemonTower_2F_Movement_RivalExitDown {
    walk_right
    walk_right
    walk_down
    walk_down
    walk_down
    walk_down
    walk_down
    walk_in_place_faster_right
    step_end
}

text PokemonTower_2F_Text_RivalIntro {
    "{RIVAL}: Hey, {PLAYER}!\n"
    "What brings you here?\l"
    "Is your POKéMON dead?\p"
    "Hey! It's alive!\p"
    "I can at least make them faint!\n"
    "Let's go!$"
}

text PokemonTower_2F_Text_RivalDefeat {
    "What?\n"
    "You stinker!\p"
    "I took it easy on you, too!$"
}

text PokemonTower_2F_Text_RivalPostBattle {
    "How's your POKéDEX coming?\n"
    "I just caught a CUBONE!\p"
    "I can't find the bigger MAROWAK.\n"
    "Where could they be?\p"
    "I bet there aren't any left!\p"
    "Well, I better get going.\n"
    "I've got a lot to accomplish,\l"
    "unlike you.\p"
    "Smell ya later!$"
}

text PokemonTower_2F_Text_SilphScopeCouldUnmaskGhosts {
    "Even we could not identify the\n"
    "wayward ghosts.\p"
    "A SILPH SCOPE might be able to\n"
    "unmask them.$"
}
