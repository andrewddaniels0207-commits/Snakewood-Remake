    end
}

script FuchsiaCity_EventScript_SlowpokeSign {
    lockall
    setvar(VAR_0x8004, SPECIES_SLOWPOKE)
    special(SetSeenMon)
    showmonpic(SPECIES_SLOWPOKE, 10, 3)
    msgbox(FuchsiaCity_Text_SlowpokeSign)
    hidemonpic()
