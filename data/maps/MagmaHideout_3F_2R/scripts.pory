mapscripts MagmaHideout_3F_2R_MapScripts {}

script MagmaHideout_3F_2R_EventScript_Grunt10 {
    trainerbattle_single(TRAINER_GRUNT_MAGMA_HIDEOUT_10, MagmaHideout_3F_2R_Text_Grunt10Intro, MagmaHideout_3F_2R_Text_Grunt10Defeat)
    msgbox(MagmaHideout_3F_2R_Text_Grunt10PostBattle, MSGBOX_AUTOCLOSE)
    end
}

text MagmaHideout_3F_2R_Text_Grunt10Intro {
    "I understand everything our leader\n"
    "says. But you know what?\p"
    "Doing stuff like digging up a super-\n"
    "ancient POKéMON and ripping off\l"
    "someone's METEORITE…\p"
    "I think we're going a little too far.\n"
    "What do you think?$"
}

text MagmaHideout_3F_2R_Text_Grunt10Defeat {
    "Yeah, I think we are doing something\n"
    "wrong somehow.$"
}

text MagmaHideout_3F_2R_Text_Grunt10PostBattle {
    "You know, losing to you cleared my mind.\p"
    "The next time I see our leader,\n"
    "I'm going to ask him about what we do.$"
}
