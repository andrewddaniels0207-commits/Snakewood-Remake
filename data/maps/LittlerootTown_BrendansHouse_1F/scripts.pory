mapscripts LittlerootTown_BrendansHouse_1F_MapScripts {
    MAP_SCRIPT_ON_LOAD: LittlerootTown_BrendansHouse_1F_OnLoad
    MAP_SCRIPT_ON_TRANSITION: LittlerootTown_BrendansHouse_1F_OnTransition
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_LITTLEROOT_INTRO_STATE, 3: LittlerootTown_BrendansHouse_1F_EventScript_EnterHouseMovingIn
        VAR_LITTLEROOT_INTRO_STATE, 5: LittlerootTown_BrendansHouse_1F_EventScript_GoUpstairsToSetClock
        VAR_LITTLEROOT_INTRO_STATE, 6: LittlerootTown_BrendansHouse_1F_EventScript_PetalburgGymReport
        VAR_LITTLEROOT_HOUSES_STATE_MAY, 1: LittlerootTown_BrendansHouse_1F_EventScript_YoureNewNeighbor
        VAR_LITTLEROOT_HOUSES_STATE_MAY, 3: PlayersHouse_1F_EventScript_GetSSTicketAndSeeLatiTV
    ]
}

script LittlerootTown_BrendansHouse_1F_OnLoad {
    if (var(VAR_LITTLEROOT_INTRO_STATE) < 6) call(LittlerootTown_BrendansHouse_1F_EventScript_SetMovingBoxes)
    if (flag(FLAG_RECEIVED_RUNNING_SHOES)) call(LittlerootTown_BrendansHouse_1F_EventScript_CheckShowShoesManual)
    end
}

script LittlerootTown_BrendansHouse_1F_EventScript_SetMovingBoxes {
    setmetatile(5, 4, METATILE_BrendansMaysHouse_MovingBox_Open, TRUE)
    setmetatile(5, 2, METATILE_BrendansMaysHouse_MovingBox_Closed, TRUE)
    return
}

script LittlerootTown_BrendansHouse_1F_EventScript_CheckShowShoesManual {
    checkplayergender()
    if (var(VAR_RESULT) == MALE) goto(LittlerootTown_BrendansHouse_1F_EventScript_ShowRunningShoesManual)
    return
}

script LittlerootTown_BrendansHouse_1F_EventScript_ShowRunningShoesManual {
    setmetatile(3, 7, METATILE_BrendansMaysHouse_BookOnTable, TRUE)
    return
}

script LittlerootTown_BrendansHouse_1F_OnTransition {
    if (var(VAR_LITTLEROOT_INTRO_STATE) == 3) call(LittlerootTown_BrendansHouse_1F_EventScript_MoveMomToDoor)
    if (var(VAR_LITTLEROOT_INTRO_STATE) == 5) call(LittlerootTown_BrendansHouse_1F_EventScript_MoveMomToStairs)
    if (var(VAR_LITTLEROOT_INTRO_STATE) == 6) call(LittlerootTown_BrendansHouse_1F_EventScript_MoveMomToTV)
    end
}

script LittlerootTown_BrendansHouse_1F_EventScript_MoveMomToStairs {
    setobjectxyperm(LOCALID_PLAYERS_HOUSE_1F_MOM, 8, 4)
    setobjectmovementtype(LOCALID_PLAYERS_HOUSE_1F_MOM, MOVEMENT_TYPE_FACE_UP)
    return
}

script LittlerootTown_BrendansHouse_1F_EventScript_MoveMomToTV {
    setobjectxyperm(LOCALID_PLAYERS_HOUSE_1F_MOM, 4, 5)
    setobjectmovementtype(LOCALID_PLAYERS_HOUSE_1F_MOM, MOVEMENT_TYPE_FACE_UP)
    return
}

script LittlerootTown_BrendansHouse_1F_EventScript_MoveMomToDoor {
    setobjectxyperm(LOCALID_PLAYERS_HOUSE_1F_MOM, 9, 8)
    setobjectmovementtype(LOCALID_PLAYERS_HOUSE_1F_MOM, MOVEMENT_TYPE_FACE_UP)
    return
}

script LittlerootTown_BrendansHouse_1F_EventScript_GoUpstairsToSetClock {
    lockall
    msgbox(PlayersHouse_1F_Text_GoSetTheClock, MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_PLAYER, LittlerootTown_BrendansHouse_1F_Movement_PushTowardStairs)
    applymovement(LOCALID_PLAYERS_HOUSE_1F_MOM, LittlerootTown_BrendansHouse_1F_Movement_PushTowardStairs)
    waitmovement(0)
    warp(MAP_LITTLEROOT_TOWN_BRENDANS_HOUSE_2F, 7, 1)
    waitstate
    releaseall
    end
}

movement LittlerootTown_BrendansHouse_1F_Movement_PushTowardStairs {
    walk_up
    step_end
}

script LittlerootTown_BrendansHouse_1F_EventScript_EnterHouseMovingIn {
    lockall
    setvar(VAR_0x8004, LOCALID_PLAYERS_HOUSE_1F_MOM)
    setvar(VAR_0x8005, MALE)
    goto(PlayersHouse_1F_EventScript_EnterHouseMovingIn)
    end
}

script LittlerootTown_BrendansHouse_1F_EventScript_PetalburgGymReport {
    lockall
    setvar(VAR_0x8004, MALE)
    setvar(VAR_0x8005, LOCALID_PLAYERS_HOUSE_1F_MOM)
    goto(PlayersHouse_1F_EventScript_PetalburgGymReportMale)
    end
}

script LittlerootTown_BrendansHouse_1F_EventScript_YoureNewNeighbor {
    lockall
    playse(SE_PIN)
    applymovement(LOCALID_RIVALS_HOUSE_1F_MOM, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(LOCALID_RIVALS_HOUSE_1F_MOM, Common_Movement_Delay48)
    waitmovement(0)
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterLeft)
    applymovement(LOCALID_RIVALS_HOUSE_1F_MOM, LittlerootTown_BrendansHouse_1F_Movement_RivalMomApproach)
    waitmovement(0)
    special(GetRivalSonDaughterString)
    msgbox(RivalsHouse_1F_Text_OhYoureTheNewNeighbor, MSGBOX_DEFAULT)
    setflag(FLAG_MET_RIVAL_MOM)
    setvar(VAR_LITTLEROOT_HOUSES_STATE_MAY, 2)
    releaseall
    end
}

movement LittlerootTown_BrendansHouse_1F_Movement_RivalMomApproach {
    walk_down
    walk_right
    walk_right
    walk_right
    walk_right
    walk_right
    step_end
}

script LittlerootTown_BrendansHouse_1F_EventScript_GoSeeRoom {
    lockall
    setvar(VAR_0x8004, LOCALID_PLAYERS_HOUSE_1F_MOM)
    setvar(VAR_0x8005, MALE)
    applymovement(VAR_0x8004, Common_Movement_WalkInPlaceFasterLeft)
    waitmovement(0)
    goto(PlayersHouse_1F_EventScript_MomGoSeeRoom)
    end
}

script LittlerootTown_BrendansHouse_1F_EventScript_MeetRival0 {
    lockall
    setvar(VAR_0x8008, 0)
    goto(LittlerootTown_BrendansHouse_1F_EventScript_MeetRival)
    end
}

script LittlerootTown_BrendansHouse_1F_EventScript_MeetRival1 {
    lockall
    setvar(VAR_0x8008, 1)
    goto(LittlerootTown_BrendansHouse_1F_EventScript_MeetRival)
    end
}

script LittlerootTown_BrendansHouse_1F_EventScript_MeetRival2 {
    lockall
    setvar(VAR_0x8008, 2)
    goto(LittlerootTown_BrendansHouse_1F_EventScript_MeetRival)
    end
}

script LittlerootTown_BrendansHouse_1F_EventScript_MeetRival {
    playse(SE_EXIT)
    delay(10)
    addobject(LOCALID_RIVALS_HOUSE_1F_RIVAL)
    delay(30)
    playse(SE_PIN)
    applymovement(LOCALID_RIVALS_HOUSE_1F_RIVAL, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(LOCALID_RIVALS_HOUSE_1F_RIVAL, Common_Movement_Delay48)
    waitmovement(0)
    if (var(VAR_0x8008) != 1) call(LittlerootTown_BrendansHouse_1F_EventScript_PlayerFaceBrendan)
    playbgm(MUS_ENCOUNTER_BRENDAN, TRUE)
    if (var(VAR_0x8008) == 0) call(LittlerootTown_BrendansHouse_1F_EventScript_BrendanApproachPlayer0)
    if (var(VAR_0x8008) == 1) call(LittlerootTown_BrendansHouse_1F_EventScript_BrendanApproachPlayer1)
    if (var(VAR_0x8008) == 2) call(LittlerootTown_BrendansHouse_1F_EventScript_BrendanApproachPlayer2)
    msgbox(RivalsHouse_1F_Text_BrendanWhoAreYou, MSGBOX_DEFAULT)
    closemessage
    if (var(VAR_0x8008) == 0) call(LittlerootTown_BrendansHouse_1F_EventScript_BrendanGoUpstairs0)
    if (var(VAR_0x8008) == 1) call(LittlerootTown_BrendansHouse_1F_EventScript_BrendanGoUpstairs1)
    if (var(VAR_0x8008) == 2) call(LittlerootTown_BrendansHouse_1F_EventScript_BrendanGoUpstairs2)
    playse(SE_EXIT)
    removeobject(LOCALID_RIVALS_HOUSE_1F_RIVAL)
    setflag(FLAG_HIDE_LITTLEROOT_TOWN_BRENDANS_HOUSE_BRENDAN)
    setflag(FLAG_HIDE_LITTLEROOT_TOWN_BRENDANS_HOUSE_2F_POKE_BALL)
    clearflag(FLAG_HIDE_LITTLEROOT_TOWN_BRENDANS_HOUSE_RIVAL_BEDROOM)
    delay(30)
    setvar(VAR_LITTLEROOT_RIVAL_STATE, 3)
    setvar(VAR_LITTLEROOT_TOWN_STATE, 1)
    savebgm(MUS_DUMMY)
    fadedefaultbgm()
    releaseall
    end
}

script LittlerootTown_BrendansHouse_1F_EventScript_PlayerFaceBrendan {
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    return
}

script LittlerootTown_BrendansHouse_1F_EventScript_BrendanApproachPlayer0 {
    applymovement(LOCALID_RIVALS_HOUSE_1F_RIVAL, LittlerootTown_BrendansHouse_1F_Movement_BrendanApproachPlayer0)
    waitmovement(0)
    return
}

script LittlerootTown_BrendansHouse_1F_EventScript_BrendanApproachPlayer1 {
    applymovement(LOCALID_RIVALS_HOUSE_1F_RIVAL, LittlerootTown_BrendansHouse_1F_Movement_BrendanApproachPlayer1)
    waitmovement(0)
    return
}

script LittlerootTown_BrendansHouse_1F_EventScript_BrendanApproachPlayer2 {
    applymovement(LOCALID_RIVALS_HOUSE_1F_RIVAL, LittlerootTown_BrendansHouse_1F_Movement_BrendanApproachPlayer2)
    waitmovement(0)
    return
}

movement LittlerootTown_BrendansHouse_1F_Movement_BrendanApproachPlayer0 {
    walk_in_place_faster_left
    walk_left
    walk_in_place_faster_up
    walk_up
    walk_up
    walk_up
    walk_up
    step_end
}

movement LittlerootTown_BrendansHouse_1F_Movement_BrendanApproachPlayer1 {
    walk_up
    walk_up
    walk_up
    step_end
}

movement LittlerootTown_BrendansHouse_1F_Movement_BrendanApproachPlayer2 {
    walk_in_place_faster_right
    walk_right
    walk_in_place_faster_up
    walk_up
    walk_up
    walk_up
    walk_up
    step_end
}

script LittlerootTown_BrendansHouse_1F_EventScript_BrendanGoUpstairs0 {
    applymovement(LOCALID_PLAYER, LittlerootTown_BrendansHouse_1F_Movement_PlayerWatchBrendanExit0)
    applymovement(LOCALID_RIVALS_HOUSE_1F_RIVAL, LittlerootTown_BrendansHouse_1F_Movement_BrendanGoUpstairs0)
    waitmovement(0)
    return
}

script LittlerootTown_BrendansHouse_1F_EventScript_BrendanGoUpstairs1 {
    applymovement(LOCALID_PLAYER, LittlerootTown_BrendansHouse_1F_Movement_PlayerWatchBrendanExit1)
    applymovement(LOCALID_RIVALS_HOUSE_1F_RIVAL, LittlerootTown_BrendansHouse_1F_Movement_BrendanGoUpstairs1)
    waitmovement(0)
    return
}

script LittlerootTown_BrendansHouse_1F_EventScript_BrendanGoUpstairs2 {
    applymovement(LOCALID_PLAYER, LittlerootTown_BrendansHouse_1F_Movement_PlayerWatchBrendanExit2)
    applymovement(LOCALID_RIVALS_HOUSE_1F_RIVAL, LittlerootTown_BrendansHouse_1F_Movement_BrendanGoUpstairs2)
    waitmovement(0)
    return
}

movement LittlerootTown_BrendansHouse_1F_Movement_PlayerWatchBrendanExit0 {
    delay_16
    delay_8
    walk_in_place_faster_right
    step_end
}

movement LittlerootTown_BrendansHouse_1F_Movement_PlayerWatchBrendanExit1 {
    delay_16
    delay_8
    walk_in_place_faster_right
    delay_16
    delay_16
    walk_in_place_faster_up
    step_end
}

movement LittlerootTown_BrendansHouse_1F_Movement_PlayerWatchBrendanExit2 {
    delay_16
    delay_8
    walk_in_place_faster_left
    step_end
}

movement LittlerootTown_BrendansHouse_1F_Movement_BrendanGoUpstairs0 {
    walk_in_place_faster_right
    walk_right
    walk_in_place_faster_up
    walk_up
    walk_up
    step_end
}

movement LittlerootTown_BrendansHouse_1F_Movement_BrendanGoUpstairs1 {
    walk_in_place_faster_right
    walk_right
    walk_in_place_faster_up
    walk_up
    walk_up
    walk_in_place_faster_left
    walk_left
    walk_in_place_faster_up
    walk_up
    step_end
}

movement LittlerootTown_BrendansHouse_1F_Movement_BrendanGoUpstairs2 {
    walk_in_place_faster_left
    walk_left
    walk_in_place_faster_up
    walk_up
    walk_up
    step_end
}

text PlayersHouse_1F_Text_IsntItNiceInHere {
    "MOM: See, {PLAYER}?\n"
    "Isn't it nice in here, too?$"
}

text PlayersHouse_1F_Text_MoversPokemonGoSetClock {
    "The mover's POKéMON do all the work\n"
    "of moving us in and cleaning up after.\l"
    "This is so convenient!\p"
    "{PLAYER}, your room is upstairs.\n"
    "Go check it out, dear!\p"
    "DAD bought you a new clock to mark\n"
    "our move here.\l"
    "Don't forget to set it!$"
}

text PlayersHouse_1F_Text_ArentYouInterestedInRoom {
    "MOM: Well, {PLAYER}?\p"
    "Aren't you interested in seeing your\n"
    "very own room?$"
}

text PlayersHouse_1F_Text_GoSetTheClock {
    "MOM: {PLAYER}.\p"
    "Go set the clock in your room, honey.$"
}

text PlayersHouse_1F_Text_OhComeQuickly {
    "MOM: Oh! {PLAYER}, {PLAYER}!\n"
    "Quick! Come quickly!$"
}

text PlayersHouse_1F_Text_MaybeDadWillBeOn {
    "MOM: Look! It's PETALBURG GYM!\n"
    "Maybe DAD will be on!$"
}

text PlayersHouse_1F_Text_ItsOverWeMissedHim {
    "MOM: Oh… It's over.\p"
    "I think DAD was on, but we missed him.\n"
    "Too bad.$"
}

text PlayersHouse_1F_Text_GoIntroduceYourselfNextDoor {
    "Oh, yes.\n"
    "One of DAD's friends lives in town.\p"
    "PROF. BIRCH is his name.\p"
    "He lives right next door, so you should\n"
    "go over and introduce yourself.$"
}

text PlayersHouse_1F_Text_SeeYouHoney {
    "MOM: See you, honey!$"
}

text PlayersHouse_1F_Text_DidYouMeetProfBirch {
    "MOM: Did you introduce yourself to\n"
    "PROF. BIRCH?$"
}

text PlayersHouse_1F_Text_YouShouldRestABit {
    "MOM: How are you doing, {PLAYER}?\n"
    "You look a little tired.\p"
    "I think you should rest a bit.$"
}

text PlayersHouse_1F_Text_TakeCareHoney {
    "MOM: Take care, honey!$"
}

text PlayersHouse_1F_Text_GotDadsBadgeHeresSomethingFromMom {
    "MOM: Oh? Did DAD give you that BADGE?\p"
    "Then here's something from your MOM!$"
}

text PlayersHouse_1F_Text_DontPushYourselfTooHard {
    "Don't push yourself too hard, dear.\n"
    "You can always come home.\p"
    "Go for it, honey!$"
}

text PlayersHouse_1F_Text_IsThatAPokenav {
    "MOM: What is that, honey? A POKéNAV?\n"
    "Someone from DEVON gave it to you?\p"
    "Well, honey, how about registering\n"
    "your mom?\p"
    "… … …$"
}

text PlayersHouse_1F_Text_RegisteredMom {
    "Registered MOM\n"
    "in the POKéNAV.$"
}

text PlayersHouse_1F_Text_Vigoroth1 {
    "Fugiiiiih!$"
}

text PlayersHouse_1F_Text_Vigoroth2 {
    "Huggoh, uggo uggo…$"
}

text PlayersHouse_1F_Text_ReportFromPetalburgGym {
    "INTERVIEWER: …We brought you this\n"
    "report from in front of PETALBURG GYM.$"
}

text PlayersHouse_1F_Text_TheresAMovieOnTV {
    "There is a movie on TV.\p"
    "Two men are dancing on a big piano\n"
    "keyboard.\p"
    "Better get going!$"
}

text PlayersHouse_1F_Text_RunningShoesManual {
    "It's the instruction booklet for the\n"
    "RUNNING SHOES.\p"
    "“Press the B Button to run while\n"
    "wearing your RUNNING SHOES.\p"
    "“Lace up your RUNNING SHOES and hit\n"
    "the road running!”$"
}

text PlayersHouse_1F_Text_TicketFromBrineyCameForYou {
    "DAD: Hm?\p"
    "Hey, it's {PLAYER}!\p"
    "It's been a while since I saw you,\n"
    "but you look…stronger, somehow.\p"
    "That's the impression I get.\n"
    "But your old man hasn't given up yet!\p"
    "Oh, yes, I have something for you.\n"
    "This came to you from someone named\l"
    "MR. BRINEY.$"
}

text PlayersHouse_1F_Text_PortsInSlateportLilycove {
    "DAD: Hm, a TICKET for a ferry?\p"
    "If I recall, there are ferry ports in\n"
    "SLATEPORT and LILYCOVE.$"
}

text PlayersHouse_1F_Text_BetterGetBackToGym {
    "I'd better get back to PETALBURG GYM.\p"
    "MOM, thanks for looking after the house\n"
    "while I'm away.$"
}

text PlayersHouse_1F_Text_DadShouldStayLonger {
    "MOM: That DAD of yours…\p"
    "He comes home for the first time in a\n"
    "while, but all he talks about is POKéMON.\p"
    "He should relax and stay a little longer.$"
}

text PlayersHouse_1F_Text_IsThatABreakingStory {
    "MOM: Is that a breaking news story?$"
}

text PlayersHouse_1F_Text_LatiEmergencyNewsFlash {
    "We bring you this emergency\n"
    "news flash!\p"
    "In various HOENN locales, there have\n"
    "been reports of a BZZT…colored\l"
    "POKéMON in flight.\p"
    "The identity of this POKéMON is\n"
    "currently unknown.\p"
    "We now return you to the regular\n"
    "movie program.$"
}

text PlayersHouse_1F_Text_WhatColorDidTheySay {
    "MOM: {PLAYER}, did you catch that?\p"
    "What color did the announcer say\n"
    "that POKéMON was?$"
}

text PlayersHouse_1F_Text_StillUnknownPokemon {
    "MOM: Well, isn't that something!\n"
    "There are still unknown POKéMON.$"
}
