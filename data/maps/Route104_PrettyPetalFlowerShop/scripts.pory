	goto Route104_PrettyPetalFlowerShop_EventScript_ShopOwner_1

Route104_PrettyPetalFlowerShop_EventScript_ShopOwner_5:
# 30 "data/maps/Route104_PrettyPetalFlowerShop/scripts.pory"
