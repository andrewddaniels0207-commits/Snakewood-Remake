Route104_PrettyPetalFlowerShop_EventScript_RandomBerryGirl::
# 103 "data/maps/Route104_PrettyPetalFlowerShop/scripts.pory"
	lock
# 104 "data/maps/Route104_PrettyPetalFlowerShop/scripts.pory"
