// Oldale Town map scripts
// Snakewood remake — placeholder text throughout

mapscripts OldaleTown_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        call(Common_EventScript_SetupRivalGfxId)
        setflag(FLAG_VISITED_OLDALE_TOWN)
        if (!flag(FLAG_RECEIVED_POTION_OLDALE)) {
            call(OldaleTown_EventScript_MoveMartEmployee)
        }
        if (flag(FLAG_ADVENTURE_STARTED)) {
            call(OldaleTown_EventScript_SetOldaleState)
        }
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_SNAKEWOOD_INTRO_STATE, 2: OldaleTown_EventScript_BirchNicknameStarter
    ]
}

script OldaleTown_EventScript_SetOldaleState {
    setvar(VAR_OLDALE_TOWN_STATE, 1)
    return
}

script OldaleTown_EventScript_MoveMartEmployee {
    setobjectxyperm(LOCALID_OLDALE_MART_EMPLOYEE, 13, 14)
    setobjectmovementtype(LOCALID_OLDALE_MART_EMPLOYEE, MOVEMENT_TYPE_FACE_DOWN)
    return
}

// ================================
// Signs
// ================================

script OldaleTown_EventScript_TownSign {
    msgbox("Placeholder: Oldale Town sign.")
    end
}

// ================================
// Girl NPC
// ================================

script OldaleTown_EventScript_Girl {
    msgbox("Placeholder: Girl NPC dialogue.$", MSGBOX_NPC)
    end
}

// ================================
// Mart Employee
// ================================

script OldaleTown_EventScript_MartEmployee {
    lock
    faceplayer
    if (flag(FLAG_RECEIVED_POTION_OLDALE) || flag(FLAG_TEMP_1)) {
        msgbox("Placeholder: Potion explanation.")
        release
        end
    }
    setflag(FLAG_TEMP_1)
    playbgm(MUS_FOLLOW_ME, FALSE)
    msgbox("Placeholder: Mart employee intro dialogue.")
    closemessage
    switch (var(VAR_FACING)) {
        case DIR_SOUTH:
            applymovement(LOCALID_OLDALE_MART_EMPLOYEE, OldaleTown_Movement_EmployeeSouth)
            applymovement(LOCALID_PLAYER, OldaleTown_Movement_PlayerSouth)
            waitmovement(0)
        case DIR_NORTH:
            applymovement(LOCALID_OLDALE_MART_EMPLOYEE, OldaleTown_Movement_EmployeeNorth)
            applymovement(LOCALID_PLAYER, OldaleTown_Movement_PlayerNorth)
            waitmovement(0)
        case DIR_EAST:
            applymovement(LOCALID_PLAYER, OldaleTown_Movement_PlayerEast)
            applymovement(LOCALID_OLDALE_MART_EMPLOYEE, OldaleTown_Movement_EmployeeEast)
            waitmovement(0)
    }
    msgbox("Placeholder: Pokemon Mart explanation.")
    giveitem(ITEM_POTION)
    if (var(VAR_RESULT) == FALSE) {
        msgbox(gText_TooBadBagIsFull)
        fadedefaultbgm
        release
        end
    }
    msgbox("Placeholder: Potion explanation.")
    setflag(FLAG_RECEIVED_POTION_OLDALE)
    fadedefaultbgm
    release
    end
}

movement OldaleTown_Movement_EmployeeEast {
    walk_up * 7
    walk_in_place_faster_down
}

movement OldaleTown_Movement_EmployeeSouth {
    walk_left
    walk_up * 2
    walk_right
    walk_up * 5
    walk_in_place_faster_down
}

movement OldaleTown_Movement_EmployeeNorth {
    walk_up * 7
    walk_in_place_faster_down
}

movement OldaleTown_Movement_PlayerEast {
    walk_right
    walk_up * 5
}

movement OldaleTown_Movement_PlayerSouth {
    delay_16 * 4
    walk_up * 5
}

movement OldaleTown_Movement_PlayerNorth {
    walk_up * 7
}

// ================================
// Rival
// Inlined to avoid cross-script goto (poryscript goto() is label-only)
// ================================

script OldaleTown_EventScript_Rival {
    lockall
    applymovement(LOCALID_OLDALE_RIVAL, Common_Movement_FacePlayer)
    waitmovement(0)
    checkplayergender
    if (var(VAR_RESULT) == MALE) {
        msgbox("Placeholder: Rival (May) dialogue.")
    } else {
        msgbox("Placeholder: Rival (Brendan) dialogue.")
    }
    closemessage
    applymovement(LOCALID_OLDALE_RIVAL, OldaleTown_Movement_RivalExit)
    waitmovement(0)
    removeobject(LOCALID_OLDALE_RIVAL)
    setvar(VAR_OLDALE_RIVAL_STATE, 2)
    setflag(FLAG_HIDE_OLDALE_TOWN_RIVAL)
    releaseall
    end
}

script OldaleTown_EventScript_RivalTrigger1 {
    lockall
    applymovement(LOCALID_OLDALE_RIVAL, OldaleTown_Movement_RivalApproachPlayer1)
    waitmovement(0)
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterRight)
    waitmovement(0)
    checkplayergender
    if (var(VAR_RESULT) == MALE) {
        msgbox("Placeholder: Rival (May) dialogue.")
    } else {
        msgbox("Placeholder: Rival (Brendan) dialogue.")
    }
    closemessage
    applymovement(LOCALID_PLAYER, OldaleTown_Movement_WatchRivalExit)
    applymovement(LOCALID_OLDALE_RIVAL, OldaleTown_Movement_RivalExit)
    waitmovement(0)
    removeobject(LOCALID_OLDALE_RIVAL)
    setvar(VAR_OLDALE_RIVAL_STATE, 2)
    setflag(FLAG_HIDE_OLDALE_TOWN_RIVAL)
    releaseall
    end
}

