movement OldaleTown_Movement_RivalApproachPlayer1 {
    walk_left * 2
}

movement OldaleTown_Movement_RivalApproachPlayer2 {
    walk_left
}

movement OldaleTown_Movement_RivalApproachPlayer3 {
    face_left
}

movement OldaleTown_Movement_RivalExit {
    walk_down * 6
}

movement OldaleTown_Movement_WatchRivalExit {
    delay_8
    delay_4
    walk_in_place_faster_down
}

// ================================
// Snakewood: Rival Alicia — Route 102 Blocker
// ================================

script OldaleTown_EventScript_RivalAlicia {
    lock
    faceplayer
    if (!flag(FLAG_RECEIVED_BIRCH_EGG)) {
        msgbox("Placeholder: You can't go that way yet!
                Go get the egg from Birch on Route 103 first.")
        release
        end
    }
    trainerbattle_single(TRAINER_RIVAL_ALICIA_1,
        "Placeholder: Alicia pre-battle dialogue.",
        "Placeholder: Alicia defeat dialogue.")
    setflag(FLAG_HIDE_OLDALE_RIVAL_ALICIA)
    msgbox("Placeholder: Alicia post-battle dialogue.
            Fine, you may pass.")
    release
    end
}

// ================================
// South Exit Guards
// Guards at (8,20) and (11,20) block exit to Route 101.
// Triggered by coord events at (9,20) and (10,20).
// ================================

script OldaleTown_EventScript_Guard1 {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    msgbox("Placeholder: Guard 1 - You can't go south from here.$")
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, OldaleTown_Movement_PushNorth)
    waitmovement(0)
    releaseall
    end
}

script OldaleTown_EventScript_Guard2 {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    msgbox("Placeholder: Guard 2 - This road is blocked.$")
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, OldaleTown_Movement_PushNorth)
    waitmovement(0)
    releaseall
    end
}

movement OldaleTown_Movement_PushNorth {
    walk_up
}

// ================================
// Birch Nickname Starter
// Fires once in Oldale after arriving from Route 101 (VAR_SNAKEWOOD_INTRO_STATE == 2).
// Offers to nickname the player's starter.
// ================================

script OldaleTown_EventScript_BirchNicknameStarter {
    setvar(VAR_SNAKEWOOD_INTRO_STATE, 3)
    lockall
    msgbox("Placeholder: Birch arrives in Oldale.\p"
           "You handled that really well back there!\p"
           "Would you like to give your Pokémon a nickname?$")
    closemessage
    // TODO: Add proper nickname screen call here.
    // Example flow: bufferfirstpokemon, yesnobox, nicknamespecies
    msgbox("Placeholder: Birch - Take care of yourself out there.$")
    releaseall
    end
}
