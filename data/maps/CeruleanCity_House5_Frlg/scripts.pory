script CeruleanCity_House5_EventScript_ExitMenu {
    msgbox(CeruleanCity_House1_Text_SeeMeIfYoudLikeToTradePowder)
    special(RemoveBerryPowderVendorMenu)
    release
    end
}

script CeruleanCity_House5_EventScript_ExchangePowderForItem {
    msgbox(CeruleanCity_House1_Text_YoullExchangeBerryPowderForItem, MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        goto(CeruleanCity_House5_EventScript_ChooseExchangeItem)
    }
    copyvar(VAR_0x8004, VAR_0x8009)
    specialvar(VAR_RESULT, HasEnoughBerryPowder)
    if (var(VAR_RESULT) == FALSE) {
        goto(CeruleanCity_House5_EventScript_NotEnoughBerryPowder)
    }
    giveitem(VAR_0x8008)
    if (var(VAR_RESULT) == FALSE) {
        goto(CeruleanCity_House5_EventScript_BagIsFull)
    }
    copyvar(VAR_0x8004, VAR_0x8009)
    special(TakeBerryPowder)
    special(PrintPlayerBerryPowderAmount)
    msgbox(CeruleanCity_House1_Text_TradeMoreBerryPowder, MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        goto(CeruleanCity_House5_EventScript_ChooseExchangeItem)
    }
    msgbox(CeruleanCity_House1_Text_HopeToSeeYouAgain)
    special(RemoveBerryPowderVendorMenu)
    release
    end
}

script CeruleanCity_House5_EventScript_BagIsFull {
    msgbox(gText_TheBagIsFull)
    special(RemoveBerryPowderVendorMenu)
    release
    end
}

script CeruleanCity_House5_EventScript_NotEnoughBerryPowder {
    msgbox(CeruleanCity_House1_Text_DontHaveEnoughBerryPowder)
    goto(CeruleanCity_House5_EventScript_ChooseExchangeItem)
    end
}

script CeruleanCity_House5_EventScript_BerryCrushRankings {
    lockall
    special(ShowBerryCrushRankings)
    waitstate
    releaseall
    end
}

text CeruleanCity_House1_Text_AnyInterestInBerries {
    "I concoct a variety of medicine\n"
    "from BERRY POWDER.\p"
    "Using good BERRY POWDER, I can\n"
    "make any kind of medicine.\p"
    "Now tell me, have you any interest\n"
    "in BERRIES?$"
}

text CeruleanCity_House1_Text_HaveJustTheThing {
    "Ah, good! For you, then, I have\n"
    "just the thing.$"
}

text CeruleanCity_House1_Text_GoCrushBerriesAtDirectCorner {
    "There's something new on the second\n"
    "floor of POKéMON CENTERS, at the\l"
    "DIRECT CORNER.\p"
    "They installed a Wireless Adapter\n"
    "machine for crushing BERRIES.\p"
    "This is where you come in.\p"
    "I have a favor to ask, one that\n"
    "I can entrust only to you.\p"
    "Could you make BERRY POWDER for\n"
    "me using that machine?\p"
    "Don't forget, the machine is at the\n"
    "DIRECT CORNER of POKéMON CENTERS.\p"
    "I'll concoct medicine for you if\n"
    "you bring me some BERRY POWDER.\p"
    "Don't forget, crush BERRIES into\n"
    "BERRY POWDER and bring it to me.$"
}

text CeruleanCity_House1_Text_WhyMustYouLieNoBerries {
    "Why must you lie to me?\p"
    "How many BERRIES do you have?\n"
    "Not a one!$"
}

text CeruleanCity_House1_Text_TakeInterestInAllSortsOfThings {
    "You have no interest in BERRIES?\p"
    "Young one, it's important to take an\n"
    "interest in all sorts of things.$"
}

text CeruleanCity_House1_Text_HaveYouBroughtBerryPowder {
    "Er-hem! Have you brought me some\n"
    "BERRY POWDER?$"
}

text CeruleanCity_House5_Text_ExchangeWithWhat {
    "With what would you like to \n"
    "exchange it?$"
}

text CeruleanCity_House1_Text_YoullExchangeBerryPowderForItem {
    "Fine, you'll exchange your BERRY\n"
    "POWDER for one {STR_VAR_1}?$"
}

text CeruleanCity_House1_Text_DontHaveEnoughBerryPowder {
    "Hm? You don't have enough\n"
    "BERRY POWDER.$"
}

text CeruleanCity_House1_Text_TradeMoreBerryPowder {
    "This is fine BERRY POWDER indeed.\n"
    "It will make excellent medicine.\p"
    "Would you like to trade more BERRY\n"
    "POWDER for something else?$"
}

text CeruleanCity_House1_Text_HopeToSeeYouAgain {
    "That's fine, then.\n"
    "I'll hope to see you back again.$"
}

text CeruleanCity_House1_Text_SeeMeIfYoudLikeToTradePowder {
    "Come see me if you'd like to trade\n"
    "your BERRY POWDER.$"
}
